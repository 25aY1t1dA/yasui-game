# ==============================================================================
# YASUI GAME - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi .env dan isi dengan kredensial riil server Anda.
# JANGAN PERNAH COMMIT FILE .env YANG BERISI KUNCI ASLI KE GIT REPOSITORY!
# ==============================================================================

# --- WOOCOMMERCE & WORDPRESS BACKEND ---
# URL backend WordPress headless (tanpa trailing slash)
WP_URL=https://admin.yasuigame.com
# WooCommerce REST API v3 Consumer Key & Consumer Secret (dibuat via WP Admin > WooCommerce > Settings > Advanced > REST API)
WC_CONSUMER_KEY=ck_your_consumer_key_here
WC_CONSUMER_SECRET=cs_your_consumer_secret_here

# --- WORDPRESS APPLICATION PASSWORD (MEDIA / ASSETS PROXY) ---
# Diperlukan jika media library atau endpoint WordPress terproteksi basic auth
WP_APP_USER=your_wp_username
WP_APP_PASSWORD=your_application_password_here
WP_USER=your_wp_username
WP_PASS=your_application_password_here

# --- DUITKU PAYMENT GATEWAY (HEADLESS DIRECT API) ---
# Merchant Code dan API Key dari Duitku Dashboard
DUITKU_MERCHANT_CODE=DXXXX
DUITKU_API_KEY=your_duitku_api_key_here
# Mode: "sandbox" untuk testing atau "production" untuk live transaksi
DUITKU_ENV=sandbox

# --- APPLICATION URL ---
# Base URL frontend Astro (sesuaikan untuk local dev atau production domain)
APP_URL=http://localhost:4321

# --- SKY ARENA STATION (AUTOMATION FULFILLMENT) ---
# Konfigurasi autentikasi API SkyArena Station untuk otomatisasi Summoners War
SKYARENA_LOGIN_URL=https://visual.skyarenastation.com/login
SKYARENA_EMAIL=your_skyarena_email@example.com
SKYARENA_PASSWORD=your_skyarena_password_here
SW_USD_RATE=18500

# --- SUPABASE PERSISTENCE (OMNICHANNEL WEB CHAT & SESSIONS) ---
# Project URL & Anon Key (Client-Safe / Optional)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key (SERVER-SIDE ONLY - DILARANG DIBOCORKAN KE FRONTEND / BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- TELEGRAM ADMIN BOT (OMNICHANNEL CS DISPATCHER) ---
# Bot Token dari @BotFather dan Chat ID Admin / Channel Group
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_ID=-1001234567890
# Secret Token untuk memvalidasi request resmi Telegram Webhook (Header: x-telegram-bot-api-secret-token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# --- AI CUSTOMER SUPPORT ENGINE (OPTIONAL - FALLBACK 0-TOKEN READY) ---
# OpenAI API Key (Rekomendasi: gpt-4o-mini untuk latensi ultra-cepat dan biaya sangat ekonomis)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Alternatif: Google Gemini API Key jika menggunakan Gemini Flash
GEMINI_API_KEY=your_gemini_api_key_here

# --- SELF-HOSTED CRYPTO PAYMENT GATEWAY (USDT & USDC ON-CHAIN VERIFICATION) ---
# Alamat dompet EVM Owner (menerima USDT di BSC BEP-20 & USDC/USDT di Polygon POS)
CRYPTO_WALLET_EVM=0x71C95911E9A5D330f4D621842EC243EE1343292e
# Alamat dompet TRON TRC-20 Owner (menerima USDT di TRON TRC-20)
CRYPTO_WALLET_TRC20=TYDzsYUEpvnYmQk4zGP9sWWcTEd2MiAtW6
# RPC Node Publik (Gratis, tanpa API Key)
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
TRONGRID_API_URL=https://api.trongrid.io
# BscScan API Key opsional (fallback)
BSCSCAN_API_KEY=
# Kurs Konversi IDR ke USD/USDT untuk penetapan harga crypto (Default: 16000)
CRYPTO_USD_RATE=16000



