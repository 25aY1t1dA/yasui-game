---
import FloatingWA from "../components/FloatingWA.astro";
import Icon from "../components/ui/Icon.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	showFooter?: boolean;
}

const {
	title,
	description = "Yasui Game - Marketplace Game RMT Premium, Pengiriman Instan, Aman, dan Bergaransi 100%.",
	showFooter = true,
} = Astro.props;

const cookieCurr = Astro.cookies.get("yasui_currency")?.value;
const cookieLang = Astro.cookies.get("yasui_lang")?.value;
const geoParam = Astro.url.searchParams.get("geo")?.toUpperCase();
const vercelCountry = Astro.request.headers.get("x-vercel-ip-country");
const cfCountry = Astro.request.headers.get("cf-ipcountry");
const acceptLang = Astro.request.headers.get("accept-language")?.toLowerCase() || "";

const isForeignByGeo = (geoParam && geoParam !== "ID") || (vercelCountry && vercelCountry !== "ID") || (cfCountry && cfCountry !== "ID");
const isIndonesianByLang = acceptLang.startsWith("id") || acceptLang.includes(",id") || acceptLang.includes("id-");

const serverDefaultLang = cookieLang || (isForeignByGeo ? "en" : (isIndonesianByLang ? "id" : "en"));
const serverDefaultCurr = cookieCurr || (serverDefaultLang === "id" ? "IDR" : "USD");
const detectedCountry = geoParam || vercelCountry || cfCountry || (serverDefaultLang === "id" ? "ID" : "US");

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isKatalog = pathname.startsWith("/categories") || pathname.startsWith("/category");
const isCart = pathname.startsWith("/cart");
const isCheckout = pathname.startsWith("/checkout");

const shouldShowFooter = showFooter && !isCart && !isCheckout;
---

<!doctype html>
<html lang={serverDefaultLang} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#090A0F" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		{/* Anti-Flicker & Regional Auto-Detection Inline Script */}
		<script is:inline>
			(function () {
				try {
					var storedLang = localStorage.getItem("yasui_lang");
					var storedCurr = localStorage.getItem("yasui_currency");

					if (!storedLang) {
						var browserLang = (navigator.language || navigator.userLanguage || "").toLowerCase();
						storedLang = browserLang.startsWith("id") ? "id" : "en";
						localStorage.setItem("yasui_lang", storedLang);
					}
					if (!storedCurr) {
						storedCurr = storedLang === "id" ? "IDR" : "USD";
						localStorage.setItem("yasui_currency", storedCurr);
					}

					document.cookie = "yasui_lang=" + storedLang + "; path=/; max-age=31536000; SameSite=Lax";
					document.cookie = "yasui_currency=" + storedCurr + "; path=/; max-age=31536000; SameSite=Lax";

					document.documentElement.lang = storedLang;
					window.__YASUI_INITIAL_LANG__ = storedLang;
					window.__YASUI_INITIAL_CURR__ = storedCurr;
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="min-h-screen pb-20 md:pb-0 bg-[#090A0F] text-[#94A3B8] font-sans selection:bg-[#00E5FF]/20 selection:text-[#00E5FF]">
		<header
			id="main-header"
			class="fixed top-0 left-0 right-0 z-50 h-16 bg-[#090A0F]/95 backdrop-blur-sm border-b border-[#222634] transition-all duration-150"
		>
			<div class="yg-shell h-full flex items-center justify-between gap-3">
				<div class="flex items-center gap-4 lg:gap-6 shrink-0">
					<a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="Yasui Game Homepage">
						<div class="w-8 h-8 rounded-md bg-[#11131A] border border-[#222634] flex items-center justify-center text-[#00E5FF] group-hover:border-[#00E5FF]/50 transition-colors">
							<div class="i-lucide-gamepad-2 text-lg"></div>
						</div>
						<span class="text-sm sm:text-base font-bold text-[#F8FAFC] tracking-tight inline font-mono">
							YASUI<span class="text-[#00E5FF]">GAME</span>
						</span>
					</a>

					<nav class="hidden md:flex items-center gap-1 text-xs font-medium" aria-label="Main Navigation">
						<a
							href="/categories"
							class="px-3 py-1.5 rounded-md text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-[#161922] transition-colors flex items-center gap-1.5"
							data-i18n="nav.catalog"
						>
							<div class="i-lucide-grid text-sm text-[#00E5FF]"></div>
							<span>Katalog</span>
						</a>
						<a
							href="/cara-belanja"
							class="px-3 py-1.5 rounded-md text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-[#161922] transition-colors flex items-center gap-1.5"
							data-i18n="nav.how_to_order"
						>
							<div class="i-lucide-book-open text-sm text-[#64748B]"></div>
							<span>Cara Order</span>
						</a>
					</nav>
				</div>

				<div class="hidden md:block flex-1 max-w-md mx-2 relative" id="desktop-search-container">
					<div class="relative group">
						<input
							id="desktop-search-input"
							type="text"
							name="q"
							placeholder="Cari game, produk, atau voucher..."
							data-i18n-placeholder="nav.search_placeholder"
							autocomplete="off"
							class="w-full bg-[#0D0F17] hover:bg-[#11131A] focus:bg-[#0D0F17] border border-[#222634] focus:border-[#00E5FF] text-[#F8FAFC] placeholder-[#64748B] text-xs pl-8 pr-12 py-2 rounded-md transition-colors outline-none font-mono"
						/>
						<div class="absolute left-2.5 top-2.5 text-[#64748B] group-focus-within:text-[#00E5FF] transition-colors pointer-events-none">
							<div class="i-lucide-search text-xs"></div>
						</div>
						<div class="absolute right-2.5 top-2 hidden lg:flex items-center gap-1 pointer-events-none">
							<kbd class="text-[9px] font-mono text-[#64748B] bg-[#161922] border border-[#222634] px-1.5 py-0.5 rounded">Enter</kbd>
						</div>
					</div>
					<div
						id="desktop-search-dropdown"
						class="hidden absolute top-full left-0 right-0 mt-1.5 yg-panel border border-[#222634] overflow-hidden z-50"
					>
						<div id="desktop-search-results" class="max-h-80 overflow-y-auto"></div>
					</div>
				</div>

				<div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
					<button
						type="button"
						id="mobile-search-toggle"
						onclick="window.toggleMobileSearch && window.toggleMobileSearch()"
						class="md:hidden yg-btn-icon"
						aria-label="Cari produk"
					>
						<div class="i-lucide-search text-sm"></div>
					</button>

					<div class="relative" id="regional-switcher-container">
						<button
							type="button"
							id="header-regional-btn"
							onclick="window.toggleRegionalMenu && window.toggleRegionalMenu()"
							class="yg-btn-icon !w-auto px-2.5 gap-1.5 text-xs font-mono font-medium"
							title="Pengaturan Wilayah, Mata Uang & Bahasa"
							aria-label="Ganti Mata Uang dan Bahasa"
						>
							<div class="i-lucide-globe text-xs text-[#00E5FF]"></div>
							<span id="header-curr-label" class="text-[11px] sm:text-xs text-[#F8FAFC]">{serverDefaultCurr}</span>
						</button>

						<div
							id="header-regional-menu"
							class="hidden absolute right-0 mt-2 w-64 yg-panel p-3 text-left font-mono z-50"
						>
							<div class="text-[10px] text-[#94A3B8] uppercase tracking-widest font-semibold mb-2.5 pb-1.5 border-b border-[#222634] flex items-center justify-between">
								<span class="flex items-center gap-1.5" data-i18n="regional.title">
									<span class="i-lucide-sliders-horizontal text-[#00E5FF] text-xs"></span>
									PREFERENSI REGIONAL
								</span>
								<span class="text-[9px] text-[#00E5FF]" data-i18n="regional.auto">AUTO</span>
							</div>

							<div class="mb-3">
								<div class="text-[10px] text-[#64748B] uppercase tracking-wider mb-1.5 font-sans" data-i18n="regional.currency">Mata Uang</div>
								<div class="grid grid-cols-2 gap-1.5">
									<button
										type="button"
										onclick="window.selectCurrency && window.selectCurrency('IDR')"
										id="curr-opt-idr"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-md bg-[#161922] hover:bg-[#1E2230] border border-[#222634] text-xs font-semibold text-[#F8FAFC] transition-colors cursor-pointer"
									>
										<span class="text-[#64748B] text-[10px]">Rp</span>
										<span>IDR</span>
									</button>
									<button
										type="button"
										onclick="window.selectCurrency && window.selectCurrency('USD')"
										id="curr-opt-usd"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-md bg-[#161922] hover:bg-[#1E2230] border border-[#222634] text-xs font-semibold text-[#F8FAFC] transition-colors cursor-pointer"
									>
										<span class="text-[#00E5FF] text-[10px]">$</span>
										<span>USD</span>
									</button>
								</div>
							</div>

							<div>
								<div class="text-[10px] text-[#64748B] uppercase tracking-wider mb-1.5 font-sans" data-i18n="regional.language">Bahasa</div>
								<div class="grid grid-cols-2 gap-1.5">
									<button
										type="button"
										onclick="window.selectLanguage && window.selectLanguage('id')"
										id="lang-opt-id"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-md bg-[#161922] hover:bg-[#1E2230] border border-[#222634] text-xs font-semibold text-[#F8FAFC] transition-colors cursor-pointer"
									>
										<span>🇮🇩</span>
										<span>INDONESIA</span>
									</button>
									<button
										type="button"
										onclick="window.selectLanguage && window.selectLanguage('en')"
										id="lang-opt-en"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-md bg-[#161922] hover:bg-[#1E2230] border border-[#222634] text-xs font-semibold text-[#F8FAFC] transition-colors cursor-pointer"
									>
										<span>🇬🇧</span>
										<span>ENGLISH</span>
									</button>
								</div>
							</div>
						</div>
					</div>

					<button
						type="button"
						id="header-chat-btn"
						onclick="window.openLiveChatModal && window.openLiveChatModal()"
						class="relative yg-btn-icon"
						title="Live Chat Admin"
						aria-label="Buka Live Chat Admin"
					>
						<div class="i-lucide-message-square text-sm"></div>
						<span class="absolute -top-0.5 -right-0.5 w-2 h-2 bg-emerald-400 rounded-full border border-[#090A0F]"></span>
					</button>

					<a
						href="/cart"
						class="hidden md:flex relative yg-btn-icon"
						title="Keranjang Belanja"
						aria-label="Keranjang Belanja"
					>
						<div class="i-lucide-shopping-cart text-sm"></div>
						<span
							id="global-cart-badge"
							class="absolute -top-1.5 -right-1.5 bg-[#00E5FF] text-[#090A0F] font-bold text-[10px] min-w-4 h-4 px-1 rounded flex items-center justify-center hidden font-mono tabular-nums border border-[#090A0F]"
						>
							0
						</span>
					</a>

					<div id="nav-auth-container" class="relative hidden md:block">
						<button
							id="nav-login-btn"
							onclick="window.openAuthModal && window.openAuthModal('login')"
							class="yg-btn-primary py-1.5 px-3"
							title="Masuk ke Akun"
							data-i18n="nav.login"
						>
							<div class="i-lucide-user text-xs"></div>
							<span>Masuk</span>
						</button>

						<div id="nav-user-dropdown" class="hidden relative">
							<button
								id="nav-user-btn"
								onclick="window.toggleUserMenu && window.toggleUserMenu()"
								class="flex items-center gap-2 bg-[#161922] border border-[#222634] hover:border-[#00E5FF]/40 px-2.5 py-1.5 rounded-md transition-colors text-[#F8FAFC] cursor-pointer"
								aria-label="Menu Pengguna"
							>
								<div class="w-5 h-5 rounded bg-[#00E5FF] text-[#090A0F] font-bold text-[10px] flex items-center justify-center font-mono" id="nav-user-initial">
									U
								</div>
								<span class="hidden md:block text-xs font-semibold uppercase tracking-wider max-w-[90px] truncate" id="nav-user-name" data-i18n="nav.account">
									AKUN
								</span>
								<div class="i-lucide-chevron-down text-xs text-[#94A3B8]"></div>
							</button>

							<div
								id="nav-user-menu"
								class="hidden absolute right-0 mt-2 w-60 yg-panel p-2 text-left z-50"
							>
								<div class="px-3 py-2 border-b border-[#222634] mb-1.5 bg-[#0D0F15] rounded-md">
									<div class="text-[9px] text-[#64748B] font-mono uppercase tracking-wider" data-i18n="nav.connected_account">Akun Terhubung</div>
									<div class="text-xs font-semibold text-[#F8FAFC] truncate" id="nav-menu-email">user@email.com</div>
									<div class="text-[10px] text-[#00E5FF] flex items-center gap-1.5 mt-0.5 font-mono" data-i18n="nav.session_active">
										<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Sesi 30 Hari Aktif
									</div>
								</div>

								<a
									href="/orders"
									class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-[#161922] rounded-md transition-colors"
									data-i18n="nav.my_orders"
								>
									<div class="i-lucide-receipt text-[#00E5FF] text-sm"></div>
									<span>Pesanan Saya</span>
								</a>

								<button
									onclick="window.openSetPasswordModal && window.openSetPasswordModal()"
									class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-[#94A3B8] hover:text-[#F8FAFC] hover:bg-[#161922] rounded-md transition-colors text-left cursor-pointer"
									data-i18n="nav.change_password"
								>
									<div class="i-lucide-key-round text-amber-400 text-sm"></div>
									<span>Ganti Kata Sandi</span>
								</button>

								<div class="border-t border-[#222634] my-1"></div>

								<button
									onclick="window.logoutUser && window.logoutUser()"
									class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-medium text-red-400 hover:bg-red-950/30 rounded-md transition-colors text-left cursor-pointer"
									data-i18n="nav.logout"
								>
									<div class="i-lucide-log-out text-red-400 text-sm"></div>
									<span>Keluar (Logout)</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div
				id="mobile-search-row"
				class="md:hidden transition-all duration-200 ease-in-out max-h-0 opacity-0 overflow-hidden bg-[#090A0F] border-b border-[#222634]"
			>
				<div class="px-4 py-2.5">
					<div class="relative group">
						<input
							id="mobile-search-input"
							type="text"
							name="q"
							placeholder="Cari game atau platform..."
							data-i18n-placeholder="nav.mobile_search_placeholder"
							autocomplete="off"
							class="w-full bg-[#0D0F17] focus:bg-[#11131A] border border-[#222634] focus:border-[#00E5FF] text-[#F8FAFC] placeholder-[#64748B] text-xs pl-8 pr-8 py-2 rounded-md outline-none font-mono transition-colors"
						/>
						<div class="absolute left-2.5 top-2.5 text-[#64748B] group-focus-within:text-[#00E5FF] transition-colors pointer-events-none">
							<div class="i-lucide-search text-xs"></div>
						</div>
						<button
							type="button"
							onclick="window.toggleMobileSearch && window.toggleMobileSearch()"
							class="absolute right-2 top-1.5 w-6 h-6 flex items-center justify-center rounded text-[#64748B] hover:text-[#F8FAFC] transition-colors cursor-pointer"
							aria-label="Tutup pencarian"
						>
							<div class="i-lucide-x text-xs"></div>
						</button>
					</div>
					<div
						id="mobile-search-dropdown"
						class="hidden mt-1.5 bg-[#11131A] border border-[#222634] rounded-md shadow-xl overflow-hidden"
					>
						<div id="mobile-search-results" class="max-h-60 overflow-y-auto"></div>
					</div>
				</div>
			</div>
		</header>

		<div class="pt-16">
			<slot />
		</div>

		{
			shouldShowFooter && (
				<footer class="bg-[#090A0F] border-t border-[#222634] pt-14 pb-20 md:pb-12 mt-16">
					<div class="yg-shell">
						<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12 pb-10 border-b border-[#222634]">
							<div class="flex items-start gap-3.5 p-4 rounded-lg bg-[#11131A] border border-[#222634]">
								<div class="w-10 h-10 rounded-md bg-[#00E5FF]/10 border border-[#00E5FF]/25 text-[#00E5FF] flex items-center justify-center shrink-0">
									<div class="i-lucide-zap text-lg"></div>
								</div>
								<div>
									<h4 class="text-xs font-bold text-[#F8FAFC] uppercase tracking-wider font-mono" data-i18n="footer.instant_delivery_title">Instant Delivery</h4>
									<p class="text-xs text-[#94A3B8] mt-1 leading-relaxed" data-i18n="footer.instant_delivery_desc">
										Kredensial akun dikirim otomatis ke email dan dashboard <span class="font-mono text-[#F8FAFC]">&lt; 2 menit</span> pasca pembayaran.
									</p>
								</div>
							</div>

							<div class="flex items-start gap-3.5 p-4 rounded-lg bg-[#11131A] border border-[#222634]">
								<div class="w-10 h-10 rounded-md bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 flex items-center justify-center shrink-0">
									<div class="i-lucide-shield-check text-lg"></div>
								</div>
								<div>
									<h4 class="text-xs font-bold text-[#F8FAFC] uppercase tracking-wider font-mono" data-i18n="footer.anti_hackback_title">100% Anti-Hackback</h4>
									<p class="text-xs text-[#94A3B8] mt-1 leading-relaxed" data-i18n="footer.anti_hackback_desc">
										Garansi penuh pergantian akun atau pengembalian saldo jika terjadi masalah kepemilikan.
									</p>
								</div>
							</div>

							<div class="flex items-start gap-3.5 p-4 rounded-lg bg-[#11131A] border border-[#222634]">
								<div class="w-10 h-10 rounded-md bg-amber-500/10 border border-amber-500/25 text-amber-400 flex items-center justify-center shrink-0">
									<div class="i-lucide-lock text-lg"></div>
								</div>
								<div>
									<h4 class="text-xs font-bold text-[#F8FAFC] uppercase tracking-wider font-mono" data-i18n="footer.payment_title">Official Payment</h4>
									<p class="text-xs text-[#94A3B8] mt-1 leading-relaxed" data-i18n="footer.payment_desc">
										Gateway pembayaran berlisensi via Duitku (QRIS dinamis, Virtual Account BCA/Mandiri/BRI, E-Wallet).
									</p>
								</div>
							</div>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-10">
							<div class="col-span-1 md:col-span-2">
								<div class="flex items-center gap-2 mb-3">
									<div class="w-6 h-6 rounded bg-[#11131A] border border-[#222634] flex items-center justify-center text-[#00E5FF]">
										<div class="i-lucide-gamepad-2 text-sm"></div>
									</div>
									<span class="text-sm font-bold text-[#F8FAFC] font-mono tracking-tight">YASUI<span class="text-[#00E5FF]">GAME</span></span>
								</div>
								<p class="text-xs text-[#94A3B8] leading-relaxed max-w-md" data-i18n="footer.desc">
									Platform Single-Vendor Real Money Trading (RMT) terpercaya. Spesialisasi akun Summoners War, Roblox Universe, Mobile Legends, dan layanan digital gaming terverifikasi.
								</p>
								<div class="mt-4 flex items-center gap-2 text-xs font-mono text-[#64748B]">
									<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#11131A] border border-[#222634]" data-i18n="footer.api_status">
										<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Status Sistem: Beroperasi Normal
									</span>
								</div>
							</div>

							<div>
								<h3 class="text-[#F8FAFC] font-semibold text-xs uppercase tracking-wider mb-3.5 font-mono" data-i18n="footer.info">
									Navigasi & Ketentuan
								</h3>
								<ul class="space-y-2 text-xs text-[#94A3B8]">
									<li><a href="/cara-belanja" class="hover:text-[#F8FAFC] transition-colors" data-i18n="footer.how_to_order">Cara Belanja</a></li>
									<li><a href="/security-guide" class="hover:text-[#F8FAFC] transition-colors" data-i18n="footer.security_guide">Panduan Keamanan Akun</a></li>
									<li><a href="/terms" class="hover:text-[#F8FAFC] transition-colors" data-i18n="footer.terms">Syarat & Ketentuan</a></li>
									<li><a href="/privacy" class="hover:text-[#F8FAFC] transition-colors" data-i18n="footer.privacy">Kebijakan Privasi</a></li>
								</ul>
							</div>

							<div>
								<h3 class="text-[#F8FAFC] font-semibold text-xs uppercase tracking-wider mb-3.5 font-mono" data-i18n="footer.cs">
									Dukungan CS
