			// ==========================================
			// --- GLOBAL AUTH & SESSION LOGIC (30 DAYS) ---
			// ==========================================
			window.getSession = function() {
				try {
					const raw = localStorage.getItem("yasui_session");
					if (raw) {
						const session = JSON.parse(raw);
						// Cek kadaluwarsa (30 hari)
						if (!session.expiresAt || Date.now() <= session.expiresAt) {
							return session;
						}
						console.log("Sesi 30 hari telah berakhir.");
						localStorage.removeItem("yasui_session");
					}
					// Jika ada email pembeli tersimpan, otomatis buatkan sesi pembeli 30 hari
					const savedEmail = localStorage.getItem("yasui_buyer_email");
					if (savedEmail) {
						const autoSession = {
							email: savedEmail,
							name: savedEmail.split("@")[0],
							isGuestBuyer: true,
							expiresAt: Date.now() + (30 * 24 * 60 * 60 * 1000)
						};
						localStorage.setItem("yasui_session", JSON.stringify(autoSession));
						return autoSession;
					}
					return null;
				} catch {
					return null;
				}
			};

			window.updateNavAuthUI = function() {
				const session = window.getSession();

				const loginBtn = document.getElementById("nav-login-btn");
				const userDropdown = document.getElementById("nav-user-dropdown");
