		<script is:inline define:vars={{ translations, serverDefaultCurr, serverDefaultLang, detectedCountry }}>
			// --- TRANSLATION DICTIONARY ---
			const TRANSLATIONS = translations;

			// --- GLOBAL CURRENCY & LANG LOGIC (SERVER-SIDE GEO-IP INTEGRATED) ---
			const USD_RATE = 16000;
			
			// Priority:
			// 1. localStorage (if user explicitly set previously)
			// 2. serverDefaultCurr / serverDefaultLang (from Server-Side GeoIP / Cookie)
			let curr = localStorage.getItem("yasui_currency") || serverDefaultCurr || "IDR";
			let lang = localStorage.getItem("yasui_lang") || serverDefaultLang || "id";

			// Sync storage on first visit
			if (!localStorage.getItem("yasui_currency")) {
				localStorage.setItem("yasui_currency", curr);
			}
			if (!localStorage.getItem("yasui_lang")) {
				localStorage.setItem("yasui_lang", lang);
			}

			// Footer elements (if rendered)
			const btn = document.getElementById("currency-btn");
			const txt = document.getElementById("currency-text");
			const flag = document.getElementById("currency-flag");

			const langBtn = document.getElementById("lang-btn");
			const langTxt = document.getElementById("lang-text");

			// Helper functions for selecting Currency & Language
			window.selectCurrency = function(newCurr) {
				curr = newCurr;
				localStorage.setItem("yasui_currency", curr);
				document.cookie = `yasui_currency=${curr}; path=/; max-age=31536000; SameSite=Lax`;
				updateGlobalUI();
				document.dispatchEvent(new Event("yasui-currency-change"));
			};

			window.selectLanguage = function(newLang) {
				lang = newLang;
				localStorage.setItem("yasui_lang", lang);
				document.cookie = `yasui_lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
				updateGlobalUI();
				document.dispatchEvent(new Event("yasui-lang-change"));
			};

			window.toggleRegionalMenu = function() {
				const menu = document.getElementById("header-regional-menu");
				if (menu) {
					menu.classList.toggle("hidden");
				}
			};

			// --- MOBILE SEARCH EXPANDABLE ---
			let mobileSearchOpen = false;

			window.toggleMobileSearch = function() {
				const row = document.getElementById("mobile-search-row");
				const header = document.getElementById("main-header");
				const toggleBtn = document.getElementById("mobile-search-toggle");
				const mobDropdown = document.getElementById("mobile-search-dropdown");
				if (!row) return;

				mobileSearchOpen = !mobileSearchOpen;

				if (mobileSearchOpen) {
					row.classList.remove("max-h-0", "opacity-0");
					row.classList.add("max-h-16", "opacity-100");
					header.classList.add("border-cyan-500/20");
					// Auto-focus the input after animation
					setTimeout(() => {
						const input = document.getElementById("mobile-search-input");
						if (input) input.focus();
					}, 200);
					// Swap icon to X
					if (toggleBtn) {
						toggleBtn.innerHTML = '<div class="i-lucide-x text-sm"></div>';
						toggleBtn.classList.add("border-cyan-500/50", "text-cyan-400", "bg-cyan-950/30");
					}
				} else {
					row.classList.remove("max-h-16", "opacity-100");
					row.classList.add("max-h-0", "opacity-0");
					header.classList.remove("border-cyan-500/20");
					// Hide dropdown
					if (mobDropdown) mobDropdown.classList.add("hidden");
					// Swap icon back to search
					if (toggleBtn) {
						toggleBtn.innerHTML = '<div class="i-lucide-search text-sm"></div>';
						toggleBtn.classList.remove("border-cyan-500/50", "text-cyan-400", "bg-cyan-950/30");
