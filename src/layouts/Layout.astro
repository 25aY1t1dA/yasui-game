---
// src/layouts/Layout.astro
import FloatingWA from "../components/FloatingWA.astro";

interface Props {
	title: string;
	description?: string;
	showFooter?: boolean;
}

const {
	title,
	description = "Yasui Game - Marketplace Game Premium Terpercaya, Aman, dan Bergaransi.",
	showFooter = true,
} = Astro.props;

import { translations } from "../lib/translations";

// --- SERVER-SIDE GEO-IP & USER REGIONAL PREFERENCES ---
// 1. Cek Cookie manual pengguna
const cookieCurr = Astro.cookies.get("yasui_currency")?.value;
const cookieLang = Astro.cookies.get("yasui_lang")?.value;

// 2. Cek parameter pengujian lokal (?geo=US atau ?geo=ID)
const geoParam = Astro.url.searchParams.get("geo")?.toUpperCase();

// 3. Header resmi Vercel Serverless / Edge & Cloudflare
const vercelCountry = Astro.request.headers.get("x-vercel-ip-country");
const cfCountry = Astro.request.headers.get("cf-ipcountry");
const detectedCountry = geoParam || vercelCountry || cfCountry || "ID";

// 4. Default: Jika bukan Indonesia, otomatis USD & English
const isForeign = detectedCountry !== "ID";
const serverDefaultCurr = cookieCurr || (isForeign ? "USD" : "IDR");
const serverDefaultLang = cookieLang || (isForeign ? "en" : "id");

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isKatalog = pathname.startsWith("/categories") || pathname.startsWith("/category");
const isOrders = pathname.startsWith("/orders");
const isCart = pathname.startsWith("/cart");
const isCheckout = pathname.startsWith("/checkout");

const shouldShowFooter = showFooter && !isCart && !isCheckout;
---

<!doctype html>
<html lang={serverDefaultLang} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;800&display=swap"
			rel="stylesheet"
		/>

		<style is:global>
			body {
				font-family: "JetBrains Mono", monospace;
				background-color: #050505;
				background-image:
					linear-gradient(
						rgba(34, 211, 238, 0.05) 1px,
						transparent 1px
					),
					linear-gradient(
						90deg,
						rgba(34, 211, 238, 0.05) 1px,
						transparent 1px
					);
				background-size: 40px 40px;
				color: #d1d5db;
			}
			.cyber-card {
				clip-path: polygon(
					0 0,
					100% 0,
					100% calc(100% - 15px),
					calc(100% - 15px) 100%,
					0 100%
				);
			}
			.scrollbar-none::-webkit-scrollbar,
			.no-scrollbar::-webkit-scrollbar {
				display: none !important;
				width: 0 !important;
				height: 0 !important;
			}
			.scrollbar-none,
			.no-scrollbar {
				-ms-overflow-style: none !important;
				scrollbar-width: none !important;
			}
		</style>
	</head>
	<body class="min-h-screen pb-24 md:pb-0">
		<header
			id="main-header"
			class="fixed top-0 left-0 right-0 z-50 bg-black/85 backdrop-blur-md border-b border-white/10 shadow-lg transition-all duration-300"
		>
			<!-- ROW 1: MAIN NAVBAR -->
			<div
				class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-3"
			>
				<!-- LEFT: BRAND & MAIN NAVIGATION -->
				<div class="flex items-center gap-4 lg:gap-6 flex-shrink-0">
					<a href="/" class="flex items-center gap-2 group flex-shrink-0" aria-label="Yasui Game">
						<div class="w-8 h-8 rounded-lg bg-cyan-950/70 border border-cyan-500/40 flex items-center justify-center text-cyan-400 group-hover:scale-105 group-hover:border-cyan-400 group-hover:shadow-[0_0_15px_rgba(34,211,238,0.3)] transition">
							<div class="i-lucide-gamepad-2 text-xl"></div>
						</div>
						<span class="text-base sm:text-lg font-black text-white italic tracking-tighter inline">
							YASUI <span class="text-cyan-400">GAME</span>
						</span>
					</a>

					<!-- Quick Nav Links -->
					<nav class="hidden md:flex items-center gap-1 text-xs font-bold uppercase tracking-wider">
						<a
							href="/categories"
							class="px-3 py-1.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/5 transition flex items-center gap-1.5"
						>
							<div class="i-lucide-grid text-sm text-cyan-400"></div>
							<span>Katalog</span>
						</a>
						<a
							href="/cara-belanja"
							class="px-3 py-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition flex items-center gap-1.5"
							data-i18n="nav.how_to_order"
						>
							<div class="i-lucide-book-open text-sm text-gray-500"></div>
							<span>Cara Order</span>
						</a>
					</nav>
				</div>

				<!-- CENTER: SEARCH BAR (DESKTOP ONLY — always visible) -->
				<div class="hidden md:block flex-1 max-w-xl mx-2 relative" id="desktop-search-container">
					<div class="relative group">
						<input
							id="desktop-search-input"
							type="text"
							name="q"
							placeholder="Cari game atau platform..."
							autocomplete="off"
							class="w-full bg-gray-900/70 hover:bg-gray-900 focus:bg-black border border-gray-800 focus:border-cyan-400 text-white placeholder-gray-500 text-xs pl-8.5 pr-8 py-2 rounded-xl transition outline-none font-mono focus:shadow-[0_0_20px_rgba(34,211,238,0.2)]"
						/>
						<div class="absolute left-2.5 top-2.5 text-gray-500 group-focus-within:text-cyan-400 transition pointer-events-none">
							<div class="i-lucide-search text-sm"></div>
						</div>
						<div class="absolute right-2.5 top-2 hidden lg:flex items-center gap-1 pointer-events-none">
							<kbd class="text-[9px] font-mono text-gray-500 bg-black/70 border border-gray-800 px-1.5 py-0.5 rounded">Enter</kbd>
						</div>
					</div>
					<!-- DESKTOP SEARCH DROPDOWN -->
					<div
						id="desktop-search-dropdown"
						class="hidden absolute top-full left-0 right-0 mt-2 bg-black/95 border border-gray-800 rounded-xl shadow-[0_15px_40px_rgba(0,0,0,0.9)] backdrop-blur-xl z-50 overflow-hidden"
					>
						<div id="desktop-search-results" class="max-h-80 overflow-y-auto"></div>
					</div>
				</div>

				<!-- RIGHT: ACTIONS -->
				<div class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0">

					<!-- SEARCH TOGGLE (MOBILE ONLY) -->
					<button
						type="button"
						id="mobile-search-toggle"
						onclick="toggleMobileSearch()"
						class="md:hidden flex items-center justify-center w-8.5 h-8.5 rounded-xl bg-gray-900/80 border border-gray-800 hover:border-cyan-500/50 hover:bg-cyan-950/30 text-gray-300 hover:text-cyan-400 transition cursor-pointer"
						aria-label="Cari produk"
					>
						<div class="i-lucide-search text-sm"></div>
					</button>

					<!-- REGIONAL / CURRENCY & LANG SWITCHER (DESKTOP & MOBILE HEADER) -->
					<div class="relative" id="regional-switcher-container">
						<button
							type="button"
							id="header-regional-btn"
							onclick="toggleRegionalMenu()"
							class="flex items-center gap-1.5 h-8.5 sm:h-9 px-2 sm:px-2.5 rounded-xl bg-gray-900/80 border border-gray-800 hover:border-cyan-500/50 hover:bg-cyan-950/30 text-gray-300 hover:text-cyan-400 transition group cursor-pointer text-xs font-mono font-bold"
							title="Pengaturan Wilayah, Mata Uang & Bahasa"
							aria-label="Ganti Mata Uang dan Bahasa"
						>
							<div class="i-lucide-globe text-xs sm:text-sm text-cyan-400"></div>
							<span id="header-curr-label" class="text-[11px] sm:text-xs">{serverDefaultCurr}</span>
						</button>

						<!-- Dropdown Regional Menu -->
						<div
							id="header-regional-menu"
							class="hidden absolute right-0 mt-2 w-64 bg-black/95 border border-cyan-500/40 rounded-2xl p-3 shadow-[0_15px_40px_rgba(0,0,0,0.9)] backdrop-blur-xl z-50 text-left font-mono"
						>
							<div class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-2.5 pb-1.5 border-b border-gray-800/80 flex items-center justify-between">
								<span class="flex items-center gap-1.5">
									<span class="i-lucide-sliders-horizontal text-cyan-400 text-xs"></span>
									PREFERENSI REGIONAL
								</span>
								<span class="text-[9px] text-cyan-400 font-normal">AUTO-SYNC</span>
							</div>

							<!-- MATA UANG -->
							<div class="mb-3">
								<div class="text-[10px] text-gray-400 uppercase tracking-wider mb-1.5">Mata Uang</div>
								<div class="grid grid-cols-2 gap-1.5">
									<button
										type="button"
										onclick="selectCurrency('IDR')"
										id="curr-opt-idr"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-xs font-bold transition cursor-pointer"
									>
										<span class="text-gray-500 text-[10px]">Rp</span>
										<span>IDR</span>
									</button>
									<button
										type="button"
										onclick="selectCurrency('USD')"
										id="curr-opt-usd"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-xs font-bold transition cursor-pointer"
									>
										<span class="text-cyan-400 text-[10px]">$</span>
										<span>USD</span>
									</button>
								</div>
							</div>

							<!-- BAHASA -->
							<div>
								<div class="text-[10px] text-gray-400 uppercase tracking-wider mb-1.5">Bahasa</div>
								<div class="grid grid-cols-2 gap-1.5">
									<button
										type="button"
										onclick="selectLanguage('id')"
										id="lang-opt-id"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-xs font-bold transition cursor-pointer"
									>
										<span>🇮🇩</span>
										<span>INDONESIA</span>
									</button>
									<button
										type="button"
										onclick="selectLanguage('en')"
										id="lang-opt-en"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-xs font-bold transition cursor-pointer"
									>
										<span>🇬🇧</span>
										<span>ENGLISH</span>
									</button>
								</div>
							</div>
						</div>
					</div>

					<!-- Live Chat Admin Button (Mobile & Desktop) -->
					<button
						type="button"
						id="header-chat-btn"
						onclick="openLiveChatModal()"
						class="relative flex items-center justify-center w-8.5 h-8.5 sm:w-9 sm:h-9 rounded-xl bg-gray-900/80 border border-gray-800 hover:border-cyan-500/50 hover:bg-cyan-950/30 text-gray-300 hover:text-cyan-400 transition group cursor-pointer"
						title="Live Chat Admin"
						aria-label="Buka Live Chat Admin"
					>
						<div class="i-lucide-message-square text-sm sm:text-base transition group-hover:scale-105"></div>
						<!-- Online Status Indicator -->
						<span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-400 rounded-full border-2 border-black animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
					</button>

					<!-- Cart Button (Desktop only: hidden md:flex) -->
					<a
						href="/cart"
						class="hidden md:flex relative items-center justify-center w-8.5 h-8.5 sm:w-9 sm:h-9 rounded-xl bg-gray-900/80 border border-gray-800 hover:border-cyan-500/50 hover:bg-cyan-950/30 text-gray-300 hover:text-cyan-400 transition group"
						title="Keranjang Belanja"
					>
						<div class="i-lucide-shopping-cart text-sm sm:text-base transition group-hover:scale-105"></div>
						<span
							id="global-cart-badge"
							class="absolute -top-1.5 -right-1.5 bg-cyan-400 text-black font-black text-[9px] w-4 h-4 rounded-full flex items-center justify-center hidden border-2 border-black font-mono shadow-[0_0_10px_rgba(34,211,238,0.5)]"
						>
							0
						</span>
					</a>

					<!-- NAV AUTH (DESKTOP ONLY: HIDDEN ON MOBILE TO PREVENT CLUTTER) -->
					<div id="nav-auth-container" class="relative hidden md:block">
						<!-- State 1: Guest (Tombol Masuk) -->
						<button
							id="nav-login-btn"
							onclick="openAuthModal('login')"
							class="flex items-center gap-1.5 bg-gradient-to-r from-cyan-500 to-cyan-400 hover:from-cyan-400 hover:to-white text-black font-black px-3.5 py-1.5 rounded-xl text-xs uppercase tracking-wider transition shadow-[0_0_15px_rgba(34,211,238,0.25)] hover:shadow-[0_0_20px_rgba(34,211,238,0.4)] cursor-pointer"
							title="Masuk ke Akun"
						>
							<div class="i-lucide-user text-xs"></div>
							<span>Masuk</span>
						</button>

						<!-- State 2: Logged In (Dropdown Profil Interaktif) -->
						<div id="nav-user-dropdown" class="hidden relative">
							<button
								id="nav-user-btn"
								onclick="toggleUserMenu()"
								class="flex items-center gap-2 bg-gray-900 border border-cyan-500/40 hover:border-cyan-400 px-2.5 py-1.5 rounded-xl transition text-gray-200 hover:text-white group"
							>
								<div class="w-5 h-5 rounded-lg bg-cyan-400 text-black font-black text-[10px] flex items-center justify-center" id="nav-user-initial">
									U
								</div>
								<span class="hidden md:block text-xs font-bold uppercase tracking-wider max-w-[90px] truncate" id="nav-user-name">
									AKUN
								</span>
								<div class="i-lucide-chevron-down text-xs text-gray-400 group-hover:text-cyan-400 transition"></div>
							</button>

							<!-- Dropdown Cyber Card -->
							<div
								id="nav-user-menu"
								class="hidden absolute right-0 mt-2 w-64 bg-black/95 border border-cyan-500/40 rounded-2xl p-2.5 shadow-[0_15px_40px_rgba(0,0,0,0.9)] backdrop-blur-xl z-50 text-left"
							>
								<div class="px-3 py-2.5 border-b border-gray-800/80 mb-1.5 bg-gray-900/40 rounded-xl">
									<div class="text-[9px] text-gray-500 font-mono uppercase tracking-wider">Akun Terhubung</div>
									<div class="text-xs font-bold text-white truncate" id="nav-menu-email">user@email.com</div>
									<div class="text-[10px] text-cyan-400 flex items-center gap-1.5 mt-1 font-mono">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span> Sesi 30 Hari Aktif
									</div>
								</div>

								<a
									href="/orders"
									class="flex items-center gap-3 px-3 py-2 text-xs font-bold text-gray-300 hover:text-cyan-400 hover:bg-cyan-950/20 rounded-xl transition"
								>
									<div class="i-lucide-receipt text-cyan-400 text-base"></div>
									<span>Pesanan Saya</span>
								</a>

								<button
									onclick="openSetPasswordModal()"
									class="w-full flex items-center gap-3 px-3 py-2 text-xs font-bold text-gray-300 hover:text-cyan-400 hover:bg-cyan-950/20 rounded-xl transition text-left"
								>
									<div class="i-lucide-key-round text-yellow-400 text-base"></div>
									<span>Ganti Kata Sandi</span>
								</button>

								<div class="border-t border-gray-800/80 my-1"></div>

								<button
									onclick="logoutUser()"
									class="w-full flex items-center gap-3 px-3 py-2 text-xs font-bold text-red-400 hover:bg-red-950/30 rounded-xl transition text-left"
								>
									<div class="i-lucide-log-out text-red-400 text-base"></div>
									<span>Keluar (Logout)</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- ROW 2: EXPANDABLE SEARCH BAR (MOBILE ONLY) -->
			<div
				id="mobile-search-row"
				class="md:hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 overflow-hidden"
			>
				<div class="px-4 pb-3 pt-1">
					<div class="relative group">
						<input
							id="mobile-search-input"
							type="text"
							name="q"
							placeholder="Cari game atau platform..."
							autocomplete="off"
							class="w-full bg-gray-900/80 focus:bg-black border border-gray-700 focus:border-cyan-400 text-white placeholder-gray-500 text-sm pl-10 pr-10 py-2.5 rounded-xl transition outline-none font-mono focus:shadow-[0_0_20px_rgba(34,211,238,0.15)]"
						/>
						<div class="absolute left-3 top-3 text-gray-500 group-focus-within:text-cyan-400 transition pointer-events-none">
							<div class="i-lucide-search text-base"></div>
						</div>
						<button
							type="button"
							onclick="toggleMobileSearch()"
							class="absolute right-2 top-1.5 w-7 h-7 flex items-center justify-center rounded-lg text-gray-500 hover:text-white hover:bg-white/10 transition cursor-pointer"
							aria-label="Tutup pencarian"
						>
							<div class="i-lucide-x text-sm"></div>
						</button>
					</div>
					<!-- MOBILE SEARCH DROPDOWN -->
					<div
						id="mobile-search-dropdown"
						class="hidden mt-2 bg-black/95 border border-gray-800 rounded-xl shadow-[0_15px_40px_rgba(0,0,0,0.9)] overflow-hidden"
					>
						<div id="mobile-search-results" class="max-h-64 overflow-y-auto"></div>
					</div>
				</div>
			</div>
		</header>

		<slot />

		{
			shouldShowFooter && (
				<footer
					class="bg-black/80 border-t border-gray-800 pt-16 pb-24 md:pb-16 px-4"
				>
			<div
				class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12"
			>
				<div class="col-span-1 md:col-span-2">
					<h2 class="text-white font-black italic mb-4">
						YASUI GAME
					</h2>
					<p
						class="text-xs text-gray-500 leading-relaxed max-w-sm"
						data-i18n="footer.desc"
					>
						Marketplace game premium paling aman se-Cyber World.
						Kami menyediakan akun Roblox, MLBB, dan game populer
						lainnya dengan pengiriman instan.
					</p>
				</div>
				<div>
					<h3
						class="text-cyan-400 font-bold text-xs uppercase mb-4 tracking-widest"
						data-i18n="footer.info"
					>
						Informasi
					</h3>
					<ul class="space-y-2 text-xs text-gray-400">
						<li>
							<a
								href="/cara-belanja"
								class="hover:text-white transition"
								data-i18n="nav.how_to_order">Cara Belanja</a
							>
						</li>
						<li>
							<a
								href="/contact"
								class="hover:text-white transition"
								data-i18n="nav.contact">Hubungi Kami</a
							>
						</li>
						<li>
							<a
								href="/terms"
								class="hover:text-white transition"
								data-i18n="footer.terms">Syarat & Ketentuan</a
							>
						</li>
						<li>
							<a
								href="/privacy"
								class="hover:text-white transition"
								data-i18n="footer.privacy">Kebijakan Privasi</a
							>
						</li>
					</ul>
				</div>
				<div>
					<h3
						class="text-cyan-400 font-bold text-xs uppercase mb-4 tracking-widest"
						data-i18n="footer.cs"
					>
						Layanan Pelanggan
					</h3>
					<ul class="space-y-2 text-xs text-gray-400">
						<li>
							<a
								href="https://wa.me/..."
								class="hover:text-white transition"
								data-i18n="footer.contact_wa">Kontak WhatsApp</a
							>
						</li>
						<li>
							<a
								href="mailto:support@yasuigame.com"
								class="hover:text-white transition"
								data-i18n="footer.email_support"
								>Email Support</a
							>
						</li>
					</ul>
				</div>
			</div>
			<!-- PREFERENSI REGIONAL (MATA UANG & BAHASA) & COPYRIGHT -->
			<div class="max-w-7xl mx-auto mt-12 pt-6 border-t border-gray-900 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
				<div class="flex items-center gap-3">
					<span class="text-gray-500 text-[11px]">Pengaturan Regional:</span>
					<button
						id="currency-btn"
						class="flex items-center gap-1.5 bg-gray-900 hover:bg-gray-800 border border-gray-800 hover:border-cyan-400 px-3 py-1 rounded-lg transition text-gray-300"
						title="Ganti Mata Uang"
					>
						<span id="currency-flag" class="text-cyan-400 font-bold text-xs">$</span>
						<span id="currency-text" class="font-bold text-xs">USD</span>
					</button>

					<button
						id="lang-btn"
						class="flex items-center gap-1.5 bg-gray-900 hover:bg-gray-800 border border-gray-800 hover:border-cyan-400 px-3 py-1 rounded-lg transition text-gray-300"
						title="Ganti Bahasa"
					>
						<div class="i-lucide-globe text-cyan-400 text-xs"></div>
						<span id="lang-text" class="font-bold text-xs">ID</span>
					</button>
				</div>

				<div class="text-[10px] text-gray-600">
					&copy; 2026 YASUI-GAME. ALL RIGHTS RESERVED. POWERED BY CYBER-ENGINE.
				</div>
			</div>
				</footer>
			)
		}

		<nav
			class="fixed bottom-0 left-0 right-0 bg-black/95 backdrop-blur-lg border-t border-gray-800 pt-2 pb-[calc(0.65rem+env(safe-area-inset-bottom,0px))] px-3 sm:px-6 md:hidden z-50 shadow-[0_-5px_20px_rgba(0,0,0,0.8)]"
		>
			<div class="flex justify-around items-center text-gray-500">
				<a
					href="/"
					class={`flex flex-col items-center gap-1 transition ${isHome ? "text-cyan-400" : "text-gray-400 hover:text-cyan-400"}`}
				>
