---
import FloatingWA from "../components/FloatingWA.astro";
import Icon from "../components/ui/Icon.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	showFooter?: boolean;
}

const {
	title,
	description = "Yasui Game - Marketplace Game Premium Terpercaya, Aman, dan Bergaransi.",
	showFooter = true,
} = Astro.props;

const cookieCurr = Astro.cookies.get("yasui_currency")?.value;
const cookieLang = Astro.cookies.get("yasui_lang")?.value;
const geoParam = Astro.url.searchParams.get("geo")?.toUpperCase();
const vercelCountry = Astro.request.headers.get("x-vercel-ip-country");
const cfCountry = Astro.request.headers.get("cf-ipcountry");
const detectedCountry = geoParam || vercelCountry || cfCountry || "ID";

const isForeign = detectedCountry !== "ID";
const serverDefaultCurr = cookieCurr || (isForeign ? "USD" : "IDR");
const serverDefaultLang = cookieLang || (isForeign ? "en" : "id");

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isKatalog = pathname.startsWith("/categories") || pathname.startsWith("/category");
const isCart = pathname.startsWith("/cart");
const isCheckout = pathname.startsWith("/checkout");

const shouldShowFooter = showFooter && !isCart && !isCheckout;
---

<!doctype html>
<html lang={serverDefaultLang} class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="min-h-screen pb-24 md:pb-0">
		<header
			id="main-header"
			class="fixed top-0 left-0 right-0 z-50 bg-black/85 backdrop-blur-md border-b border-white/10 shadow-lg transition-all duration-300"
		>
			<div class="yg-shell h-16 flex items-center justify-between gap-3">
				<div class="flex items-center gap-4 lg:gap-6 shrink-0">
					<a href="/" class="flex items-center gap-2 group shrink-0" aria-label="Yasui Game Homepage">
						<div class="w-8 h-8 rounded-lg bg-cyan-950/70 border border-cyan-500/40 flex items-center justify-center text-cyan-400 group-hover:scale-105 group-hover:border-cyan-400 group-hover:shadow-[0_0_15px_rgba(34,211,238,0.3)] transition">
							<div class="i-lucide-gamepad-2 text-xl"></div>
						</div>
						<span class="text-base sm:text-lg font-black text-white italic tracking-tighter inline">
							YASUI <span class="text-cyan-400">GAME</span>
						</span>
					</a>

					<nav class="hidden md:flex items-center gap-1 text-xs font-bold uppercase tracking-wider" aria-label="Main Navigation">
						<a
							href="/categories"
							class="px-3 py-1.5 rounded-lg text-gray-300 hover:text-white hover:bg-white/5 transition flex items-center gap-1.5"
						>
							<div class="i-lucide-grid text-sm text-cyan-400"></div>
							<span>Katalog</span>
						</a>
						<a
							href="/cara-belanja"
							class="px-3 py-1.5 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition flex items-center gap-1.5"
							data-i18n="nav.how_to_order"
						>
							<div class="i-lucide-book-open text-sm text-gray-500"></div>
							<span>Cara Order</span>
						</a>
					</nav>
				</div>

				<div class="hidden md:block flex-1 max-w-xl mx-2 relative" id="desktop-search-container">
					<div class="relative group">
						<input
							id="desktop-search-input"
							type="text"
							name="q"
							placeholder="Cari game atau platform..."
							autocomplete="off"
							class="w-full bg-gray-900/70 hover:bg-gray-900 focus:bg-black border border-gray-800 focus:border-cyan-400 text-white placeholder-gray-500 text-xs pl-8.5 pr-8 py-2 rounded-xl transition outline-none font-mono focus:shadow-[0_0_20px_rgba(34,211,238,0.2)]"
						/>
						<div class="absolute left-2.5 top-2.5 text-gray-500 group-focus-within:text-cyan-400 transition pointer-events-none">
							<div class="i-lucide-search text-sm"></div>
						</div>
						<div class="absolute right-2.5 top-2 hidden lg:flex items-center gap-1 pointer-events-none">
							<kbd class="text-[9px] font-mono text-gray-500 bg-black/70 border border-gray-800 px-1.5 py-0.5 rounded">Enter</kbd>
						</div>
					</div>
					<div
						id="desktop-search-dropdown"
						class="hidden absolute top-full left-0 right-0 mt-2 yg-panel overflow-hidden"
					>
						<div id="desktop-search-results" class="max-h-80 overflow-y-auto"></div>
					</div>
				</div>

				<div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
					<button
						type="button"
						id="mobile-search-toggle"
						onclick="window.toggleMobileSearch && window.toggleMobileSearch()"
						class="md:hidden yg-btn-icon"
						aria-label="Cari produk"
					>
						<div class="i-lucide-search text-sm"></div>
					</button>

					<div class="relative" id="regional-switcher-container">
						<button
							type="button"
							id="header-regional-btn"
							onclick="window.toggleRegionalMenu && window.toggleRegionalMenu()"
							class="yg-btn-icon !w-auto px-2 sm:px-2.5 gap-1.5 text-xs font-mono font-bold"
							title="Pengaturan Wilayah, Mata Uang & Bahasa"
							aria-label="Ganti Mata Uang dan Bahasa"
						>
							<div class="i-lucide-globe text-xs sm:text-sm text-cyan-400"></div>
							<span id="header-curr-label" class="text-[11px] sm:text-xs">{serverDefaultCurr}</span>
						</button>

						<div
							id="header-regional-menu"
							class="hidden absolute right-0 mt-2 w-64 yg-panel p-3 text-left font-mono"
						>
							<div class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-2.5 pb-1.5 border-b border-gray-800/80 flex items-center justify-between">
								<span class="flex items-center gap-1.5">
									<span class="i-lucide-sliders-horizontal text-cyan-400 text-xs"></span>
									PREFERENSI REGIONAL
								</span>
								<span class="text-[9px] text-cyan-400 font-normal">AUTO-SYNC</span>
							</div>

							<div class="mb-3">
								<div class="text-[10px] text-gray-400 uppercase tracking-wider mb-1.5">Mata Uang</div>
								<div class="grid grid-cols-2 gap-1.5">
									<button
										type="button"
										onclick="window.selectCurrency && window.selectCurrency('IDR')"
										id="curr-opt-idr"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-xs font-bold transition cursor-pointer"
									>
										<span class="text-gray-500 text-[10px]">Rp</span>
										<span>IDR</span>
									</button>
									<button
										type="button"
										onclick="window.selectCurrency && window.selectCurrency('USD')"
										id="curr-opt-usd"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-xs font-bold transition cursor-pointer"
									>
										<span class="text-cyan-400 text-[10px]">$</span>
										<span>USD</span>
									</button>
								</div>
							</div>

							<div>
								<div class="text-[10px] text-gray-400 uppercase tracking-wider mb-1.5">Bahasa</div>
								<div class="grid grid-cols-2 gap-1.5">
									<button
										type="button"
										onclick="window.selectLanguage && window.selectLanguage('id')"
										id="lang-opt-id"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-xs font-bold transition cursor-pointer"
									>
										<span>🇮🇩</span>
										<span>INDONESIA</span>
									</button>
									<button
										type="button"
										onclick="window.selectLanguage && window.selectLanguage('en')"
										id="lang-opt-en"
										class="flex items-center justify-center gap-1.5 py-1.5 px-2 rounded-xl border text-xs font-bold transition cursor-pointer"
									>
										<span>🇬🇧</span>
										<span>ENGLISH</span>
									</button>
								</div>
							</div>
						</div>
					</div>

					<button
						type="button"
						id="header-chat-btn"
						onclick="window.openLiveChatModal && window.openLiveChatModal()"
						class="relative yg-btn-icon"
						title="Live Chat Admin"
						aria-label="Buka Live Chat Admin"
					>
						<div class="i-lucide-message-square text-sm sm:text-base transition group-hover:scale-105"></div>
						<span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-400 rounded-full border-2 border-black animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
					</button>

					<a
						href="/cart"
						class="hidden md:flex relative yg-btn-icon"
						title="Keranjang Belanja"
						aria-label="Keranjang Belanja"
					>
						<div class="i-lucide-shopping-cart text-sm sm:text-base transition group-hover:scale-105"></div>
						<span
							id="global-cart-badge"
							class="absolute -top-1.5 -right-1.5 bg-cyan-400 text-black font-black text-[9px] w-4 h-4 rounded-full flex items-center justify-center hidden border-2 border-black font-mono shadow-[0_0_10px_rgba(34,211,238,0.5)]"
						>
							0
						</span>
					</a>

					<div id="nav-auth-container" class="relative hidden md:block">
						<button
							id="nav-login-btn"
							onclick="window.openAuthModal && window.openAuthModal('login')"
							class="yg-btn-primary"
							title="Masuk ke Akun"
						>
							<div class="i-lucide-user text-xs"></div>
							<span>Masuk</span>
						</button>

						<div id="nav-user-dropdown" class="hidden relative">
							<button
								id="nav-user-btn"
								onclick="window.toggleUserMenu && window.toggleUserMenu()"
								class="flex items-center gap-2 bg-gray-900 border border-cyan-500/40 hover:border-cyan-400 px-2.5 py-1.5 rounded-xl transition text-gray-200 hover:text-white group cursor-pointer"
								aria-label="Menu Pengguna"
							>
								<div class="w-5 h-5 rounded-lg bg-cyan-400 text-black font-black text-[10px] flex items-center justify-center" id="nav-user-initial">
									U
								</div>
								<span class="hidden md:block text-xs font-bold uppercase tracking-wider max-w-[90px] truncate" id="nav-user-name">
									AKUN
								</span>
								<div class="i-lucide-chevron-down text-xs text-gray-400 group-hover:text-cyan-400 transition"></div>
							</button>

							<div
								id="nav-user-menu"
								class="hidden absolute right-0 mt-2 w-64 yg-panel p-2.5 text-left"
							>
								<div class="px-3 py-2.5 border-b border-gray-800/80 mb-1.5 bg-gray-900/40 rounded-xl">
									<div class="text-[9px] text-gray-500 font-mono uppercase tracking-wider">Akun Terhubung</div>
									<div class="text-xs font-bold text-white truncate" id="nav-menu-email">user@email.com</div>
									<div class="text-[10px] text-cyan-400 flex items-center gap-1.5 mt-1 font-mono">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span> Sesi 30 Hari Aktif
									</div>
								</div>

								<a
									href="/orders"
									class="flex items-center gap-3 px-3 py-2 text-xs font-bold text-gray-300 hover:text-cyan-400 hover:bg-cyan-950/20 rounded-xl transition"
								>
									<div class="i-lucide-receipt text-cyan-400 text-base"></div>
									<span>Pesanan Saya</span>
								</a>

								<button
									onclick="window.openSetPasswordModal && window.openSetPasswordModal()"
									class="w-full flex items-center gap-3 px-3 py-2 text-xs font-bold text-gray-300 hover:text-cyan-400 hover:bg-cyan-950/20 rounded-xl transition text-left cursor-pointer"
								>
									<div class="i-lucide-key-round text-yellow-400 text-base"></div>
									<span>Ganti Kata Sandi</span>
								</button>

								<div class="border-t border-gray-800/80 my-1"></div>

								<button
									onclick="window.logoutUser && window.logoutUser()"
									class="w-full flex items-center gap-3 px-3 py-2 text-xs font-bold text-red-400 hover:bg-red-950/30 rounded-xl transition text-left cursor-pointer"
								>
									<div class="i-lucide-log-out text-red-400 text-base"></div>
									<span>Keluar (Logout)</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div
				id="mobile-search-row"
				class="md:hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 overflow-hidden"
			>
				<div class="px-4 pb-3 pt-1">
					<div class="relative group">
						<input
							id="mobile-search-input"
							type="text"
							name="q"
							placeholder="Cari game atau platform..."
							autocomplete="off"
							class="w-full bg-gray-900/80 focus:bg-black border border-gray-700 focus:border-cyan-400 text-white placeholder-gray-500 text-sm pl-10 pr-10 py-2.5 rounded-xl transition outline-none font-mono focus:shadow-[0_0_20px_rgba(34,211,238,0.15)]"
						/>
						<div class="absolute left-3 top-3 text-gray-500 group-focus-within:text-cyan-400 transition pointer-events-none">
							<div class="i-lucide-search text-base"></div>
						</div>
						<button
							type="button"
							onclick="window.toggleMobileSearch && window.toggleMobileSearch()"
							class="absolute right-2 top-1.5 w-7 h-7 flex items-center justify-center rounded-lg text-gray-500 hover:text-white hover:bg-white/10 transition cursor-pointer"
							aria-label="Tutup pencarian"
						>
							<div class="i-lucide-x text-sm"></div>
						</button>
					</div>
					<div
						id="mobile-search-dropdown"
						class="hidden mt-2 bg-black/95 border border-gray-800 rounded-xl shadow-[0_15px_40px_rgba(0,0,0,0.9)] overflow-hidden"
					>
						<div id="mobile-search-results" class="max-h-64 overflow-y-auto"></div>
					</div>
				</div>
			</div>
		</header>

		<slot />

		{
			shouldShowFooter && (
				<footer class="bg-black/80 border-t border-gray-800 pt-16 pb-24 md:pb-16 px-4">
					<div class="yg-shell grid grid-cols-1 md:grid-cols-4 gap-12">
						<div class="col-span-1 md:col-span-2">
							<h2 class="text-white font-black italic mb-4">YASUI GAME</h2>
							<p class="text-xs text-gray-500 leading-relaxed max-w-sm" data-i18n="footer.desc">
								Marketplace game premium paling aman se-Cyber World. Kami menyediakan akun Roblox, MLBB, dan game populer lainnya dengan pengiriman instan.
							</p>
						</div>
						<div>
							<h3 class="text-cyan-400 font-bold text-xs uppercase mb-4 tracking-widest" data-i18n="footer.info">
								Informasi
							</h3>
							<ul class="space-y-2 text-xs text-gray-400">
								<li><a href="/cara-belanja" class="hover:text-white transition" data-i18n="nav.how_to_order">Cara Belanja</a></li>
								<li><a href="/contact" class="hover:text-white transition" data-i18n="nav.contact">Hubungi Kami</a></li>
								<li><a href="/terms" class="hover:text-white transition" data-i18n="footer.terms">Syarat & Ketentuan</a></li>
								<li><a href="/privacy" class="hover:text-white transition" data-i18n="footer.privacy">Kebijakan Privasi</a></li>
							</ul>
						</div>
						<div>
							<h3 class="text-cyan-400 font-bold text-xs uppercase mb-4 tracking-widest" data-i18n="footer.cs">
								Layanan Pelanggan
							</h3>
							<ul class="space-y-2 text-xs text-gray-400">
								<li><a href="https://wa.me/628989685098" target="_blank" rel="noopener noreferrer" class="hover:text-white transition" data-i18n="footer.contact_wa">Kontak WhatsApp</a></li>
								<li><a href="mailto:support@yasuigame.com" class="hover:text-white transition" data-i18n="footer.email_support">Email Support</a></li>
							</ul>
						</div>
					</div>

					<div class="yg-shell mt-12 pt-6 border-t border-gray-900 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
						<div class="flex items-center gap-3">
							<span class="text-gray-500 text-[11px]">Pengaturan Regional:</span>
							<button
								id="currency-btn"
								class="flex items-center gap-1.5 bg-gray-900 hover:bg-gray-800 border border-gray-800 hover:border-cyan-400 px-3 py-1 rounded-lg transition text-gray-300 cursor-pointer"
								title="Ganti Mata Uang"
							>
								<span id="currency-flag" class="text-cyan-400 font-bold text-xs">$</span>
								<span id="currency-text" class="font-bold text-xs">USD</span>
							</button>

							<button
								id="lang-btn"
								class="flex items-center gap-1.5 bg-gray-900 hover:bg-gray-800 border border-gray-800 hover:border-cyan-400 px-3 py-1 rounded-lg transition text-gray-300 cursor-pointer"
								title="Ganti Bahasa"
							>
								<div class="i-lucide-globe text-cyan-400 text-xs"></div>
								<span id="lang-text" class="font-bold text-xs">ID</span>
							</button>
						</div>

						<div class="text-[10px] text-gray-600">
							&copy; 2026 YASUI-GAME. ALL RIGHTS RESERVED. POWERED BY CYBER-ENGINE.
						</div>
					</div>
				</footer>
			)
		}

		<nav class="fixed bottom-0 left-0 right-0 bg-black/95 backdrop-blur-lg border-t border-gray-800 pt-2 pb-[calc(0.65rem+env(safe-area-inset-bottom,0px))] px-3 sm:px-6 md:hidden z-50 shadow-[0_-5px_20px_rgba(0,0,0,0.8)]" aria-label="Mobile Bottom Navigation">
			<div class="flex justify-around items-center text-gray-500">
				<a
					href="/"
					class={`flex flex-col items-center gap-1 transition ${isHome ? "text-cyan-400" : "text-gray-400 hover:text-cyan-400"}`}
				>
					<div class={`i-lucide-home text-lg ${isHome ? "filter drop-shadow-[0_0_8px_rgba(34,211,238,0.8)]" : ""}`}></div>
					<span class="text-[9px] font-bold" data-i18n="nav.home">HOME</span>
				</a>
				<a
					href="/categories"
					class={`flex flex-col items-center gap-1 transition ${isKatalog ? "text-cyan-400" : "text-gray-400 hover:text-cyan-400"}`}
				>
					<div class={`i-lucide-grid text-lg ${isKatalog ? "filter drop-shadow-[0_0_8px_rgba(34,211,238,0.8)]" : ""}`}></div>
					<span class="text-[9px] font-bold">KATALOG</span>
				</a>
				<a
					href="/cart"
					class={`flex flex-col items-center gap-1 transition relative ${isCart ? "text-cyan-400" : "text-gray-400 hover:text-cyan-400"}`}
				>
					<div class={`i-lucide-shopping-cart text-lg ${isCart ? "filter drop-shadow-[0_0_8px_rgba(34,211,238,0.8)]" : ""}`}></div>
					<span class="text-[9px] font-bold" data-i18n="nav.cart">CART</span>
					<span
						id="mobile-cart-badge"
						class="absolute -top-1 -right-2 bg-cyan-400 text-black font-black text-[9px] w-4 h-4 rounded-full flex items-center justify-center hidden border-2 border-black font-mono shadow-[0_0_10px_rgba(34,211,238,0.5)]"
					>
						0
					</span>
				</a>
				<a
					href="/orders"
					id="mobile-nav-auth"
					class="flex flex-col items-center gap-1 text-gray-400 hover:text-cyan-400 transition"
				>
					<div class="i-lucide-user text-lg" id="mobile-nav-icon"></div>
					<span class="text-[9px] font-bold uppercase tracking-wider" id="mobile-nav-label">MASUK</span>
				</a>
			</div>
		</nav>

		<a
			href="https://discord.com/users/1312253061800001541"
			target="_blank"
			rel="noopener noreferrer"
			class="hidden md:flex fixed md:bottom-24 right-6 z-50 w-14 h-14 bg-[#5865F2] hover:bg-[#4752c4] text-white rounded-full items-center justify-center shadow-[0_0_20px_rgba(88,101,242,0.5)] transition-all duration-300 hover:scale-110 group"
			aria-label="Chat on Discord"
		>
			<div class="absolute right-full mr-3 bg-gray-900 text-white text-xs font-bold px-3 py-1.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap border border-gray-700 pointer-events-none shadow-lg">
				Chat on Discord
			</div>
			<Icon name="discord" width={28} height={28} />
		</a>

		<div
			id="global-livechat-modal"
			class="fixed inset-0 z-[110] bg-black/85 backdrop-blur-md items-end sm:items-center justify-center p-0 sm:p-4 hidden"
		>
			<div class="relative w-full max-w-md bg-black/95 border border-cyan-500/50 rounded-t-3xl sm:rounded-2xl p-4 sm:p-5 shadow-[0_0_50px_rgba(34,211,238,0.25)] flex flex-col h-[85vh] sm:h-[600px] max-h-[85vh] cyber-card">
				<div class="flex items-center justify-between border-b border-gray-800/80 pb-3 mb-3">
					<div class="flex items-center gap-3">
						<div class="relative w-10 h-10 rounded-xl bg-cyan-950/70 border border-cyan-500/50 flex items-center justify-center text-cyan-400">
							<div class="i-lucide-headset text-xl"></div>
							<span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-400 rounded-full border-2 border-black animate-pulse"></span>
						</div>
						<div class="flex flex-col">
							<div class="flex items-center gap-2">
								<span class="text-xs sm:text-sm font-black text-white uppercase tracking-tight">Admin Yasui Game</span>
								<span class="yg-badge-cyan">OFFICIAL</span>
							</div>
							<span class="text-[10px] text-emerald-400 font-mono flex items-center gap-1">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Online &bull; Membalas &lt; 2 menit
							</span>
						</div>
					</div>
					<button
						type="button"
						onclick="window.closeLiveChatModal && window.closeLiveChatModal()"
						class="text-gray-400 hover:text-white hover:bg-gray-800/80 p-1.5 rounded-lg transition cursor-pointer"
						aria-label="Tutup Live Chat"
					>
						<div class="i-lucide-x text-lg"></div>
					</button>
				</div>

				<div id="livechat-messages" class="flex-1 overflow-y-auto space-y-3 pr-1 scrollbar-none text-xs">
					<div class="flex items-start gap-2 max-w-[85%]">
						<div class="w-6 h-6 rounded-lg bg-cyan-950 border border-cyan-800 text-cyan-400 flex items-center justify-center text-[10px] shrink-0 mt-0.5 font-bold">
							Y
						</div>
						<div class="bg-gray-900/90 border border-gray-800 rounded-2xl rounded-tl-sm p-3 text-gray-200 shadow-sm leading-relaxed">
							Halo Gamers! Selamat datang di <strong>Yasui Game</strong>. Ada akun game atau voucher yang ingin ditanyakan stoknya?
						</div>
					</div>

					<div class="flex items-start gap-2 max-w-[85%]">
						<div class="w-6 h-6 rounded-lg bg-cyan-950 border border-cyan-800 text-cyan-400 flex items-center justify-center text-[10px] shrink-0 mt-0.5 font-bold">
							Y
						</div>
						<div class="bg-gray-900/90 border border-gray-800 rounded-2xl rounded-tl-sm p-3 text-gray-200 shadow-sm leading-relaxed">
							Kami melayani transaksi aman 24 jam dengan garansi 100% anti hackback. Silakan ketik pertanyaan Anda di bawah!
						</div>
					</div>

					<div class="pt-2">
						<div class="text-[9px] font-mono text-gray-500 uppercase tracking-wider mb-1.5">Pertanyaan Populer:</div>
						<div class="flex flex-wrap gap-1.5">
							<button type="button" onclick="window.sendQuickChatMessage && window.sendQuickChatMessage('Berapa lama proses pengiriman akun?')" class="text-[10px] bg-cyan-950/40 hover:bg-cyan-900/50 border border-cyan-800/60 text-cyan-300 px-2.5 py-1 rounded-full transition cursor-pointer flex items-center gap-1">
								<div class="i-lucide-zap w-3 h-3 text-cyan-400"></div>
								<span>Berapa lama proses kirim?</span>
							</button>
							<button type="button" onclick="window.sendQuickChatMessage && window.sendQuickChatMessage('Bagaimana klaim garansi anti hackback?')" class="text-[10px] bg-cyan-950/40 hover:bg-cyan-900/50 border border-cyan-800/60 text-cyan-300 px-2.5 py-1 rounded-full transition cursor-pointer flex items-center gap-1">
								<div class="i-lucide-shield-check w-3 h-3 text-cyan-400"></div>
								<span>Garansi anti hackback</span>
							</button>
							<button type="button" onclick="window.sendQuickChatMessage && window.sendQuickChatMessage('Metode pembayaran apa saja yang tersedia?')" class="text-[10px] bg-cyan-950/40 hover:bg-cyan-900/50 border border-cyan-800/60 text-cyan-300 px-2.5 py-1 rounded-full transition cursor-pointer flex items-center gap-1">
								<div class="i-lucide-credit-card w-3 h-3 text-cyan-400"></div>
								<span>Pembayaran QRIS/VA</span>
							</button>
						</div>
					</div>
				</div>

				<div id="livechat-typing" class="hidden items-center gap-1.5 py-1.5 text-[10px] text-gray-400 font-mono">
					<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-bounce"></span>
					<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-bounce [animation-delay:0.2s]"></span>
					<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-bounce [animation-delay:0.4s]"></span>
					<span class="ml-1">Admin sedang mengetik...</span>
				</div>

				<div class="pt-3 border-t border-gray-800/80">
					<form id="livechat-form" onsubmit="window.handleLiveChatSubmit && window.handleLiveChatSubmit(event)" class="flex items-center gap-2">
						<input
							type="text"
							id="livechat-input"
							placeholder="Ketik pesan untuk Admin..."
							class="flex-1 bg-gray-900 border border-gray-800 focus:border-cyan-400 rounded-xl px-3.5 py-2 text-xs text-white placeholder-gray-500 outline-none font-mono transition"
							autocomplete="off"
						/>
						<button
							type="submit"
							class="w-9 h-9 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-black flex items-center justify-center font-bold shadow-[0_0_15px_rgba(34,211,238,0.3)] transition cursor-pointer shrink-0"
							title="Kirim Pesan"
						>
							<div class="i-lucide-send text-sm"></div>
						</button>
					</form>

					<div class="mt-2.5 flex items-center justify-between text-[10px] font-mono">
						<span class="text-gray-500">Butuh respon cepat?</span>
						<a
							href="https://wa.me/628989685098?text=Halo%20Admin%20Yasui,%20saya%20mau%20tanya%20stok%20akun..."
							target="_blank"
							rel="noopener noreferrer"
							class="text-emerald-400 hover:text-emerald-300 flex items-center gap-1 font-bold transition"
						>
							<div class="i-lucide-external-link text-xs"></div>
							Lanjutkan di WhatsApp &rarr;
						</a>
					</div>
				</div>
			</div>
		</div>

		<div
			id="global-auth-modal"
			class="fixed inset-0 z-[100] bg-black/85 backdrop-blur-md items-center justify-center p-4 hidden"
		>
			<div class="relative max-w-md w-full bg-black/95 border border-cyan-500/50 p-6 md:p-8 shadow-[0_0_50px_rgba(34,211,238,0.25)] cyber-card">
				<button
					onclick="window.closeAuthModal && window.closeAuthModal()"
					class="absolute top-4 right-4 text-gray-400 hover:text-white hover:bg-gray-800/80 p-1.5 rounded-lg transition cursor-pointer"
					aria-label="Tutup Dialog Autentikasi"
				>
					<div class="i-lucide-x text-lg"></div>
				</button>

				<div class="mb-5">
					<div class="yg-badge-cyan mb-2">
						<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
						SISTEM AUTENTIKASI PENGGUNA
					</div>
					<h2 class="text-xl font-black text-white uppercase tracking-tight" id="auth-modal-title">
						MASUK KE YASUI GAME
					</h2>
					<p class="text-xs text-gray-400 mt-1">
						Kelola semua akun game, status pengiriman, dan klaim garansi Anda.
					</p>
				</div>

				<div id="auth-modal-alert" class="hidden mb-4 p-3 rounded-lg text-xs font-mono border"></div>

				<form id="form-auth-login" onsubmit="window.handleAuthLogin && window.handleAuthLogin(event)" class="space-y-4">
					<div>
						<label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">
							Email Akun <span class="text-red-400">*</span>
						</label>
						<input
							type="email"
							id="auth-login-email"
							required
							placeholder="nama@email.com"
							class="yg-input"
						/>
					</div>

					<div>
						<div class="flex items-center justify-between mb-1.5">
							<label class="text-[11px] font-bold text-gray-300 uppercase tracking-wider">
								Kata Sandi <span class="text-red-400">*</span>
							</label>
							<button
								type="button"
								onclick="window.openSetPasswordModal && window.openSetPasswordModal()"
								class="text-[10px] text-cyan-400 hover:underline font-mono cursor-pointer"
							>
								Lupa / Buat Sandi?
							</button>
						</div>
						<div class="relative">
							<input
								type="password"
								id="auth-login-password"
								required
								placeholder="••••••••"
								class="yg-input pr-10"
							/>
							<button
								type="button"
								onclick="window.togglePasswordVisibility && window.togglePasswordVisibility('auth-login-password', this)"
								class="absolute right-3 top-2.5 text-gray-500 hover:text-white cursor-pointer"
								aria-label="Lihat kata sandi"
							>
								<div class="i-lucide-eye text-sm"></div>
							</button>
						</div>
					</div>

					<button
						type="submit"
						id="btn-submit-login"
						class="w-full yg-btn-primary py-3 text-xs mt-2"
					>
						<span>MASUK SEKARANG</span>
						<div class="i-lucide-arrow-right text-sm"></div>
					</button>

					<p class="text-[10px] text-gray-500 text-center font-mono mt-2">
						Sesi login aman tersimpan 30 hari di peramban ini.
					</p>
				</form>
			</div>
		</div>

		<div
			id="global-set-password-modal"
			class="fixed inset-0 z-[110] bg-black/85 backdrop-blur-md items-center justify-center p-4 hidden"
		>
			<div class="relative max-w-md w-full bg-black/95 border border-cyan-500/50 p-6 md:p-8 shadow-[0_0_50px_rgba(34,211,238,0.25)] cyber-card">
				<button
					onclick="window.closeSetPasswordModal && window.closeSetPasswordModal()"
					class="absolute top-4 right-4 text-gray-400 hover:text-white hover:bg-gray-800/80 p-1.5 rounded-lg transition cursor-pointer"
					aria-label="Tutup Dialog Sandi"
				>
					<div class="i-lucide-x text-lg"></div>
				</button>

				<div class="mb-5">
					<div class="yg-badge-yellow mb-2">
						<span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>
						PENGATURAN KREDENSIAL
					</div>
					<h2 class="text-xl font-black text-white uppercase tracking-tight">
						PASANG / GANTI KATA SANDI
					</h2>
					<p class="text-xs text-gray-400 mt-1">
						Pasang kata sandi untuk mengamankan akun dan memudahkan login di masa depan.
					</p>
				</div>

				<div id="set-pwd-alert" class="hidden mb-4 p-3 rounded-lg text-xs font-mono border"></div>

				<form id="form-set-password" onsubmit="window.handleSetPassword && window.handleSetPassword(event)" class="space-y-4">
					<div>
						<label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">
							Email Akun <span class="text-red-400">*</span>
						</label>
						<input
							type="email"
							id="set-pwd-email"
							required
							placeholder="nama@email.com"
							class="yg-input"
						/>
					</div>

					<div>
						<label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">
							Kata Sandi Baru <span class="text-red-400">*</span> (Minimal 6 Karakter)
						</label>
						<input
							type="password"
							id="set-pwd-new"
							required
							minlength="6"
							placeholder="Minimal 6 karakter"
							class="yg-input"
						/>
					</div>

					<div>
						<label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">
							Konfirmasi Kata Sandi <span class="text-red-400">*</span>
						</label>
						<input
							type="password"
							id="set-pwd-confirm"
							required
							minlength="6"
							placeholder="Ketik ulang kata sandi"
							class="yg-input"
						/>
					</div>

					<button
						type="submit"
						id="btn-submit-pwd"
						class="w-full yg-btn-primary py-3 text-xs mt-2"
					>
						<span>SIMPAN KATA SANDI</span>
						<div class="i-lucide-shield-check text-sm"></div>
					</button>
				</form>
			</div>
		</div>

		<FloatingWA />

		<script is:inline define:vars={{ serverDefaultCurr, serverDefaultLang, detectedCountry }}>
			window.__YASUI_CONFIG__ = {
				curr: serverDefaultCurr,
				lang: serverDefaultLang,
				country: detectedCountry
			};
		</script>
		<script src="../scripts/app.ts"></script>
	</body>
</html>
