---
// DATA SLIDER (Nanti bisa diambil dari WordPress juga)
const slides = [
  {
    image: "/assets/banners/roblox-banner.jpeg",
    title: "ROBLOX Univers",
    subtitle: "Starter Account for All Roblox Universe Game",
    color: "from-cyan-500 to-blue-600"
  },
  {
    image: "/assets/banners/ml-banner.jpg",
    title: "MOBILE LEGENDS",
    subtitle: "Cheap Account with Luxury Skins Collection",
    color: "from-yellow-500 to-orange-600"
  },
  {
    image: "/assets/banners/sw-banner.png",
    title: "SUMMONERS WAR: SKY AREA",
    subtitle: "Starter Account Specialist",
    color: "from-red-500 to-pink-600"
  }
];
---

<div class="relative w-full h-[200px] md:h-[380px] overflow-hidden rounded-xl border border-gray-800 group shadow-2xl">
    
    <div id="slider-track" class="flex transition-transform duration-700 ease-in-out h-full">
        {slides.map((slide) => (
            <div class="w-full flex-shrink-0 relative h-full">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-1000 scale-105 group-hover:scale-110" style={`background-image: url('${slide.image}')`}></div>
                
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-90"></div>
                
                <div class="absolute bottom-0 left-0 p-6 md:p-10 w-full md:w-2/3">
                    <span class={`inline-block px-2 py-0.5 mb-2 text-[8px] md:text-[10px] font-black text-white rounded bg-gradient-to-r ${slide.color}`}>
                        FEATURED
                    </span>
                    
                    <h2 class="text-3xl md:text-5xl font-black text-white italic tracking-tighter leading-none mb-2 md:mb-4 drop-shadow-lg">
                        {slide.title}
                    </h2>
                    
                    <p class="text-gray-300 text-[10px] md:text-sm max-w-[200px] md:max-w-lg drop-shadow-md leading-tight">
                        {slide.subtitle}
                    </p>
                    
                    <button class="mt-3 md:mt-6 bg-white text-black text-[10px] md:text-xs font-black px-4 py-2 md:px-6 md:py-3 rounded hover:scale-105 transition uppercase shadow-lg">
                        Cek Sekarang
                    </button>
                </div>
            </div>
        ))}
    </div>

    <div class="absolute bottom-4 right-4 flex gap-1.5 z-20">
        {slides.map((_, index) => (
            <button class="slider-dot w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-gray-600 hover:bg-white transition-all" data-index={index}></button>
        ))}
    </div>
    
    <button id="prev-slide" class="absolute top-1/2 left-4 -translate-y-1/2 bg-black/50 text-white p-2 rounded-full hover:bg-cyan-400 hover:text-black transition backdrop-blur hidden md:block"><div class="i-lucide-chevron-left text-xl"></div></button>
    <button id="next-slide" class="absolute top-1/2 right-4 -translate-y-1/2 bg-black/50 text-white p-2 rounded-full hover:bg-cyan-400 hover:text-black transition backdrop-blur hidden md:block"><div class="i-lucide-chevron-right text-xl"></div></button>
</div>

<script>
    let currentSlide = 0;
    const track = document.getElementById('slider-track');
    const dots = document.querySelectorAll('.slider-dot');
    const totalSlides = dots.length;

    function updateSlider() {
        track.style.transform = `translateX(-${currentSlide * 100}%)`;
        dots.forEach((dot, idx) => {
            if(idx === currentSlide) {
                dot.classList.add('bg-cyan-400', 'w-4', 'md:w-6');
                dot.classList.remove('bg-gray-600', 'w-1.5', 'md:w-2');
            } else {
                dot.classList.remove('bg-cyan-400', 'w-4', 'md:w-6');
                dot.classList.add('bg-gray-600', 'w-1.5', 'md:w-2');
            }
        });
    }

    let autoPlay = setInterval(() => { currentSlide = (currentSlide + 1) % totalSlides; updateSlider(); }, 5000);

    const nextBtn = document.getElementById('next-slide');
    const prevBtn = document.getElementById('prev-slide');

    if(nextBtn) nextBtn.addEventListener('click', () => { clearInterval(autoPlay); currentSlide = (currentSlide + 1) % totalSlides; updateSlider(); });
    if(prevBtn) prevBtn.addEventListener('click', () => { clearInterval(autoPlay); currentSlide = (currentSlide - 1 + totalSlides) % totalSlides; updateSlider(); });

    updateSlider();
</script>