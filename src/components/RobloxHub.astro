---
import { ROBLOX_SERVICE_GROUPS, ROBLOX_FEATURED_SLUGS } from "../data/roblox";

const { categories = [], failed = false } = Astro.props;
const serviceGroups = ROBLOX_SERVICE_GROUPS;
const serviceSlugs = new Set(serviceGroups.flatMap((group) => group.slugs));
const games = categories.filter((item: any) => !serviceSlugs.has(item.slug)).sort((a: any, b: any) => a.name.localeCompare(b.name, "id", { numeric: true }));
const featured = ROBLOX_FEATURED_SLUGS.map((slug) => games.find((item: any) => item.slug === slug)).filter(Boolean).slice(0, 4);
const imageUrl = (item: any) => item.image?.sourceUrl ? `/img-proxy?src=${encodeURIComponent(item.image.sourceUrl)}` : null;
---

<div id="roblox-hub">
    <section aria-labelledby="services-title" class="mb-8">
        <h2 id="services-title" class="text-xs font-mono font-bold uppercase tracking-widest text-[#94A3B8] mb-3" data-i18n="roblox.services_title">
            Layanan Roblox
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 md:gap-3">
            {serviceGroups.map((group) => (
                <a href={`#service-${group.key}`} class="group yg-card-interactive p-3.5 md:p-4 flex items-center gap-3">
                    <span class="w-9 h-9 rounded-md bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/20 flex items-center justify-center shrink-0">
                        <span class={`${group.icon} text-lg`} />
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block text-xs md:text-sm font-semibold text-[#F8FAFC] group-hover:text-[#00E5FF] transition-colors">{group.name}</span>
                        <span class="text-[11px] text-[#94A3B8] truncate block mt-0.5">{group.detail}</span>
                    </span>
                    <span class="i-lucide-chevron-right text-[#64748B] group-hover:text-[#00E5FF] text-sm shrink-0 transition-colors" />
                </a>
            ))}
        </div>
        {serviceGroups.map((group) => (
            <section id={`service-${group.key}`} class="service-panel mt-3 p-4 md:p-5 border border-[#222634] rounded-lg bg-[#0D0F15]" aria-label={group.name}>
                <div class="flex justify-between gap-3 items-center mb-3 pb-2 border-b border-[#222634]">
                    <h3 class="text-xs md:text-sm font-bold text-[#F8FAFC] uppercase tracking-wide">
                        {group.name === "Robux" ? "Pilih Metode Pembelian Robux" : group.name}
                    </h3>
                    <a href="#services-title" aria-label="Tutup pilihan layanan" class="text-xs font-mono text-[#94A3B8] hover:text-[#00E5FF] flex items-center gap-1">
                        <span data-i18n="roblox.close">TUTUP</span>
                        <span class="i-lucide-x text-sm" />
                    </a>
                </div>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
                    {categories.filter((item: any) => group.slugs.includes(item.slug)).map((item: any) => (
                        <a href={`/category/${item.slug}`} class="flex items-center justify-between gap-3 p-3 rounded-md border border-[#222634] bg-[#11131A] text-xs font-medium text-[#F8FAFC] hover:border-[#00E5FF]/40 hover:text-[#00E5FF] transition-colors">
                            <span>{item.name}</span>
                            <span class="i-lucide-arrow-right text-[#64748B] text-xs shrink-0" />
                        </a>
                    ))}
                    {!categories.some((item: any) => group.slugs.includes(item.slug)) && (
                        <p class="text-xs text-[#94A3B8] font-mono py-2" data-i18n="roblox.service_empty">Layanan ini belum tersedia.</p>
                    )}
                </div>
                {group.key === "account" && (
                    <p class="text-[11px] text-[#94A3B8] font-mono mt-3" data-i18n="roblox.account_hint">Mencari akun dengan progres game tertentu? Pilih gamenya di direktori bawah.</p>
                )}
            </section>
        ))}
    </section>

    <section aria-labelledby="directory-title">
        <div class="flex items-end justify-between gap-3 mb-4">
            <div>
                <h2 id="directory-title" class="text-base md:text-xl font-bold text-[#F8FAFC] tracking-tight" data-i18n="roblox.browse_by_game">
                    Belanja Berdasarkan Game
                </h2>
                <p class="text-xs text-[#94A3B8] mt-1" data-i18n="roblox.browse_desc">
                    Temukan item, currency, dan gamepass resmi untuk game Roblox pilihan.
                </p>
            </div>
            <span class="hidden sm:inline-block text-xs font-mono text-[#64748B] whitespace-nowrap">
                {games.length} game terdaftar
            </span>
        </div>

        <div class="relative mb-5">
            <span class="i-lucide-search absolute left-3.5 top-1/2 -translate-y-1/2 text-[#64748B] text-sm pointer-events-none" />
            <label for="roblox-game-search" class="sr-only">Cari game di Roblox</label>
            <input
                id="roblox-game-search"
                type="search"
                placeholder="Ketik nama game Roblox (Blox Fruits, Pet Simulator, Blade Ball)..."
                data-i18n-placeholder="roblox.search_placeholder"
                autocomplete="off"
                class="yg-input !h-11 !pl-10 !pr-4 !text-xs !bg-[#0D0F15]"
            />
        </div>

        {featured.length > 0 && (
            <section id="featured-games" class="mb-6" aria-labelledby="featured-title">
                <div class="flex items-center justify-between mb-2.5">
                    <h3 id="featured-title" class="text-xs font-mono uppercase tracking-widest text-[#94A3B8] font-bold" data-i18n="roblox.featured_games">
                        Game Unggulan
                    </h3>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 md:gap-3">
                    {featured.map((item: any) => (
                        <a href={`/category/${item.slug}`} class="group yg-card-interactive p-2.5 flex flex-col gap-2">
                            <div class="aspect-video bg-[#0D0F15] rounded border border-[#222634] flex items-center justify-center overflow-hidden relative">
                                {imageUrl(item) ? (
                                    <img src={imageUrl(item)} alt={item.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                                ) : (
                                    <span class="text-lg font-mono font-bold text-[#00E5FF]/60" aria-hidden="true">
                                        {item.name.split(/\s+/).map((word: string) => word[0]).slice(0, 2).join("")}
                                    </span>
                                )}
                                <span class="yg-badge-overlay-online absolute top-1.5 left-1.5 text-[10px]">
                                    ROBLOX
                                </span>
                            </div>
                            <div class="flex justify-between items-center gap-1.5 px-0.5">
                                <span class="text-xs font-medium text-[#F8FAFC] truncate group-hover:text-[#00E5FF] transition-colors">{item.name}</span>
                                <span class="i-lucide-arrow-up-right text-xs text-[#64748B] group-hover:text-[#00E5FF] shrink-0" />
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )}

        <div class="flex justify-between items-center mb-3">
            <h3 id="all-games-title" class="text-xs font-mono uppercase tracking-widest text-[#94A3B8] font-bold" data-i18n="roblox.all_games">
                Semua Game
            </h3>
            <span id="game-result-count" role="status" aria-live="polite" class="text-xs font-mono text-[#64748B]">
                {games.length} game · A–Z
            </span>
        </div>

        <div id="all-roblox-games" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 md:gap-3" aria-labelledby="all-games-title">
            {games.map((item: any) => (
                <a data-game-name={item.name} href={`/category/${item.slug}`} class="directory-card group yg-card-interactive p-2.5 flex items-center gap-2.5">
                    <span class="w-10 h-10 md:w-11 md:h-11 rounded-md bg-[#0D0F15] border border-[#222634] shrink-0 flex items-center justify-center overflow-hidden">
                        {imageUrl(item) ? (
                            <img src={imageUrl(item)} alt="" loading="lazy" class="w-full h-full object-cover" />
                        ) : (
                            <span class="text-xs font-mono font-bold text-[#00E5FF]/70" aria-hidden="true">
                                {item.name.replace(/[^\p{L}\p{N}]/gu, "").slice(0, 2).toUpperCase()}
                            </span>
                        )}
                    </span>
                    <span class="text-xs font-medium text-[#F8FAFC] leading-snug line-clamp-2 break-words group-hover:text-[#00E5FF] transition-colors">
                        {item.name}
                    </span>
                </a>
            ))}
        </div>

        <div id="no-games" hidden class="py-10 px-4 text-center rounded-lg border border-dashed border-[#222634] bg-[#0D0F15] my-4">
            <p class="text-xs text-[#F8FAFC]" data-i18n="roblox.not_found">Game tidak ditemukan.</p>
            <p class="text-[11px] text-[#94A3B8] mt-1 font-mono" data-i18n="roblox.not_found_desc">Coba kata kunci lain atau periksa kembali ejaan.</p>
            <button id="reset-game-search" type="button" class="mt-3 yg-btn-secondary text-xs" data-i18n="roblox.reset_search">
                Reset Pencarian
            </button>
        </div>

        {failed && (
            <p class="p-4 text-xs font-mono text-red-400 bg-red-950/20 border border-red-500/20 rounded-md my-3">
                Daftar game belum berhasil dimuat. Silakan muat ulang halaman.
            </p>
        )}

        <div class="text-center mt-6">
            <button id="load-more-games" hidden type="button" class="yg-btn-secondary px-6 py-2.5 text-xs" data-i18n="roblox.load_more">
                Muat Lebih Banyak
            </button>
        </div>
    </section>
</div>

<style>
    .service-panel { display: none; scroll-margin-top: 100px; }
    .service-panel:target { display: block; }
    #services-title { scroll-margin-top: 100px; }
    [hidden] { display: none !important; }
</style>

<script>
    function initRobloxDirectory() {
        const input = document.querySelector<HTMLInputElement>("#roblox-game-search");
        if (!input || input.dataset.ready) return;
        input.dataset.ready = "true";
        const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-game-name]"));
        const more = document.querySelector<HTMLButtonElement>("#load-more-games")!;
        const count = document.querySelector("#game-result-count")!;
        const empty = document.querySelector<HTMLElement>("#no-games")!;
        const featured = document.querySelector<HTMLElement>("#featured-games");
        const title = document.querySelector("#all-games-title")!;
        const normalize = (value: string) => value.normalize("NFKD").replace(/\p{M}/gu, "").toLocaleLowerCase("id").trim();
        let visible = 24;
        const key = "yasui_roblox_directory";
        try {
            const state = JSON.parse(sessionStorage.getItem(key) || "null");
            if (state) {
                input.value = typeof state.query === "string" ? state.query : "";
                visible = Math.max(24, Number(state.visible) || 24);
            }
        } catch {}

        function render() {
            const query = normalize(input!.value);
            const matches = cards.filter((card) => normalize(card.dataset.gameName || "").includes(query));
            cards.forEach((card) => { card.hidden = true; });
            matches.slice(0, visible).forEach((card) => { card.hidden = false; });
            if (more) more.hidden = matches.length <= visible;
            if (empty) empty.hidden = matches.length > 0;
            if (featured) featured.hidden = !!query;
            if (title) title.textContent = query ? "Hasil Pencarian" : "Semua Game";
            if (count) count.textContent = `${matches.length} game${query ? "" : " · A–Z"}`;
            try { sessionStorage.setItem(key, JSON.stringify({ query: input!.value, visible })); } catch {}
        }

        input.addEventListener("input", () => { visible = 24; render(); });
        more?.addEventListener("click", () => {
            const previous = visible;
            visible += 24;
            render();
            const matches = cards.filter((card) => !card.hidden);
            matches[previous]?.focus({ preventScroll: true });
        });
        document.querySelector("#reset-game-search")?.addEventListener("click", () => {
            input.value = "";
            visible = 24;
            render();
            input.focus();
        });
        render();
    }

    initRobloxDirectory();
    document.addEventListener("astro:page-load", initRobloxDirectory);
</script>
