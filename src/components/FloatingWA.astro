---
import Icon from "./ui/Icon.astro";

const pathname = Astro.url.pathname || "";
const isProductPage = pathname.startsWith("/product/");
const isCartPage = pathname.startsWith("/cart");
const mobileBottomClass = (isProductPage || isCartPage) ? "bottom-32" : "bottom-20";
---

<aside aria-label="Customer Support Speed Dial">
    <a
        href="https://wa.me/628989685098?text=Halo%20Admin%20Yasui,%20saya%20mau%20tanya%20stok%20akun..."
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:block fixed md:bottom-6 right-6 z-[90] group"
        aria-label="Chat WhatsApp Admin"
    >
        <div class="absolute right-full mr-3 top-1/2 -translate-y-1/2 bg-gray-900 text-white text-xs font-bold px-3 py-1.5 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap border border-gray-700 pointer-events-none shadow-lg">
            Chat on WhatsApp
        </div>

        <div class="w-14 h-14 bg-[#25D366] text-white rounded-full flex items-center justify-center shadow-[0_0_20px_rgba(37,211,102,0.5)] hover:scale-110 transition duration-300 border-2 border-black/20 animate-bounce-slow relative overflow-hidden">
            <Icon name="whatsapp" width={28} height={28} />
        </div>
    </a>

    <div class={`block md:hidden fixed ${mobileBottomClass} right-3.5 z-40 transition-all duration-300`} id="mobile-cs-container">
        <div
            id="mobile-cs-menu"
            class="absolute bottom-13 right-0 w-56 bg-black/95 border border-cyan-500/50 rounded-2xl p-2.5 shadow-[0_10px_35px_rgba(0,0,0,0.95)] backdrop-blur-xl transition-all duration-200 transform origin-bottom-right scale-90 opacity-0 pointer-events-none"
        >
            <div class="px-2 py-1.5 border-b border-gray-800/80 mb-2 flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold text-cyan-400 uppercase tracking-wider flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Bantuan Admin
                </span>
                <span class="text-[9px] text-gray-500 font-mono">Online</span>
            </div>

            <a
                href="https://wa.me/628989685098?text=Halo%20Admin%20Yasui,%20saya%20mau%20tanya%20stok%20akun..."
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 p-2 rounded-xl bg-emerald-950/40 hover:bg-emerald-900/40 border border-emerald-500/30 text-white transition mb-1.5 group"
            >
                <div class="w-8 h-8 rounded-lg bg-[#25D366] text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition">
                    <Icon name="whatsapp" width={18} height={18} />
                </div>
                <div class="flex flex-col text-left">
                    <span class="text-xs font-bold text-white group-hover:text-emerald-400 transition leading-tight">WhatsApp CS</span>
                    <span class="text-[9px] text-gray-400 font-mono leading-tight">Balas Cepat & Transaksi</span>
                </div>
            </a>

            <a
                href="https://discord.com/users/1312253061800001541"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 p-2 rounded-xl bg-indigo-950/40 hover:bg-indigo-900/40 border border-indigo-500/30 text-white transition mb-1.5 group"
            >
                <div class="w-8 h-8 rounded-lg bg-[#5865F2] text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition">
                    <Icon name="discord" width={18} height={18} />
                </div>
                <div class="flex flex-col text-left">
                    <span class="text-xs font-bold text-white group-hover:text-indigo-400 transition leading-tight">Discord Server</span>
                    <span class="text-[9px] text-gray-400 font-mono leading-tight">Komunitas Gamers</span>
                </div>
            </a>

            <button
                type="button"
                id="mobile-cs-livechat-btn"
                class="w-full flex items-center gap-2.5 p-2 rounded-xl bg-cyan-950/40 hover:bg-cyan-900/40 border border-cyan-500/30 text-white transition group cursor-pointer text-left"
            >
                <div class="w-8 h-8 rounded-lg bg-cyan-950 border border-cyan-400/50 text-cyan-400 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition">
                    <div class="i-lucide-messages-square text-lg"></div>
                </div>
                <div class="flex flex-col text-left">
                    <span class="text-xs font-bold text-white group-hover:text-cyan-400 transition leading-tight">Live Chat Web</span>
                    <span class="text-[9px] text-cyan-300 font-mono leading-tight">Admin Yasui Online</span>
                </div>
            </button>
        </div>

        <button
            id="mobile-cs-trigger"
            type="button"
            class="w-11 h-11 rounded-full bg-black/90 hover:bg-black border border-cyan-400/80 text-cyan-400 flex items-center justify-center shadow-[0_0_15px_rgba(34,211,238,0.35)] backdrop-blur-md active:scale-95 transition-all cursor-pointer relative"
            aria-label="Layanan Bantuan Pelanggan"
        >
            <span class="absolute top-1 right-1 w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)] animate-pulse"></span>
            <div id="cs-icon-headset" class="i-lucide-headset text-lg transition-transform duration-200"></div>
            <div id="cs-icon-close" class="i-lucide-x text-lg hidden transition-transform duration-200"></div>
        </button>
    </div>
</aside>

<script>
    function initMobileCS() {
        const trigger = document.getElementById("mobile-cs-trigger");
        const menu = document.getElementById("mobile-cs-menu");
        const iconHeadset = document.getElementById("cs-icon-headset");
        const iconClose = document.getElementById("cs-icon-close");
        const livechatBtn = document.getElementById("mobile-cs-livechat-btn");
        if (!trigger || !menu) return;

        let isOpen = false;

        function toggleMenu(show?: boolean) {
            isOpen = typeof show === "boolean" ? show : !isOpen;
            if (isOpen) {
                menu!.classList.remove("scale-90", "opacity-0", "pointer-events-none");
                menu!.classList.add("scale-100", "opacity-100", "pointer-events-auto");
                iconHeadset?.classList.add("hidden");
                iconClose?.classList.remove("hidden");
            } else {
                menu!.classList.add("scale-90", "opacity-0", "pointer-events-none");
                menu!.classList.remove("scale-100", "opacity-100", "pointer-events-auto");
                iconHeadset?.classList.remove("hidden");
                iconClose?.classList.add("hidden");
            }
        }

        trigger.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleMenu();
        });

        livechatBtn?.addEventListener("click", () => {
            toggleMenu(false);
            if ((window as any).openLiveChatModal) {
                (window as any).openLiveChatModal();
            }
        });

        document.addEventListener("click", (e) => {
            if (isOpen && !menu.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
                toggleMenu(false);
            }
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMobileCS);
    } else {
        initMobileCS();
    }
</script>

<style>
    @keyframes bounce-slow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }
    .animate-bounce-slow {
        animation: bounce-slow 3s infinite ease-in-out;
    }
</style>
