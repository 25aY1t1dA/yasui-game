---
// src/pages/checkout.astro
import Layout from "../layouts/Layout.astro";
import { translations } from "../lib/translations";
---

<Layout title="Secure Checkout - Yasui Game" showFooter={false}>
    <div
        id="cyber-modal"
        class="fixed inset-0 z-[150] bg-black/80 backdrop-blur-sm hidden flex-col justify-center items-center p-4"
    >
        <div
            class="relative bg-[#11131A] border border-[#222634] w-full max-w-sm p-6 rounded-lg shadow-2xl modal-animate"
            id="modal-box"
        >
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-[#161922] rounded-md flex items-center justify-center border border-[#222634]">
                    <div id="modal-icon" class="text-xl"></div>
                </div>
                <div>
                    <h3 id="modal-title" class="text-[#F8FAFC] font-bold uppercase tracking-wider text-xs">
                        STATUS TRANSAKSI
                    </h3>
                    <p class="text-[10px] text-[#64748B] font-mono" id="modal-subtitle">
                        Gateway Verification
                    </p>
                </div>
            </div>

            <p id="modal-message" class="text-[#94A3B8] text-xs mb-6 leading-relaxed"></p>

            <button
                id="modal-btn"
                class="yg-btn-primary w-full py-2.5 text-xs font-mono font-semibold tracking-wider"
            >
                MENGERTI
            </button>
        </div>
    </div>

    <div
        id="loader"
        class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-md hidden flex-col items-center justify-center"
    >
        <div class="relative w-12 h-12 mb-4">
            <div class="absolute inset-0 border-2 border-[#222634] rounded-full"></div>
            <div class="absolute inset-0 border-2 border-t-[#00E5FF] rounded-full animate-spin"></div>
        </div>
        <h3 class="text-[#00E5FF] font-mono font-bold text-xs tracking-widest animate-pulse" data-i18n="checkout.connecting">
            CONNECTING TO GATEWAY...
        </h3>
        <p class="text-[11px] text-[#64748B] mt-1 font-mono" data-i18n="checkout.dont_close">
            Mohon jangan menutup jendela ini
        </p>
    </div>

    <header class="border-b border-[#222634] bg-[#090A0F]/90 backdrop-blur-md p-4 sticky top-0 z-50">
        <div class="max-w-3xl mx-auto flex items-center justify-between">
            <a href="/cart" class="flex items-center gap-1.5 text-xs font-semibold text-[#94A3B8] hover:text-[#F8FAFC] transition-colors">
                <div class="i-lucide-arrow-left text-sm"></div>
                <span data-i18n="product.back">Kembali ke Keranjang</span>
            </a>
            <div class="flex items-center gap-2">
                <div class="i-lucide-shield-check text-[#00E5FF]"></div>
                <span class="text-xs font-mono font-bold tracking-wider text-[#F8FAFC]" data-i18n="checkout.title">SECURE CHECKOUT</span>
            </div>
        </div>
    </header>

    <main class="max-w-3xl mx-auto p-4 md:p-8">
        <section class="mb-8">
            <h2
                class="text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-4 border-b border-[#222634] pb-2 flex items-center justify-between"
                data-i18n="checkout.order_items"
            >
                <span>1. Item Pesanan</span>
                <span class="text-[10px] text-[#64748B] font-mono font-normal">Verifikasi Detail</span>
            </h2>
            <div id="order-items" class="space-y-2.5">
                <p class="text-center text-[#64748B] text-xs font-mono py-4" data-i18n="checkout.loading">
                    Memuat data pesanan...
                </p>
            </div>

            <div class="mt-4 bg-[#11131A] border border-[#222634] rounded-lg p-4 space-y-2 text-xs font-mono">
                <div class="flex justify-between items-center text-[#94A3B8]">
                    <span data-i18n="checkout.summary_fee">Biaya Layanan Gateway:</span>
                    <span class="text-emerald-400 font-semibold" data-i18n="checkout.summary_fee_free">Rp 0 (BEBAS BIAYA ADMIN)</span>
                </div>
                <div class="flex justify-between items-center pt-2 border-t border-[#222634]">
                    <span class="text-[#F8FAFC] font-semibold" data-i18n="checkout.total_bill">Total Tagihan:</span>
                    <span class="text-lg md:text-xl font-bold text-[#00E5FF] tabular-nums" id="total-bill">Rp 0</span>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h2 class="text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-4 border-b border-[#222634] pb-2 flex items-center justify-between">
                <span data-i18n="checkout.buyer_info">2. Data Penerima & Pengiriman</span>
                <span class="text-[10px] text-[#00E5FF] font-mono flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00E5FF] animate-pulse"></span> AUTO-SYNC AKUN
                </span>
            </h2>

            <div class="space-y-4 bg-[#11131A] border border-[#222634] p-4 sm:p-5 rounded-lg">
                <div>
                    <label class="block text-xs font-semibold text-[#F8FAFC] uppercase tracking-wider mb-1.5">
                        <span data-i18n="checkout.email_label">Email Penerima</span> <span class="text-red-400">*</span>
                    </label>
                    <input
                        type="email"
                        id="buyer-email"
                        required
                        placeholder="nama@example.com"
                        data-i18n-placeholder="checkout.email_placeholder"
                        class="yg-input"
                    />
                    <p class="text-[11px] text-[#64748B] font-mono mt-1" data-i18n="checkout.buyer_note">
                        Kredensial akun game & invoice faktur otomatis dikirim dan ditautkan ke email ini.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-1.5">
                            <span data-i18n="checkout.wa_label">Nomor WhatsApp</span> <span class="text-[#64748B] font-normal font-mono">(Opsional)</span>
                        </label>
                        <input
                            type="tel"
                            id="buyer-wa"
                            placeholder="08xxxxxxxxxx"
                            class="yg-input"
                        />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-1.5">
                            <span data-i18n="checkout.discord_label">Username Discord</span> <span class="text-[#64748B] font-normal font-mono">(Opsional)</span>
                        </label>
                        <input
                            type="text"
                            id="buyer-discord"
                            placeholder="username#0000"
                            class="yg-input"
                        />
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h2
                class="text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-4 border-b border-[#222634] pb-2 flex items-center justify-between"
                data-i18n="checkout.payment_method"
            >
                <span>3. Pilih Metode Pembayaran</span>
                <span class="text-[10px] text-[#64748B] font-mono">Duitku Direct API</span>
            </h2>

            <div class="grid grid-cols-2 gap-3 mb-4">
                <button
                    type="button"
                    id="tab-qris"
                    class="active-tab border border-[#00E5FF] bg-[#00E5FF]/5 p-3 rounded-lg flex items-center justify-center gap-2 transition-colors cursor-pointer text-[#F8FAFC]"
                >
                    <div class="i-lucide-qr-code text-base text-[#00E5FF]"></div>
                    <span class="text-xs font-semibold uppercase tracking-wider" data-i18n="checkout.qris_title">Indonesia Payment</span>
                </button>
                <button
                    type="button"
                    id="tab-global"
                    class="border border-[#222634] bg-[#11131A] p-3 rounded-lg flex items-center justify-center gap-2 transition-colors hover:border-[#2E3446] cursor-pointer text-[#94A3B8]"
                >
                    <div class="i-lucide-credit-card text-base"></div>
                    <span class="text-xs font-semibold uppercase tracking-wider" data-i18n="checkout.global_title">International Payment</span>
                </button>
            </div>

            <div class="bg-[#11131A] border border-[#222634] p-4 sm:p-5 rounded-lg text-left">
                <div id="info-qris" class="payment-info w-full space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-[#222634]">
                        <div>
                            <p class="text-[#F8FAFC] font-semibold text-xs uppercase tracking-wider">
                                Pembayaran Domestik (QRIS, VA, E-Wallet)
                            </p>
                            <p class="text-[11px] text-[#64748B] font-mono mt-0.5">
                                Verifikasi instan otomatis 24 jam terhubung langsung ke Duitku.
                            </p>
                        </div>
                        <span class="text-[10px] text-[#00E5FF] font-mono bg-[#00E5FF]/10 border border-[#00E5FF]/25 px-2 py-0.5 rounded">
                            BEBAS BIAYA
                        </span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="channel-list">
                        <div
                            data-channel="qris"
                            class="channel-card active-channel border border-[#00E5FF] bg-[#00E5FF]/5 p-3.5 rounded-lg cursor-pointer transition-colors flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#0D0F15] flex items-center justify-center text-[#00E5FF] border border-[#00E5FF]/30">
                                    <div class="i-lucide-qr-code text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC] flex items-center gap-1.5">
                                        QRIS <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 px-1 py-0.2 rounded font-mono">REKOMENDASI</span>
                                    </div>
                                    <div class="text-[10px] text-[#94A3B8] font-mono">Semua Bank & E-Wallet</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#00E5FF] flex items-center justify-center">
                                <div class="w-2 h-2 rounded-full bg-[#00E5FF]"></div>
                            </div>
                        </div>

                        <div
                            data-channel="va_bca"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-blue-400 border border-[#222634]">
                                    <div class="i-lucide-landmark text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">BCA Virtual Account</div>
                                    <div class="text-[10px] text-[#64748B] font-mono">Transfer m-BCA / KlikBCA / ATM</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>

                        <div
                            data-channel="va_mandiri"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-amber-400 border border-[#222634]">
                                    <div class="i-lucide-landmark text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">Mandiri Virtual Account</div>
                                    <div class="text-[10px] text-[#64748B] font-mono">Livin' by Mandiri / ATM</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>

                        <div
                            data-channel="va_bri"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-blue-400 border border-[#222634]">
                                    <div class="i-lucide-landmark text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">BRI Virtual Account</div>
                                    <div class="text-[10px] text-[#64748B] font-mono">BRImo / ATM BRI</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>

                        <div
                            data-channel="va_bni"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-orange-400 border border-[#222634]">
                                    <div class="i-lucide-landmark text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">BNI Virtual Account</div>
                                    <div class="text-[10px] text-[#64748B] font-mono">BNI Mobile Banking / ATM</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>

                        <div
                            data-channel="ewallet_dana"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-[#00E5FF] border border-[#222634]">
                                    <div class="i-lucide-wallet text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">DANA E-Wallet</div>
                                    <div class="text-[10px] text-[#64748B] font-mono">Aplikasi DANA</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>
                    </div>
                </div>

                <div id="info-global" class="payment-info hidden w-full space-y-4 text-left">
                    <div class="flex items-center justify-between pb-3 border-b border-[#222634]">
                        <div>
                            <p class="text-[#F8FAFC] font-semibold text-xs uppercase tracking-wider">
                                Pembayaran Internasional (Credit Card / Crypto)
                            </p>
                            <p class="text-[11px] text-[#64748B] font-mono mt-0.5">
                                Kartu debit/kredit global dengan enkripsi 3D-Secure & PCI-DSS.
                            </p>
                        </div>
                        <span class="text-[10px] text-[#00E5FF] font-mono bg-[#00E5FF]/10 border border-[#00E5FF]/25 px-2 py-0.5 rounded">
                            CROSS-BORDER
                        </span>
                    </div>

                    <div class="grid grid-cols-1 gap-2.5">
                        <div
                            data-channel="credit_card"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#00E5FF] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded bg-[#11131A] flex items-center justify-center text-[#00E5FF] border border-[#222634] flex-shrink-0">
                                    <div class="i-lucide-credit-card text-lg"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC] flex items-center gap-1.5 flex-wrap">
                                        <span>Visa / Mastercard / JCB</span>
                                        <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 px-1 py-0.2 rounded font-mono">AKTIF</span>
                                        <span class="text-[9px] bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/25 px-1 py-0.2 rounded font-mono">3D-SECURE OTP</span>
                                    </div>
                                    <div class="text-[10px] text-[#94A3B8] mt-1 font-mono">
                                        Kartu internasional. Nilai transaksi dikonversi otomatis oleh bank penerbit.
                                    </div>
                                    <div class="flex items-center gap-2 mt-2 text-[10px] font-mono text-[#64748B]">
                                        <span class="text-blue-400 font-bold">VISA</span> • 
                                        <span class="text-red-400 font-bold">Mastercard</span> • 
                                        <span class="text-green-400 font-bold">JCB</span> • 
                                        <span class="text-[#00E5FF] font-bold">AMEX</span>
                                    </div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center flex-shrink-0"></div>
                        </div>

                        <div
                            id="btn-crypto-notice"
                            class="border border-[#222634] bg-[#0D0F15]/60 hover:bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-amber-400/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3 group"
                        >
                            <div class="flex items-start sm:items-center gap-3">
                                <div class="w-9 h-9 rounded bg-[#11131A] flex items-center justify-center text-amber-400 border border-[#222634] flex-shrink-0">
                                    <div class="i-lucide-coins text-lg"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#94A3B8] flex items-center gap-1.5 flex-wrap">
                                        <span>Crypto (USDT / USDC)</span>
                                        <span class="text-[9px] bg-amber-500/10 text-amber-400 border border-amber-500/25 px-1.5 py-0.2 rounded font-mono">SEGERA HADIR</span>
                                        <span class="text-[9px] bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/25 px-1 py-0.2 rounded font-mono">NON-CUSTODIAL</span>
                                    </div>
                                    <p class="text-[10px] text-[#64748B] mt-1 font-mono">
                                        Pembayaran Web3 terdesentralisasi anti-chargeback (TRC-20, Polygon, BEP-20).
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center self-end sm:self-center">
                                <span class="text-[10px] text-amber-400 bg-amber-500/10 border border-amber-500/30 px-2 py-1 rounded font-mono flex items-center gap-1">
                                    <div class="i-lucide-info text-xs"></div> DETAIL
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <button
            id="pay-btn"
            class="yg-btn-primary w-full py-4 text-xs font-mono font-bold tracking-wider flex items-center justify-center gap-2"
            data-i18n="checkout.pay_now"
        >
            <div class="i-lucide-zap text-sm"></div> BAYAR SEKARANG
        </button>
    </main>

    <script is:inline define:vars={{ translations }}>
        let currentMethod = "qris";
        let cartItems = [];
        let orderSuccess = false;

        const USD_RATE = 16000;
        let curr = localStorage.getItem("yasui_currency") || "IDR";
        let lang = localStorage.getItem("yasui_lang") || "id";

        function getTranslation(key) {
            const currentLang = localStorage.getItem("yasui_lang") || lang || "id";
            const t = translations[currentLang] || translations["id"];
            return t[key] || key;
        }

        function updatePageTranslations() {
            const currentLang = localStorage.getItem("yasui_lang") || lang || "id";
            const t = translations[currentLang] || translations["id"];
            const icons = {
                "checkout.pay_now": '<div class="i-lucide-zap"></div>',
            };

            document.querySelectorAll("[data-i18n]").forEach((el) => {
                const key = el.getAttribute("data-i18n");
                if (t && t[key]) {
                    if (icons[key]) {
                        el.innerHTML = icons[key] + " " + t[key];
                    } else {
                        el.innerText = t[key];
                    }
                }
            });

            document.querySelectorAll("[data-i18n-placeholder]").forEach((el) => {
                const key = el.getAttribute("data-i18n-placeholder");
                if (t && t[key]) {
                    el.setAttribute("placeholder", t[key]);
                }
            });
        }
        updatePageTranslations();

        document.addEventListener("yasui-lang-change", (e) => {
            lang = e.detail?.lang || localStorage.getItem("yasui_lang") || "id";
            updatePageTranslations();
        });

        document.addEventListener("yasui-currency-change", (e) => {
            curr = e.detail?.currency || localStorage.getItem("yasui_currency") || "IDR";
            initCheckout();
        });

        function parsePrice(priceStr) {
            if (!priceStr) return 0;
            let str = String(priceStr).trim();
            if (/^\d+$/.test(str)) return parseInt(str, 10);
            if (str.match(/[,.]00$/)) str = str.substring(0, str.length - 3);
            const clean = str.replace(/\D/g, "");
            return parseInt(clean, 10) || 0;
        }

        function formatMoney(n) {
            const num = parsePrice(n);
            return curr === "USD"
                ? new Intl.NumberFormat("en-US", {
                      style: "currency",
                      currency: "USD",
                  }).format(num / USD_RATE)
                : new Intl.NumberFormat("id-ID", {
                      style: "currency",
                      currency: "IDR",
                      minimumFractionDigits: 0,
                  }).format(num);
        }

        function initCheckout() {
            const rawCart = JSON.parse(
                localStorage.getItem("yasui_cart") || "[]",
            );
            cartItems = rawCart.filter((item) => item.selected);

            cartItems = cartItems.map((item) => {
                if ((!item.id || item.id === 0) && item.globalId) {
                    try {
                        const decoded = atob(item.globalId);
                        const idPart = decoded.split(":")[1];
                        if (idPart) {
                            item.id = parseInt(idPart);
                        }
                    } catch (e) {}
                }
                return item;
            });

            if (cartItems.length === 0) {
                window.location.href = "/cart";
                return;
            }

            const container = document.getElementById("order-items");
            let total = 0;

            if (container) {
                container.innerHTML = cartItems
                    .map((item) => {
                        total += parsePrice(item.price);
                        return `
                    <div class="flex gap-3 items-center bg-[#11131A] p-3 rounded-lg border border-[#222634]">
                        <img src="${item.image}" class="w-10 h-10 rounded-md object-cover bg-[#0D0F15] border border-[#222634]">
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-semibold text-[#F8FAFC] truncate">${item.name}</h4>
                            <p class="text-[10px] text-[#64748B] font-mono">${item.email}</p>
                        </div>
                        <div class="text-[#00E5FF] font-mono text-xs font-bold tabular-nums">${formatMoney(item.price)}</div>
                    </div>
                `;
                    })
                    .join("");
            }

            const totalBillEl = document.getElementById("total-bill");
            if (totalBillEl) {
                totalBillEl.innerText = formatMoney(total);
            }

            const firstItem = cartItems[0];
            const emailEl = document.getElementById("buyer-email");
            const waEl = document.getElementById("buyer-wa");
            const discordEl = document.getElementById("buyer-discord");

            const prefEmail = localStorage.getItem("yasui_buyer_email") || (firstItem?.email && firstItem.email !== "guest@yasuigame.com" ? firstItem.email : "") || "";
            const prefWa = localStorage.getItem("yasui_buyer_wa") || (firstItem?.wa && firstItem.wa !== "-" ? firstItem.wa : "") || "";
            const prefDiscord = localStorage.getItem("yasui_buyer_discord") || (firstItem?.contactValue && firstItem.contactValue !== "-" ? firstItem.contactValue : "") || "";

            if (emailEl && !emailEl.value && prefEmail) emailEl.value = prefEmail;
            if (waEl && !waEl.value && prefWa) waEl.value = prefWa;
            if (discordEl && !discordEl.value && prefDiscord) discordEl.value = prefDiscord;
        }

        function selectChannel(code) {
            currentMethod = code;
            document.querySelectorAll(".channel-card").forEach((card) => {
                card.classList.remove("border-[#00E5FF]", "bg-[#00E5FF]/5");
                card.classList.add("border-[#222634]", "bg-[#0D0F15]");
                const ind = card.querySelector(".channel-indicator");
                if (ind) {
                    ind.classList.remove("border-[#00E5FF]");
                    ind.classList.add("border-[#222634]");
                    ind.innerHTML = "";
                }
            });

            const active = document.querySelector(`.channel-card[data-channel="${code}"]`);
            if (active) {
                active.classList.remove("border-[#222634]", "bg-[#0D0F15]");
                active.classList.add("border-[#00E5FF]", "bg-[#00E5FF]/5");
                const ind = active.querySelector(".channel-indicator");
                if (ind) {
                    ind.classList.remove("border-[#222634]");
                    ind.classList.add("border-[#00E5FF]");
                    ind.innerHTML = '<div class="w-2 h-2 rounded-full bg-[#00E5FF]"></div>';
                }
            }
        }

        function switchTab(id) {
            document
                .querySelectorAll('button[id^="tab-"]')
                .forEach((el) => {
                    el.classList.remove("active-tab", "border-[#00E5FF]", "bg-[#00E5FF]/5", "text-[#F8FAFC]");
                    el.classList.add("border-[#222634]", "bg-[#11131A]", "text-[#94A3B8]");
                });
            document
                .querySelectorAll(".payment-info")
                .forEach((el) => el.classList.add("hidden"));

            const activeTabBtn = document.getElementById(`tab-${id}`);
            if (activeTabBtn) {
                activeTabBtn.classList.add("active-tab", "border-[#00E5FF]", "bg-[#00E5FF]/5", "text-[#F8FAFC]");
                activeTabBtn.classList.remove("border-[#222634]", "bg-[#11131A]", "text-[#94A3B8]");
            }

            document
                .getElementById(`info-${id}`)
                ?.classList.remove("hidden");

            if (id === "global") {
                selectChannel("credit_card");
            } else {
                const activeChannelEl = document.querySelector("#channel-list .channel-card.border-\\[\\#00E5FF\\]") || document.querySelector("#channel-list .channel-card.active-channel");
                const selected = activeChannelEl ? activeChannelEl.getAttribute("data-channel") : "qris";
                selectChannel(selected);
            }
        }

        let modalCloseCallback = null;
        let targetPaymentUrl = null;

        function showCyberModal(type, title, message, onModalClose = null) {
            const modal = document.getElementById("cyber-modal");
            const box = document.getElementById("modal-box");
            const icon = document.getElementById("modal-icon");
            const btn = document.getElementById("modal-btn");
            const sub = document.getElementById("modal-subtitle");

            modalCloseCallback = onModalClose;
            const titleEl = document.getElementById("modal-title");
            const msgEl = document.getElementById("modal-message");
            if (titleEl) titleEl.innerText = title;
            if (msgEl) msgEl.innerText = message;

            box?.classList.remove("border-red-500", "border-emerald-500", "border-amber-500", "border-[#00E5FF]", "border-[#222634]");

            if (type === "success") {
                box?.classList.add("border-emerald-500");
                if (icon) icon.className = "i-lucide-check-circle text-emerald-400";
                if (btn) {
                    btn.className = "yg-btn-primary w-full py-2.5 text-xs font-mono font-semibold tracking-wider";
                    btn.innerText = "MENGERTI";
                }
                if (sub) sub.innerText = "Transaction Approved";
                orderSuccess = true;
            } else if (type === "crypto") {
                box?.classList.add("border-amber-500");
                if (icon) icon.className = "i-lucide-coins text-amber-400";
                if (btn) {
                    btn.className = "yg-btn-secondary w-full py-2.5 text-xs font-mono font-semibold tracking-wider text-amber-400 border-amber-500/40";
                    btn.innerText = "GUNAKAN VISA / MASTERCARD";
                }
                if (sub) sub.innerText = "Web3 Roadmap Notice";
                orderSuccess = false;
            } else {
                box?.classList.add("border-red-500");
                if (icon) icon.className = "i-lucide-alert-triangle text-red-400";
                if (btn) {
                    btn.className = "yg-btn-danger w-full py-2.5 text-xs font-mono font-semibold tracking-wider";
                    btn.innerText = "MENGERTI";
                }
                if (sub) sub.innerText = "Transaction Status";
                orderSuccess = false;
            }

            modal?.classList.remove("hidden");
            modal?.classList.add("flex");
        }

        function closeModal() {
            const modal = document.getElementById("cyber-modal");
            modal?.classList.add("hidden");
            modal?.classList.remove("flex");
            if (typeof modalCloseCallback === "function") {
                const cb = modalCloseCallback;
                modalCloseCallback = null;
                cb();
                return;
            }
            if (targetPaymentUrl) {
                window.location.href = targetPaymentUrl;
            } else if (orderSuccess) {
                window.location.href = "/";
            }
        }

        async function processPayment() {
            const emailEl = document.getElementById("buyer-email");
            const waEl = document.getElementById("buyer-wa");
            const discordEl = document.getElementById("buyer-discord");

            const emailVal = emailEl ? emailEl.value.trim().toLowerCase() : "";
            const waVal = waEl ? waEl.value.trim() : "-";
            const discordVal = discordEl ? discordEl.value.trim() : "-";

            if (!emailVal || !emailVal.includes("@") || !emailVal.includes(".")) {
                showCyberModal(
                    "error",
                    "EMAIL DIBUTUHKAN",
                    "Mohon masukkan alamat email yang valid agar detail akun game dan invoice pesanan dapat dikirimkan kepada Anda.",
                );
                emailEl?.focus();
                return;
            }

            localStorage.setItem("yasui_buyer_email", emailVal);
            if (waVal && waVal !== "-") localStorage.setItem("yasui_buyer_wa", waVal);
            if (discordVal && discordVal !== "-") localStorage.setItem("yasui_buyer_discord", discordVal);

            const btn = document.getElementById("pay-btn");
            const loader = document.getElementById("loader");

            if (btn) btn.disabled = true;
            loader?.classList.remove("hidden");
            loader?.classList.add("flex");

            try {
                const response = await fetch("/api/create-order", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        cartItems: cartItems,
                        customerInfo: {
                            email: emailVal,
                            wa: waVal || "-",
                            discord: discordVal || "-",
                        },
                        paymentCategory: currentMethod,
                    }),
                });

                const result = await response.json();

                if (result.success) {
                    const remainingCart = JSON.parse(
                        localStorage.getItem("yasui_cart") || "[]",
                    ).filter((item) => !item.selected);

                    localStorage.setItem("yasui_cart", JSON.stringify(remainingCart));
                    localStorage.setItem("yasui_buyer_email", emailVal);

                    if (result.session && result.session.token) {
                        localStorage.setItem("yasui_session", JSON.stringify({
                            email: result.session.email || emailVal,
                            name: result.session.name || emailVal.split("@")[0],
                            token: result.session.token,
                            expiresAt: result.session.expiresAt
                        }));
                    } else {
                        localStorage.setItem("yasui_session", JSON.stringify({
                            email: emailVal,
                            name: emailVal.split("@")[0],
                            expiresAt: Date.now() + (30 * 24 * 60 * 60 * 1000)
                        }));
                    }
                    if (result.order?.id) {
                        try {
                            const rec = JSON.parse(localStorage.getItem("yasui_recent_orders") || "[]");
                            const cleanId = String(result.order.id).trim();
                            if (!rec.includes(cleanId)) {
                                rec.unshift(cleanId);
                                localStorage.setItem("yasui_recent_orders", JSON.stringify(rec.slice(0, 10)));
                            }
                        } catch (e) {}
                    }

                    try {
                        document.dispatchEvent(new Event("yasui-auth-changed"));
                    } catch (e) {}

                    targetPaymentUrl = result.paymentUrl;
                    showCyberModal(
                        "success",
                        "PESANAN BERHASIL DIBUAT",
                        "Mengarahkan ke halaman instruksi pembayaran...",
                    );
                    setTimeout(() => {
                        window.location.href = result.paymentUrl;
                    }, 1200);
                } else {
                    showCyberModal(
                        "error",
                        "FAILED",
                        getTranslation("checkout.failed_msg") + result.error,
                    );
                    if (btn) btn.disabled = false;
                    loader?.classList.add("hidden");
                    loader?.classList.remove("flex");
                }
            } catch (error) {
                showCyberModal(
                    "error",
                    "ERROR",
                    getTranslation("checkout.error_msg"),
                );
                if (btn) btn.disabled = false;
                loader?.classList.add("hidden");
                loader?.classList.remove("flex");
            }
        }

        document.getElementById("tab-qris")?.addEventListener("click", () => switchTab("qris"));
        document.getElementById("tab-global")?.addEventListener("click", () => switchTab("global"));
        document.getElementById("modal-btn")?.addEventListener("click", closeModal);
        document.getElementById("pay-btn")?.addEventListener("click", processPayment);
        document.getElementById("btn-crypto-notice")?.addEventListener("click", () => {
            showCyberModal(
                "crypto",
                "CRYPTO GATEWAY (SEGERA HADIR)",
                "Dukungan pembayaran Web3 Crypto (USDT & USDC) di jaringan TRC-20, Polygon, dan BEP-20 saat ini sedang dalam proses audit smart contract kami.\n\nUntuk pesanan Anda saat ini, silakan gunakan metode Visa / Mastercard / JCB yang telah aktif dan terhubung ke gateway Duitku.",
                () => {
                    selectChannel("credit_card");
                }
            );
        });

        document.querySelectorAll(".channel-card").forEach((card) => {
            card.addEventListener("click", () => {
                const channel = card.getAttribute("data-channel");
                if (channel) selectChannel(channel);
            });
        });

        initCheckout();
    </script>
</Layout>
