                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center flex-shrink-0"></div>
                        </div>

                        <div
                            onclick="window.switchTabToCrypto && window.switchTabToCrypto()"
                            class="border border-[#222634] bg-[#0D0F15]/60 hover:bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-amber-400/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3 group"
                        >
                            <div class="flex items-start sm:items-center gap-3">
                                <div class="w-9 h-9 rounded bg-[#11131A] flex items-center justify-center text-amber-400 border border-[#222634] flex-shrink-0">
                                    <div class="i-lucide-coins text-lg"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC] flex items-center gap-1.5 flex-wrap">
                                        <span>Crypto Instant (USDT / USDC)</span>
                                        <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 px-1.5 py-0.2 rounded font-mono">0% FEE</span>
                                        <span class="text-[9px] bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/25 px-1 py-0.2 rounded font-mono">ON-CHAIN</span>
                                    </div>
                                    <p class="text-[10px] text-[#94A3B8] mt-1 font-mono" data-i18n="checkout.crypto_cta_desc">
                                        Dukungan BSC BEP-20, Polygon POS, & TRON TRC-20 aktif. Klik untuk memilih jaringan crypto.
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center self-end sm:self-center">
                                <span class="text-[10px] text-amber-400 bg-amber-500/10 border border-amber-500/30 px-2 py-1 rounded font-mono flex items-center gap-1 group-hover:bg-amber-500/20 transition-colors" data-i18n="checkout.crypto_choose_btn">
                                    <div class="i-lucide-arrow-right text-xs"></div> PILIH CRYPTO
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <button
            id="pay-btn"
            class="yg-btn-primary w-full py-4 text-xs font-mono font-bold tracking-wider flex items-center justify-center gap-2"
            data-i18n="checkout.pay_now"
        >
            <div class="i-lucide-zap text-sm"></div> BAYAR SEKARANG
        </button>
    </main>

    <script is:inline define:vars={{ translations }}>
        let currentMethod = "qris";
        let cartItems = [];
        let orderSuccess = false;
        let subtotalAmount = 0;
        let appliedPromo = null;

        const USD_RATE = window.IDR_TO_USD_RATE || 16000;
        let curr = localStorage.getItem("yasui_currency") || "IDR";
        let lang = localStorage.getItem("yasui_lang") || "id";

        function getTranslation(key, fallback = "") {
            if (typeof window.t === "function") {
                return window.t(key, fallback || key);
            }
            const currentLang = localStorage.getItem("yasui_lang") || lang || "id";
            const t = translations[currentLang] || translations["id"];
            return (t && t[key]) ? t[key] : (fallback || key);
        }

        function updatePageTranslations() {
            if (typeof window.applyTranslations === "function") {
                window.applyTranslations(document);
            } else {
                const currentLang = localStorage.getItem("yasui_lang") || lang || "id";
                const t = translations[currentLang] || translations["id"];
                const icons = {
                    "checkout.pay_now": '<div class="i-lucide-zap"></div>',
                };

                document.querySelectorAll("[data-i18n]").forEach((el) => {
                    const key = el.getAttribute("data-i18n");
                    if (t && t[key]) {
                        if (icons[key]) {
                            el.innerHTML = icons[key] + " " + t[key];
                        } else {
                            el.innerText = t[key];
                        }
                    }
                });

                document.querySelectorAll("[data-i18n-placeholder]").forEach((el) => {
                    const key = el.getAttribute("data-i18n-placeholder");
                    if (t && t[key]) {
                        el.setAttribute("placeholder", t[key]);
                    }
                });
            }
        }
        updatePageTranslations();

        document.addEventListener("yasui-lang-change", (e) => {
            lang = e.detail?.lang || localStorage.getItem("yasui_lang") || "id";
            updatePageTranslations();
            initCheckout();
        });

        document.addEventListener("yasui-currency-change", (e) => {
            curr = e.detail?.currency || localStorage.getItem("yasui_currency") || "IDR";
            initCheckout();
        });

        function parsePrice(priceStr) {
            if (!priceStr) return 0;
            let str = String(priceStr).trim();
            if (/^\d+$/.test(str)) return parseInt(str, 10);
            if (str.match(/[,.]00$/)) str = str.substring(0, str.length - 3);
            const clean = str.replace(/\D/g, "");
            return parseInt(clean, 10) || 0;
        }

        function formatMoney(n) {
            const num = parsePrice(n);
            return curr === "USD"
                ? new Intl.NumberFormat("en-US", {
                      style: "currency",
                      currency: "USD",
                  }).format(num / USD_RATE)
                : new Intl.NumberFormat("id-ID", {
                      style: "currency",
                      currency: "IDR",
                      minimumFractionDigits: 0,
                  }).format(num);
        }

        function initCheckout() {
            const rawCart = JSON.parse(
                localStorage.getItem("yasui_cart") || "[]",
            );
            cartItems = rawCart.filter((item) => item.selected);

            cartItems = cartItems.map((item) => {
                if ((!item.id || item.id === 0) && item.globalId) {
                    try {
                        const decoded = atob(item.globalId);
                        const idPart = decoded.split(":")[1];
                        if (idPart) {
                            item.id = parseInt(idPart);
                        }
                    } catch (e) {}
                }
                return item;
            });

            if (cartItems.length === 0) {
                window.location.href = "/cart";
                return;
            }

            const container = document.getElementById("order-items");
            let total = 0;
            const currentLang = localStorage.getItem("yasui_lang") || lang || "id";

            if (container) {
                container.innerHTML = cartItems
                    .map((item) => {
                        const qty = Math.max(1, parseInt(item.quantity || (item.orderMeta && item.orderMeta.quantity) || 1, 10));
                        const rawPrice = parsePrice(item.price);
                        const unitPrice = item.unitPrice ? parsePrice(item.unitPrice) : Math.round(rawPrice / qty);
                        const lineTotal = rawPrice > 0 ? rawPrice : (unitPrice * qty);
                        total += lineTotal;

                        // Format Target Information
                        let targetDisplay = "";
                        if (typeof window.formatOrderTargetInfo === "function") {
                            targetDisplay = window.formatOrderTargetInfo(item, currentLang);
                        } else {
                            const meta = item.orderMeta || {};
                            const robloxUser = meta.robloxUsername || item.robloxUsername || "";
                            const deliveryMethod = meta.deliveryMethod || item.deliveryMethod || "";
                            const gameUid = meta.gameUid || item.gameUserId || "";
                            const gameZone = meta.gameZone || item.gameZoneId || "";
                            const gameNick = meta.inGameNickname || item.gameNickname || "";
                            const itemMode = meta.subCategoryMode || item.mode || "account";

                            if (itemMode === "roblox_item") {
                                targetDisplay = `Target: ${robloxUser || "@User"} • Metode: ${deliveryMethod === "direct_gift" ? "Direct Gift" : "Private Server Trade"} • Qty: ${qty}x`;
                            } else if (itemMode === "topup_gamepass") {
                                if (robloxUser) {
                                    const taxPart = meta.gamepassTaxCalc?.requiredGamepassPrice ? ` (Set ${meta.gamepassTaxCalc.requiredGamepassPrice} R$)` : "";
                                    targetDisplay = `Target: ${robloxUser} • Metode: ${deliveryMethod === "via_gamepass_link" ? "Link Gamepass" : "Gift In-Game"}${taxPart} • Qty: ${qty}x`;
                                } else if (gameUid) {
                                    targetDisplay = `UID: ${gameUid}${gameZone ? ` (${gameZone})` : ""}${gameNick ? ` • Nick: ${gameNick}` : ""} • Qty: ${qty}x`;
                                }
                            } else if (itemMode === "game_gift" || (gameUid && gameZone)) {
                                targetDisplay = `UID: ${gameUid || "-"}${gameZone ? ` (${gameZone})` : ""}${gameNick ? ` • Nick: ${gameNick}` : ""} • Qty: ${qty}x`;
                            } else if (item.playerInGameId) {
                                targetDisplay = `${item.playerInGameId} • Qty: ${qty}x`;
                            } else {
                                const credText = getTranslation("cart.email_login_credentials", "Kredensial Login via Email");
                                targetDisplay = `${credText} • Qty: ${qty}x`;
                            }
                        }

                        const variantName = item.orderMeta?.variantName || item.variant || "";

                        return `
                    <div class="flex gap-3 items-start bg-[#11131A] p-3 rounded-lg border border-[#222634]">
                        <img src="${item.image || "/favicon.svg"}" class="w-11 h-11 rounded-md object-cover bg-[#0D0F15] border border-[#222634] shrink-0 mt-0.5">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <h4 class="text-xs font-semibold text-[#F8FAFC] truncate">${item.name}</h4>
                                ${variantName ? `<span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/30 font-semibold uppercase">${variantName}</span>` : ""}
                            </div>
                            
                            ${targetDisplay ? `
                            <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#0D0F15] border border-[#222634] text-[10px] text-[#00E5FF] font-mono my-1 max-w-full">
                                <div class="i-lucide-crosshair text-xs shrink-0 text-[#00E5FF]"></div>
                                <span class="truncate">${targetDisplay}</span>
                            </div>
                            ` : ""}
                            
                            <p class="text-[10px] text-[#64748B] font-mono">${item.email || "guest@yasuigame.com"}</p>
                        </div>
                        <div class="text-right shrink-0">
                            <div class="text-[#00E5FF] font-mono text-xs font-bold tabular-nums">${formatMoney(lineTotal)}</div>
                            ${qty > 1 ? `<div class="text-[9px] text-[#64748B] font-mono">(${qty}x @ ${formatMoney(unitPrice)})</div>` : ""}
                        </div>
                    </div>
                `;
                    })
                    .join("");

                if (typeof window.applyTranslations === "function") {
                    window.applyTranslations(container);
                }
            }

            subtotalAmount = total;
            const subtotalEl = document.getElementById("subtotal-bill");
            if (subtotalEl) {
                subtotalEl.innerText = formatMoney(subtotalAmount);
            }
            recalculateBill();

            const firstItem = cartItems[0];
            const emailEl = document.getElementById("buyer-email");
            const waEl = document.getElementById("buyer-wa");
            const discordEl = document.getElementById("buyer-discord");

            const prefEmail = localStorage.getItem("yasui_buyer_email") || (firstItem?.email && firstItem.email !== "guest@yasuigame.com" ? firstItem.email : "") || "";
            const prefWa = localStorage.getItem("yasui_buyer_wa") || (firstItem?.wa && firstItem.wa !== "-" ? firstItem.wa : "") || "";
            const prefDiscord = localStorage.getItem("yasui_buyer_discord") || (firstItem?.contactValue && firstItem.contactValue !== "-" ? firstItem.contactValue : "") || "";

            if (emailEl && !emailEl.value && prefEmail) emailEl.value = prefEmail;
            if (waEl && !waEl.value && prefWa) waEl.value = prefWa;
            if (discordEl && !discordEl.value && prefDiscord) discordEl.value = prefDiscord;

            // Auto-check kode referral dari URL ?ref= atau localStorage
            const urlRef = new URLSearchParams(window.location.search).get("ref");
            const storedRef = urlRef || localStorage.getItem("yasui_ref_code");
            if (storedRef && !appliedPromo) {
                const promoInput = document.getElementById("promo-code-input");
                if (promoInput) promoInput.value = storedRef.trim().toUpperCase();
                applyPromoCode(storedRef);
            }
        }

        function recalculateBill() {
            const discountRow = document.getElementById("discount-row");
            const discountAmountEl = document.getElementById("discount-amount");
            const discountBadgeEl = document.getElementById("discount-badge");
            const totalBillEl = document.getElementById("total-bill");

            let discount = 0;
            if (appliedPromo && appliedPromo.discountAmount > 0) {
                discount = appliedPromo.discountAmount;
                if (discountRow) {
                    discountRow.classList.remove("hidden");
                    discountRow.classList.add("flex");
                }
                if (discountAmountEl) {
                    discountAmountEl.innerText = `-${formatMoney(discount)}`;
                }
                if (discountBadgeEl) {
                    discountBadgeEl.innerText = appliedPromo.code;
                }
            } else {
                if (discountRow) {
                    discountRow.classList.add("hidden");
                    discountRow.classList.remove("flex");
                }
            }

            const finalTotal = Math.max(0, subtotalAmount - discount);
            if (totalBillEl) {
                totalBillEl.innerText = formatMoney(finalTotal);
            }
        }

        async function applyPromoCode(overrideCode = null) {
            const input = document.getElementById("promo-code-input");
            const btn = document.getElementById("apply-promo-btn");
            const btnText = document.getElementById("apply-promo-text");
            const statusMsg = document.getElementById("promo-status-msg");
            const statusIcon = document.getElementById("promo-status-icon");
            const statusText = document.getElementById("promo-status-text");
            const removeBtn = document.getElementById("remove-promo-btn");

            const code = (overrideCode || input?.value || "").trim().toUpperCase();
            if (!code) {
                showCyberModal("error", getTranslation("checkout.modal_tx_status", "STATUS"), getTranslation("checkout.promo_invalid", "Silakan masukkan kode promo atau referral."));
                return;
            }

            const emailEl = document.getElementById("buyer-email");
            const email = emailEl ? emailEl.value.trim().toLowerCase() : (localStorage.getItem("yasui_buyer_email") || "");

            const waEl = document.getElementById("buyer-wa");
            const wa = waEl ? waEl.value.trim() : (localStorage.getItem("yasui_buyer_wa") || "");

            if (btn) btn.disabled = true;
            if (btnText) btnText.innerText = "...";

            try {
                const response = await fetch("/api/promo/validate", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        code: code,
                        cartTotal: subtotalAmount,
                        email: email,
                        buyerWa: wa,
                        targetInfo: cartItems[0]?.orderMeta || null
                    })
                });

                const res = await response.json();

                if (res.success && res.promo) {
                    appliedPromo = res.promo;
                    if (input) {
                        input.value = res.promo.code;
                        input.disabled = true;
                    }
                    if (btn) btn.classList.add("hidden");

                    if (statusMsg) {
                        statusMsg.classList.remove("hidden", "border-red-500/40", "text-red-400");
                        statusMsg.classList.add("flex", "border-emerald-500/40", "text-emerald-400");
                    }
                    if (statusIcon) statusIcon.className = "i-lucide-check-circle text-emerald-400";
                    if (statusText) statusText.innerText = `${res.promo.code} - ${res.promo.description} (${formatMoney(res.promo.discountAmount)})`;
                    if (removeBtn) removeBtn.classList.remove("hidden");

                    recalculateBill();
                } else {
                    appliedPromo = null;
                    if (statusMsg) {
                        statusMsg.classList.remove("hidden", "border-emerald-500/40", "text-emerald-400");
                        statusMsg.classList.add("flex", "border-red-500/40", "text-red-400");
                    }
                    if (statusIcon) statusIcon.className = "i-lucide-alert-circle text-red-400";
                    if (statusText) statusText.innerText = res.error || getTranslation("checkout.promo_invalid", "Kode tidak valid.");
                    if (removeBtn) removeBtn.classList.add("hidden");

                    recalculateBill();
                }
            } catch (e) {
                console.warn("[Apply Promo Exception]", e);
            } finally {
                if (btn) btn.disabled = false;
                if (btnText) btnText.innerText = getTranslation("checkout.btn_apply_promo", "APPLY");
            }
        }

        function removePromoCode() {
            appliedPromo = null;
            const input = document.getElementById("promo-code-input");
            const btn = document.getElementById("apply-promo-btn");
            const statusMsg = document.getElementById("promo-status-msg");
            const removeBtn = document.getElementById("remove-promo-btn");

            if (input) {
                input.value = "";
                input.disabled = false;
            }
            if (btn) btn.classList.remove("hidden");
            if (statusMsg) statusMsg.classList.add("hidden");
            if (removeBtn) removeBtn.classList.add("hidden");

            recalculateBill();
        }

        function selectChannel(code) {
            currentMethod = code;
            document.querySelectorAll(".channel-card").forEach((card) => {
                card.classList.remove("border-[#00E5FF]", "bg-[#00E5FF]/5");
                card.classList.add("border-[#222634]", "bg-[#0D0F15]");
                const ind = card.querySelector(".channel-indicator");
                if (ind) {
                    ind.classList.remove("border-[#00E5FF]");
                    ind.classList.add("border-[#222634]");
                    ind.innerHTML = "";
                }
            });

            const active = document.querySelector(`.channel-card[data-channel="${code}"]`);
            if (active) {
                active.classList.remove("border-[#222634]", "bg-[#0D0F15]");
                active.classList.add("border-[#00E5FF]", "bg-[#00E5FF]/5");
                const ind = active.querySelector(".channel-indicator");
                if (ind) {
                    ind.classList.remove("border-[#222634]");
                    ind.classList.add("border-[#00E5FF]");
                    ind.innerHTML = '<div class="w-2 h-2 rounded-full bg-[#00E5FF]"></div>';
                }
            }
        }

        function switchTab(id) {
            document
                .querySelectorAll('button[id^="tab-"]')
                .forEach((el) => {
                    el.classList.remove("active-tab", "border-[#00E5FF]", "bg-[#00E5FF]/5", "text-[#F8FAFC]");
                    el.classList.add("border-[#222634]", "bg-[#11131A]", "text-[#94A3B8]");
                });
            document
                .querySelectorAll(".payment-info")
                .forEach((el) => el.classList.add("hidden"));

            const activeTabBtn = document.getElementById(`tab-${id}`);
            if (activeTabBtn) {
                activeTabBtn.classList.add("active-tab", "border-[#00E5FF]", "bg-[#00E5FF]/5", "text-[#F8FAFC]");
                activeTabBtn.classList.remove("border-[#222634]", "bg-[#11131A]", "text-[#94A3B8]");
            }

            document
                .getElementById(`info-${id}`)
                ?.classList.remove("hidden");

            if (id === "global") {
                selectChannel("credit_card");
            } else if (id === "crypto") {
                const activeCryptoEl = document.querySelector("#info-crypto .channel-card.border-\\[\\#00E5FF\\]");
                const selectedCrypto = activeCryptoEl ? activeCryptoEl.getAttribute("data-channel") : "CRYPTO_USDT_BEP20";
                selectChannel(selectedCrypto);
            } else {
                const activeChannelEl = document.querySelector("#channel-list .channel-card.border-\\[\\#00E5FF\\]") || document.querySelector("#channel-list .channel-card.active-channel");
                const selected = activeChannelEl ? activeChannelEl.getAttribute("data-channel") : "qris";
                selectChannel(selected);
            }
        }

        window.switchTabToCrypto = () => switchTab("crypto");

        let modalCloseCallback = null;
        let targetPaymentUrl = null;

        function showCyberModal(type, title, message, onModalClose = null) {
            const modal = document.getElementById("cyber-modal");
            const box = document.getElementById("modal-box");
            const icon = document.getElementById("modal-icon");
            const btn = document.getElementById("modal-btn");
            const sub = document.getElementById("modal-subtitle");

            modalCloseCallback = onModalClose;
            const titleEl = document.getElementById("modal-title");
            const msgEl = document.getElementById("modal-message");
            if (titleEl) titleEl.innerText = title;
            if (msgEl) msgEl.innerText = message;

            box?.classList.remove("border-red-500", "border-emerald-500", "border-amber-500", "border-[#00E5FF]", "border-[#222634]");

            if (type === "success") {
                box?.classList.add("border-emerald-500");
                if (icon) icon.className = "i-lucide-check-circle text-emerald-400";
                if (btn) {
                    btn.className = "yg-btn-primary w-full py-2.5 text-xs font-mono font-semibold tracking-wider";
                    btn.innerText = getTranslation("checkout.btn_understand", "MENGERTI");
                }
                if (sub) sub.innerText = getTranslation("checkout.modal_tx_approved", "Transaction Approved");
                orderSuccess = true;
            } else if (type === "crypto") {
                box?.classList.add("border-amber-500");
                if (icon) icon.className = "i-lucide-coins text-amber-400";
                if (btn) {
                    btn.className = "yg-btn-secondary w-full py-2.5 text-xs font-mono font-semibold tracking-wider text-amber-400 border-amber-500/40";
                    btn.innerText = getTranslation("checkout.btn_use_card", "GUNAKAN VISA / MASTERCARD");
                }
                if (sub) sub.innerText = getTranslation("checkout.modal_web3_notice", "Web3 Gateway Notice");
                orderSuccess = false;
            } else {
                box?.classList.add("border-red-500");
                if (icon) icon.className = "i-lucide-alert-triangle text-red-400";
                if (btn) {
                    btn.className = "yg-btn-danger w-full py-2.5 text-xs font-mono font-semibold tracking-wider";
                    btn.innerText = getTranslation("checkout.btn_understand", "MENGERTI");
                }
                if (sub) sub.innerText = getTranslation("checkout.modal_tx_status", "Transaction Status");
                orderSuccess = false;
            }

            modal?.classList.remove("hidden");
            modal?.classList.add("flex");
        }

        function closeModal() {
            const modal = document.getElementById("cyber-modal");
            modal?.classList.add("hidden");
            modal?.classList.remove("flex");
            if (typeof modalCloseCallback === "function") {
                const cb = modalCloseCallback;
                modalCloseCallback = null;
                cb();
                return;
            }
            if (targetPaymentUrl) {
                window.location.href = targetPaymentUrl;
            } else if (orderSuccess) {
                window.location.href = "/";
            }
        }

        async function processPayment() {
            const emailEl = document.getElementById("buyer-email");
            const waEl = document.getElementById("buyer-wa");
            const discordEl = document.getElementById("buyer-discord");

            const emailVal = emailEl ? emailEl.value.trim().toLowerCase() : "";
            const waVal = waEl ? waEl.value.trim() : "-";
            const discordVal = discordEl ? discordEl.value.trim() : "-";

            if (!emailVal || !emailVal.includes("@") || !emailVal.includes(".")) {
                showCyberModal(
                    "error",
                    getTranslation("checkout.modal_email_required_title", "EMAIL DIBUTUHKAN"),
                    getTranslation("checkout.modal_email_required_desc", "Mohon masukkan alamat email yang valid agar detail akun game dan invoice pesanan dapat dikirimkan kepada Anda."),
                );
                emailEl?.focus();
                return;
            }

            localStorage.setItem("yasui_buyer_email", emailVal);
            if (waVal && waVal !== "-") localStorage.setItem("yasui_buyer_wa", waVal);
            if (discordVal && discordVal !== "-") localStorage.setItem("yasui_buyer_discord", discordVal);

            const btn = document.getElementById("pay-btn");
            const loader = document.getElementById("loader");

            if (btn) btn.disabled = true;
            loader?.classList.remove("hidden");
            loader?.classList.add("flex");

            try {
                const normalizedCartItems = cartItems.map(item => {
                    const qty = Math.max(1, parseInt(item.quantity || (item.orderMeta && item.orderMeta.quantity) || 1, 10));
                    return {
                        ...item,
                        quantity: qty,
                        orderMeta: item.orderMeta || {
                            subCategoryMode: item.mode || "account",
                            quantity: qty,
                            variantName: item.variant || "",
                            robloxUsername: item.robloxUsername || "",
                            deliveryMethod: item.deliveryMethod || "",
                            gameUid: item.gameUserId || "",
                            gameZone: item.gameZoneId || "",
                            inGameNickname: item.gameNickname || ""
                        }
                    };
                });

                const response = await fetch("/api/create-order", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        cartItems: normalizedCartItems,
                        customerInfo: {
                            email: emailVal,
                            wa: waVal || "-",
                            discord: discordVal || "-",
                        },
                        paymentCategory: currentMethod,
                        promoCode: appliedPromo?.code || "",
                        appliedPromo: appliedPromo || null,
                    }),
                });

                const result = await response.json();

                if (result.success) {
                    const remainingCart = JSON.parse(
                        localStorage.getItem("yasui_cart") || "[]",
                    ).filter((item) => !item.selected);

                    localStorage.setItem("yasui_cart", JSON.stringify(remainingCart));
                    localStorage.setItem("yasui_buyer_email", emailVal);

                    if (result.session && result.session.token) {
                        localStorage.setItem("yasui_session", JSON.stringify({
                            email: result.session.email || emailVal,
                            name: result.session.name || emailVal.split("@")[0],
                            token: result.session.token,
                            expiresAt: result.session.expiresAt
                        }));
                    } else {
                        localStorage.setItem("yasui_session", JSON.stringify({
                            email: emailVal,
                            name: emailVal.split("@")[0],
                            expiresAt: Date.now() + (30 * 24 * 60 * 60 * 1000)
                        }));
                    }
                    if (result.order?.id) {
                        try {
                            const rec = JSON.parse(localStorage.getItem("yasui_recent_orders") || "[]");
                            const cleanId = String(result.order.id).trim();
                            if (!rec.includes(cleanId)) {
                                rec.unshift(cleanId);
                                localStorage.setItem("yasui_recent_orders", JSON.stringify(rec.slice(0, 10)));
                            }
                        } catch (e) {}
                    }

                    try {
                        document.dispatchEvent(new Event("yasui-auth-changed"));
                    } catch (e) {}

                    targetPaymentUrl = result.paymentUrl;
                    showCyberModal(
                        "success",
                        getTranslation("checkout.order_created_title", "PESANAN BERHASIL DIBUAT"),
                        getTranslation("checkout.order_created_redirecting", "Mengarahkan ke halaman instruksi pembayaran..."),
                    );
                    setTimeout(() => {
                        window.location.href = result.paymentUrl;
                    }, 1200);
                } else {
                    showCyberModal(
                        "error",
                        "FAILED",
                        getTranslation("checkout.failed_msg", "Gagal membuat order: ") + result.error,
                    );
                    if (btn) btn.disabled = false;
                    loader?.classList.add("hidden");
                    loader?.classList.remove("flex");
                }
            } catch (error) {
                showCyberModal(
                    "error",
                    "ERROR",
                    getTranslation("checkout.error_msg", "Terjadi kesalahan sistem. Silakan coba lagi."),
                );
                if (btn) btn.disabled = false;
                loader?.classList.add("hidden");
                loader?.classList.remove("flex");
            }
        }

        document.getElementById("tab-qris")?.addEventListener("click", () => switchTab("qris"));
        document.getElementById("tab-crypto")?.addEventListener("click", () => switchTab("crypto"));
        document.getElementById("tab-global")?.addEventListener("click", () => switchTab("global"));
        document.getElementById("modal-btn")?.addEventListener("click", closeModal);
        document.getElementById("pay-btn")?.addEventListener("click", processPayment);
        document.getElementById("apply-promo-btn")?.addEventListener("click", () => applyPromoCode());
        document.getElementById("remove-promo-btn")?.addEventListener("click", removePromoCode);
        document.getElementById("promo-code-input")?.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                applyPromoCode();
            }
        });

        document.querySelectorAll(".channel-card").forEach((card) => {
            card.addEventListener("click", () => {
                const channel = card.getAttribute("data-channel");
                if (channel) selectChannel(channel);
            });
        });

        initCheckout();
    </script>
</Layout>
