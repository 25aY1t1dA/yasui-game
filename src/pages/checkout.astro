---
// src/pages/checkout.astro
import { translations } from "../lib/translations";
---

<html lang="id" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Secure Checkout - Yasui Game</title>
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;800&display=swap"
            rel="stylesheet"
        />
        <style>
            body {
                font-family: "JetBrains Mono", monospace;
                background-color: #050505;
                background-image: radial-gradient(#151515 1px, transparent 1px);
                background-size: 20px 20px;
            }
            .active-tab {
                border-color: #22d3ee;
                color: #22d3ee;
                background: rgba(34, 211, 238, 0.1);
            }
            .disabled-btn {
                opacity: 0.5;
                cursor: wait;
            }

            /* Modal Animation */
            @keyframes modalPop {
                0% {
                    transform: scale(0.9);
                    opacity: 0;
                }
                100% {
                    transform: scale(1);
                    opacity: 1;
                }
            }
            .modal-animate {
                animation: modalPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }
        </style>
    </head>
    <body class="bg-black text-gray-300 min-h-screen pb-24">
        <div
            id="cyber-modal"
            class="fixed inset-0 z-[150] bg-black/90 backdrop-blur-sm hidden flex-col justify-center items-center p-6"
        >
            <div
                class="relative bg-gray-900 border w-full max-w-sm p-6 rounded-none shadow-[0_0_50px_rgba(0,0,0,0.8)] modal-animate"
                id="modal-box"
            >
                <div
                    class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-current to-transparent"
                    id="modal-line"
                >
                </div>

                <div class="flex items-center gap-4 mb-4">
                    <div
                        class="w-12 h-12 bg-gray-800 flex items-center justify-center border border-gray-700 skew-x-[-10deg]"
                    >
                        <div id="modal-icon" class="text-2xl skew-x-[10deg]">
                        </div>
                    </div>
                    <div>
                        <h3
                            id="modal-title"
                            class="text-white font-black uppercase tracking-wider text-sm"
                        >
                            SYSTEM MESSAGE
                        </h3>
                        <p
                            class="text-[10px] text-gray-500 font-mono"
                            id="modal-subtitle"
                        >
                            Transaction Status
                        </p>
                    </div>
                </div>

                <p
                    id="modal-message"
                    class="text-gray-300 text-sm mb-6 leading-relaxed border-l-2 border-gray-700 pl-4"
                >
                </p>

                <button
                    onclick="closeModal()"
                    id="modal-btn"
                    class="w-full font-black uppercase py-3 text-xs tracking-widest hover:brightness-110 transition shadow-lg"
                >
                    MENGERTI
                </button>
            </div>
        </div>

        <div
            id="loader"
            class="fixed inset-0 z-[100] bg-black/95 backdrop-blur hidden flex-col items-center justify-center"
        >
            <div class="relative w-16 h-16 mb-4">
                <div
                    class="absolute inset-0 border-4 border-gray-800 rounded-full"
                >
                </div>
                <div
                    class="absolute inset-0 border-4 border-t-cyan-400 rounded-full animate-spin"
                >
                </div>
            </div>
            <h3 class="text-cyan-400 font-bold animate-pulse tracking-widest">
                CONNECTING TO GATEWAY...
            </h3>
            <p class="text-xs text-gray-500 mt-2 font-mono">
                Do not close this window
            </p>
        </div>

        <header
            class="border-b border-gray-800 bg-black/50 backdrop-blur p-4 sticky top-0 z-50"
        >
            <div class="max-w-3xl mx-auto flex items-center justify-between">
                <a
                    href="/cart"
                    class="flex items-center gap-2 text-gray-400 hover:text-white transition"
                >
                    <span data-i18n="product.back">Batal</span>
                </a>
                <div class="flex items-center gap-2">
                    <div class="i-lucide-shield-check text-cyan-400"></div>
                    <span
                        class="text-sm font-bold text-white"
                        data-i18n="checkout.title">SECURE CHECKOUT</span
                    >
                </div>
            </div>
        </header>

        <main class="max-w-3xl mx-auto p-4 md:p-8">
            <div class="mb-8">
                <h2
                    class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4 border-b border-gray-800 pb-2"
                    data-i18n="checkout.order_items"
                >
                    1. Item Pesanan
                </h2>
                <div id="order-items" class="space-y-3">
                    <p
                        class="text-center text-gray-600 text-sm py-4"
                        data-i18n="checkout.loading"
                    >
                        Memuat data...
                    </p>
                </div>

                <div
                    class="flex justify-between items-center mt-4 pt-4 border-t border-gray-800 border-dashed"
                >
                    <span
                        class="text-sm text-gray-400"
                        data-i18n="checkout.total_bill">Total Tagihan</span
                    >
                    <span
                        class="text-xl font-mono font-bold text-cyan-400"
                        id="total-bill">Rp 0</span
                    >
                </div>
            </div>

            <!-- 2. DATA PENERIMA & AKUN -->
            <div class="mb-8">
                <h2
                    class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4 border-b border-gray-800 pb-2 flex items-center justify-between"
                >
                    <span>2. Data Penerima & Akun</span>
                    <span class="text-[10px] text-cyan-400 font-mono flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span> AUTO-SYNC AKUN
                    </span>
                </h2>

                <div class="space-y-4 bg-gray-900/40 border border-gray-800 p-4 rounded-lg">
                    <div>
                        <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-1.5">
                            Email Penerima <span class="text-red-400">*</span>
                        </label>
                        <input
                            type="email"
                            id="buyer-email"
                            required
                            placeholder="emailkamu@example.com"
                            class="w-full bg-black/80 border border-gray-800 rounded px-3 py-2.5 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-cyan-400 font-mono transition"
                        />
                        <p class="text-[11px] text-gray-500 mt-1">
                            Akun game & bukti pesanan otomatis dikirim dan dikaitkan ke email ini (anti-hilang).
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1.5">
                                WhatsApp <span class="text-gray-600 font-normal">(Opsional)</span>
                            </label>
                            <input
                                type="tel"
                                id="buyer-wa"
                                placeholder="08xxxxxxxxxx"
                                class="w-full bg-black/80 border border-gray-800 rounded px-3 py-2 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-cyan-400 font-mono transition"
                            />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-1.5">
                                Discord <span class="text-gray-600 font-normal">(Opsional)</span>
                            </label>
                            <input
                                type="text"
                                id="buyer-discord"
                                placeholder="username#0000"
                                class="w-full bg-black/80 border border-gray-800 rounded px-3 py-2 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-cyan-400 font-mono transition"
                            />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-8">
                <h2
                    class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4 border-b border-gray-800 pb-2"
                    data-i18n="checkout.payment_method"
                >
                    3. Pilih Metode Bayar
                </h2>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <button
                        onclick="switchTab('qris')"
                        id="tab-qris"
                        class="active-tab border border-gray-800 bg-gray-900 p-3 rounded flex flex-col items-center gap-2 transition hover:border-gray-600 group"
                    >
                        <div
                            class="i-lucide-qr-code text-xl group-hover:scale-110 transition"
                        >
                        </div>
                        <span
                            class="text-[10px] font-bold uppercase"
                            data-i18n="checkout.qris_title"
                            >Indonesia Payment</span
                        >
                    </button>
                    <button
                        onclick="switchTab('global')"
                        id="tab-global"
                        class="border border-gray-800 bg-gray-900 p-3 rounded flex flex-col items-center gap-2 transition hover:border-gray-600 group"
                    >
                        <div
                            class="i-lucide-credit-card text-xl group-hover:scale-110 transition"
                        >
                        </div>
                        <span
                            class="text-[10px] font-bold uppercase"
                            data-i18n="checkout.global_title"
                            >International Payment</span
                        >
                    </button>
                </div>

                <div
                    class="bg-gray-900/50 border border-gray-800 p-4 rounded text-left min-h-[80px]"
                >
                    <div id="info-qris" class="payment-info w-full space-y-4">
                        <div class="flex items-center justify-between pb-2 border-b border-gray-800">
                            <div>
                                <p class="text-white font-bold text-xs uppercase tracking-wider">
                                    Metode Pembayaran Domestik (Duitku)
                                </p>
                                <p class="text-[11px] text-gray-500 font-mono">
                                    Verifikasi otomatis 24 jam & terhubung langsung ke gateway.
                                </p>
                            </div>
                            <span class="text-[10px] text-cyan-400 font-mono bg-cyan-950/60 border border-cyan-800 px-2 py-0.5">
                                BEBAS BIAYA ADMIN
                            </span>
                        </div>

                        <!-- Channel Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="channel-list">
                            <!-- QRIS -->
                            <div
                                onclick="selectChannel('qris')"
                                data-channel="qris"
                                class="channel-card active-channel border border-cyan-400 bg-cyan-950/20 p-3 rounded cursor-pointer transition hover:border-cyan-300 flex items-center justify-between"
                            >
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-black flex items-center justify-center text-cyan-400 border border-cyan-800">
                                        <div class="i-lucide-qr-code text-lg"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white flex items-center gap-1.5">
                                            QRIS <span class="text-[9px] bg-red-950 text-red-400 border border-red-800 px-1 py-0.2 rounded font-mono">REKOMENDASI</span>
                                        </div>
                                        <div class="text-[10px] text-gray-400">Semua Bank & E-Wallet</div>
                                    </div>
                                </div>
                                <div class="channel-indicator w-4 h-4 rounded-full border-2 border-cyan-400 flex items-center justify-center">
                                    <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
                                </div>
                            </div>

                            <!-- BCA VA -->
                            <div
                                onclick="selectChannel('va_bca')"
                                data-channel="va_bca"
                                class="channel-card border border-gray-800 bg-gray-900/60 p-3 rounded cursor-pointer transition hover:border-gray-700 flex items-center justify-between"
                            >
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-black flex items-center justify-center text-blue-400 border border-gray-800">
                                        <div class="i-lucide-landmark text-lg"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white">BCA Virtual Account</div>
                                        <div class="text-[10px] text-gray-500 font-mono">Transfer m-BCA / ATM</div>
                                    </div>
                                </div>
                                <div class="channel-indicator w-4 h-4 rounded-full border-2 border-gray-700 flex items-center justify-center"></div>
                            </div>

                            <!-- Mandiri VA -->
                            <div
                                onclick="selectChannel('va_mandiri')"
                                data-channel="va_mandiri"
                                class="channel-card border border-gray-800 bg-gray-900/60 p-3 rounded cursor-pointer transition hover:border-gray-700 flex items-center justify-between"
                            >
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-black flex items-center justify-center text-yellow-400 border border-gray-800">
                                        <div class="i-lucide-landmark text-lg"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white">Mandiri Virtual Account</div>
                                        <div class="text-[10px] text-gray-500 font-mono">Livin' by Mandiri / ATM</div>
                                    </div>
                                </div>
                                <div class="channel-indicator w-4 h-4 rounded-full border-2 border-gray-700 flex items-center justify-center"></div>
                            </div>

                            <!-- BRI VA -->
                            <div
                                onclick="selectChannel('va_bri')"
                                data-channel="va_bri"
                                class="channel-card border border-gray-800 bg-gray-900/60 p-3 rounded cursor-pointer transition hover:border-gray-700 flex items-center justify-between"
                            >
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-black flex items-center justify-center text-blue-400 border border-gray-800">
                                        <div class="i-lucide-landmark text-lg"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white">BRI Virtual Account</div>
                                        <div class="text-[10px] text-gray-500 font-mono">BRImo / ATM BRI</div>
                                    </div>
                                </div>
                                <div class="channel-indicator w-4 h-4 rounded-full border-2 border-gray-700 flex items-center justify-center"></div>
                            </div>

                            <!-- BNI VA -->
                            <div
                                onclick="selectChannel('va_bni')"
                                data-channel="va_bni"
                                class="channel-card border border-gray-800 bg-gray-900/60 p-3 rounded cursor-pointer transition hover:border-gray-700 flex items-center justify-between"
                            >
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-black flex items-center justify-center text-orange-400 border border-gray-800">
                                        <div class="i-lucide-landmark text-lg"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white">BNI Virtual Account</div>
                                        <div class="text-[10px] text-gray-500 font-mono">BNI Mobile / ATM</div>
                                    </div>
                                </div>
                                <div class="channel-indicator w-4 h-4 rounded-full border-2 border-gray-700 flex items-center justify-center"></div>
                            </div>

                            <!-- DANA -->
                            <div
                                onclick="selectChannel('ewallet_dana')"
                                data-channel="ewallet_dana"
                                class="channel-card border border-gray-800 bg-gray-900/60 p-3 rounded cursor-pointer transition hover:border-gray-700 flex items-center justify-between"
                            >
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-black flex items-center justify-center text-cyan-400 border border-gray-800">
                                        <div class="i-lucide-wallet text-lg"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white">DANA E-Wallet</div>
                                        <div class="text-[10px] text-gray-500 font-mono">Aplikasi DANA</div>
                                    </div>
                                </div>
                                <div class="channel-indicator w-4 h-4 rounded-full border-2 border-gray-700 flex items-center justify-center"></div>
                            </div>
                        </div>
                    </div>
                    <div id="info-global" class="payment-info hidden w-full space-y-4 text-left">
                        <div class="flex items-center justify-between pb-2 border-b border-gray-800">
                            <div>
                                <p class="text-white font-bold text-xs uppercase tracking-wider">
                                    Metode Pembayaran Internasional
                                </p>
                                <p class="text-[11px] text-gray-500 font-mono">
                                    Mendukung kartu debit/kredit global & konversi kurs otomatis.
                                </p>
                            </div>
                            <span class="text-[10px] text-cyan-400 font-mono bg-cyan-950/60 border border-cyan-800 px-2 py-0.5">
                                CROSS-BORDER GATEWAY
                            </span>
                        </div>

                        <!-- Channel Grid International -->
                        <div class="grid grid-cols-1 gap-2.5">
                            <!-- VISA / MASTERCARD / JCB (ACTIVE & ACTIONABLE) -->
                            <div
                                onclick="selectChannel('credit_card')"
                                data-channel="credit_card"
                                class="channel-card border border-gray-800 bg-gray-900/60 p-3.5 rounded cursor-pointer transition hover:border-cyan-400 flex items-center justify-between"
                            >
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded bg-black flex items-center justify-center text-cyan-400 border border-gray-800 flex-shrink-0">
                                        <div class="i-lucide-credit-card text-xl"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-white flex items-center gap-1.5 flex-wrap">
                                            <span>Visa / Mastercard / JCB</span>
                                            <span class="text-[9px] bg-green-950 text-green-400 border border-green-800 px-1 py-0.2 rounded font-mono">AKTIF</span>
                                            <span class="text-[9px] bg-cyan-950 text-cyan-400 border border-cyan-800 px-1 py-0.2 rounded font-mono">3D-SECURE OTP</span>
                                        </div>
                                        <div class="text-[10px] text-gray-400 mt-1 font-mono">
                                            Kartu kredit & debit internasional. Dikonversi otomatis oleh bank penerbit Anda.
                                        </div>
                                        <div class="flex items-center gap-2 mt-2 text-[10px] font-mono text-gray-500">
                                            <span class="text-blue-400 font-bold">VISA</span> • 
                                            <span class="text-red-400 font-bold">Mastercard</span> • 
                                            <span class="text-green-400 font-bold">JCB</span> • 
                                            <span class="text-cyan-400 font-bold">AMEX</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="channel-indicator w-4 h-4 rounded-full border-2 border-gray-700 flex items-center justify-center flex-shrink-0"></div>
                            </div>

                            <!-- CRYPTO USDT / USDC (VISUAL ROADMAP) -->
                            <div
                                onclick="showCryptoModalNotice()"
                                class="border border-gray-800 bg-gray-900/40 hover:bg-gray-900/70 p-3.5 rounded cursor-pointer transition hover:border-amber-400/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3 group relative overflow-hidden"
                            >
                                <div class="flex items-start sm:items-center gap-3">
                                    <div class="w-10 h-10 rounded bg-black flex items-center justify-center text-amber-400 border border-amber-900/60 group-hover:border-amber-400/50 transition flex-shrink-0">
                                        <div class="i-lucide-coins text-xl group-hover:scale-110 transition"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-gray-200 flex items-center gap-1.5 flex-wrap">
                                            <span>Crypto (USDT / USDC)</span>
                                            <span class="text-[9px] bg-amber-950/80 text-amber-400 border border-amber-800 px-1.5 py-0.2 rounded font-mono">SEGERA HADIR</span>
                                            <span class="text-[9px] bg-cyan-950 text-cyan-400 border border-cyan-800 px-1 py-0.2 rounded font-mono">NON-CUSTODIAL</span>
                                        </div>
                                        <p class="text-[10px] text-gray-400 mt-1 font-mono">
                                            Pembayaran Web3 terdesentralisasi bebas biaya transfer lintas negara & anti-chargeback.
                                        </p>
                                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                                            <span class="text-[9px] bg-black/80 text-emerald-400 border border-emerald-900/80 px-1.5 py-0.2 rounded font-mono">
                                                TRC-20 (Tron)
                                            </span>
                                            <span class="text-[9px] bg-black/80 text-purple-400 border border-purple-900/80 px-1.5 py-0.2 rounded font-mono">
                                                Polygon (MATIC)
                                            </span>
                                            <span class="text-[9px] bg-black/80 text-yellow-400 border border-yellow-900/80 px-1.5 py-0.2 rounded font-mono">
                                                BEP-20 (BNB)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center justify-end sm:justify-center self-end sm:self-center">
                                    <span class="text-[10px] text-amber-400 bg-amber-950/40 border border-amber-800/80 px-2 py-1 rounded font-mono flex items-center gap-1 group-hover:bg-amber-400 group-hover:text-black transition">
                                        <div class="i-lucide-info text-xs"></div> DETAIL
                                    </span>
                                </div>
                            </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button
                id="pay-btn"
                onclick="processPayment()"
                class="w-full bg-cyan-400 text-black font-black uppercase py-4 rounded hover:bg-white transition shadow-[0_0_20px_rgba(34,211,238,0.3)] flex items-center justify-center gap-2"
                data-i18n="checkout.pay_now"
            >
                <div class="i-lucide-zap"></div> BAYAR SEKARANG
            </button>
        </main>

        <script is:inline define:vars={{ translations }}>
            let currentMethod = "qris";
            let cartItems = [];
            let orderSuccess = false; // Flag untuk redirect setelah tutup modal

            const USD_RATE = 16000;
            const curr = localStorage.getItem("yasui_currency") || "IDR";
            const lang = localStorage.getItem("yasui_lang") || "id";

            // --- TRANSLATION LOGIC ---
            function getTranslation(key) {
                const currentLang = lang || "id";
                const t = translations[currentLang] || translations["id"];
                return t[key] || key;
            }

            function updatePageTranslations() {
                const currentLang = lang || "id";
                const t = translations[currentLang] || translations["id"];
                const icons = {
                    // "product.back": '<div class="i-lucide-arrow-left"></div>', // Removed to fix duplicate icon
                    "checkout.pay_now": '<div class="i-lucide-zap"></div>',
                };

                document.querySelectorAll("[data-i18n]").forEach((el) => {
                    const key = el.getAttribute("data-i18n");
                    if (t[key]) {
                        if (icons[key]) {
                            el.innerHTML = icons[key] + " " + t[key];
                        } else {
                            el.innerText = t[key];
                        }
                    }
                });
            }
            // Run translations immediately
            updatePageTranslations();

            function parsePrice(priceStr) {
                if (!priceStr) return 0;
                let str = String(priceStr).trim();
                if (/^\d+$/.test(str)) return parseInt(str, 10);
                if (str.match(/[,.]00$/)) str = str.substring(0, str.length - 3);
                const clean = str.replace(/\D/g, "");
                return parseInt(clean, 10) || 0;
            }

            function formatMoney(n) {
                const num = parsePrice(n);
                return curr === "USD"
                    ? new Intl.NumberFormat("en-US", {
                          style: "currency",
                          currency: "USD",
                      }).format(num / USD_RATE)
                    : new Intl.NumberFormat("id-ID", {
                          style: "currency",
                          currency: "IDR",
                          minimumFractionDigits: 0,
                      }).format(num);
            }

            // --- CORE FUNCTIONS ---

            function initCheckout() {
                const rawCart = JSON.parse(
                    localStorage.getItem("yasui_cart") || "[]",
                );
                cartItems = rawCart.filter((item) => item.selected);

                // Fix: Ensure every item has a valid Integer ID for the backend
                cartItems = cartItems.map((item) => {
                    // If id is missing/zero but globalId exists, try to recover it
                    if ((!item.id || item.id === 0) && item.globalId) {
                        try {
                            // globalId format usually "post:123" (base64)
                            // or just base64 string
                            const decoded = atob(item.globalId);
                            // Format: "post:123"
                            const idPart = decoded.split(":")[1];
                            if (idPart) {
                                item.id = parseInt(idPart);
                                console.log(
                                    "Recovered ID for",
                                    item.name,
                                    ":",
                                    item.id,
                                );
                            }
                        } catch (e) {
                            console.warn("Failed to recover ID for", item.name);
                        }
                    }
                    return item;
                });

                if (cartItems.length === 0) {
                    // Redirect jika reload halaman tapi cart kosong
                    window.location.href = "/cart";
                    return;
                }

                const container = document.getElementById("order-items");
                let total = 0;

                container.innerHTML = cartItems
                    .map((item) => {
                        total += parsePrice(item.price);
                        return `
                    <div class="flex gap-3 items-center bg-gray-900 p-3 rounded border border-gray-800">
                        <img src="${item.image}" class="w-10 h-10 rounded object-cover bg-black border border-gray-700">
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-white truncate">${item.name}</h4>
                            <p class="text-[10px] text-gray-500 font-mono">${item.email}</p>
                        </div>
                        <div class="text-cyan-400 font-mono text-xs font-bold">${formatMoney(item.price)}</div>
                    </div>
                `;
                    })
                    .join("");

                document.getElementById("total-bill").innerText =
                    formatMoney(total);

                // Auto-fill Data Pembeli dari item atau localStorage
                const firstItem = cartItems[0];
                const emailEl = document.getElementById("buyer-email");
                const waEl = document.getElementById("buyer-wa");
                const discordEl = document.getElementById("buyer-discord");

                const prefEmail = localStorage.getItem("yasui_buyer_email") || (firstItem?.email && firstItem.email !== "guest@yasuigame.com" ? firstItem.email : "") || "";
                const prefWa = localStorage.getItem("yasui_buyer_wa") || (firstItem?.wa && firstItem.wa !== "-" ? firstItem.wa : "") || "";
                const prefDiscord = localStorage.getItem("yasui_buyer_discord") || (firstItem?.contactValue && firstItem.contactValue !== "-" ? firstItem.contactValue : "") || "";

                if (emailEl && !emailEl.value && prefEmail) emailEl.value = prefEmail;
                if (waEl && !waEl.value && prefWa) waEl.value = prefWa;
                if (discordEl && !discordEl.value && prefDiscord) discordEl.value = prefDiscord;
            }

            window.selectChannel = (code) => {
                currentMethod = code;
                document.querySelectorAll(".channel-card").forEach((card) => {
                    card.classList.remove("border-cyan-400", "bg-cyan-950/20");
                    card.classList.add("border-gray-800", "bg-gray-900/60");
                    const ind = card.querySelector(".channel-indicator");
                    if (ind) {
                        ind.classList.remove("border-cyan-400");
                        ind.classList.add("border-gray-700");
                        ind.innerHTML = "";
                    }
                });

                const active = document.querySelector(`.channel-card[data-channel="${code}"]`);
                if (active) {
                    active.classList.remove("border-gray-800", "bg-gray-900/60");
                    active.classList.add("border-cyan-400", "bg-cyan-950/20");
                    const ind = active.querySelector(".channel-indicator");
                    if (ind) {
                        ind.classList.remove("border-gray-700");
                        ind.classList.add("border-cyan-400");
                        ind.innerHTML = '<div class="w-2 h-2 rounded-full bg-cyan-400"></div>';
                    }
                }
            };

            window.switchTab = (id) => {
                document
                    .querySelectorAll('button[id^="tab-"]')
                    .forEach((el) => {
                        el.classList.remove("active-tab");
                        el.classList.add("border-gray-800");
                    });
                document
                    .querySelectorAll(".payment-info")
                    .forEach((el) => el.classList.add("hidden"));

                document
                    .getElementById(`tab-${id}`)
                    .classList.add("active-tab");
                document
                    .getElementById(`tab-${id}`)
                    .classList.remove("border-gray-800");
                document
                    .getElementById(`info-${id}`)
                    .classList.remove("hidden");

                if (id === "global") {
                    selectChannel("credit_card");
                } else {
                    const activeChannelEl = document.querySelector("#channel-list .channel-card.border-cyan-400");
                    const selected = activeChannelEl ? activeChannelEl.getAttribute("data-channel") : "qris";
                    selectChannel(selected);
                }
            };

            // --- CYBER MODAL SYSTEM ---
            let modalCloseCallback = null;

            function showCyberModal(type, title, message, onModalClose = null) {
                const modal = document.getElementById("cyber-modal");
                const box = document.getElementById("modal-box");
                const icon = document.getElementById("modal-icon");
                const btn = document.getElementById("modal-btn");
                const sub = document.getElementById("modal-subtitle");

                modalCloseCallback = onModalClose;
                document.getElementById("modal-title").innerText = title;
                document.getElementById("modal-message").innerText = message;

                box.classList.remove("border-red-500", "border-green-500", "border-amber-500", "border-blue-500", "border-cyan-400");

                if (type === "success") {
                    box.classList.add("border-green-500");
                    icon.className = "i-lucide-check-circle text-green-500";
                    btn.className = "w-full bg-green-500 text-black font-black uppercase py-3 text-xs tracking-widest hover:bg-white transition";
                    btn.innerText = "MENGERTI";
                    if (sub) sub.innerText = "Transaction Approved";
                    orderSuccess = true;
                } else if (type === "crypto") {
                    box.classList.add("border-amber-500");
                    icon.className = "i-lucide-coins text-amber-400";
                    btn.className = "w-full bg-amber-400 text-black font-black uppercase py-3 text-xs tracking-widest hover:bg-white transition";
                    btn.innerText = "GUNAKAN VISA / MASTERCARD";
                    if (sub) sub.innerText = "Web3 Roadmap Notice";
                    orderSuccess = false;
                } else if (type === "info") {
                    box.classList.add("border-blue-500");
                    icon.className = "i-lucide-globe text-blue-400";
                    btn.className = "w-full bg-blue-500 text-white font-black uppercase py-3 text-xs tracking-widest hover:bg-white hover:text-black transition";
                    btn.innerText = "GUNAKAN VISA / MASTERCARD";
                    if (sub) sub.innerText = "Cross-Border Gateway Notice";
                    orderSuccess = false;
                } else {
                    box.classList.add("border-red-500");
                    icon.className = "i-lucide-alert-triangle text-red-500";
                    btn.className = "w-full bg-red-500 text-black font-black uppercase py-3 text-xs tracking-widest hover:bg-white transition";
                    btn.innerText = "MENGERTI";
                    if (sub) sub.innerText = "Transaction Status";
                    orderSuccess = false;
                }

                modal.classList.remove("hidden");
                modal.classList.add("flex");
            }

            let targetPaymentUrl = null;

            window.closeModal = () => {
                document.getElementById("cyber-modal").classList.add("hidden");
                document.getElementById("cyber-modal").classList.remove("flex");
                if (typeof modalCloseCallback === "function") {
                    const cb = modalCloseCallback;
                    modalCloseCallback = null;
                    cb();
                    return;
                }
                if (targetPaymentUrl) {
                    window.location.href = targetPaymentUrl;
                } else if (orderSuccess) {
                    window.location.href = "/";
                }
            };

            window.showCryptoModalNotice = () => {
                showCyberModal(
                    "crypto",
                    "CRYPTO GATEWAY (SEGERA HADIR)",
                    "Dukungan pembayaran Web3 Crypto (USDT & USDC) di jaringan TRC-20, Polygon, dan BEP-20 saat ini sedang dalam proses audit smart contract kami.\n\nUntuk pesanan Anda saat ini, silakan gunakan metode Visa / Mastercard / JCB yang telah aktif dan terhubung ke gateway Duitku.",
                    () => {
                        selectChannel("credit_card");
                    }
                );
            };

            // --- PROCESS ---
            window.processPayment = async () => {
                const emailEl = document.getElementById("buyer-email");
                const waEl = document.getElementById("buyer-wa");
                const discordEl = document.getElementById("buyer-discord");

                const emailVal = emailEl ? emailEl.value.trim().toLowerCase() : "";
                const waVal = waEl ? waEl.value.trim() : "-";
                const discordVal = discordEl ? discordEl.value.trim() : "-";

                // Validasi Email Wajib
                if (!emailVal || !emailVal.includes("@") || !emailVal.includes(".")) {
                    showCyberModal(
                        "error",
                        "EMAIL DIBUTUHKAN",
                        "Mohon masukkan alamat email yang valid agar detail akun game dan invoice pesanan dapat dikirimkan kepada Anda.",
                    );
                    if (emailEl) emailEl.focus();
                    return;
                }

                // Simpan email agar transaksi berikutnya otomatis terisi
                localStorage.setItem("yasui_buyer_email", emailVal);
                if (waVal && waVal !== "-") localStorage.setItem("yasui_buyer_wa", waVal);
                if (discordVal && discordVal !== "-") localStorage.setItem("yasui_buyer_discord", discordVal);

                const btn = document.getElementById("pay-btn");
                const loader = document.getElementById("loader");

                btn.disabled = true;
                loader.classList.remove("hidden");
                loader.classList.add("flex");

                try {
                    const response = await fetch("/api/create-order", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            cartItems: cartItems,
                            customerInfo: {
                                email: emailVal,
                                wa: waVal || "-",
                                discord: discordVal || "-",
                            },
                            paymentCategory: currentMethod,
                        }),
                    });

                    const result = await response.json();

                    if (result.success) {
                        // A. Bersihkan Keranjang (Hanya item yang dibeli)
                        const remainingCart = JSON.parse(
                            localStorage.getItem("yasui_cart") || "[]",
                        ).filter((item) => !item.selected);

                        localStorage.setItem(
                            "yasui_cart",
                            JSON.stringify(remainingCart),
                        );

                        // B. Simpan Sesi Login Otomatis 30 Hari & Riwayat Email
                        localStorage.setItem("yasui_buyer_email", emailVal);
                        if (result.session && result.session.token) {
                            localStorage.setItem("yasui_session", JSON.stringify({
                                email: result.session.email || emailVal,
                                name: result.session.name || emailVal.split("@")[0],
                                token: result.session.token,
                                expiresAt: result.session.expiresAt
                            }));
                        } else {
                            localStorage.setItem("yasui_session", JSON.stringify({
                                email: emailVal,
                                name: emailVal.split("@")[0],
                                expiresAt: Date.now() + (30 * 24 * 60 * 60 * 1000)
                            }));
                        }
                        try {
                            document.dispatchEvent(new Event("yasui-auth-changed"));
                        } catch (e) {}

                        targetPaymentUrl = result.paymentUrl;
                        // C. Redirect ke Halaman Pembayaran Headless Duitku
                        showCyberModal(
                            "success",
                            "PESANAN BERHASIL DIBUAT",
                            "Mengarahkan ke halaman instruksi pembayaran...",
                        );
                        setTimeout(() => {
                            window.location.href = result.paymentUrl;
                        }, 1200);
                    } else {
                        // C. Jika Gagal (Misal API Key salah atau Server Error)
                        console.error(result.error);
                        showCyberModal(
                            "error",
                            "FAILED",
                            getTranslation("checkout.failed_msg") +
                                result.error,
                        );
                        btn.disabled = false;
                        loader.classList.add("hidden");
                        loader.classList.remove("flex");
                    }
                } catch (error) {
                    console.error(error);
                    showCyberModal(
                        "error",
                        "ERROR",
                        getTranslation("checkout.error_msg"),
                    );
                    btn.disabled = false;
                    loader.classList.add("hidden");
                    loader.classList.remove("flex");
                }
            };
            initCheckout();
        </script>
    </body>
</html>
