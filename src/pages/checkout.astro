---
// src/pages/checkout.astro
import Layout from "../layouts/Layout.astro";
import { translations } from "../lib/translations";
---

<Layout title="Secure Checkout - Yasui Game" showFooter={false} noindex={true}>
    <div
        id="cyber-modal"
        class="fixed inset-0 z-[150] bg-black/80 backdrop-blur-sm hidden flex-col justify-center items-center p-4"
    >
        <div
            class="relative bg-[#11131A] border border-[#222634] w-full max-w-sm p-6 rounded-lg shadow-2xl modal-animate"
            id="modal-box"
        >
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-[#161922] rounded-md flex items-center justify-center border border-[#222634]">
                    <div id="modal-icon" class="text-xl"></div>
                </div>
                <div>
                    <h3 id="modal-title" class="text-[#F8FAFC] font-bold uppercase tracking-wider text-xs" data-i18n="checkout.modal_tx_status">
                        STATUS TRANSAKSI
                    </h3>
                    <p class="text-[10px] text-[#64748B] font-mono" id="modal-subtitle">
                        Gateway Verification
                    </p>
                </div>
            </div>

            <p id="modal-message" class="text-[#94A3B8] text-xs mb-6 leading-relaxed"></p>

            <button
                id="modal-btn"
                class="yg-btn-primary w-full py-2.5 text-xs font-mono font-semibold tracking-wider"
                data-i18n="checkout.btn_understand"
            >
                MENGERTI
            </button>
        </div>
    </div>

    <div
        id="loader"
        class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-md hidden flex-col items-center justify-center"
    >
        <div class="relative w-12 h-12 mb-4">
            <div class="absolute inset-0 border-2 border-[#222634] rounded-full"></div>
            <div class="absolute inset-0 border-2 border-t-[#00E5FF] rounded-full animate-spin"></div>
        </div>
        <h3 class="text-[#00E5FF] font-mono font-bold text-xs tracking-widest animate-pulse" data-i18n="checkout.connecting">
            CONNECTING TO GATEWAY...
        </h3>
        <p class="text-[11px] text-[#64748B] mt-1 font-mono" data-i18n="checkout.dont_close">
            Mohon jangan menutup jendela ini
        </p>
    </div>

    <header class="border-b border-[#222634] bg-[#090A0F]/90 backdrop-blur-md p-4 sticky top-0 z-50">
        <div class="max-w-3xl mx-auto flex items-center justify-between">
            <a href="/cart" class="flex items-center gap-1.5 text-xs font-semibold text-[#94A3B8] hover:text-[#F8FAFC] transition-colors">
                <div class="i-lucide-arrow-left text-sm"></div>
                <span data-i18n="checkout.back_to_cart">Kembali ke Keranjang</span>
            </a>
            <div class="flex items-center gap-2">
                <div class="i-lucide-shield-check text-[#00E5FF]"></div>
                <span class="text-xs font-mono font-bold tracking-wider text-[#F8FAFC]" data-i18n="checkout.title">SECURE CHECKOUT</span>
            </div>
        </div>
    </header>

    <main class="max-w-3xl mx-auto p-4 md:p-8">
        <section class="mb-8">
            <h2
                class="text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-4 border-b border-[#222634] pb-2 flex items-center justify-between"
            >
                <span data-i18n="checkout.order_items">1. Item Pesanan</span>
                <span class="text-[10px] text-[#64748B] font-mono font-normal" data-i18n="checkout.verify_details">Verifikasi Detail</span>
            </h2>
            <div id="order-items" class="space-y-2.5">
                <p class="text-center text-[#64748B] text-xs font-mono py-4" data-i18n="checkout.loading">
                    Memuat data pesanan...
                </p>
            </div>

            <!-- Tactical Promo & Creator Code Box -->
            <div class="mt-4 bg-[#11131A] border border-[#222634] rounded-lg p-3 sm:p-4">
                <div class="flex items-center justify-between mb-2">
                    <label class="text-[11px] font-bold text-[#F8FAFC] uppercase tracking-wider font-mono flex items-center gap-1.5">
                        <span class="i-lucide-ticket text-xs text-[#00E5FF]"></span>
                        <span data-i18n="checkout.promo_code_label">PROMO / CREATOR CODE</span>
                    </label>
                    <span class="text-[10px] text-[#64748B] font-mono" data-i18n="checkout.promo_code_hint">Kupon, Voucher, atau Referral</span>
                </div>
                
                <div class="flex items-center gap-2">
                    <div class="relative flex-1">
                        <input
                            type="text"
                            id="promo-code-input"
                            placeholder="KODE PROMO / REFERRAL"
                            data-i18n-placeholder="checkout.promo_placeholder"
                            class="yg-input font-mono uppercase text-xs tracking-wider"
                            autocomplete="off"
                        />
                    </div>
                    <button
                        type="button"
                        id="apply-promo-btn"
                        class="yg-btn-secondary px-4 py-2.5 text-xs font-mono font-bold tracking-wider shrink-0 flex items-center gap-1.5 cursor-pointer"
                        data-i18n="checkout.btn_apply_promo"
                    >
                        <span id="apply-promo-text">APPLY</span>
                    </button>
                </div>

                <div id="promo-status-msg" class="hidden text-[11px] font-mono mt-2.5 items-center justify-between p-2 rounded bg-[#0D0F17] border border-[#222634]">
                    <div class="flex items-center gap-2 truncate">
                        <span id="promo-status-icon" class="text-sm shrink-0"></span>
                        <span id="promo-status-text" class="truncate font-semibold"></span>
                    </div>
                    <button type="button" id="remove-promo-btn" title="Hapus Promo" class="hidden text-xs text-[#64748B] hover:text-red-400 font-mono ml-2 p-1 cursor-pointer">
                        ✕
                    </button>
                </div>
            </div>

            <div class="mt-4 bg-[#11131A] border border-[#222634] rounded-lg p-4 space-y-2 text-xs font-mono">
                <div class="flex justify-between items-center text-[#94A3B8]">
                    <span data-i18n="checkout.summary_subtotal">Subtotal Produk:</span>
                    <span class="font-mono tabular-nums text-[#F8FAFC]" id="subtotal-bill">Rp 0</span>
                </div>
                <div id="discount-row" class="hidden justify-between items-center text-emerald-400">
                    <span class="flex items-center gap-1">
                        <span data-i18n="checkout.summary_discount">Potongan Diskon</span>
                        <span id="discount-badge" class="text-[10px] bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-1.5 py-0.2 rounded font-mono"></span>:
                    </span>
                    <span class="font-mono tabular-nums font-semibold" id="discount-amount">-Rp 0</span>
                </div>
                <div class="flex justify-between items-center text-[#94A3B8]">
                    <span data-i18n="checkout.summary_fee">Biaya Layanan Gateway:</span>
                    <span class="text-emerald-400 font-semibold" data-i18n="checkout.summary_fee_free">Rp 0 (BEBAS BIAYA ADMIN)</span>
                </div>
                <div class="flex justify-between items-center pt-2 border-t border-[#222634]">
                    <span class="text-[#F8FAFC] font-semibold" data-i18n="checkout.total_bill">Total Tagihan:</span>
                    <span class="text-lg md:text-xl font-bold text-[#00E5FF] tabular-nums" id="total-bill">Rp 0</span>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h2 class="text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-4 border-b border-[#222634] pb-2 flex items-center justify-between">
                <span data-i18n="checkout.buyer_info">2. Data Penerima & Pengiriman</span>
                <span class="text-[10px] text-[#00E5FF] font-mono flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00E5FF] animate-pulse"></span> <span data-i18n="checkout.auto_sync_account">AUTO-SYNC AKUN</span>
                </span>
            </h2>

            <div class="space-y-4 bg-[#11131A] border border-[#222634] p-4 sm:p-5 rounded-lg">
                <div>
                    <label class="block text-xs font-semibold text-[#F8FAFC] uppercase tracking-wider mb-1.5">
                        <span data-i18n="checkout.email_label">Email Penerima</span> <span class="text-red-400">*</span>
                    </label>
                    <input
                        type="email"
                        id="buyer-email"
                        required
                        placeholder="nama@example.com"
                        data-i18n-placeholder="checkout.email_placeholder"
                        class="yg-input"
                    />
                    <p class="text-[11px] text-[#64748B] font-mono mt-1" data-i18n="checkout.buyer_note">
                        Kredensial akun game & invoice faktur otomatis dikirim dan ditautkan ke email ini.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-1.5">
                            <span data-i18n="checkout.wa_label">Nomor WhatsApp</span> <span class="text-[#64748B] font-normal font-mono" data-i18n="checkout.optional">(Opsional)</span>
                        </label>
                        <input
                            type="tel"
                            id="buyer-wa"
                            placeholder="08xxxxxxxxxx"
                            class="yg-input"
                        />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-1.5">
                            <span data-i18n="checkout.discord_label">Username Discord</span> <span class="text-[#64748B] font-normal font-mono" data-i18n="checkout.optional">(Opsional)</span>
                        </label>
                        <input
                            type="text"
                            id="buyer-discord"
                            placeholder="username#0000"
                            class="yg-input"
                        />
                    </div>
                </div>
            </div>
        </section>

        <section class="mb-8">
            <h2
                class="text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-4 border-b border-[#222634] pb-2 flex items-center justify-between"
                data-i18n="checkout.payment_method"
            >
                <span>3. Pilih Metode Pembayaran</span>
                <span class="text-[10px] text-[#64748B] font-mono">Duitku Direct API</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 mb-4">
                <button
                    type="button"
                    id="tab-qris"
                    class="active-tab border border-[#00E5FF] bg-[#00E5FF]/5 p-3 rounded-lg flex items-center justify-center gap-2 transition-colors cursor-pointer text-[#F8FAFC]"
                >
                    <div class="i-lucide-qr-code text-base text-[#00E5FF]"></div>
                    <span class="text-xs font-semibold uppercase tracking-wider" data-i18n="checkout.qris_title">Indonesia Payment</span>
                </button>
                <button
                    type="button"
                    id="tab-crypto"
                    class="border border-[#222634] bg-[#11131A] p-3 rounded-lg flex items-center justify-center gap-2 transition-colors hover:border-[#2E3446] cursor-pointer text-[#94A3B8]"
                >
                    <div class="i-lucide-coins text-base text-amber-400"></div>
                    <span class="text-xs font-semibold uppercase tracking-wider" data-i18n="checkout.crypto_tab">Crypto (0% Fee)</span>
                </button>
                <button
                    type="button"
                    id="tab-global"
                    class="border border-[#222634] bg-[#11131A] p-3 rounded-lg flex items-center justify-center gap-2 transition-colors hover:border-[#2E3446] cursor-pointer text-[#94A3B8]"
                >
                    <div class="i-lucide-credit-card text-base"></div>
                    <span class="text-xs font-semibold uppercase tracking-wider" data-i18n="checkout.global_title">Credit Card</span>
                </button>
            </div>

            <div class="bg-[#11131A] border border-[#222634] p-4 sm:p-5 rounded-lg text-left">
                <div id="info-qris" class="payment-info w-full space-y-4">
                    <div class="flex items-center justify-between pb-3 border-b border-[#222634]">
                        <div>
                            <p class="text-[#F8FAFC] font-semibold text-xs uppercase tracking-wider" data-i18n="checkout.domestic_title">
                                Pembayaran Domestik (QRIS, VA, E-Wallet)
                            </p>
                            <p class="text-[11px] text-[#64748B] font-mono mt-0.5" data-i18n="checkout.domestic_desc">
                                Verifikasi instan otomatis 24 jam terhubung langsung ke Duitku.
                            </p>
                        </div>
                        <span class="text-[10px] text-[#00E5FF] font-mono bg-[#00E5FF]/10 border border-[#00E5FF]/25 px-2 py-0.5 rounded" data-i18n="checkout.no_fee">
                            BEBAS BIAYA
                        </span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="channel-list">
                        <div
                            data-channel="qris"
                            class="channel-card active-channel border border-[#00E5FF] bg-[#00E5FF]/5 p-3.5 rounded-lg cursor-pointer transition-colors flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#0D0F15] flex items-center justify-center text-[#00E5FF] border border-[#00E5FF]/30">
                                    <div class="i-lucide-qr-code text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC] flex items-center gap-1.5">
                                        QRIS <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 px-1 py-0.2 rounded font-mono" data-i18n="checkout.recommended">REKOMENDASI</span>
                                    </div>
                                    <div class="text-[10px] text-[#94A3B8] font-mono" data-i18n="checkout.all_banks_ewallet">Semua Bank & E-Wallet</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#00E5FF] flex items-center justify-center">
                                <div class="w-2 h-2 rounded-full bg-[#00E5FF]"></div>
                            </div>
                        </div>

                        <div
                            data-channel="va_bca"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-blue-400 border border-[#222634]">
                                    <div class="i-lucide-landmark text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">BCA Virtual Account</div>
                                    <div class="text-[10px] text-[#64748B] font-mono" data-i18n="checkout.va_bca_desc">Transfer m-BCA / KlikBCA / ATM</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>

                        <div
                            data-channel="va_mandiri"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-amber-400 border border-[#222634]">
                                    <div class="i-lucide-landmark text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">Mandiri Virtual Account</div>
                                    <div class="text-[10px] text-[#64748B] font-mono" data-i18n="checkout.va_mandiri_desc">Livin' by Mandiri / ATM</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>

                        <div
                            data-channel="va_bri"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-blue-400 border border-[#222634]">
                                    <div class="i-lucide-landmark text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">BRI Virtual Account</div>
                                    <div class="text-[10px] text-[#64748B] font-mono" data-i18n="checkout.va_bri_desc">BRImo / ATM BRI</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>

                        <div
                            data-channel="va_bni"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-orange-400 border border-[#222634]">
                                    <div class="i-lucide-landmark text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">BNI Virtual Account</div>
                                    <div class="text-[10px] text-[#64748B] font-mono" data-i18n="checkout.va_bni_desc">BNI Mobile Banking / ATM</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>

                        <div
                            data-channel="ewallet_dana"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#2E3446] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded bg-[#11131A] flex items-center justify-center text-[#00E5FF] border border-[#222634]">
                                    <div class="i-lucide-wallet text-base"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">DANA E-Wallet</div>
                                    <div class="text-[10px] text-[#64748B] font-mono" data-i18n="checkout.ewallet_dana_desc">Aplikasi DANA</div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center"></div>
                        </div>
                    </div>
                </div>

                <div id="info-crypto" class="payment-info hidden w-full space-y-4 text-left">
                    <div class="flex items-center justify-between pb-3 border-b border-[#222634]">
                        <div>
                            <p class="text-[#F8FAFC] font-semibold text-xs uppercase tracking-wider" data-i18n="checkout.crypto_headline">
                                Crypto Instant (USDT / USDC — 0% Gateway Fee)
                            </p>
                            <p class="text-[11px] text-[#64748B] font-mono mt-0.5" data-i18n="checkout.crypto_headline_desc">
                                Web3 Non-Custodial Direct Gateway. Terverifikasi on-chain otomatis 24/7 tanpa risiko blokir pihak ketiga.
                            </p>
                        </div>
                        <span class="text-[10px] text-amber-400 font-mono bg-amber-500/10 border border-amber-500/25 px-2 py-0.5 rounded" data-i18n="checkout.crypto_tag">
                            0% FEE • ON-CHAIN
                        </span>
                    </div>

                    <div class="grid grid-cols-1 gap-2.5">
                        <div
                            data-channel="CRYPTO_USDT_BEP20"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#00E5FF] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded bg-[#11131A] flex items-center justify-center text-amber-400 border border-[#222634] flex-shrink-0">
                                    <div class="i-lucide-coins text-lg"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC] flex items-center gap-1.5 flex-wrap">
                                        <span data-i18n="checkout.crypto_bep20_title">USDT (BEP-20 / BNB Smart Chain)</span>
                                        <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 px-1 py-0.2 rounded font-mono" data-i18n="checkout.recommended">REKOMENDASI</span>
                                        <span class="text-[9px] bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/25 px-1 py-0.2 rounded font-mono">GAS FEE ~$0.01</span>
                                    </div>
                                    <div class="text-[10px] text-[#94A3B8] mt-1 font-mono" data-i18n="checkout.crypto_bep20_detail">
                                        Jaringan BNB Chain. Biaya transfer ultra-murah, konfirmasi cepat & stabil.
                                    </div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center flex-shrink-0"></div>
                        </div>

                        <div
                            data-channel="CRYPTO_USDC_POLYGON"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#00E5FF] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded bg-[#11131A] flex items-center justify-center text-purple-400 border border-[#222634] flex-shrink-0">
                                    <div class="i-lucide-zap text-lg"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC] flex items-center gap-1.5 flex-wrap">
                                        <span data-i18n="checkout.crypto_polygon_title">USDC / USDT (Polygon POS Network)</span>
                                        <span class="text-[9px] bg-purple-500/10 text-purple-400 border border-purple-500/25 px-1 py-0.2 rounded font-mono">INSTAN</span>
                                        <span class="text-[9px] bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/25 px-1 py-0.2 rounded font-mono">GAS FEE &lt; $0.01</span>
                                    </div>
                                    <div class="text-[10px] text-[#94A3B8] mt-1 font-mono" data-i18n="checkout.crypto_polygon_detail">
                                        Jaringan Polygon POS. Finalitas blok instan dalam 2-5 detik, mendukung USDC & USDT.
                                    </div>
                                </div>
                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center flex-shrink-0"></div>
                        </div>

                        <div
                            data-channel="CRYPTO_USDT_TRC20"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#00E5FF] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded bg-[#11131A] flex items-center justify-center text-red-400 border border-[#222634] flex-shrink-0">
                                    <div class="i-lucide-shield-check text-lg"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC] flex items-center gap-1.5 flex-wrap">
                                        <span data-i18n="checkout.crypto_trc20_title">USDT (TRC-20 / TRON Network)</span>
                                        <span class="text-[9px] bg-red-500/10 text-red-400 border border-red-500/25 px-1 py-0.2 rounded font-mono">POPULER</span>
                                        <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 px-1 py-0.2 rounded font-mono">EXCHANGE READY</span>
