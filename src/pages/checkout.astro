                            </div>
                            <div class="channel-indicator w-4 h-4 rounded-full border-2 border-[#222634] flex items-center justify-center flex-shrink-0"></div>
                        </div>
                    </div>
                </div>

                <div id="info-global" class="payment-info hidden w-full space-y-4 text-left">
                    <div class="flex items-center justify-between pb-3 border-b border-[#222634]">
                        <div>
                            <p class="text-[#F8FAFC] font-semibold text-xs uppercase tracking-wider" data-i18n="checkout.card_headline">
                                Pembayaran Internasional (Credit / Debit Card)
                            </p>
                            <p class="text-[11px] text-[#64748B] font-mono mt-0.5" data-i18n="checkout.card_headline_desc">
                                Kartu debit/kredit global dengan enkripsi 3D-Secure & PCI-DSS.
                            </p>
                        </div>
                        <span class="text-[10px] text-[#00E5FF] font-mono bg-[#00E5FF]/10 border border-[#00E5FF]/25 px-2 py-0.5 rounded" data-i18n="checkout.card_crossborder">
                            CROSS-BORDER
                        </span>
                    </div>

                    <div class="grid grid-cols-1 gap-2.5">
                        <div
                            data-channel="credit_card"
                            class="channel-card border border-[#222634] bg-[#0D0F15] p-3.5 rounded-lg cursor-pointer transition-colors hover:border-[#00E5FF] flex items-center justify-between"
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded bg-[#11131A] flex items-center justify-center text-[#00E5FF] border border-[#222634] flex-shrink-0">
                                    <div class="i-lucide-credit-card text-lg"></div>
                                </div>
                                <div>
                                    <div class="text-xs font-semibold text-[#F8FAFC] flex items-center gap-1.5 flex-wrap">
                                        <span>Visa / Mastercard / JCB</span>
                                        <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 px-1 py-0.2 rounded font-mono" data-i18n="checkout.card_active">AKTIF</span>
                                        <span class="text-[9px] bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/25 px-1 py-0.2 rounded font-mono">3D-SECURE OTP</span>
                                    </div>
                                    <div class="text-[10px] text-[#94A3B8] mt-1 font-mono" data-i18n="checkout.card_detail">
                                        Kartu internasional. Nilai transaksi dikonversi otomatis oleh bank penerbit.
                                    </div>
                                    <div class="flex items-center gap-2 mt-2 text-[10px] font-mono text-[#64748B]">
                                        <span class="text-blue-400 font-bold">VISA</span> • 
                                        <span class="text-red-400 font-bold">Mastercard</span> • 
                                        <span class="text-green-400 font-bold">JCB</span> • 
                                        <span class="text-[#00E5FF] font-bold">AMEX</span>
                                    </div>
                                </div>
