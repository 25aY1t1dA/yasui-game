        window.reorderItems = function(items) {
            if (!items || !items.length) return;
            try {
                const currentCart = JSON.parse(localStorage.getItem("yasui_cart") || "[]");
                items.forEach(item => {
                    const targetId = String(item.productId || item.id);
                    const existingIdx = currentCart.findIndex(c => String(c.id) === targetId);
                    if (existingIdx >= 0) {
                        currentCart[existingIdx].quantity = (currentCart[existingIdx].quantity || 1) + (item.quantity || 1);
                        currentCart[existingIdx].selected = true;
                    } else {
                        currentCart.push({
                            id: targetId,
                            name: item.name,
                            price: item.price,
                            rawPrice: item.price,
                            quantity: item.quantity || 1,
                            selected: true,
                            image: item.image ? { sourceUrl: item.image } : null
                        });
                    }
                });
                localStorage.setItem("yasui_cart", JSON.stringify(currentCart));
                window.location.href = "/checkout";
            } catch (e) {
                console.error("Reorder failed:", e);
                window.location.href = "/cart";
            }
        };

