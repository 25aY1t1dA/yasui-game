                        <div class="text-[11px] text-[#94A3B8]">
                            Potongan <b class="text-emerald-400">${formatMoney(data.voucher.discount_value || amount)}</b> · Gunakan kode ini langsung di halaman checkout!
                        </div>
                    `;
