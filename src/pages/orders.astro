        async function loadReferralDashboardData(force = false) {
            let session = null;
            try {
                session = typeof window.getSession === "function" ? window.getSession() : JSON.parse(localStorage.getItem("yasui_session") || "null");
            } catch (e) {}

            if (!session?.email || !session?.token) return;

            try {
                const res = await fetch(`/api/user/referral?action=get_dashboard&email=${encodeURIComponent(session.email)}`, {
                    headers: {
                        "Authorization": `Bearer ${session.token}`
                    }
                });
                const data = await res.json();
                if (data.success) {
                    referralDashboardData = data;
                    renderReferralUI(data);
                }
            } catch (err) {
                console.warn("[Referral Dashboard] Error loading referral data:", err);
            }
        }

        function renderReferralUI(data) {
            if (!data) return;
            const profile = data.profile || {};
            const stats = data.stats || {};
            const vouchers = data.vouchers || [];
            const conversions = data.conversions || [];

            // 1. Kartu Referral & Link
            const codeEl = document.getElementById("ref-display-code");
            if (codeEl) codeEl.innerText = profile.referralCode || "YASUI";

            const linkEl = document.getElementById("ref-display-link");
            const fullLink = `${window.location.origin}/categories?ref=${profile.referralCode || ''}`;
            if (linkEl) linkEl.innerText = fullLink;

            const tierEl = document.getElementById("ref-tier-badge");
            if (tierEl) {
                tierEl.innerText = profile.tier === "creator"
                    ? t("orders.ref_tier_creator", "CREATOR PARTNER")
                    : t("orders.ref_tier_member", "MEMBER AFILIASI");
            }

            const discPctEl = document.getElementById("ref-discount-pct");
            if (discPctEl) discPctEl.innerText = `${profile.discountPercent || 3}%`;

            const commPctEl = document.getElementById("ref-commission-pct");
            if (commPctEl) commPctEl.innerText = `${profile.commissionPercent || 5}%`;

            // 2. 4 Kartu Metrik
            const clicksEl = document.getElementById("metric-total-clicks");
            if (clicksEl) clicksEl.innerText = Number(stats.totalClicks || 0).toLocaleString();

            const ordersEl = document.getElementById("metric-successful-orders");
            if (ordersEl) ordersEl.innerText = Number(stats.successfulOrders || 0).toLocaleString();

            const pendingEl = document.getElementById("metric-pending-commission");
            if (pendingEl) pendingEl.innerText = formatMoney(stats.pendingBalanceIdr || 0);

            const availEl = document.getElementById("metric-available-balance");
            if (availEl) availEl.innerText = formatMoney(stats.availableBalanceIdr || 0);

            // 3. Vouchers
            const countVouchersEl = document.getElementById("count-vouchers");
            if (countVouchersEl) countVouchersEl.innerText = vouchers.length;

            const vEmptyState = document.getElementById("vouchers-empty-state");
            const vContainer = document.getElementById("vouchers-items-container");

            if (vContainer) {
                if (vouchers.length === 0) {
                    vContainer.innerHTML = "";
                    vEmptyState?.classList.remove("hidden");
                } else {
                    vEmptyState?.classList.add("hidden");
                    vContainer.innerHTML = vouchers.map(v => {
                        const isExpired = v.expiresAt && new Date(v.expiresAt).getTime() < Date.now();
                        const isExhausted = v.usedCount >= v.maxUses;
                        const canUse = v.isActive && !isExpired && !isExhausted;
                        const discFormatted = v.discountType === "percent"
                            ? `${v.discountValue}%`
                            : formatMoney(v.discountValue);

                        return `
                            <div class="flex flex-wrap items-center justify-between gap-3 bg-[#0D0F15] border border-[#222634] p-3.5 rounded-lg text-xs font-mono">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                                        <div class="i-lucide-ticket text-sm"></div>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-sm font-bold text-white tracking-wider">${v.code}</span>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${canUse ? 'bg-emerald-950/40 text-emerald-400 border border-emerald-500/40' : 'bg-[#11131A] text-[#64748B] border border-[#222634]'}">
                                                ${canUse ? 'AKTIF' : (isExpired ? 'KADALUARSA' : 'TERPAKAI')}
                                            </span>
                                        </div>
                                        <div class="text-[11px] text-[#94A3B8] mt-0.5">
                                            Diskon <span class="text-emerald-400 font-bold">${discFormatted}</span> · Terpakai: ${v.usedCount}/${v.maxUses}
                                        </div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        onclick="copyText('${v.code}', 'Kode Voucher')"
                                        class="px-2.5 py-1.5 rounded bg-[#11131A] hover:bg-[#1A1E29] border border-[#222634] text-[#00E5FF] hover:border-[#00E5FF]/40 text-xs transition flex items-center gap-1.5 cursor-pointer"
                                    >
                                        <div class="i-lucide-copy text-xs"></div>
                                        <span>Salin Voucher</span>
                                    </button>
                                </div>
                            </div>
                        `;
                    }).join("");
                }
            }

            // 4. Conversions
            const countConvEl = document.getElementById("count-conversions");
            if (countConvEl) countConvEl.innerText = conversions.length;

            const cEmptyState = document.getElementById("conversions-empty-state");
            const cTable = document.getElementById("conversions-table-container");
            const cTbody = document.getElementById("conversions-tbody");

            if (cTbody) {
                if (conversions.length === 0) {
                    cTbody.innerHTML = "";
                    cTable?.classList.add("hidden");
                    cEmptyState?.classList.remove("hidden");
                } else {
                    cEmptyState?.classList.add("hidden");
                    cTable?.classList.remove("hidden");
                    cTbody.innerHTML = conversions.map(c => {
                        let statusBadge = '';
                        if (c.status === "approved") {
                            statusBadge = `<span class="px-2 py-0.5 rounded bg-emerald-950/40 text-emerald-400 border border-emerald-500/40 text-[10px] font-bold">SELESAI</span>`;
                        } else if (c.status === "rejected") {
                            statusBadge = `<span class="px-2 py-0.5 rounded bg-red-950/40 text-red-400 border border-red-500/40 text-[10px] font-bold">DITOLAK</span>`;
                        } else {
                            statusBadge = `<span class="px-2 py-0.5 rounded bg-amber-950/40 text-amber-400 border border-amber-500/40 text-[10px] font-bold">TERTUNDA</span>`;
                        }

                        return `
                            <tr class="hover:bg-[#0D0F15]/60 transition">
                                <td class="py-2.5 px-3 text-[#94A3B8] whitespace-nowrap">${formatDate(c.createdAt)}</td>
                                <td class="py-2.5 px-3 text-[#00E5FF] font-bold whitespace-nowrap">#${c.orderId}</td>
                                <td class="py-2.5 px-3 text-white truncate max-w-[120px]">${c.buyerMasked || 'Buyer'}</td>
                                <td class="py-2.5 px-3 text-white whitespace-nowrap">${formatMoney(c.orderTotalIdr)}</td>
                                <td class="py-2.5 px-3 text-emerald-400 font-bold whitespace-nowrap">+${formatMoney(c.commissionAmountIdr)}</td>
                                <td class="py-2.5 px-3 whitespace-nowrap">${statusBadge}</td>
                            </tr>
                        `;
                    }).join("");
                }
            }
        }

