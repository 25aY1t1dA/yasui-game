        window.handleConvertVoucher = async () => {
            const input = document.getElementById("convert-voucher-amount");
            const btn = document.getElementById("btn-convert-voucher");
            const resultBox = document.getElementById("convert-voucher-result");
            const amount = Number(input?.value) || 0;

            if (amount < 5000) {
                if (resultBox) {
                    resultBox.className = "mb-4 p-3 rounded-lg text-xs font-mono border bg-amber-950/40 border-amber-500/40 text-amber-400 block";
                    resultBox.innerText = "Nominal konversi minimal adalah Rp 5.000.";
                }
                return;
            }

            let session = null;
            try {
                session = typeof window.getSession === "function" ? window.getSession() : JSON.parse(localStorage.getItem("yasui_session") || "null");
            } catch (e) {}

            if (!session?.email || !session?.token) {
                showToast("Sesi tidak ditemukan. Silakan login kembali.");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<div class="i-lucide-loader-2 text-xs animate-spin"></div> <span>Memproses...</span>`;

            try {
                const res = await fetch("/api/user/referral", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${session.token}`
                    },
                    body: JSON.stringify({
                        action: "convert_to_voucher",
                        email: session.email,
                        token: session.token,
                        amount: amount
                    })
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.error || "Gagal mengonversi saldo menjadi voucher.");
                }

                if (resultBox) {
                    resultBox.className = "mb-4 p-3.5 rounded-lg text-xs font-mono border bg-emerald-950/40 border-emerald-500/40 text-emerald-300 block space-y-2";
                    resultBox.innerHTML = `
                        <div class="flex items-center justify-between">
                            <span class="font-bold flex items-center gap-1.5 text-emerald-400">
                                <div class="i-lucide-check-circle text-sm"></div> ${t("orders.ref_convert_success", "Voucher berhasil diterbitkan!")}
                            </span>
                            <button
                                type="button"
                                onclick="copyText('${data.voucher.code}', 'Kode Voucher')"
                                class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 text-[10px] font-bold cursor-pointer"
                            >
                                Salin
                            </button>
                        </div>
                        <div class="text-sm font-bold text-white tracking-wider bg-[#0D0F15] p-2 rounded border border-[#222634] text-center">
                            ${data.voucher.code}
