            }
        };

        function checkAndLoadAuth() {
            let session = null;
            try {
                if (typeof window.getSession === "function") {
                    session = window.getSession();
                } else {
                    const raw = localStorage.getItem("yasui_session");
                    if (raw) session = JSON.parse(raw);
                }
            } catch(e) {}

            // Hanya otomatis muat data jika terdapat sesi token yang valid dan belum kedaluwarsa
            if (session && session.email && session.token && (!session.expiresAt || session.expiresAt > Date.now())) {
                fetchUserOrders(session.email, session.token);
            } else {
                // Selaraskan Navbar agar tidak tertinggal dalam status login palsu
                if (typeof window.updateNavbarAuthUI === "function") {
                    window.updateNavbarAuthUI();
                } else if (typeof window.updateNavAuthUI === "function") {
                    window.updateNavAuthUI();
                }

                const savedEmail = localStorage.getItem("yasui_buyer_email") || (session?.email || "");
                const emailInput = document.getElementById("orders-login-email");
                if (emailInput && savedEmail && !emailInput.value) {
                    emailInput.value = savedEmail;
                }

                document.getElementById("dashboard-content").classList.add("hidden");
                document.getElementById("user-profile-badge").classList.add("hidden");
                document.getElementById("user-profile-badge").classList.remove("flex");
                document.getElementById("auth-box").classList.remove("hidden");
            }
        }

        // AUTO-DETECT SAAT HALAMAN DIBUKA & SAAT STATUS LOGIN BERUBAH
        document.addEventListener("DOMContentLoaded", checkAndLoadAuth);
        window.addEventListener("yasui:auth-changed", checkAndLoadAuth);
        document.addEventListener("yasui:auth-changed", checkAndLoadAuth);
        document.addEventListener("yasui-auth-changed", checkAndLoadAuth);
        window.addEventListener("yasui-currency-change", () => {
            if (allOrdersData && allOrdersData.length > 0) renderOrders();
            if (referralDashboardData) renderReferralUI(referralDashboardData);
        });
        window.addEventListener("yasui-lang-change", () => {
            if (typeof window.applyTranslations === "function") {
                window.applyTranslations(document);
            }
            if (allOrdersData && allOrdersData.length > 0) renderOrders();
            if (referralDashboardData) renderReferralUI(referralDashboardData);
        });
    </script>

    <div id="sw-modal-overlay" class="hidden fixed inset-0 z-[90] bg-black/80 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="min-h-full flex items-center justify-center py-10">
            <div id="sw-modal" class="relative w-full max-w-md bg-[#11131A] border border-[#222634] rounded-lg shadow-2xl overflow-hidden">
                <div class="flex items-center justify-between px-5 py-4 border-b border-[#222634] bg-[#0D0F15]">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-purple-950/40 border border-purple-500/40 flex items-center justify-center text-purple-400">
                            <div class="i-lucide-user-cog text-sm"></div>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono" data-i18n="sw.modal_title">Set Account Hive ID</h3>
                            <p class="text-[10px] text-[#64748B] font-mono">Order <span id="sw-order-number" class="text-[#00E5FF]">#-</span> · Summoners War</p>
                        </div>
                    </div>
                    <button onclick="closeSwModal()" class="p-1.5 text-[#94A3B8] hover:text-white hover:bg-[#1A1E29] rounded-lg transition" aria-label="Tutup">
                        <div class="i-lucide-x text-base"></div>
                    </button>
                </div>

                <form id="sw-set-form" class="p-5 space-y-4" novalidate>
                    <div id="sw-alert" class="hidden p-3 rounded-lg text-xs font-mono border"></div>

                    <p class="text-[11px] text-[#94A3B8] leading-relaxed bg-[#0D0F15] border border-[#222634] rounded-lg p-3">
                        <span class="i-lucide-info inline-block align-[-2px] mr-1 text-[#00E5FF]"></span>
                        <span data-i18n="sw.info_notice">Masukkan 3 opsi username Hive (Opsi 1 wajib; opsi berikutnya dicoba otomatis jika ditolak) dan 1 password. Akun Anda sudah diamankan — tidak perlu terburu-buru.</span>
                    </p>

                    <div>
                        <label class="block text-[10px] font-bold text-[#F8FAFC] uppercase tracking-wider mb-1.5 font-mono">
                            <span data-i18n="sw.u1_label">Username Hive — Opsi 1</span> <span class="text-red-400">*</span>
                        </label>
                        <input type="text" id="sw-u1" required autocomplete="off" placeholder="mis. yasuiplayer01"
                            class="sw-u-input yg-input" />
                        <p class="sw-hint text-[10px] mt-1 text-[#64748B] font-mono hidden"></p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-[#94A3B8] uppercase tracking-wider mb-1.5 font-mono" data-i18n="sw.u2_label">Opsi 2 (cadangan)</label>
                            <input type="text" id="sw-u2" autocomplete="off" placeholder="opsional" data-i18n-placeholder="sw.optional"
                                class="sw-u-input yg-input" />
                            <p class="sw-hint text-[10px] mt-1 text-[#64748B] font-mono hidden"></p>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-[#94A3B8] uppercase tracking-wider mb-1.5 font-mono" data-i18n="sw.u3_label">Opsi 3 (cadangan)</label>
                            <input type="text" id="sw-u3" autocomplete="off" placeholder="opsional" data-i18n-placeholder="sw.optional"
                                class="sw-u-input yg-input" />
                            <p class="sw-hint text-[10px] mt-1 text-[#64748B] font-mono hidden"></p>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-[#F8FAFC] uppercase tracking-wider mb-1.5 font-mono">
                            <span data-i18n="sw.pass_label">Password Hive</span> <span class="text-red-400">*</span>
                        </label>
                        <div class="relative">
                            <input type="password" id="sw-pass" required autocomplete="new-password" placeholder="min 9 karakter, ada angka & simbol" data-i18n-placeholder="sw.pass_placeholder"
                                class="yg-input pr-10" />
                            <button type="button" id="sw-pass-toggle" class="absolute right-3 top-1/2 -translate-y-1/2 text-[#64748B] hover:text-[#00E5FF] transition" aria-label="Tampilkan password">
                                <div class="i-lucide-eye text-sm"></div>
                            </button>
                        </div>
                        <p id="sw-pass-hint" class="text-[10px] mt-1 text-[#64748B] font-mono hidden"></p>
                    </div>

                    <div class="text-[10px] text-[#64748B] leading-relaxed border-t border-[#222634] pt-3" data-i18n="sw.check_hint">
                        <b class="text-[#94A3B8]">Cek ketersediaan username:</b> gunakan fitur <i>Forgot Password</i> di dalam game — jika muncul "ID tidak ditemukan", berarti username bisa dipakai.
                    </div>

                    <button type="submit" id="sw-submit" disabled
                        class="yg-btn-primary w-full text-xs py-3 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                        <div class="i-lucide-send text-xs"></div>
                        <span data-i18n="sw.submit_btn">Kirim & Mulai Set Akun</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        /* ====== SW SET ACCOUNT: modal, validasi real-time, submit & polling ====== */
        const SW_U_RE = /^[A-Za-z0-9\-_.]{6,12}$/;
        const SW_P_RE = /^(?=.*[0-9])(?=.*[^A-Za-z0-9]).{9,}$/;
        let swOrderId = null;

        window.openSwSetAccount = function(orderId, status) {
            openSwModal(orderId, status);
        };

        function openSwModal(orderId, status) {
            if (status === "processing" || status === "completed") return;
            swOrderId = orderId;
            document.getElementById("sw-order-number").textContent = "#" + orderId;
            document.getElementById("sw-modal-overlay").classList.remove("hidden");
            document.body.style.overflow = "hidden";
        }
        function closeSwModal() {
            document.getElementById("sw-modal-overlay").classList.add("hidden");
            document.body.style.overflow = "";
        }
        document.getElementById("sw-modal-overlay")?.addEventListener("click", (e) => {
            if (e.target.id === "sw-modal-overlay") closeSwModal();
        });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeSwModal(); });

        // show/hide password
        document.getElementById("sw-pass-toggle")?.addEventListener("click", function () {
            const input = document.getElementById("sw-pass");
            const show = input.type === "password";
            input.type = show ? "text" : "password";
            this.innerHTML = `<div class="i-lucide-${show ? "eye-off" : "eye"} text-sm"></div>`;
        });

        function swValidateUsername(el) {
            const v = el.value.trim();
            const hint = el.parentElement.querySelector(".sw-hint");
            let ok = true, msg = "";
            if (v) {
                ok = SW_U_RE.test(v);
                msg = ok ? "✓ format valid" : "✗ 6–12 karakter; huruf/angka serta - _ .";
            } else if (el.id === "sw-u1") {
                ok = false; msg = "";
            }
            el.classList.toggle("border-red-500", v && !ok);
            el.classList.toggle("border-emerald-500", ok && !!v);
            if (hint) { hint.textContent = msg; hint.classList.toggle("hidden", !msg); }
            hint && hint.classList.toggle("text-emerald-400", ok && !!v);
            hint && hint.classList.toggle("text-red-400", v && !ok);
            swUpdateSubmit();
        }
        function swValidatePassword(el) {
            const v = el.value;
            const hint = document.getElementById("sw-pass-hint");
            const ok = SW_P_RE.test(v);
            el.classList.toggle("border-red-500", v && !ok);
            el.classList.toggle("border-emerald-500", ok);
            if (hint) {
                hint.textContent = v ? (ok ? "✓ password valid" : "✗ min 9 karakter, wajib ada angka & simbol") : "";
                hint.classList.toggle("hidden", !v);
                hint.classList.toggle("text-emerald-400", ok);
                hint.classList.toggle("text-red-400", v && !ok);
            }
            swUpdateSubmit();
        }
        function swUpdateSubmit() {
            const u1 = document.getElementById("sw-u1").value.trim();
            const pass = document.getElementById("sw-pass").value;
            document.getElementById("sw-submit").disabled = !(SW_U_RE.test(u1) && SW_P_RE.test(pass));
        }
        document.querySelectorAll(".sw-u-input").forEach((el) => el.addEventListener("input", () => swValidateUsername(el)));
        document.getElementById("sw-pass")?.addEventListener("input", (e) => swValidatePassword(e.target));

        // submit
        document.getElementById("sw-set-form")?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const alertBox = document.getElementById("sw-alert");
            const btn = document.getElementById("sw-submit");
            const session = JSON.parse(localStorage.getItem("yasui_session") || "null");
            if (!session?.token || !session?.email) {
                swAlert("Sesi tidak ditemukan. Muat ulang & login ulang.", "error"); return;
            }
            const usernames = ["sw-u1", "sw-u2", "sw-u3"].map(id => document.getElementById(id).value.trim()).filter(Boolean);
            const password = document.getElementById("sw-pass").value;
            btn.disabled = true;
            btn.innerHTML = `<div class="i-lucide-loader-2 text-xs animate-spin"></div> Memulai…`;
            try {
                const res = await fetch("/api/sw/set-account", {
                    method: "POST",
                    headers: { "Content-Type": "application/json", "Authorization": `Bearer ${session.token}` },
                    body: JSON.stringify({ orderId: swOrderId, email: session.email, usernames, password })
                });
                const j = await res.json();
                if (!j.success) throw new Error(j.error || "Gagal memulai set akun.");
                swAlert(j.message || "Set akun dimulai. Status akan diperbarui di kartu pesanan.", "ok");
                setTimeout(() => { closeSwModal(); location.reload(); }, 1800);
            } catch (err) {
                swAlert(err.message, "error");
                btn.disabled = false;
                btn.innerHTML = `<div class="i-lucide-send text-xs"></div> Kirim & Mulai Set Akun`;
            }
        });
        function swAlert(msg, type) {
            const b = document.getElementById("sw-alert");
            b.textContent = msg;
            b.className = `p-3 rounded-lg text-xs font-mono border ${type === "error" ? "bg-red-950/30 border-red-800/60 text-red-400" : "bg-emerald-950/30 border-emerald-800/60 text-emerald-400"}`;
        }

        // polling status fulfillment utk kartu order aktif (jika ada yang processing)
        (function swPollStatus() {
            const session = JSON.parse(localStorage.getItem("yasui_session") || "null");
            if (!session?.token || !session?.email) return;
            const processing = (window.allOrdersData || []).filter(o => o.swFulfillStatus === "processing");
            if (!processing.length) return;
            const tick = async () => {
                let anyProcessing = false;
                for (const o of processing) {
                    try {
                        const res = await fetch(`/api/sw/set-account/status?orderId=${o.id}&email=${encodeURIComponent(session.email)}`, { headers: { "Authorization": `Bearer ${session.token}` } });
                        const j = await res.json();
                        if (j.success && j.fulfillment?.status === "completed") { location.reload(); return; }
                        if (j.success && j.fulfillment?.status === "processing") anyProcessing = true;
                    } catch {}
                }
                if (anyProcessing) setTimeout(tick, 15000);
            };
            setTimeout(tick, 15000);
        })();
    </script>
</Layout>
