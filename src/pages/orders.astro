---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Pesanan Saya & Dashboard Akun - Yasui Game"
    description="Lacak riwayat transaksi, status pembayaran, dan detail akun game yang telah Anda beli di Yasui Game."
    noindex={true}
>
    <main class="max-w-5xl mx-auto px-4 pt-4 md:pt-6 pb-32">
        <header class="mb-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#222634] pb-6">
                <div>
                    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[#00E5FF]/10 border border-[#00E5FF]/30 text-[#00E5FF] text-xs font-mono mb-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#00E5FF] animate-pulse"></span>
                        <span data-i18n="orders.terminal">TERMINAL PENGGUNA</span>
                    </div>
                    <h1 class="text-2xl md:text-3xl font-bold text-white tracking-tight uppercase" data-i18n="orders.heading">
                        Pesanan & Akun Saya
                    </h1>
                    <p class="text-[#94A3B8] text-xs md:text-sm mt-1" data-i18n="orders.subtitle">
                        Akses seluruh kredensial akun game, status invoice, dan riwayat pesanan Anda secara aman.
                    </p>
                </div>

                <div id="user-profile-badge" class="hidden items-center gap-3 bg-[#11131A] border border-[#222634] p-3 rounded-lg">
                    <div class="w-9 h-9 rounded-lg bg-[#00E5FF]/10 border border-[#00E5FF]/30 flex items-center justify-center text-[#00E5FF] font-bold text-xs font-mono" id="user-avatar">
                        U
                    </div>
                    <div class="text-left">
                        <div class="text-xs font-bold text-white truncate max-w-[180px]" id="user-display-email">user@email.com</div>
                        <div class="text-[10px] text-[#64748B] font-mono" id="user-orders-count">0 Pesanan</div>
                    </div>
                    <button
                        onclick="window.yasuiLogout ? window.yasuiLogout() : (window.logoutUser && window.logoutUser())"
                        title="Ganti Email / Keluar"
                        class="p-2 text-[#94A3B8] hover:text-red-400 hover:bg-[#0D0F15] rounded-lg transition cursor-pointer"
                    >
                        <div class="i-lucide-log-out text-sm"></div>
                    </button>
                </div>
            </div>
        </header>

        <div id="auth-box" class="bg-[#11131A] border border-[#222634] rounded-lg p-6 md:p-8 mb-8">
            <div class="max-w-md mx-auto text-center py-2">
                <div class="w-12 h-12 bg-[#00E5FF]/10 border border-[#00E5FF]/30 rounded-lg flex items-center justify-center text-[#00E5FF] text-xl mx-auto mb-3">
                    <div class="i-lucide-lock"></div>
                </div>
                <h2 class="text-lg md:text-xl font-bold text-white uppercase tracking-wider mb-2 font-mono" data-i18n="orders.login_title">
                    Masuk ke Akun Anda
                </h2>
                <p class="text-xs text-[#94A3B8] mb-6 leading-relaxed" data-i18n="orders.login_desc">
                    Untuk melindungi data akun game dan kredensial pesanan Anda, silakan masuk menggunakan email dan kata sandi Anda.
                </p>

                <div id="orders-auth-alert" class="hidden mb-4 p-3 rounded-lg text-xs font-mono border text-left"></div>

                <form onsubmit="handleOrdersPageLogin(event)" class="space-y-4 mb-5 text-left">
                    <div>
                        <label class="block text-[11px] font-bold text-[#F8FAFC] uppercase tracking-wider mb-1.5 font-mono">
                            <span data-i18n="orders.email_label">Email Pembelian</span> <span class="text-red-400">*</span>
                        </label>
                        <input
                            type="email"
                            id="orders-login-email"
                            required
                            placeholder="nama@email.com"
                            class="yg-input"
                        />
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="text-[11px] font-bold text-[#F8FAFC] uppercase tracking-wider font-mono">
                                <span data-i18n="orders.password_label">Kata Sandi</span> <span class="text-red-400">*</span>
                            </label>
                            <button
                                type="button"
                                onclick="window.openSetPasswordModal ? window.openSetPasswordModal() : null"
                                class="text-[10px] text-[#00E5FF] hover:underline font-mono"
                                data-i18n="orders.forgot_password"
                            >
                                Lupa / Buat Sandi?
                            </button>
                        </div>
                        <div class="relative">
                            <input
                                type="password"
                                id="orders-login-password"
                                required
                                placeholder="••••••••"
                                class="yg-input pr-10"
                            />
                            <button
                                type="button"
                                onclick="toggleOrdersPasswordVisibility('orders-login-password', this)"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-[#64748B] hover:text-white"
                            >
                                <div class="i-lucide-eye text-sm"></div>
                            </button>
                        </div>
                    </div>

                    <button
                        type="submit"
                        id="btn-orders-submit-login"
                        class="yg-btn-primary w-full py-3.5 flex items-center justify-center gap-2 cursor-pointer"
                    >
                        <span data-i18n="orders.login_btn">MASUK SEKARANG</span>
                        <div class="i-lucide-arrow-right text-xs"></div>
                    </button>
                </form>

                <p class="text-[11px] text-[#64748B] flex items-center justify-center gap-1.5 font-mono">
                    <span class="i-lucide-shield-check text-[#00E5FF]"></span>
                    <span data-i18n="orders.login_guarantee">Riwayat transaksi aman & kredensial akun terenkripsi</span>
                </p>
            </div>
        </div>

        <section id="dashboard-content" class="hidden">
            <!-- 2 MAIN TABS -->
            <div class="flex items-center gap-2 border-b border-[#222634] pb-4 mb-6">
                <button
                    type="button"
                    onclick="switchMainDashboardTab('orders')"
                    id="main-tab-orders"
                    class="main-nav-tab active-main-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-bold uppercase transition flex items-center gap-2 font-mono cursor-pointer"
                >
                    <div class="i-lucide-package text-sm"></div>
                    <span data-i18n="orders.main_tab_orders">📦 Riwayat Pesanan & Akun</span>
                </button>
                <button
                    type="button"
                    onclick="switchMainDashboardTab('referral')"
                    id="main-tab-referral"
                    class="main-nav-tab px-4 py-2.5 rounded-lg text-xs md:text-sm font-bold uppercase text-[#94A3B8] hover:text-white transition flex items-center gap-2 font-mono cursor-pointer"
                >
                    <div class="i-lucide-gem text-sm text-[#00E5FF]"></div>
                    <span data-i18n="orders.main_tab_referral">💎 Dashboard Referral & Afiliasi</span>
                </button>
            </div>

            <!-- VIEW 1: ORDERS & CREDENTIALS -->
            <div id="view-orders-tab" class="space-y-6">
                <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 scrollbar-none border-b border-[#222634]">
                    <button onclick="filterStatus('all')" id="tab-all" class="filter-tab active-filter-tab px-3.5 py-2 rounded-lg text-xs font-bold uppercase transition flex items-center gap-1.5 whitespace-nowrap font-mono cursor-pointer">
                        <span data-i18n="orders.tab_all">Semua Pesanan</span>
                        <span class="bg-[#0D0F15] border border-[#222634] text-[#94A3B8] text-[10px] px-1.5 py-0.5 rounded" id="count-all">0</span>
                    </button>
                    <button onclick="filterStatus('pending')" id="tab-pending" class="filter-tab px-3.5 py-2 rounded-lg text-xs font-bold uppercase text-[#94A3B8] hover:text-white transition flex items-center gap-1.5 whitespace-nowrap font-mono cursor-pointer">
                        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                        <span data-i18n="orders.tab_pending">Menunggu Bayar</span>
                        <span class="bg-[#0D0F15] border border-[#222634] text-[#94A3B8] text-[10px] px-1.5 py-0.5 rounded" id="count-pending">0</span>
                    </button>
                    <button onclick="filterStatus('processing')" id="tab-processing" class="filter-tab px-3.5 py-2 rounded-lg text-xs font-bold uppercase text-[#94A3B8] hover:text-white transition flex items-center gap-1.5 whitespace-nowrap font-mono cursor-pointer">
                        <span class="w-2 h-2 rounded-full bg-[#00E5FF]"></span>
                        <span data-i18n="orders.tab_processing">Diproses</span>
                        <span class="bg-[#0D0F15] border border-[#222634] text-[#94A3B8] text-[10px] px-1.5 py-0.5 rounded" id="count-processing">0</span>
                    </button>
                    <button onclick="filterStatus('completed')" id="tab-completed" class="filter-tab px-3.5 py-2 rounded-lg text-xs font-bold uppercase text-[#94A3B8] hover:text-white transition flex items-center gap-1.5 whitespace-nowrap font-mono cursor-pointer">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span data-i18n="orders.tab_completed">Selesai</span>
                        <span class="bg-[#0D0F15] border border-[#222634] text-[#94A3B8] text-[10px] px-1.5 py-0.5 rounded" id="count-completed">0</span>
                    </button>
                </div>

                <div id="orders-list" class="space-y-4"></div>

                <div id="orders-empty-state" class="hidden text-center py-16 bg-[#11131A] border border-[#222634] rounded-lg">
                    <div class="i-lucide-inbox text-4xl text-[#64748B] mx-auto mb-3"></div>
                    <h3 class="text-sm font-bold text-[#F8FAFC] uppercase font-mono" data-i18n="orders.empty_title">Tidak Ada Pesanan</h3>
                    <p class="text-xs text-[#94A3B8] mt-1 max-w-sm mx-auto" data-i18n="orders.empty_desc">
                        Tidak ada pesanan yang sesuai dengan filter ini.
                    </p>
                </div>
            </div>

            <!-- VIEW 2: REFERRAL, PROMO & PARTNER HUB -->
            <div id="view-referral-tab" class="hidden space-y-6">
                <!-- 1. KARTU KODE REFERRAL & LINK PRIBADI -->
                <div class="bg-[#11131A] border border-[#222634] rounded-lg p-5 md:p-6">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#222634] pb-5 mb-5">
                        <div class="space-y-1">
                            <div class="flex items-center gap-2">
                                <span id="ref-tier-badge" class="px-2 py-0.5 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/30 text-[10px] font-mono font-bold uppercase">
                                    MEMBER AFILIASI
                                </span>
                                <span class="inline-flex items-center gap-1 text-[10px] font-mono text-emerald-400">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> AKTIF
                                </span>
                            </div>
                            <h2 class="text-lg md:text-xl font-bold text-white uppercase tracking-wider font-mono">
                                <span data-i18n="orders.ref_your_code">Kode Referral Anda</span>
                            </h2>
                            <p class="text-xs text-[#94A3B8]">
                                Bagikan kode atau link referral Anda kepada teman untuk mendapatkan komisi dari setiap transaksi yang selesai.
                            </p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <div class="px-3 py-1.5 rounded-lg bg-[#0D0F15] border border-[#222634] text-xs font-mono">
                                <span class="text-[#94A3B8]" data-i18n="orders.ref_friends_discount">Diskon Teman:</span>
                                <span id="ref-discount-pct" class="text-emerald-400 font-bold ml-1">3%</span>
                            </div>
                            <div class="px-3 py-1.5 rounded-lg bg-[#0D0F15] border border-[#222634] text-xs font-mono">
                                <span class="text-[#94A3B8]" data-i18n="orders.ref_your_commission">Komisi Anda:</span>
                                <span id="ref-commission-pct" class="text-[#00E5FF] font-bold ml-1">5%</span>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Box Kode Unik -->
                        <div class="bg-[#0D0F15] border border-[#222634] rounded-lg p-4 flex flex-col justify-between">
                            <div class="text-[11px] font-bold text-[#94A3B8] uppercase font-mono mb-2" data-i18n="orders.ref_your_code">
                                Kode Referral
                            </div>
                            <div class="flex items-center justify-between gap-3 bg-[#11131A] border border-[#222634] px-4 py-3 rounded-lg">
                                <span id="ref-display-code" class="text-lg md:text-xl font-bold text-[#00E5FF] font-mono tracking-widest tabular-nums">
                                    MEMUAT...
                                </span>
                                <button
                                    type="button"
                                    id="btn-copy-code"
                                    onclick="copyReferralCode()"
                                    class="px-3 py-1.5 rounded bg-[#00E5FF]/10 text-[#00E5FF] hover:bg-[#00E5FF]/20 border border-[#00E5FF]/30 text-xs font-mono font-bold uppercase transition flex items-center gap-1.5 cursor-pointer"
                                >
                                    <div class="i-lucide-copy text-xs"></div>
                                    <span data-i18n="orders.ref_copy_code">Salin Kode</span>
                                </button>
                            </div>
                        </div>

                        <!-- Box Link Afiliasi -->
                        <div class="bg-[#0D0F15] border border-[#222634] rounded-lg p-4 flex flex-col justify-between">
                            <div class="text-[11px] font-bold text-[#94A3B8] uppercase font-mono mb-2">
                                Link Afiliasi Langsung
                            </div>
                            <div class="flex items-center justify-between gap-3 bg-[#11131A] border border-[#222634] px-3.5 py-3 rounded-lg">
                                <span id="ref-display-link" class="text-xs text-[#F8FAFC] font-mono truncate max-w-[200px] md:max-w-[260px]">
                                    https://...
                                </span>
                                <button
                                    type="button"
                                    id="btn-copy-link"
                                    onclick="copyReferralLink()"
                                    class="px-3 py-1.5 rounded bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 border border-emerald-500/30 text-xs font-mono font-bold uppercase transition flex items-center gap-1.5 cursor-pointer whitespace-nowrap"
                                >
                                    <div class="i-lucide-share-2 text-xs"></div>
                                    <span data-i18n="orders.ref_copy_link">Salin Link</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. 4 KARTU METRIK -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
                    <!-- Metric 1: Total Klik -->
                    <div class="bg-[#11131A] border border-[#222634] rounded-lg p-4 font-mono">
                        <div class="flex items-center justify-between text-[#94A3B8] text-xs mb-2">
                            <span data-i18n="orders.ref_metric_clicks">Total Klik</span>
                            <div class="i-lucide-mouse-pointer-click text-sm text-[#00E5FF]"></div>
                        </div>
                        <div id="metric-total-clicks" class="text-xl md:text-2xl font-bold text-white tabular-nums">0</div>
                        <div class="text-[10px] text-[#64748B] mt-1">Kunjungan link referral</div>
                    </div>

                    <!-- Metric 2: Pesanan Sukses -->
                    <div class="bg-[#11131A] border border-[#222634] rounded-lg p-4 font-mono">
                        <div class="flex items-center justify-between text-[#94A3B8] text-xs mb-2">
                            <span data-i18n="orders.ref_metric_orders">Pesanan Sukses</span>
                            <div class="i-lucide-shopping-bag text-sm text-emerald-400"></div>
                        </div>
                        <div id="metric-successful-orders" class="text-xl md:text-2xl font-bold text-emerald-400 tabular-nums">0</div>
                        <div class="text-[10px] text-[#64748B] mt-1">Transaksi terverifikasi</div>
                    </div>

                    <!-- Metric 3: Komisi Tertunda -->
                    <div class="bg-[#11131A] border border-[#222634] rounded-lg p-4 font-mono">
                        <div class="flex items-center justify-between text-[#94A3B8] text-xs mb-2">
                            <span data-i18n="orders.ref_metric_pending">Komisi Tertunda</span>
                            <div class="i-lucide-clock text-sm text-amber-400"></div>
                        </div>
                        <div id="metric-pending-commission" class="text-base md:text-lg font-bold text-amber-400 tabular-nums">Rp 0</div>
                        <div class="text-[10px] text-[#64748B] mt-1">Menunggu bayar / kliring</div>
                    </div>

                    <!-- Metric 4: Saldo Tersedia -->
                    <div class="bg-[#11131A] border border-[#00E5FF]/30 rounded-lg p-4 font-mono bg-[#00E5FF]/5">
                        <div class="flex items-center justify-between text-[#00E5FF] text-xs mb-2">
                            <span data-i18n="orders.ref_metric_available">Saldo Tersedia</span>
                            <div class="i-lucide-wallet text-sm text-[#00E5FF]"></div>
                        </div>
                        <div id="metric-available-balance" class="text-base md:text-lg font-bold text-[#00E5FF] tabular-nums">Rp 0</div>
                        <div class="text-[10px] text-emerald-400 mt-1">Siap dicairkan / ditukar</div>
                    </div>
                </div>

                <!-- 3. DUA BENTO AKSI: CONVERT TO VOUCHER & REQUEST PAYOUT -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Bento A: Convert to Voucher -->
                    <div class="bg-[#11131A] border border-[#222634] rounded-lg p-5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-2 mb-1.5">
                                <div class="w-7 h-7 rounded bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-sm">
                                    <div class="i-lucide-ticket"></div>
                                </div>
                                <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono" data-i18n="orders.ref_convert_title">
                                    Tukar Saldo Jadi Voucher
                                </h3>
                            </div>
                            <p class="text-xs text-[#94A3B8] mb-4" data-i18n="orders.ref_convert_desc">
                                Tukar saldo komisi menjadi voucher belanja toko instan (Min Rp 5.000).
                            </p>

                            <div id="convert-voucher-result" class="hidden mb-4 p-3 rounded-lg text-xs font-mono border"></div>

                            <div class="space-y-3">
                                <div>
                                    <label class="block text-[10px] font-bold text-[#94A3B8] uppercase font-mono mb-1" data-i18n="orders.ref_convert_amount">
                                        Nominal Tukar (IDR)
                                    </label>
                                    <input
                                        type="number"
                                        id="convert-voucher-amount"
                                        min="5000"
                                        step="1000"
                                        placeholder="5000"
                                        class="yg-input font-mono tabular-nums"
                                    />
                                </div>
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <button type="button" onclick="setConvertAmount(5000)" class="px-2 py-1 rounded bg-[#0D0F15] border border-[#222634] text-[10px] font-mono text-[#94A3B8] hover:text-[#00E5FF] hover:border-[#00E5FF]/40 transition cursor-pointer">Rp 5.000</button>
                                    <button type="button" onclick="setConvertAmount(10000)" class="px-2 py-1 rounded bg-[#0D0F15] border border-[#222634] text-[10px] font-mono text-[#94A3B8] hover:text-[#00E5FF] hover:border-[#00E5FF]/40 transition cursor-pointer">Rp 10.000</button>
                                    <button type="button" onclick="setConvertAmount(25000)" class="px-2 py-1 rounded bg-[#0D0F15] border border-[#222634] text-[10px] font-mono text-[#94A3B8] hover:text-[#00E5FF] hover:border-[#00E5FF]/40 transition cursor-pointer">Rp 25.000</button>
                                    <button type="button" onclick="setConvertAmount(50000)" class="px-2 py-1 rounded bg-[#0D0F15] border border-[#222634] text-[10px] font-mono text-[#94A3B8] hover:text-[#00E5FF] hover:border-[#00E5FF]/40 transition cursor-pointer">Rp 50.000</button>
                                    <button type="button" onclick="setConvertAmountMax()" class="px-2 py-1 rounded bg-[#00E5FF]/10 border border-[#00E5FF]/30 text-[10px] font-mono text-[#00E5FF] hover:bg-[#00E5FF]/20 transition cursor-pointer">Semua Saldo</button>
                                </div>
                            </div>
                        </div>

                        <button
                            type="button"
                            id="btn-convert-voucher"
                            onclick="handleConvertVoucher()"
                            class="yg-btn-primary w-full py-2.5 mt-4 text-xs font-mono flex items-center justify-center gap-1.5 cursor-pointer"
                        >
                            <div class="i-lucide-zap text-xs"></div>
                            <span data-i18n="orders.ref_convert_btn">Tukar Jadi Voucher</span>
                        </button>
                    </div>

                    <!-- Bento B: Request Payout -->
                    <div class="bg-[#11131A] border border-[#222634] rounded-lg p-5 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-2 mb-1.5">
                                <div class="w-7 h-7 rounded bg-[#00E5FF]/10 border border-[#00E5FF]/30 flex items-center justify-center text-[#00E5FF] text-sm">
                                    <div class="i-lucide-arrow-up-right"></div>
                                </div>
                                <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono" data-i18n="orders.ref_payout_title">
                                    Pencairan Saldo (Payout)
                                </h3>
                            </div>
                            <p class="text-xs text-[#94A3B8] mb-4" data-i18n="orders.ref_payout_desc">
                                Tarik saldo ke USDT (Crypto) atau E-Wallet / Bank (Min Rp 50.000).
                            </p>

                            <div id="payout-result" class="hidden mb-4 p-3 rounded-lg text-xs font-mono border"></div>

                            <form id="payout-form" onsubmit="handleRequestPayout(event)" class="space-y-3">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <div>
                                        <label class="block text-[10px] font-bold text-[#94A3B8] uppercase font-mono mb-1" data-i18n="orders.ref_payout_channel">
                                            Metode Pencairan
                                        </label>
                                        <select id="payout-method" class="yg-input text-xs font-mono">
                                            <option value="USDT">USDT (BEP-20 / TRC-20)</option>
                                            <option value="DANA">DANA (E-Wallet)</option>
                                            <option value="GOPAY">GoPay (E-Wallet)</option>
                                            <option value="OVO">OVO (E-Wallet)</option>
                                            <option value="BANK_TRANSFER">Transfer Bank (BCA/Mandiri/BRI)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold text-[#94A3B8] uppercase font-mono mb-1" data-i18n="orders.ref_payout_amount">
                                            Nominal (IDR)
                                        </label>
                                        <input
                                            type="number"
                                            id="payout-amount"
                                            min="50000"
                                            step="5000"
                                            placeholder="50000"
                                            required
                                            class="yg-input font-mono tabular-nums text-xs"
                                        />
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <div>
                                        <label class="block text-[10px] font-bold text-[#94A3B8] uppercase font-mono mb-1" data-i18n="orders.ref_payout_account">
                                            No. Rek / Address
                                        </label>
                                        <input
                                            type="text"
                                            id="payout-account"
                                            placeholder="08123... / 0x..."
                                            required
                                            class="yg-input font-mono text-xs"
                                        />
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold text-[#94A3B8] uppercase font-mono mb-1" data-i18n="orders.ref_payout_holder">
                                            Nama Pemilik Rekening
                                        </label>
                                        <input
                                            type="text"
                                            id="payout-holder"
                                            placeholder="Nama Lengkap"
                                            required
                                            class="yg-input text-xs"
                                        />
                                    </div>
                                </div>

                                <button
                                    type="submit"
                                    id="btn-submit-payout"
                                    class="yg-btn-secondary w-full py-2.5 mt-2 text-xs font-mono flex items-center justify-center gap-1.5 cursor-pointer"
                                >
                                    <div class="i-lucide-send text-xs"></div>
                                    <span data-i18n="orders.ref_payout_btn">Ajukan Pencairan</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 4. SUB-TABS: RIWAYAT VOUCHER & RIWAYAT REFERRAL -->
                <div class="bg-[#11131A] border border-[#222634] rounded-lg p-5">
                    <div class="flex items-center gap-2 border-b border-[#222634] pb-3 mb-5 overflow-x-auto scrollbar-none font-mono">
                        <button
                            type="button"
                            id="subtab-btn-vouchers"
                            onclick="switchReferralSubTab('vouchers')"
                            class="px-3.5 py-1.5 rounded-lg text-xs font-bold uppercase transition flex items-center gap-1.5 whitespace-nowrap active-sub-tab cursor-pointer"
                        >
                            <span data-i18n="orders.ref_vouchers_title">Voucher Belanja Aktif</span>
                            <span id="count-vouchers" class="bg-[#0D0F15] border border-[#222634] text-[#94A3B8] text-[10px] px-1.5 py-0.5 rounded">0</span>
                        </button>
                        <button
                            type="button"
                            id="subtab-btn-conversions"
                            onclick="switchReferralSubTab('conversions')"
                            class="px-3.5 py-1.5 rounded-lg text-xs font-bold uppercase text-[#94A3B8] hover:text-white transition flex items-center gap-1.5 whitespace-nowrap cursor-pointer"
                        >
                            <span data-i18n="orders.ref_conversions_title">Riwayat Referral</span>
                            <span id="count-conversions" class="bg-[#0D0F15] border border-[#222634] text-[#94A3B8] text-[10px] px-1.5 py-0.5 rounded">0</span>
                        </button>
                    </div>

                    <!-- Panel Vouchers -->
                    <div id="panel-vouchers-list" class="space-y-3">
                        <div id="vouchers-empty-state" class="text-center py-10 bg-[#0D0F15] border border-[#222634] rounded-lg">
                            <div class="i-lucide-ticket text-3xl text-[#64748B] mx-auto mb-2"></div>
                            <p class="text-xs text-[#94A3B8] max-w-sm mx-auto" data-i18n="orders.ref_vouchers_empty">
                                Belum ada voucher aktif. Tukarkan saldo komisi Anda di atas!
                            </p>
                        </div>
                        <div id="vouchers-items-container" class="space-y-2.5"></div>
                    </div>

                    <!-- Panel Conversions -->
                    <div id="panel-conversions-list" class="hidden space-y-3">
                        <div id="conversions-empty-state" class="text-center py-10 bg-[#0D0F15] border border-[#222634] rounded-lg">
                            <div class="i-lucide-users text-3xl text-[#64748B] mx-auto mb-2"></div>
                            <p class="text-xs text-[#94A3B8] max-w-sm mx-auto" data-i18n="orders.ref_conversions_empty">
                                Belum ada riwayat referral. Bagikan kode atau link Anda ke teman!
                            </p>
                        </div>
                        <div id="conversions-table-container" class="hidden overflow-x-auto">
                            <table class="w-full text-left text-xs font-mono">
                                <thead>
                                    <tr class="text-[10px] text-[#64748B] uppercase border-b border-[#222634]">
                                        <th class="py-2.5 px-3" data-i18n="orders.ref_table_date">Tanggal</th>
                                        <th class="py-2.5 px-3" data-i18n="orders.ref_table_order">ID Pesanan</th>
                                        <th class="py-2.5 px-3" data-i18n="orders.ref_table_buyer">Pembeli</th>
                                        <th class="py-2.5 px-3" data-i18n="orders.ref_table_total">Total Belanja</th>
                                        <th class="py-2.5 px-3" data-i18n="orders.ref_table_commission">Komisi</th>
                                        <th class="py-2.5 px-3" data-i18n="orders.ref_table_status">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="conversions-tbody" class="divide-y divide-[#222634]"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div id="loading-state" class="hidden text-center py-16">
            <div class="inline-block w-8 h-8 border-2 border-[#00E5FF] border-t-transparent rounded-full animate-spin mb-4"></div>
            <p class="text-xs font-mono text-[#94A3B8]" data-i18n="orders.loading">Memuat data pesanan Anda dari server...</p>
        </div>
    </main>

    <div id="toast" class="fixed bottom-24 md:bottom-8 right-6 z-[100] bg-[#11131A] border border-[#00E5FF]/40 text-white text-xs px-4 py-3 rounded-lg shadow-2xl flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none font-mono">
        <div class="i-lucide-check-circle text-[#00E5FF] text-base"></div>
        <span id="toast-msg" data-i18n="orders.copied">Kredensial berhasil disalin!</span>
    </div>

    <style>
        .active-filter-tab {
            background-color: rgba(0, 229, 255, 0.08);
            color: #00E5FF;
            border: 1px solid rgba(0, 229, 255, 0.4);
        }
        .active-main-tab {
            background-color: rgba(0, 229, 255, 0.12);
            color: #00E5FF;
            border: 1px solid rgba(0, 229, 255, 0.4);
        }
        .active-sub-tab {
            background-color: rgba(0, 229, 255, 0.1);
            color: #00E5FF;
            border-bottom: 2px solid #00E5FF;
        }
    </style>

    <script is:inline>
        let allOrdersData = [];
        window.allOrdersData = allOrdersData; // expose utk SW polling
        let currentFilter = "all";
        let referralDashboardData = null;
        let currentMainTab = "orders";
        let currentReferralSubTab = "vouchers";

        const t = (key, fallback) => {
            if (typeof window !== "undefined" && typeof window.t === "function") {
                return window.t(key, fallback);
            }
            return fallback !== undefined ? fallback : key;
        };

        function showToast(text) {
            const toast = document.getElementById("toast");
            const msg = document.getElementById("toast-msg");
            msg.innerText = text;
            toast.classList.remove("translate-y-20", "opacity-0");
            toast.classList.add("translate-y-0", "opacity-100");
            setTimeout(() => {
                toast.classList.remove("translate-y-0", "opacity-100");
                toast.classList.add("translate-y-20", "opacity-0");
            }, 2500);
        }

        window.copyText = (text, label) => {
            navigator.clipboard.writeText(text).then(() => {
                showToast(t("orders.copied", `${label || 'Teks'} berhasil disalin!`));
            });
        };

        function getCurr() {
            return typeof window.getCurrentCurrency === "function" ? window.getCurrentCurrency() : (localStorage.getItem("yasui_currency") || "IDR");
        }

        function getLang() {
            return typeof window.getCurrentLanguage === "function" ? window.getCurrentLanguage() : (localStorage.getItem("yasui_lang") || "id");
        }

        function formatMoney(num) {
            const curr = getCurr();
            if (typeof window.formatCurrency === "function") {
                return window.formatCurrency(num, curr);
            }
            const usdRate = window.IDR_TO_USD_RATE || 16000;
            if (curr === "USD") {
                return "$" + (Number(num || 0) / usdRate).toFixed(2);
            }
            return "Rp " + Number(num || 0).toLocaleString("id-ID");
        }

        function formatIDR(num) {
            return formatMoney(num);
        }

        /* ====== SUMMONERS WAR: SET ACCOUNT HELPERS ====== */
        function swFulfillMeta(order) {
            const m = (order.metaData || []).find(x => x.key === "_sw_set_account");
            return m?.value || null;
        }
        function hasSwItems(order) {
            return (order.items || []).some(i => (i.sku || "").startsWith("sw-"));
        }
        function swButtonLabel(status) {
            const isEn = getLang() === "en";
            switch (status) {
                case "processing": return isEn ? "Setting Account: Processing…" : "Set Akun: Memproses…";
                case "completed": return isEn ? "Account Bound ✓" : "Akun Ter-set ✓";
                case "failed": return isEn ? "Binding Failed — Contact CS" : "Set Akun Gagal — Hubungi CS";
                default: return "Set Account Hive ID";
            }
        }

        function formatDate(dateStr) {
            if (!dateStr) return "-";
            const d = new Date(dateStr);
            const locale = getLang() === "en" ? "en-US" : "id-ID";
            return d.toLocaleDateString(locale, {
                day: "numeric",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            });
        }

        function getStatusBadge(status, isExpired = false) {
            if (isExpired || status === "cancelled") {
                return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-red-950/40 text-red-400 border border-red-500/40 text-[10px] font-mono font-bold uppercase tracking-wider">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> ${t('orders.status_expired', 'KADALUARSA')}
                </span>`;
            }
            switch(status) {
                case "completed":
                    return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-950/40 text-emerald-400 border border-emerald-500/40 text-[10px] font-mono font-bold uppercase tracking-wider">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ${t('orders.status_completed', 'SELESAI')}
                    </span>`;
                case "processing":
                    return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/40 text-[10px] font-mono font-bold uppercase tracking-wider">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#00E5FF] animate-pulse"></span> ${t('orders.status_processing', 'DIPROSES')}
                    </span>`;
                case "pending":
                case "on-hold":
                    return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-950/40 text-amber-400 border border-amber-500/40 text-[10px] font-mono font-bold uppercase tracking-wider animate-pulse">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> ${t('orders.status_pending', 'MENUNGGU BAYAR')}
                    </span>`;
                case "failed":
                    return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-red-950/40 text-red-400 border border-red-500/40 text-[10px] font-mono font-bold uppercase tracking-wider">
                        ${t('orders.status_failed', 'GAGAL')}
                    </span>`;
                default:
                    return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-[#0D0F15] border border-[#222634] text-[#94A3B8] text-[10px] font-mono font-bold uppercase">
                        ${status}
                    </span>`;
            }
        }

        async function fetchUserOrders(email, token) {
            const authBox = document.getElementById("auth-box");
            const loadingState = document.getElementById("loading-state");
            const dashboardContent = document.getElementById("dashboard-content");
            const profileBadge = document.getElementById("user-profile-badge");

            loadingState.classList.remove("hidden");
            dashboardContent.classList.add("hidden");

            try {
                let session = null;
                try {
                    session = typeof window.getSession === "function" ? window.getSession() : JSON.parse(localStorage.getItem("yasui_session") || "null");
                } catch (e) {}

                const authToken = token || session?.token || "";

                const res = await fetch("/api/user/orders", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        ...(authToken ? { "Authorization": `Bearer ${authToken}` } : {})
                    },
                    body: JSON.stringify({ email: email, token: authToken })
                });

                const data = await res.json();

                if (!res.ok || !data.success) {
                    if (res.status === 401) {
                        if (typeof window.yasuiLogout === "function") {
                            window.yasuiLogout();
                        } else {
                            localStorage.removeItem("yasui_session");
                            localStorage.removeItem("yasui_buyer_email");
                            if (typeof window.updateNavbarAuthUI === "function") window.updateNavbarAuthUI();
                            window.dispatchEvent(new CustomEvent('yasui:auth-changed', { detail: { user: null } }));
                        }
                        throw new Error(data.error || t("orders.session_expired", "Sesi telah berakhir. Silakan masuk kembali dengan kata sandi."));
                    }
                    throw new Error(data.error || t("orders.load_failed", "Gagal memuat pesanan"));
                }

                allOrdersData = data.orders || [];

                // Sync recent orders to localStorage for contextual chat thread selector
                try {
                    const existingRecent = JSON.parse(localStorage.getItem("yasui_recent_orders") || "[]");
                    const orderIds = allOrdersData.map(o => String(o.id).trim()).filter(Boolean);
                    const merged = Array.from(new Set([...orderIds, ...existingRecent])).slice(0, 10);
                    localStorage.setItem("yasui_recent_orders", JSON.stringify(merged));
                    if (window.renderThreadSelector) {
                        window.renderThreadSelector();
                    }
                } catch (e) {}

                // Simpan email di localStorage
                localStorage.setItem("yasui_buyer_email", email);
                document.dispatchEvent(new Event("yasui-auth-changed"));

                // Update UI Profil
                profileBadge.classList.remove("hidden");
                profileBadge.classList.add("flex");
                document.getElementById("user-display-email").innerText = email;
                document.getElementById("user-orders-count").innerText = `${allOrdersData.length} ${t("orders.logged_orders_count", "Pesanan Tercatat")}`;
                document.getElementById("user-avatar").innerText = email.charAt(0).toUpperCase();

                // Sembunyikan form login jika sudah berhasil login
                authBox.classList.add("hidden");

                // Update counter
                updateCounters();

                // Render pesanan
                renderOrders();

                // Muat data referral & afiliasi user
                loadReferralDashboardData();

                dashboardContent.classList.remove("hidden");

            } catch (err) {
                alert("Peringatan: " + err.message);
                authBox.classList.remove("hidden");
                document.getElementById("dashboard-content").classList.add("hidden");
                document.getElementById("user-profile-badge").classList.add("hidden");
                document.getElementById("user-profile-badge").classList.remove("flex");
            } finally {
                loadingState.classList.add("hidden");
            }
        }

        function updateCounters() {
            const countAll = allOrdersData.length;
            const countPending = allOrdersData.filter(o => o.status === "pending" || o.status === "on-hold").length;
            const countProcessing = allOrdersData.filter(o => o.status === "processing").length;
            const countCompleted = allOrdersData.filter(o => o.status === "completed").length;

            document.getElementById("count-all").innerText = countAll;
            document.getElementById("count-pending").innerText = countPending;
            document.getElementById("count-processing").innerText = countProcessing;
            document.getElementById("count-completed").innerText = countCompleted;
        }

        window.filterStatus = (status) => {
            currentFilter = status;
            document.querySelectorAll(".filter-tab").forEach(btn => {
                btn.classList.remove("active-filter-tab");
                btn.classList.add("text-[#94A3B8]");
            });

            const activeBtn = document.getElementById(`tab-${status}`);
            if (activeBtn) {
                activeBtn.classList.add("active-filter-tab");
                activeBtn.classList.remove("text-[#94A3B8]");
            }

            renderOrders();
        };

        function renderOrders() {
            const container = document.getElementById("orders-list");
            const emptyState = document.getElementById("orders-empty-state");

            let filtered = allOrdersData;
            if (currentFilter === "pending") {
                filtered = allOrdersData.filter(o => o.status === "pending" || o.status === "on-hold");
            } else if (currentFilter === "processing") {
                filtered = allOrdersData.filter(o => o.status === "processing");
            } else if (currentFilter === "completed") {
                filtered = allOrdersData.filter(o => o.status === "completed");
            }

            if (filtered.length === 0) {
                container.innerHTML = "";
                emptyState.classList.remove("hidden");
                return;
            }

            emptyState.classList.add("hidden");

            container.innerHTML = filtered.map(order => {
                const isPending = order.status === "pending" || order.status === "on-hold";
                const isCompleted = order.status === "completed";
                const isProcessing = order.status === "processing";
                const swFulfill = swFulfillMeta(order);
                order.swFulfillStatus = swFulfill?.status || "awaiting_form";

                // Format link bantuan WhatsApp dengan template pesan resmi
                const waSupportUrl = `https://wa.me/6285972775966?text=${encodeURIComponent(`Halo Admin Yasui Game, saya butuh bantuan/garansi untuk Pesanan #${order.number} (${order.items?.[0]?.name || 'Akun Game'}).`)}`;

                const itemsHtml = (order.items || []).map(item => `
                    <div class="flex items-center gap-3 py-2.5 border-b border-[#222634] last:border-none">
                        <div class="w-12 h-12 bg-[#0D0F15] rounded-lg border border-[#222634] flex-shrink-0 overflow-hidden flex items-center justify-center">
                            ${item.image ? `<img src="${item.image}" class="w-full h-full object-cover">` : `<div class="i-lucide-gamepad-2 text-xl text-[#64748B]"></div>`}
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-white truncate">${item.name}</h4>
                            <div class="text-[11px] text-[#94A3B8] font-mono tabular-nums">Qty: ${item.quantity} × <span class="yg-price" data-price-idr="${item.price}">${formatMoney(item.price)}</span></div>
                        </div>
                        <div class="text-xs font-mono font-bold text-[#F8FAFC] tabular-nums yg-price" data-price-idr="${item.total}">
                            ${formatMoney(item.total)}
                        </div>
                    </div>
                `).join("");

                return `
                    <div class="bg-[#11131A] border border-[#222634] hover:border-[#33394D] rounded-lg p-4 md:p-6 transition-all duration-200">
                        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#222634] pb-4 mb-4">
                            <div class="flex items-center gap-3">
                                <span class="text-sm md:text-base font-bold text-[#00E5FF] font-mono tracking-tight">#${order.number}</span>
                                <span class="text-xs text-[#64748B] font-mono">● ${formatDate(order.dateCreated)}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                ${getStatusBadge(order.status, order.isExpired)}
                            </div>
                        </div>

                        <div class="space-y-1 mb-4">
                            ${itemsHtml}
                        </div>

                        <div class="flex items-center justify-between bg-[#0D0F15] border border-[#222634] rounded-lg p-3 mb-4 text-xs font-mono">
                            <span class="text-[#94A3B8]">${t('orders.bill_total', 'Total Tagihan')} (${order.paymentMethodTitle || 'Gateway'})</span>
                            <span class="text-sm font-bold text-[#00E5FF] tabular-nums yg-price" data-price-idr="${order.total}">${formatMoney(order.total)}</span>
                        </div>

                        ${(isCompleted || isProcessing) && order.customerNote ? `
                            <div class="bg-[#0D0F15] border-l-2 border-[#00E5FF] border-y border-r border-[#222634] rounded-r-lg p-3.5 mb-4 font-mono text-xs">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-[#00E5FF] font-bold text-[11px] uppercase flex items-center gap-1.5">
                                        <div class="i-lucide-key text-xs"></div> ${t('orders.info_notes', 'INFORMASI PENGIRIMAN / CATATAN')}
                                    </span>
                                    <button onclick="copyText('${order.customerNote.replace(/'/g, "\\'")}', '${t('orders.account_info_copied', 'Informasi Akun')}')" class="text-[10px] text-[#94A3B8] hover:text-[#00E5FF] underline cursor-pointer">${t('orders.copy_btn', 'Salin')}</button>
                                </div>
                                <div class="text-[#F8FAFC] break-words whitespace-pre-wrap bg-[#11131A] p-2.5 rounded border border-[#222634]">${order.customerNote}</div>
                            </div>
                        ` : ''}

                        <div class="flex flex-wrap items-center justify-end gap-2 pt-3 border-t border-[#222634]">
                            ${isPending && !order.isExpired ? `
                                <a href="${order.paymentUrl}" class="yg-btn-primary text-xs py-2 px-3.5 flex items-center gap-1.5">
                                    <div class="i-lucide-credit-card text-xs"></div>
                                    <span>${t('orders.pay_now', 'BAYAR SEKARANG')}</span>
                                    ${order.remainingSeconds > 0 ? `<span class="text-[10px] bg-black/30 text-black px-1.5 py-0.5 rounded font-mono font-bold">${t('orders.expires_in', 'Sisa')} ${Math.ceil(order.remainingSeconds / 60)}m</span>` : ''}
                                </a>
                            ` : ''}

                            ${(order.isExpired || order.status === "cancelled" || order.status === "failed") && order.items && order.items.length > 0 ? `
                                <button onclick="reorderItems(${JSON.stringify(order.items).replace(/"/g, '&quot;')})" class="bg-red-950/30 hover:bg-red-900/50 text-red-400 border border-red-500/40 font-mono font-bold uppercase text-xs px-3.5 py-2 rounded-lg transition flex items-center gap-1.5">
                                    <div class="i-lucide-refresh-cw text-xs"></div>
                                    <span>${t('orders.reorder', 'PESAN ULANG')}</span>
                                </button>
                            ` : ''}

                            ${isCompleted && order.items?.[0]?.productId ? `
                                <a href="/review?id=${order.items[0].productId}" class="bg-amber-950/30 hover:bg-amber-900/50 text-amber-400 border border-amber-400/30 font-mono font-bold text-xs px-3.5 py-2 rounded-lg transition flex items-center gap-1.5">
                                    <div class="i-lucide-star text-xs fill-current"></div>
                                    <span>${t('orders.review', 'Tulis Ulasan')}</span>
                                </a>
                            ` : ''}

                            ${(isCompleted || isProcessing) && hasSwItems(order) ? `
                                <button onclick="openSwSetAccount(${order.id}, '${(order.swFulfillStatus || 'awaiting_form')}')" class="sw-set-btn bg-purple-950/30 hover:bg-purple-900/50 text-purple-400 border border-purple-400/30 font-mono font-bold text-xs px-3.5 py-2 rounded-lg transition flex items-center gap-1.5" ${order.swFulfillStatus === 'processing' || order.swFulfillStatus === 'completed' ? 'disabled' : ''}>
                                    <div class="i-lucide-user-cog text-xs"></div>
                                    <span>${swButtonLabel(order.swFulfillStatus)}</span>
                                </button>
                            ` : ''}

                            <button onclick="window.openLiveChatModal && window.openLiveChatModal('Pesanan #${order.id}', '${order.id}')" class="yg-btn-secondary text-xs py-2 px-3 flex items-center gap-1.5 cursor-pointer border-[#00E5FF]/30 hover:border-[#00E5FF] text-[#F8FAFC] hover:text-[#00E5FF]" title="${t('orders.order_chat_prefix', 'Chat Admin #')}${order.id}">
                                <div class="i-lucide-headset text-xs text-[#00E5FF]"></div>
                                <span>${t('orders.order_chat_prefix', 'Chat Admin #')}${order.id}</span>
                            </button>

                            <a href="${waSupportUrl}" target="_blank" rel="noopener noreferrer" class="yg-btn-secondary text-xs py-2 px-3 flex items-center gap-1.5">
