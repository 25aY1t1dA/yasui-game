                if (resultBox) {
                    resultBox.className = "mb-4 p-3 rounded-lg text-xs font-mono border bg-red-950/40 border-red-500/40 text-red-400 block";
                    resultBox.innerText = err.message;
                }
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<div class="i-lucide-zap text-xs"></div> <span>${t("orders.ref_convert_btn", "Tukar Jadi Voucher")}</span>`;
            }
        };

        window.handleRequestPayout = async (e) => {
            e.preventDefault();
            const btn = document.getElementById("btn-submit-payout");
            const resultBox = document.getElementById("payout-result");
            const method = document.getElementById("payout-method")?.value || "USDT";
            const amount = Number(document.getElementById("payout-amount")?.value) || 0;
            const account = document.getElementById("payout-account")?.value?.trim() || "";
            const holder = document.getElementById("payout-holder")?.value?.trim() || "";

            if (amount < 50000) {
                if (resultBox) {
                    resultBox.className = "mb-4 p-3 rounded-lg text-xs font-mono border bg-amber-950/40 border-amber-500/40 text-amber-400 block";
                    resultBox.innerText = "Minimal penarikan saldo adalah Rp 50.000.";
                }
                return;
            }

            let session = null;
            try {
                session = typeof window.getSession === "function" ? window.getSession() : JSON.parse(localStorage.getItem("yasui_session") || "null");
            } catch (e) {}

            if (!session?.email || !session?.token) {
                showToast("Sesi tidak ditemukan. Silakan login kembali.");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<div class="i-lucide-loader-2 text-xs animate-spin"></div> <span>Mengajukan...</span>`;

            try {
                const res = await fetch("/api/user/referral", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${session.token}`
                    },
                    body: JSON.stringify({
                        action: "request_payout",
                        email: session.email,
                        token: session.token,
                        amount: amount,
                        payoutMethod: method,
                        destinationAccount: account,
                        accountName: holder
                    })
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.error || "Gagal mengajukan permohonan penarikan saldo.");
                }

                if (resultBox) {
                    resultBox.className = "mb-4 p-3 rounded-lg text-xs font-mono border bg-emerald-950/40 border-emerald-500/40 text-emerald-300 block";
                    resultBox.innerHTML = `
                        <div class="flex items-center gap-1.5 font-bold mb-1">
