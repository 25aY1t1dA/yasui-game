---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Hubungi Kami & Layanan Pelanggan - Yasui Game"
    description="Hubungi tim support Yasui Game untuk bantuan pesanan, konfirmasi pembayaran, dan layanan garansi akun game."
>
    <main class="pt-4 md:pt-6 pb-20 px-4 min-h-[80vh]">
        <div class="max-w-4xl mx-auto">
            <header class="text-center mb-12">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#00E5FF]/10 border border-[#00E5FF]/30 text-[#00E5FF] text-xs font-mono mb-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00E5FF]"></span>
                    CUSTOMER RELATIONS & SUPPORT
                </span>
                <h1
                    class="text-3xl md:text-4xl font-bold text-white tracking-tight uppercase mb-3"
                    data-i18n="contact.title"
                >
                    Hubungi Kami
                </h1>
                <p
                    class="text-[#94A3B8] text-xs md:text-sm font-mono max-w-lg mx-auto leading-relaxed"
                    data-i18n="contact.subtitle"
                >
                    Punya pertanyaan atau kendala pada transaksi? Tim support kami siap melayani Anda.
                </p>
            </header>

            <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <article
                    class="bg-[#11131A] border border-[#222634] hover:border-[#33394D] p-6 rounded-lg transition-colors group"
                >
                    <div
                        class="w-10 h-10 bg-[#0D0F15] border border-[#222634] rounded-lg flex items-center justify-center mb-4 text-[#00E5FF]"
                    >
                        <div class="i-lucide-mail text-lg"></div>
                    </div>
                    <span
                        class="text-[10px] font-bold text-[#64748B] uppercase tracking-wider font-mono mb-1 block"
                        data-i18n="contact.email_label"
                    >
                        EMAIL SUPPORT
                    </span>
                    <a
                        href="mailto:support@yasuigame.com"
                        class="text-lg font-mono font-bold text-white hover:text-[#00E5FF] transition break-all"
                        data-i18n="contact.email_value"
                    >
                        support@yasuigame.com
                    </a>
                </article>

                <article
                    class="bg-[#11131A] border border-[#222634] hover:border-[#33394D] p-6 rounded-lg transition-colors group"
                >
                    <div
                        class="w-10 h-10 bg-[#0D0F15] border border-[#222634] rounded-lg flex items-center justify-center mb-4 text-emerald-400"
                    >
                        <div class="i-lucide-message-circle text-lg"></div>
                    </div>
                    <span
                        class="text-[10px] font-bold text-[#64748B] uppercase tracking-wider font-mono mb-1 block"
                        data-i18n="contact.wa_label"
                    >
                        WHATSAPP OFFICIAL
                    </span>
                    <a
                        href="https://wa.me/6285972775966"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-lg font-mono font-bold text-white hover:text-emerald-400 transition"
                        data-i18n="contact.wa_value"
                    >
                        +62 859-7277-5966
                    </a>
                </article>

                <article
                    class="md:col-span-2 bg-[#11131A] border border-[#222634] p-6 sm:p-8 rounded-lg"
                >
                    <div class="flex flex-col md:flex-row gap-6 items-start justify-between">
                        <div class="flex-1">
                            <div
                                class="w-10 h-10 bg-[#0D0F15] border border-[#222634] rounded-lg flex items-center justify-center mb-4 text-[#00E5FF]"
                            >
                                <div class="i-lucide-map-pin text-lg"></div>
                            </div>
                            <span
                                class="text-[10px] font-bold text-[#64748B] uppercase tracking-wider font-mono mb-1 block"
                                data-i18n="contact.address_label"
                            >
                                ALAMAT OPERASIONAL
                            </span>
                            <p
                                class="text-base sm:text-lg font-mono font-bold text-white leading-relaxed max-w-lg"
                                data-i18n="contact.address_value"
                            >
                                CQ97+4RM Mayang, Sukoharjo Regency, Central Java
                            </p>

                            <div class="mt-6 pt-4 border-t border-[#222634]">
                                <span
                                    class="text-[10px] font-bold text-[#64748B] uppercase tracking-wider font-mono mb-1 block"
                                    data-i18n="contact.hours_label"
                                >
                                    JAM OPERASIONAL CS
                                </span>
                                <p
                                    class="text-xs text-[#00E5FF] font-mono"
                                    data-i18n="contact.hours_value"
                                >
                                    Setiap Hari: 09:00 - 23:00 WIB (Pengiriman Sistem Otomatis 24 Jam)
                                </p>
                            </div>
                        </div>

                        <div class="w-full md:w-auto shrink-0 pt-2">
                            <a
                                href="https://www.google.com/maps/search/?api=1&query=CQ97+4RM+Mayang,+Sukoharjo+Regency,+Central+Java"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="yg-btn-secondary inline-flex items-center justify-center gap-2 text-xs w-full md:w-auto"
                                data-i18n="contact.view_map"
                            >
                                <div class="i-lucide-map text-sm"></div>
                                <span>Buka di Google Maps</span>
                            </a>
                        </div>
                    </div>
                </article>
            </section>
        </div>
    </main>
</Layout>
