---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us - Yasui Game">
    <main class="pt-24 pb-20 px-4 min-h-screen">
        <div class="max-w-4xl mx-auto">
            {/* Header */}
            <div class="text-center mb-16 space-y-4">
                <div class="inline-block relative">
                    <div class="absolute -inset-1 bg-cyan-500/20 blur-xl"></div>
                    <h1
                        class="relative text-4xl md:text-6xl font-black text-white italic tracking-tighter"
                        data-i18n="contact.title"
                    >
                        HUBUNGI <span class="text-cyan-400">KAMI</span>
                    </h1>
                </div>
                <p
                    class="text-gray-400 text-sm md:text-base max-w-lg mx-auto leading-relaxed"
                    data-i18n="contact.subtitle"
                >
                    Punya pertanyaan atau butuh bantuan? Tim support kami siap
                    membantu 24/7.
                </p>
            </div>

            {/* Contact Grid */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {/* Email Card */}
                <div
                    class="cyber-card bg-gray-900/50 border border-gray-800 p-8 hover:border-cyan-400/50 transition duration-300 group"
                >
                    <div
                        class="w-12 h-12 bg-gray-800 rounded-lg flex items-center justify-center mb-6 group-hover:bg-cyan-900/30 group-hover:text-cyan-400 transition"
                    >
                        <div
                            class="i-lucide-mail text-2xl text-gray-400 group-hover:text-cyan-400"
                        >
                        </div>
                    </div>
                    <h3
                        class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2"
                        data-i18n="contact.email_label"
                    >
                        EMAIL SUPPORT
                    </h3>
                    <a
                        href="mailto:support@yasuigame.com"
                        class="text-xl md:text-2xl font-mono font-bold text-white hover:text-cyan-400 transition break-all"
                        data-i18n="contact.email_value"
                    >
                        support@yasuigame.com
                    </a>
                </div>

                {/* WhatsApp Card */}
                <div
                    class="cyber-card bg-gray-900/50 border border-gray-800 p-8 hover:border-green-400/50 transition duration-300 group"
                >
                    <div
                        class="w-12 h-12 bg-gray-800 rounded-lg flex items-center justify-center mb-6 group-hover:bg-green-900/30 group-hover:text-green-400 transition"
                    >
                        <div
                            class="i-lucide-message-circle text-2xl text-gray-400 group-hover:text-green-400"
                        >
                        </div>
                    </div>
                    <h3
                        class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2"
                        data-i18n="contact.wa_label"
                    >
                        WHATSAPP OFFICIAL
                    </h3>
                    <a
                        href="https://wa.me/6281991400395"
                        target="_blank"
                        class="text-xl md:text-2xl font-mono font-bold text-white hover:text-green-400 transition"
                        data-i18n="contact.wa_value"
                    >
                        +62 819-9140-0395
                    </a>
                </div>

                {/* Address Card (Full Width) */}
                <div
                    class="md:col-span-2 cyber-card bg-gray-900/50 border border-gray-800 p-8 hover:border-purple-400/50 transition duration-300 group relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 p-8 opacity-10 group-hover:opacity-20 transition"
                    >
                        <div class="i-lucide-map-pin text-9xl text-purple-500">
                        </div>
                    </div>

                    <div
                        class="relative z-10 flex flex-col md:flex-row gap-8 items-start"
                    >
                        <div class="flex-1">
                            <div
                                class="w-12 h-12 bg-gray-800 rounded-lg flex items-center justify-center mb-6 group-hover:bg-purple-900/30 group-hover:text-purple-400 transition"
                            >
                                <div
                                    class="i-lucide-map-pin text-2xl text-gray-400 group-hover:text-purple-400"
                                >
                                </div>
                            </div>
                            <h3
                                class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2"
                                data-i18n="contact.address_label"
                            >
                                ALAMAT BISNIS
                            </h3>
                            <p
                                class="text-lg md:text-xl font-mono font-bold text-white leading-relaxed max-w-md"
                                data-i18n="contact.address_value"
                            >
                                CQ97+4RM Mayang, Sukoharjo Regency, Central Java
                            </p>

                            <div class="mt-6 pt-6 border-t border-gray-800">
                                <h4
                                    class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2"
                                    data-i18n="contact.hours_label"
                                >
                                    JAM OPERASIONAL
                                </h4>
                                <p
                                    class="text-sm text-cyan-400 font-mono"
                                    data-i18n="contact.hours_value"
                                >
                                    Setiap Hari: 09:00 - 23:00 WIB
                                </p>
                            </div>
                        </div>

                        <div class="w-full md:w-auto">
                            <a
                                href="https://www.google.com/maps/search/?api=1&query=CQ97+4RM+Mayang,+Sukoharjo+Regency,+Central+Java"
                                target="_blank"
                                class="flex items-center justify-center gap-2 bg-white text-black font-bold uppercase text-xs px-6 py-4 rounded hover:bg-purple-400 transition shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:shadow-[0_0_20px_rgba(192,132,252,0.6)]"
                                data-i18n="contact.view_map"
                            >
                                <div class="i-lucide-map"></div> View on Google Maps
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>
