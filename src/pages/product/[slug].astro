    <script is:inline define:vars={{ product, galleryImages, pPrice }}>
        // --- 1. LIGHTBOX & GALLERY LOGIC ---
        const lightbox = document.getElementById("lightbox");
        const lbImg = document.getElementById("lightbox-img");
        const closeBtn = document.getElementById("close-lightbox");
        const trigger = document.getElementById("trigger-lightbox");

        // Expose gallery images for client-side use
        const clientGallery = galleryImages;

        const close = () => {
            lightbox.classList.add("opacity-0");
            setTimeout(() => (lightbox.style.display = "none"), 300);
        };

        window.openLightbox = (index) => {
            if (clientGallery[index]) {
                lbImg.src = clientGallery[index];
                lightbox.style.display = "flex";
                setTimeout(() => lightbox.classList.remove("opacity-0"), 10);
            }
        };

        window.changeImage = (index) => {
            // Update Main Image
            const mainImg = document.querySelector("#trigger-lightbox img");
            if (mainImg && clientGallery[index]) {
                // Update src
                mainImg.src = clientGallery[index];
                mainImg.srcset = ""; // Clear srcset to prevent Astro responsive overrides confusing things

                // Update active border on thumbnails
                const thumbs = document.querySelectorAll(".flex-shrink-0");
                thumbs.forEach((t, i) => {
                    if (i === index) {
                        t.classList.remove("border-gray-800", "opacity-60");
                        t.classList.add("border-cyan-400");
                    } else {
                        t.classList.add("border-gray-800", "opacity-60");
                        t.classList.remove("border-cyan-400");
                    }
                });
            }
        };

        if (trigger)
            trigger.addEventListener("click", () => {
                // Open lightbox with current main image
                const currentSrc = document.querySelector(
                    "#trigger-lightbox img",
                ).src;
                lbImg.src = currentSrc;
                lightbox.style.display = "flex";
                setTimeout(() => lightbox.classList.remove("opacity-0"), 10);
            });
        if (closeBtn) closeBtn.addEventListener("click", close);
        if (lightbox)
            lightbox.addEventListener("click", (e) => {
                if (e.target === lightbox) close();
            });

        // --- 3. TOAST SYSTEM (NEW) ---
        // --- 3. TOAST SYSTEM (NEW - CYBERPUNK) ---
        function showToast(message) {
            const toast = document.getElementById("cyber-toast");
            const msgEl = document.getElementById("toast-message");
            msgEl.innerText = message;

            // Reset
            toast.classList.remove("translate-x-[150%]");
            toast.classList.add("translate-x-0");
            toast.classList.add("cyber-glitch"); // Glitch effect on enter

            // Remove glitch after entry
            setTimeout(() => {
                toast.classList.remove("cyber-glitch");
            }, 500);

            // Auto hide
            setTimeout(() => {
                toast.classList.remove("translate-x-0");
                toast.classList.add("translate-x-[150%]");
            }, 4000);
        }

        // --- 4. SESSION & USER STATE SYSTEM ---
        function hasValidSession() {
            try {
                const sessionRaw = localStorage.getItem("yasui_session");
                if (sessionRaw) {
                    const session = JSON.parse(sessionRaw);
                    if (session?.email && (!session.expires || session.expires > Date.now())) {
                        return { email: session.email, name: session.name || "Member" };
                    }
                }
            } catch (e) {}

            const savedEmail = localStorage.getItem("yasui_buyer_email");
            if (savedEmail && savedEmail.includes("@")) {
                return { email: savedEmail, name: "Pelanggan Setia" };
            }
            return null;
        }

        function checkUserSession() {
            const user = hasValidSession();
            const savedWa = localStorage.getItem("yasui_buyer_wa") || "";
            const savedDiscord = localStorage.getItem("yasui_buyer_discord") || "";
            const prefContact = savedWa || (savedDiscord ? `[Discord] ${savedDiscord}` : "");

            const authView = document.getElementById("auth-user-view");
            const guestView = document.getElementById("guest-user-view");
            const badge = document.getElementById("delivery-status-badge");
            const desktopBuyBtn = document.getElementById("desktop-btn-buy");
            const mobileAuthInd = document.getElementById("mobile-auth-indicator");
            const mobileEmailLabel = document.getElementById("mobile-auth-email-label");
            const mobileBuyBtn = document.getElementById("mobile-buy-btn");

            // Pre-fill inputs on desktop & mobile modal
            const forms = [document.getElementById("desktop-form"), document.getElementById("mobile-modal-form")];
            forms.forEach(form => {
                if (!form) return;
                const emailInp = form.querySelector('[name="user_email"]');
                const contactInp = form.querySelector('[name="contact_value"]');
                const methodSel = form.querySelector('[name="contact_method"]');

                if (emailInp && user?.email && !emailInp.value) {
                    emailInp.value = user.email;
                }
                if (contactInp && !contactInp.value) {
                    if (savedWa) {
                        if (methodSel) methodSel.value = "whatsapp";
                        contactInp.value = savedWa;
                    } else if (savedDiscord) {
                        if (methodSel) methodSel.value = "discord";
                        contactInp.value = savedDiscord;
                    }
                }
            });

            if (user && prefContact) {
                // User has verified session and saved contact!
                if (authView && guestView) {
                    authView.classList.remove("hidden");
                    guestView.classList.add("hidden");
                    const dispEmail = document.getElementById("auth-display-email");
                    const dispContact = document.getElementById("auth-display-contact");
                    if (dispEmail) dispEmail.innerText = user.email;
                    if (dispContact) dispContact.innerText = prefContact;
                }
                if (badge) {
                    badge.innerText = "Member Terverifikasi";
                    badge.classList.remove("bg-gray-800", "text-gray-400", "border-gray-700");
                    badge.classList.add("bg-cyan-950/50", "text-cyan-400", "border-cyan-500/40");
                }
                if (desktopBuyBtn) {
                    desktopBuyBtn.innerText = "Beli Langsung (1-Klik)";
                    desktopBuyBtn.classList.add("shadow-[0_0_20px_rgba(34,211,238,0.4)]");
                }
                if (mobileAuthInd) {
                    mobileAuthInd.classList.remove("hidden");
                    mobileAuthInd.classList.add("flex");
                }
                if (mobileEmailLabel) {
                    mobileEmailLabel.innerText = user.email;
                }
                if (mobileBuyBtn) {
                    mobileBuyBtn.innerText = "Beli (1-Klik)";
                }
            } else if (user) {
                // User has email but needs contact value once
                if (badge) {
                    badge.innerText = "Lengkapi Kontak";
                }
            }
        }

        window.toggleEditContact = () => {
            const authView = document.getElementById("auth-user-view");
            const guestView = document.getElementById("guest-user-view");
            if (authView && guestView) {
                authView.classList.toggle("hidden");
                guestView.classList.toggle("hidden");
            }
        };

        window.toggleDescription = () => {
            const desc = document.getElementById("product-desc-content");
            const btnText = document.getElementById("desc-btn-text");
            const btnIcon = document.getElementById("desc-btn-icon");
            const fade = document.getElementById("desc-expand-wrapper");

            if (!desc) return;
            const isCollapsed = desc.classList.contains("max-h-56");

            if (isCollapsed) {
                desc.classList.remove("max-h-56");
                if (btnText) btnText.innerText = "Tutup Deskripsi";
                if (btnIcon) btnIcon.classList.add("rotate-180");
                if (fade) fade.classList.remove("-mt-12", "bg-gradient-to-t");
            } else {
                desc.classList.add("max-h-56");
                if (btnText) btnText.innerText = "Baca Selengkapnya";
                if (btnIcon) btnIcon.classList.remove("rotate-180");
                if (fade) fade.classList.add("-mt-12", "bg-gradient-to-t");
            }
        };

        // --- 4.1 MOBILE MODAL & ACTION HANDLER ---
        let mobileIsDirectBuy = false;

        window.openMobileForm = (isDirect) => {
            mobileIsDirectBuy = isDirect;
            const modal = document.getElementById("mobile-form-modal");
            if (modal) {
                modal.classList.remove("hidden");
                modal.classList.add("flex");
            }
        };

        window.closeMobileForm = () => {
            const modal = document.getElementById("mobile-form-modal");
            if (modal) {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
            }
        };

        window.confirmMobileForm = () => {
            const form = document.getElementById("mobile-modal-form");
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            processCart(form, mobileIsDirectBuy);
            closeMobileForm();
        };

        window.handleMobileAction = (isDirectBuy) => {
            const user = hasValidSession();
            const desktopForm = document.getElementById("desktop-form");
            const savedWa = localStorage.getItem("yasui_buyer_wa");
            const savedDiscord = localStorage.getItem("yasui_buyer_discord");

            // If user has verified email AND saved contact info: 1-Click Buy / Add to Cart!
            if (user?.email && (savedWa || savedDiscord)) {
                // Sync to desktop form inputs
                const emailInp = desktopForm?.querySelector('[name="user_email"]');
                const contactInp = desktopForm?.querySelector('[name="contact_value"]');
                const methodSel = desktopForm?.querySelector('[name="contact_method"]');
                if (emailInp) emailInp.value = user.email;
                if (contactInp) contactInp.value = savedWa || savedDiscord;
                if (methodSel) methodSel.value = savedWa ? "whatsapp" : "discord";

                processCart(desktopForm, isDirectBuy);
            } else {
                // Guest or first time: Open mobile modal
                openMobileForm(isDirectBuy);
            }
        };

        // --- 4.5 CONTENT LOGIC ---
        window.updateContactPlaceholder = (formId) => {
            const form = document.getElementById(formId);
            if (!form) return;

            const methodSelect = form.querySelector('[name="contact_method"]');
            const valueInput = form.querySelector('[name="contact_value"]');

            if (methodSelect && valueInput) {
                const isWA = methodSelect.value === "whatsapp";
                if (isWA) {
                    valueInput.type = "tel";
                    valueInput.placeholder = "0812-3456-xxxx";
                    valueInput.pattern = "^08[0-9]{8,13}$";
                    valueInput.title =
                        "Nomor WhatsApp harus diawali 08 dan terdiri dari 10-15 angka";
                } else {
                    valueInput.type = "text";
                    valueInput.placeholder = "Username#1234";
                    valueInput.pattern = "^.{3,32}$";
                    valueInput.title = "Username Discord minimal 3 karakter";
                }
            }
        };

        window.validateContactInput = (input, formId) => {
            const form = document.getElementById(formId);
            if (!form) return;
            const methodSelect = form.querySelector('[name="contact_method"]');

            if (methodSelect && methodSelect.value === "whatsapp") {
                // Saring karakter non-angka secara realtime
                input.value = input.value.replace(/[^0-9]/g, "");
            }
        };

        // --- 5. CART LOGIC ---
        function getCart() {
            return JSON.parse(localStorage.getItem("yasui_cart") || "[]");
        }
        function saveCart(cart) {
            localStorage.setItem("yasui_cart", JSON.stringify(cart));
            updateCartBadge();
        }
        function updateCartBadge() {
            const cart = getCart();
            const badge = document.getElementById("cart-badge");
            const globalBadge = document.getElementById("global-cart-badge");
            const mobileBadge = document.getElementById("mobile-cart-badge");

            if (badge) {
                badge.innerText = cart.length;
                badge.classList.toggle("hidden", cart.length === 0);
            }
            if (globalBadge) {
                globalBadge.innerText = cart.length;
                globalBadge.classList.toggle("hidden", cart.length === 0);
            }
            if (mobileBadge) {
                mobileBadge.innerText = cart.length;
                mobileBadge.classList.toggle("hidden", cart.length === 0);
            }
        }
        updateCartBadge();

        window.addToCart = (isDirectBuy) => {
            const form = document.getElementById("desktop-form");
            processCart(form, isDirectBuy);
        };

        function processCart(form, isDirectBuy) {
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData(form);
            const userEmail = formData.get("user_email") || "";
            const contactMethod = formData.get("contact_method") || "whatsapp";
            const contactValue = formData.get("contact_value") || "";
            const playerInGameId = formData.get("player_in_game_id") || "";

            // Auto-persist contact info to localStorage for future 1-Click checkout
            if (userEmail) {
                localStorage.setItem("yasui_buyer_email", userEmail);
            }
            if (contactMethod === "whatsapp" && contactValue) {
                localStorage.setItem("yasui_buyer_wa", contactValue);
            } else if (contactMethod === "discord" && contactValue) {
                localStorage.setItem("yasui_buyer_discord", contactValue);
            }

            const item = {
                id:
                    product.databaseId ||
                    (product.id ? parseInt(atob(product.id).split(":")[1]) : 0),
                globalId: product.id,
                name: product.name,
                slug: product.slug,
                price: pPrice || (product.rawPrice ? parseInt(product.rawPrice) : 0),
                image:
                    document.querySelector("#trigger-lightbox img")?.src || "",
                email: userEmail,
                contactMethod: contactMethod,
                contactValue: contactValue,
                playerInGameId: playerInGameId,
                wa:
                    contactMethod === "whatsapp"
                        ? contactValue
                        : `[Discord] ${contactValue}`,
                timestamp: Date.now(),
            };

            let cart = getCart();
            cart.push(item);
            saveCart(cart);

            if (isDirectBuy) {
                window.location.href = "/cart";
            } else {
                showToast(`"${product.name}" ditambahkan!`);
                // Re-evaluate session display immediately
                checkUserSession();
            }
        }

        // Initialize session on load
        checkUserSession();
        // --- 6. REVIEW SYSTEM (DEPRECATED: MOVED TO EMAIL ONLY) ---
        // Logic removed to prevent public spam.
        // Reviews are now collected via exclusive email links.
    </script>
</Layout>
