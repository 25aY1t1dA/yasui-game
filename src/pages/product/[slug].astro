---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { parsePrice } from "../../lib/price";
import { getProductBySlug, getProducts, normalizeProduct } from "../../lib/wc";
import { sanitizeHtml } from "../../lib/sanitize";

const IS_PROD = import.meta.env.PROD;

const normalizeImgUrl = (url: string | null) => {
    if (!url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};

const { slug } = Astro.params;
let product: any = null;
let relatedProducts: any[] = [];
let galleryImages: any[] = [];
let prodMainSrc: any = null;
let prodGallerySrcs: any[] = [];

try {
    const rawProduct = await getProductBySlug(slug);
    if (rawProduct) {
        product = normalizeProduct(rawProduct);

        const rawMain = product.images?.[0]?.src || null;
        const rawGallery = (product.images || []).slice(1).map((img: any) => img.src);

        galleryImages = rawMain ? [normalizeImgUrl(rawMain)] : [];
        const proxyGallery = rawGallery.map((u: string) => normalizeImgUrl(u));
        galleryImages = [...galleryImages, ...proxyGallery];

        prodMainSrc = rawMain;
        prodGallerySrcs = rawGallery;

        const firstCategoryId = rawProduct.categories?.[0]?.id;
        if (firstCategoryId) {
            try {
                const rawRelated = await getProducts({ category: firstCategoryId, per_page: 5 });
                relatedProducts = (rawRelated || [])
                    .filter((p: any) => p.id !== rawProduct.id)
                    .slice(0, 4)
                    .map(normalizeProduct);
            } catch (e: any) {
                console.warn("Related product fetch warning:", e.message);
            }
        }
    }
} catch (error: any) {
    console.error("[Product REST Error]:", error);
}

if (!product) {
    return Astro.redirect("/404");
}

const pPrice = parsePrice(product.price);
const pRegular = parsePrice(product.regularPrice);
const hasDiscount = pRegular > pPrice;
const discountPercent = hasDiscount
    ? Math.round(((pRegular - pPrice) / pRegular) * 100)
    : 0;

const attributes = product.attributes?.nodes || [];

const getAttributeStyle = (attr: any) => {
    const lowerName = attr.name.toLowerCase();
    const value = attr.options?.[0] || "";
    const lowerValue = value.toLowerCase();

    if (lowerName.includes("age") || lowerName.includes("umur") || lowerName.includes("band")) {
        const isOld = lowerValue.startsWith("old") || lowerValue.includes("tua");
        return {
            icon: isOld ? "i-lucide-hourglass" : "i-lucide-sparkles",
            label: isOld ? "AKUN TUA" : "FRESH",
            valueClass: isOld ? "text-gray-300" : "text-green-400",
            wrapperClass: isOld ? "border-gray-800 bg-gray-900/50" : "border-green-800/60 bg-green-950/30",
        };
    }

    if (lowerName.includes("server")) {
        return {
            icon: "i-lucide-globe",
            label: "SERVER",
            valueClass: "text-cyan-400",
            wrapperClass: "border-gray-800 bg-gray-900/50",
        };
    }

    if (
        lowerName.includes("tier") ||
        lowerName.includes("rank") ||
        lowerName.includes("account")
    ) {
        let colorClass = "text-gray-300";
        if (lowerValue.includes("fresh") || lowerValue.includes("new"))
            colorClass = "text-green-400";
        else if (lowerValue.includes("mid")) colorClass = "text-blue-400";
        else if (lowerValue.includes("end") || lowerValue.includes("high"))
            colorClass = "text-purple-400";

        return {
            icon: "i-lucide-bar-chart-2",
            label: "TIER / RANK",
            valueClass: colorClass,
            wrapperClass: "border-gray-800 bg-gray-900/50",
        };
    }

    return {
        icon: "i-lucide-tag",
        label: attr.name.toUpperCase(),
        valueClass: "text-gray-400",
        wrapperClass: "border-gray-800 bg-gray-900/50",
    };
};

const schema = {
    "@context": "https://schema.org/",
    "@type": "Product",
    name: product.name,
    description: product.shortDescription,
    sku: product.slug,
    image: product.image?.sourceUrl,
    offers: {
        "@type": "Offer",
        priceCurrency: "IDR",
        price: product.rawPrice || 0,
        availability: "https://schema.org/InStock",
        url: Astro.url.href,
    },
};
---

<Layout title={product.name} description={product.shortDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <div
        id="cyber-toast"
        class="fixed top-24 right-4 z-[100] translate-x-[150%] transition-transform duration-300 flex items-center gap-3 bg-black/95 backdrop-blur-xl border border-cyan-500 p-4 rounded-sm shadow-[0_0_30px_rgba(34,211,238,0.4)] max-w-xs md:max-w-md group"
    >
        <div class="w-8 h-8 bg-cyan-400 flex items-center justify-center text-black font-bold">
            <div class="i-lucide-check-circle-2 text-xl"></div>
        </div>
        <div>
            <h4 class="text-xs font-bold text-white uppercase font-mono tracking-wider">Item Ditambahkan</h4>
            <p id="toast-message" class="text-[11px] text-gray-400 font-mono">Pesanan masuk ke keranjang.</p>
        </div>
    </div>

    <div
        id="lightbox"
        style="display: none;"
        class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-xl flex flex-col justify-center items-center opacity-0 transition-opacity duration-300"
    >
        <button
            id="close-lightbox"
            class="absolute top-4 right-4 text-white p-2 bg-gray-800 rounded-full hover:bg-red-500 transition z-50 cursor-pointer"
            aria-label="Tutup Lightbox"
        >
            <div class="i-lucide-x text-xl"></div>
        </button>
        <div class="relative w-full max-w-5xl aspect-video flex items-center justify-center p-4">
            <img
                id="lightbox-img"
                src=""
                alt="Product preview"
                class="max-h-[80vh] max-w-full object-contain shadow-[0_0_50px_rgba(34,211,238,0.2)]"
            />
        </div>
    </div>

    <main class="yg-shell pt-20 lg:pt-24 pb-40 lg:pb-32">
        <nav
            class="flex py-4 text-gray-500 text-[10px] font-mono uppercase tracking-tighter"
            aria-label="Breadcrumb"
        >
            <ol class="flex items-center space-x-2">
                <li><a href="/" class="hover:text-cyan-400" data-i18n="nav.home">HOME</a></li>
                <li><span class="text-gray-700">/</span></li>
                <li>
                    <a href={`/category/${product.productCategories?.nodes[0]?.slug}`} class="hover:text-cyan-400">
                        {product.productCategories?.nodes[0]?.name}
                    </a>
                </li>
                <li><span class="text-gray-700">/</span></li>
                <li class="text-white font-bold truncate max-w-[150px]">{product.name}</li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            <div class="lg:col-span-7 w-full space-y-6">
                <div class="space-y-3">
                    <div
                        class="relative group rounded-xl overflow-hidden border border-gray-800 bg-gray-900 shadow-2xl aspect-video cursor-pointer"
                        id="trigger-lightbox"
                    >
                        <div class="absolute top-2 right-2 bg-black/60 backdrop-blur px-2 py-1 rounded text-white text-[9px] font-bold z-20 flex items-center gap-1 pointer-events-none">
                            <div class="i-lucide-maximize-2 text-xs"></div> ZOOM
                        </div>
                        {
                            galleryImages.length > 0 && galleryImages[0] ? (
                                IS_PROD ? (
                                    <Image
                                        src={prodMainSrc}
                                        alt={product.name}
                                        width={600}
                                        height={600}
                                        format="webp"
                                        class="w-full h-full object-contain bg-black"
                                        loading="eager"
                                    />
                                ) : (
                                    <img
                                        src={galleryImages[0]}
                                        alt={product.name}
                                        width="600"
                                        height="600"
                                        class="w-full h-full object-contain bg-black"
                                        loading="eager"
                                        decoding="async"
                                    />
                                )
                            ) : (
                                <div class="flex items-center justify-center h-full text-gray-700 text-xs font-mono">
                                    NO VISUAL DATA
                                </div>
                            )
                        }
                    </div>

                    <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-none lg:grid lg:grid-cols-5">
                        {
                            galleryImages.map((img, index) => (
                                <div
                                    class={`shrink-0 w-20 lg:w-auto aspect-video bg-black rounded border cursor-pointer overflow-hidden ${index === 0 ? "border-cyan-400" : "border-gray-800 opacity-60"}`}
                                    onclick={`window.changeImage(${index})`}
                                >
                                    {img ? (
                                        IS_PROD && prodGallerySrcs[index - 1] ? (
                                            <Image
                                                src={prodGallerySrcs[index - 1]}
                                                alt={`${product.name} gallery ${index + 1}`}
                                                width={300}
                                                height={300}
                                                format="webp"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                            />
                                        ) : IS_PROD && index === 0 && prodMainSrc ? (
                                            <Image
                                                src={prodMainSrc}
                                                alt={`${product.name} main`}
                                                width={300}
                                                height={300}
                                                format="webp"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <img
                                                src={img}
                                                alt={`${product.name} gallery ${index + 1}`}
                                                width="300"
                                                height="300"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        )
                                    ) : (
                                        <div class="w-full h-full bg-gray-800 flex items-center justify-center text-[10px]">
                                            No Img
                                        </div>
                                    )}
                                </div>
                            ))
                        }
                    </div>
                </div>

                <div class="pt-4 lg:pt-6 border-t border-gray-800">
                    <div class="flex items-center justify-between mb-3">
                        <h2
                            class="text-xs font-bold uppercase tracking-widest text-cyan-400 flex items-center gap-2"
                            data-i18n="product.description"
                        >
                            <div class="i-lucide-cpu text-sm"></div> Deskripsi Produk
                        </h2>
                        <span class="text-[9px] font-mono text-gray-500 uppercase tracking-widest hidden sm:inline-block">
                            Spesifikasi Terverifikasi
                        </span>
                    </div>

                    <div class="yg-card p-4 md:p-6 relative overflow-hidden transition-all">
                        <div
                            id="product-desc-content"
                            class="prose prose-invert prose-sm max-w-none text-gray-300 leading-relaxed max-h-56 md:max-h-none overflow-hidden transition-all duration-300 relative [&_p]:text-sm [&_p]:leading-relaxed [&_p]:text-gray-300 [&_p]:mb-3 [&_h1]:text-base [&_h1]:font-bold [&_h1]:text-white [&_h1]:mb-2 [&_h2]:text-base [&_h2]:font-bold [&_h2]:text-cyan-400 [&_h2]:mb-2 [&_h3]:text-sm [&_h3]:font-bold [&_h3]:text-white [&_h3]:mb-1.5 [&_ul]:space-y-1.5 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:text-sm [&_li]:text-gray-300 [&_a]:text-cyan-400 [&_a]:underline hover:[&_a]:text-cyan-300 [&_strong]:text-cyan-300 [&_span]:text-inherit"
                            set:html={sanitizeHtml(
                                product.description || product.shortDescription,
                            )}
                        />

                        <div
                            id="desc-expand-wrapper"
                            class="md:hidden pt-8 -mt-12 bg-gradient-to-t from-gray-950 via-gray-950/80 to-transparent relative z-10 flex justify-center"
                        >
                            <button
                                type="button"
                                id="desc-expand-btn"
                                onclick="window.toggleDescription && window.toggleDescription()"
                                class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-gray-800/90 hover:bg-gray-700 border border-gray-700/80 rounded-full text-xs font-bold text-cyan-400 transition shadow-lg active:scale-95 cursor-pointer"
                            >
                                <span id="desc-btn-text">Baca Selengkapnya</span>
                                <div id="desc-btn-icon" class="i-lucide-chevron-down text-sm transition-transform duration-200"></div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-5 w-full relative">
                <div class="sticky top-24 space-y-6">
                    <div>
                        <div class="flex flex-wrap gap-2 mb-3">
                            <span class="yg-badge-cyan">
                                {product.productCategories?.nodes[0]?.name || "GAME"}
                            </span>
                        </div>
                        <h1 class="text-2xl md:text-3xl font-black text-white tracking-tighter leading-tight mb-4">
                            {product.name}
                        </h1>

                        <div class="flex items-center gap-2.5 mb-4 text-xs font-mono">
                            <span class="yg-badge-emerald">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                Stok Siap Kirim
                            </span>
                            <span class="text-gray-500 font-mono text-[11px]">Pengiriman 1–5 Menit</span>
                        </div>

                        <div class="flex items-end gap-3 pb-6 border-b border-gray-800 border-dashed relative">
                            {
                                hasDiscount && (
                                    <div class="flex flex-col items-start mb-1">
                                        <div class="bg-red-600 text-white px-2 py-0.5 text-[10px] font-black italic skew-x-[-10deg] mb-1 shadow-[0_0_10px_rgba(220,38,38,0.5)]">
                                            <span data-i18n="product.save">HEMAT</span> {discountPercent}%
                                        </div>
                                        <span
                                            class="text-sm text-gray-500 line-through decoration-red-500 decoration-2 font-mono price-tag"
                                            data-price-idr={pRegular}
                                        >
                                            {product.regularPrice}
                                        </span>
                                    </div>
                                )
                            }
                            <span
                                class="text-3xl md:text-4xl font-mono text-cyan-400 font-bold price-tag"
                                data-price-idr={pPrice}
                            >
                                {product.price || "Rp 0"}
                            </span>
                        </div>
                    </div>

                    {attributes.length > 0 && (
                        <div>
                            <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-400 mb-3 flex items-center gap-2">
                                <div class="i-lucide-settings-2"></div> SPESIFIKASI AKUN
                            </h2>
                            <div class="grid grid-cols-2 gap-2">
                                {attributes.map((attr: any) => {
                                    const style = getAttributeStyle(attr);
                                    return (
                                        <div class={`p-3 rounded-lg flex flex-col justify-between gap-2 ${style.wrapperClass}`}>
                                            <div class="flex items-center gap-2 text-gray-500">
                                                <div class={`${style.icon} text-xs`} />
                                                <span class="text-[9px] font-bold uppercase tracking-wider">
                                                    {style.label}
                                                </span>
                                            </div>
                                            <div class={`text-sm md:text-base font-mono font-bold ${style.valueClass} truncate`}>
                                                {attr.options?.[0] || "-"}
                                            </div>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    )}

                    <div class="bg-gray-900/80 backdrop-blur border border-gray-800 p-5 md:p-6 rounded-xl shadow-2xl relative overflow-hidden">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-sm font-bold text-white flex items-center gap-2" data-i18n="product.complete_data">
                                <div class="i-lucide-shopping-bag text-cyan-400"></div> Data Pengiriman
                            </h2>
                            <span
                                id="delivery-status-badge"
                                class="text-[9px] font-mono px-2 py-0.5 rounded bg-gray-800 text-gray-400 border border-gray-700 uppercase"
                            >
                                Mode Tamu
                            </span>
                        </div>

                        <form id="order-form" class="space-y-4">
                            <div
                                id="auth-user-view"
                                class="hidden bg-cyan-950/20 border border-cyan-500/30 rounded-lg p-3 space-y-2.5 transition-all"
                            >
                                <div class="flex items-center justify-between border-b border-cyan-900/40 pb-2">
                                    <div class="flex items-center gap-1.5 text-xs font-bold text-cyan-400">
                                        <div class="i-lucide-badge-check text-sm text-cyan-400"></div>
                                        <span>Pengiriman Terverifikasi</span>
                                    </div>
                                    <button
                                        type="button"
                                        onclick="window.toggleEditContact && window.toggleEditContact()"
                                        class="text-[10px] text-gray-400 hover:text-cyan-300 underline font-mono cursor-pointer"
                                    >
                                        [Ubah Data]
                                    </button>
                                </div>
                                <div class="text-xs font-mono text-white flex items-center gap-2">
                                    <div class="i-lucide-mail text-cyan-400 text-xs shrink-0"></div>
                                    <span class="text-gray-400 text-[10px] uppercase">Email:</span>
                                    <span id="auth-display-email" class="truncate font-bold text-white">...</span>
                                </div>
                                <div class="text-xs font-mono text-gray-300 flex items-center gap-2">
                                    <div class="i-lucide-phone text-cyan-400 text-xs shrink-0"></div>
                                    <span class="text-gray-400 text-[10px] uppercase">Kontak:</span>
                                    <span id="auth-display-contact" class="font-bold text-white">...</span>
                                </div>
                            </div>

                            <div id="guest-user-view" class="space-y-4">
                                <div class="space-y-1">
                                    <div class="flex items-center justify-between">
                                        <label
                                            for="user-email-input"
                                            class="text-[10px] font-bold text-gray-400 uppercase"
                                            data-i18n="product.email_label"
                                        >
                                            Email Penerima (Wajib)
                                        </label>
                                        <span class="text-[9px] text-cyan-400 font-mono">Untuk kirim data akun</span>
                                    </div>
                                    <input
                                        type="email"
                                        id="user-email-input"
                                        name="user_email"
                                        required
                                        autocomplete="email"
                                        class="yg-input !text-sm"
                                        placeholder="email@example.com"
                                    />
                                </div>

                                <div class="grid grid-cols-3 gap-3">
                                    <div class="col-span-1 space-y-1">
                                        <label for="contact-method-select" class="text-[10px] font-bold text-gray-400 uppercase">
                                            Metode
                                        </label>
                                        <select
                                            id="contact-method-select"
                                            name="contact_method"
                                            class="w-full bg-black border border-gray-700 text-white p-2.5 rounded-xl focus:border-cyan-400 focus:outline-none text-xs font-mono appearance-none"
                                            onchange="window.updateContactPlaceholder && window.updateContactPlaceholder()"
                                        >
                                            <option value="whatsapp">WhatsApp</option>
                                            <option value="discord">Discord</option>
                                        </select>
                                    </div>
                                    <div class="col-span-2 space-y-1">
                                        <label for="contact-value-input" class="text-[10px] font-bold text-gray-400 uppercase">
                                            No WA / Discord ID
                                        </label>
                                        <input
                                            type="tel"
                                            id="contact-value-input"
                                            name="contact_value"
                                            required
                                            autocomplete="tel"
                                            class="yg-input !text-sm"
                                            placeholder="0812-3456-xxxx"
                                            pattern="^08[0-9]{8,13}$"
                                            title="Nomor WhatsApp harus diawali 08 dan terdiri dari 10-15 angka"
                                        />
                                    </div>
                                </div>

                                <div id="game-player-id-field" class="hidden space-y-1 pt-1">
                                    <label for="player-id-input" class="text-[10px] font-bold text-gray-400 uppercase flex items-center justify-between">
                                        <span>ID Pemain / Username Game</span>
                                        <span class="text-[9px] text-cyan-400 font-mono">(Item / Trade)</span>
                                    </label>
                                    <input
                                        type="text"
                                        id="player-id-input"
                                        name="player_in_game_id"
                                        autocomplete="off"
                                        class="yg-input !text-sm"
                                        placeholder="Contoh: Nickname#TAG atau User ID"
                                    />
                                </div>

                                <p class="text-[10px] text-gray-400 leading-tight flex items-center gap-1.5">
                                    <span class="i-lucide-shield-check text-cyan-400 text-xs shrink-0"></span>
                                    <span><strong class="text-white font-semibold">Checkout Cepat:</strong> Kredensial akun otomatis dikirimkan ke email di atas setelah pembayaran diverifikasi.</span>
                                </p>
                            </div>

                            <div class="grid grid-cols-2 gap-3 pt-2">
                                <button
                                    type="button"
                                    id="btn-add-to-cart"
                                    onclick="window.submitOrderForm && window.submitOrderForm(false)"
                                    class="yg-btn-secondary py-3 text-xs"
                                    data-i18n="product.add_to_cart"
                                >
                                    + Keranjang
                                </button>
                                <button
                                    type="button"
                                    id="btn-buy-now"
                                    onclick="window.submitOrderForm && window.submitOrderForm(true)"
                                    class="yg-btn-primary py-3 text-xs"
                                    data-i18n="product.buy_now"
                                >
                                    Beli Langsung
                                </button>
                            </div>

                            <div class="pt-4 border-t border-gray-800 border-dashed">
                                <div class="border border-cyan-900/50 bg-cyan-900/10 rounded-lg p-3">
                                    <h3 class="text-xs font-bold text-cyan-400 uppercase tracking-wider mb-3 flex items-center gap-2" data-i18n="product.guarantee_title">
                                        <div class="i-lucide-shield-check"></div> Jaminan Yasui Game
                                    </h3>
                                    <div class="space-y-3">
                                        <div class="flex items-start gap-3">
                                            <div class="i-lucide-shield text-gray-400 mt-0.5 text-sm"></div>
                                            <div>
                                                <p class="text-xs font-bold text-gray-300" data-i18n="product.guarantee_30day">
                                                    Garansi 30 Hari
                                                </p>
                                                <p class="text-[10px] text-gray-500" data-i18n="product.guarantee_desc">
                                                    Semua produk bergaransi 30 hari anti-hackback.
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-3">
                                            <div class="i-lucide-headset text-gray-400 mt-0.5 text-sm"></div>
                                            <div>
                                                <p class="text-xs font-bold text-gray-300" data-i18n="product.need_help">
                                                    Butuh Bantuan?
                                                </p>
                                                <p class="text-[10px] text-cyan-400 decoration-dashed cursor-default" data-i18n="product.chat_admin">
                                                    Admin siap membantu melalui Live Chat / WA.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        {relatedProducts.length > 0 && (
            <section aria-labelledby="related-products-title" class="mt-12 pt-8 border-t border-gray-800">
                <div class="flex items-center gap-2 mb-6 border-l-4 border-cyan-400 pl-4">
                    <h2 id="related-products-title" class="text-xl font-bold text-white uppercase tracking-wide" data-i18n="product.you_might_like">
                        MUNGKIN ANDA SUKA
                    </h2>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
                    {relatedProducts.map((item) => {
                        const priceVal = parsePrice(item.price);
                        const regularVal = parsePrice(item.regularPrice);
                        const hasDiscount = regularVal > priceVal;
                        const discount = hasDiscount
                            ? Math.round(((regularVal - priceVal) / regularVal) * 100)
                            : 0;

                        return (
                            <a
                                href={`/product/${item.slug}`}
                                class="cyber-card bg-gray-900/50 border border-gray-800 hover:border-cyan-400 transition-all duration-300 group hover:-translate-y-1 block relative shadow-lg"
                            >
                                <div class="aspect-video bg-black relative overflow-hidden border-b border-gray-800">
                                    {item.image && item.image.sourceUrl ? (
                                        <img
                                            src={normalizeImgUrl(item.image.sourceUrl)}
                                            alt={item.name}
                                            width="300"
                                            height="300"
                                            class="w-full h-full object-contain transition duration-500 filter brightness-90 group-hover:brightness-100"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    ) : (
                                        <div class="flex items-center justify-center h-full text-gray-700 text-[10px]">
                                            NO IMG
                                        </div>
                                    )}

                                    <div class="absolute top-0 left-0 bg-black/80 backdrop-blur px-2 py-1 border-r border-b border-gray-800">
                                        <span class="text-[9px] text-cyan-400 font-bold uppercase tracking-wider">
                                            {item.productCategories?.nodes[0]?.name}
                                        </span>
                                    </div>

                                    {hasDiscount && (
                                        <div class="absolute top-2 right-0 bg-red-600/90 text-white px-2 py-0.5 text-[10px] font-black italic skew-x-[-10deg] shadow-[0_0_10px_rgba(220,38,38,0.7)] backdrop-blur-sm border-l border-red-400">
                                            <span data-i18n="product.save">HEMAT</span> {discount}%
                                        </div>
                                    )}
                                </div>
                                <div class="p-4">
                                    <h3 class="text-xs md:text-sm font-bold text-gray-200 leading-snug mb-3 line-clamp-2 h-[2.5em] group-hover:text-cyan-400 transition">
                                        {item.name}
                                    </h3>
                                    <div class="flex items-center justify-between border-t border-gray-800 pt-3">
                                        <div class="flex flex-col">
                                            {hasDiscount && (
                                                <span
                                                    class="price-tag text-[10px] text-gray-500 line-through decoration-red-500 decoration-2 font-mono leading-none mb-0.5"
                                                    data-price-idr={regularVal}
                                                >
                                                    {item.regularPrice}
                                                </span>
                                            )}
                                            <div class="text-cyan-400 font-mono text-sm md:text-lg font-bold price-tag" data-price-idr={priceVal}>
                                                {item.price || "Rp 0"}
                                            </div>
                                        </div>
                                        <div class="w-6 h-6 bg-gray-800 text-gray-400 flex items-center justify-center hover:bg-cyan-400 hover:text-black transition skew-x-[-10deg]">
                                            <div class="i-lucide-plus text-xs skew-x-[10deg]" />
                                        </div>
                                    </div>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </section>
        )}
    </main>

    <div class="lg:hidden fixed bottom-[52px] left-0 right-0 bg-black/95 backdrop-blur-lg border-t border-gray-800 px-4 py-2.5 z-40 shadow-[0_-10px_25px_rgba(0,0,0,0.8)]">
        <div id="mobile-auth-indicator" class="hidden items-center justify-between pb-1.5 mb-1.5 border-b border-gray-800/80">
            <div class="flex items-center gap-1.5 text-[10px] font-mono text-cyan-400 truncate">
                <div class="i-lucide-badge-check text-xs shrink-0"></div>
                <span class="text-gray-400">Kirim ke:</span>
                <span id="mobile-auth-email-label" class="font-bold text-white truncate max-w-[150px]">...</span>
            </div>
            <button type="button" onclick="window.toggleEditContact && window.toggleEditContact()" class="text-[9px] text-gray-500 hover:text-cyan-400 underline font-mono cursor-pointer">
                [Ganti]
            </button>
        </div>

        <div class="flex items-center justify-between gap-3">
            <div class="flex flex-col">
                {
                    hasDiscount && (
                        <div class="flex items-center gap-1.5 mb-0.5">
                            <span class="bg-red-600/90 text-white px-1.5 py-0.5 text-[8px] font-black italic skew-x-[-10deg] rounded-sm">
                                <span data-i18n="product.save">HEMAT</span> {discountPercent}%
                            </span>
                            <span
                                class="text-[10px] text-gray-500 line-through decoration-red-500 font-mono price-tag"
                                data-price-idr={pRegular}
                            >
                                {product.regularPrice}
                            </span>
                        </div>
                    )
                }
                <span class="text-lg font-mono font-bold text-cyan-400 leading-none price-tag" data-price-idr={pPrice}>
                    {product.price || "Rp 0"}
                </span>
            </div>
            <div class="flex gap-2 flex-1 max-w-[240px]">
                <button
                    type="button"
                    onclick="window.submitOrderForm && window.submitOrderForm(false)"
                    class="flex-1 bg-gray-800 text-white font-bold text-[10px] uppercase py-2.5 rounded border border-gray-700 active:scale-95 transition cursor-pointer"
                    data-i18n="product.add_to_cart"
                >
                    + Keranjang
                </button>
                <button
                    type="button"
                    id="mobile-buy-btn"
                    onclick="window.submitOrderForm && window.submitOrderForm(true)"
                    class="flex-1 bg-white text-black font-black text-[10px] uppercase py-2.5 rounded hover:bg-cyan-400 active:scale-95 shadow-[0_0_15px_rgba(255,255,255,0.2)] transition cursor-pointer"
                    data-i18n="product.buy_now"
                >
                    Beli Sekarang
                </button>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ product, galleryImages, pPrice }}>
        const clientGallery = galleryImages;
        const lightbox = document.getElementById("lightbox");
        const lbImg = document.getElementById("lightbox-img");
        const closeBtn = document.getElementById("close-lightbox");
        const trigger = document.getElementById("trigger-lightbox");

        const closeLb = () => {
            if (lightbox) {
                lightbox.classList.add("opacity-0");
                setTimeout(() => (lightbox.style.display = "none"), 300);
            }
        };

        window.openLightbox = (index) => {
            if (clientGallery[index] && lbImg && lightbox) {
                lbImg.src = clientGallery[index];
                lightbox.style.display = "flex";
                setTimeout(() => lightbox.classList.remove("opacity-0"), 10);
            }
        };

        window.changeImage = (index) => {
            const mainImg = document.querySelector("#trigger-lightbox img");
            if (mainImg && clientGallery[index]) {
                mainImg.src = clientGallery[index];
                mainImg.srcset = "";

                const thumbs = document.querySelectorAll(".shrink-0");
                thumbs.forEach((t, i) => {
                    if (i === index) {
                        t.classList.remove("border-gray-800", "opacity-60");
                        t.classList.add("border-cyan-400");
                    } else {
                        t.classList.add("border-gray-800", "opacity-60");
                        t.classList.remove("border-cyan-400");
                    }
                });
            }
        };

        if (trigger) {
            trigger.addEventListener("click", () => {
                const currentSrc = document.querySelector("#trigger-lightbox img")?.src;
                if (currentSrc && lbImg && lightbox) {
                    lbImg.src = currentSrc;
                    lightbox.style.display = "flex";
                    setTimeout(() => lightbox.classList.remove("opacity-0"), 10);
                }
            });
        }
        if (closeBtn) closeBtn.addEventListener("click", closeLb);
        if (lightbox) {
            lightbox.addEventListener("click", (e) => {
                if (e.target === lightbox) closeLb();
            });
        }

        function showToast(message) {
            const toast = document.getElementById("cyber-toast");
            const msgEl = document.getElementById("toast-message");
            if (!toast || !msgEl) return;
            msgEl.innerText = message;
            toast.classList.remove("translate-x-[150%]");
            toast.classList.add("translate-x-0");
            setTimeout(() => {
                toast.classList.remove("translate-x-0");
                toast.classList.add("translate-x-[150%]");
            }, 4000);
        }

        function checkUserSession() {
            const session = window.getSession ? window.getSession() : null;
            const savedEmail = session?.email || localStorage.getItem("yasui_buyer_email");
            const savedWa = localStorage.getItem("yasui_buyer_wa") || "";
            const savedDiscord = localStorage.getItem("yasui_buyer_discord") || "";
            const prefContact = savedWa || (savedDiscord ? `[Discord] ${savedDiscord}` : "");

            const form = document.getElementById("order-form");
            const authView = document.getElementById("auth-user-view");
            const guestView = document.getElementById("guest-user-view");
            const badge = document.getElementById("delivery-status-badge");
            const desktopBuyBtn = document.getElementById("btn-buy-now");
            const mobileAuthInd = document.getElementById("mobile-auth-indicator");
            const mobileEmailLabel = document.getElementById("mobile-auth-email-label");

            if (form) {
                const emailInp = form.querySelector('[name="user_email"]');
                const contactInp = form.querySelector('[name="contact_value"]');
                const methodSel = form.querySelector('[name="contact_method"]');

                if (emailInp && savedEmail && !emailInp.value) {
                    emailInp.value = savedEmail;
                }
                if (contactInp && !contactInp.value) {
                    if (savedWa) {
                        if (methodSel) methodSel.value = "whatsapp";
                        contactInp.value = savedWa;
                    } else if (savedDiscord) {
                        if (methodSel) methodSel.value = "discord";
                        contactInp.value = savedDiscord;
                    }
                }
            }

            if (savedEmail && prefContact) {
                if (authView && guestView) {
                    authView.classList.remove("hidden");
                    guestView.classList.add("hidden");
                    const dispEmail = document.getElementById("auth-display-email");
                    const dispContact = document.getElementById("auth-display-contact");
                    if (dispEmail) dispEmail.innerText = savedEmail;
                    if (dispContact) dispContact.innerText = prefContact;
                }
                if (badge) {
                    badge.innerText = "Member Terverifikasi";
                    badge.className = "text-[9px] font-mono px-2 py-0.5 rounded bg-cyan-950/50 text-cyan-400 border border-cyan-500/40 uppercase";
                }
                if (desktopBuyBtn) {
                    desktopBuyBtn.innerText = "Beli Langsung (1-Klik)";
                }
                if (mobileAuthInd) {
                    mobileAuthInd.classList.remove("hidden");
                    mobileAuthInd.classList.add("flex");
                }
                if (mobileEmailLabel) {
                    mobileEmailLabel.innerText = savedEmail;
                }
            }
        }

        window.toggleEditContact = () => {
            const authView = document.getElementById("auth-user-view");
            const guestView = document.getElementById("guest-user-view");
            if (authView && guestView) {
                authView.classList.toggle("hidden");
                guestView.classList.toggle("hidden");
            }
        };

        window.toggleDescription = () => {
            const desc = document.getElementById("product-desc-content");
            const btnText = document.getElementById("desc-btn-text");
            const btnIcon = document.getElementById("desc-btn-icon");
            const fade = document.getElementById("desc-expand-wrapper");

            if (!desc) return;
            const isCollapsed = desc.classList.contains("max-h-56");

            if (isCollapsed) {
                desc.classList.remove("max-h-56");
                if (btnText) btnText.innerText = "Tutup Deskripsi";
                if (btnIcon) btnIcon.classList.add("rotate-180");
                if (fade) fade.classList.remove("-mt-12", "bg-gradient-to-t");
            } else {
                desc.classList.add("max-h-56");
                if (btnText) btnText.innerText = "Baca Selengkapnya";
                if (btnIcon) btnIcon.classList.remove("rotate-180");
                if (fade) fade.classList.add("-mt-12", "bg-gradient-to-t");
            }
        };

        window.updateContactPlaceholder = () => {
            const form = document.getElementById("order-form");
            if (!form) return;
            const methodSelect = form.querySelector('[name="contact_method"]');
            const valueInput = form.querySelector('[name="contact_value"]');

            if (methodSelect && valueInput) {
                const isWA = methodSelect.value === "whatsapp";
                if (isWA) {
                    valueInput.type = "tel";
                    valueInput.placeholder = "0812-3456-xxxx";
                    valueInput.pattern = "^08[0-9]{8,13}$";
                } else {
                    valueInput.type = "text";
                    valueInput.placeholder = "Username#1234";
                    valueInput.pattern = "^.{3,32}$";
                }
            }
        };

        function getCart() {
            try {
                return JSON.parse(localStorage.getItem("yasui_cart") || "[]");
            } catch {
                return [];
            }
        }

        function saveCart(cart) {
            localStorage.setItem("yasui_cart", JSON.stringify(cart));
            document.dispatchEvent(new Event("yasui-cart-changed"));
        }

        window.submitOrderForm = (isDirectBuy) => {
            const form = document.getElementById("order-form");
            if (!form) return;

            if (!form.checkValidity()) {
                form.reportValidity();
                form.scrollIntoView({ behavior: "smooth", block: "center" });
                return;
            }

            const formData = new FormData(form);
            const userEmail = formData.get("user_email") || "";
            const contactMethod = formData.get("contact_method") || "whatsapp";
            const contactValue = formData.get("contact_value") || "";
            const playerInGameId = formData.get("player_in_game_id") || "";

            if (userEmail) {
                localStorage.setItem("yasui_buyer_email", userEmail);
            }
            if (contactMethod === "whatsapp" && contactValue) {
                localStorage.setItem("yasui_buyer_wa", contactValue);
            } else if (contactMethod === "discord" && contactValue) {
                localStorage.setItem("yasui_buyer_discord", contactValue);
            }

            const item = {
                id: product.databaseId || (product.id ? parseInt(atob(product.id).split(":")[1]) : 0),
                globalId: product.id,
                name: product.name,
                slug: product.slug,
                price: pPrice || (product.rawPrice ? parseInt(product.rawPrice) : 0),
                image: document.querySelector("#trigger-lightbox img")?.src || "",
                email: userEmail,
                contactMethod: contactMethod,
                contactValue: contactValue,
                playerInGameId: playerInGameId,
                wa: contactMethod === "whatsapp" ? contactValue : `[Discord] ${contactValue}`,
                timestamp: Date.now(),
            };

            const cart = getCart();
            cart.push(item);
            saveCart(cart);

            if (isDirectBuy) {
                window.location.href = "/cart";
            } else {
                showToast(`"${product.name}" ditambahkan ke keranjang!`);
                checkUserSession();
            }
        };

        checkUserSession();
    </script>
</Layout>
