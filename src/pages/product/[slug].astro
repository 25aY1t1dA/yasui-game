---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { parsePrice } from "../../lib/price";
import { getProductBySlug, getProducts, normalizeProduct } from "../../lib/wc";
import { sanitizeHtml } from "../../lib/sanitize";

const IS_PROD = import.meta.env.PROD;

const normalizeImgUrl = (url: string | null) => {
    if (!url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};

const { slug } = Astro.params;
let product: any = null;
let relatedProducts: any[] = [];
let galleryImages: any[] = [];
let prodMainSrc: any = null;
let prodGallerySrcs: any[] = [];

try {
    const rawProduct = await getProductBySlug(slug);
    if (rawProduct) {
        product = normalizeProduct(rawProduct);

        const rawMain = product.images?.[0]?.src || null;
        const rawGallery = (product.images || []).slice(1).map((img: any) => img.src);

        galleryImages = rawMain ? [normalizeImgUrl(rawMain)] : [];
        const proxyGallery = rawGallery.map((u: string) => normalizeImgUrl(u));
        galleryImages = [...galleryImages, ...proxyGallery];

        prodMainSrc = rawMain;
        prodGallerySrcs = rawGallery;

        const firstCategoryId = rawProduct.categories?.[0]?.id;
        if (firstCategoryId) {
            try {
                const rawRelated = await getProducts({ category: firstCategoryId, per_page: 5 });
                relatedProducts = (rawRelated || [])
                    .filter((p: any) => p.id !== rawProduct.id)
                    .slice(0, 4)
                    .map(normalizeProduct);
            } catch (e: any) {
                console.warn("Related product fetch warning:", e.message);
            }
        }
    }
} catch (error: any) {
    console.error("[Product REST Error]:", error);
}

if (!product) {
    return Astro.redirect("/404");
}

const pPrice = parsePrice(product.price);
const pRegular = parsePrice(product.regularPrice);
const hasDiscount = pRegular > pPrice;
const discountPercent = hasDiscount
    ? Math.round(((pRegular - pPrice) / pRegular) * 100)
    : 0;

const attributes = product.attributes?.nodes || [];

const getAttributeStyle = (attr: any) => {
    const lowerName = attr.name.toLowerCase();
    const value = attr.options?.[0] || "";
    const lowerValue = value.toLowerCase();

    if (lowerName.includes("age") || lowerName.includes("umur") || lowerName.includes("band")) {
        const isOld = lowerValue.startsWith("old") || lowerValue.includes("tua");
        return {
            icon: isOld ? "i-lucide-hourglass" : "i-lucide-sparkles",
            label: isOld ? "AKUN TUA" : "FRESH",
            valueClass: isOld ? "text-[#94A3B8]" : "text-emerald-400",
            wrapperClass: "border-[#222634] bg-[#0D0F15]",
        };
    }

    if (lowerName.includes("server")) {
        return {
            icon: "i-lucide-globe",
            label: "SERVER",
            valueClass: "text-[#00E5FF]",
            wrapperClass: "border-[#222634] bg-[#0D0F15]",
        };
    }

    if (
        lowerName.includes("tier") ||
        lowerName.includes("rank") ||
        lowerName.includes("account")
    ) {
        let colorClass = "text-[#94A3B8]";
        if (lowerValue.includes("fresh") || lowerValue.includes("new"))
            colorClass = "text-emerald-400";
        else if (lowerValue.includes("mid")) colorClass = "text-[#00E5FF]";
        else if (lowerValue.includes("end") || lowerValue.includes("high"))
            colorClass = "text-amber-400";

        return {
            icon: "i-lucide-bar-chart-2",
            label: "TIER / RANK",
            valueClass: colorClass,
            wrapperClass: "border-[#222634] bg-[#0D0F15]",
        };
    }

    return {
        icon: "i-lucide-tag",
        label: attr.name.toUpperCase(),
        valueClass: "text-[#94A3B8]",
        wrapperClass: "border-[#222634] bg-[#0D0F15]",
    };
};

const categoryName = product.categories?.[0]?.name || product.productCategories?.nodes?.[0]?.name || "Game";
const categorySlug = product.categories?.[0]?.slug || product.productCategories?.nodes?.[0]?.slug || "categories";

const allCategorySlugs = [
    ...(product.categories || []).map((c: any) => c.slug || ""),
    ...(product.productCategories?.nodes || []).map((c: any) => c.slug || "")
].map((s: string) => s.toLowerCase());

const prodNameLower = (product.name || "").toLowerCase();

const isSummonersWar = allCategorySlugs.some((s: string) => s.includes("summoners-war")) || prodNameLower.includes("summoners war");
const isRoblox = allCategorySlugs.some((s: string) => s.includes("roblox") || s.includes("robux")) || prodNameLower.includes("roblox") || prodNameLower.includes("robux");
const isAccount = isSummonersWar || allCategorySlugs.some((s: string) => s.includes("akun")) || prodNameLower.includes("akun");
const isItemOrTopup = allCategorySlugs.some((s: string) => s.includes("item") || s.includes("top-up") || s.includes("topup") || s.includes("robux") || s.includes("currency") || s.includes("diamond")) || prodNameLower.includes("top up") || prodNameLower.includes("top-up") || prodNameLower.includes("item");

// Show Roblox / Player ID field ONLY if it is Roblox or Item/Top-up, and NOT an Account product (like Summoners War)
const showPlayerIdField = (isRoblox || isItemOrTopup) && !isAccount;

const schema = {
    "@context": "https://schema.org/",
    "@type": "Product",
    name: product.name,
    description: product.shortDescription,
    sku: product.slug,
    image: product.image?.sourceUrl,
    offers: {
        "@type": "Offer",
        priceCurrency: "IDR",
        price: product.rawPrice || 0,
        availability: "https://schema.org/InStock",
        url: Astro.url.href,
    },
};
---

<Layout title={`${product.name} - Yasui Game`} description={product.shortDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    {/* Tactical Cyber Toast */}
    <div
        id="cyber-toast"
        class="fixed top-20 right-4 z-[100] translate-x-[150%] transition-transform duration-300 flex items-center gap-3 bg-[#11131A] border border-[#00E5FF] p-3.5 rounded-md shadow-2xl max-w-xs md:max-w-md"
    >
        <div class="w-7 h-7 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/20 flex items-center justify-center shrink-0">
            <span class="i-lucide-check text-base"></span>
        </div>
        <div class="min-w-0">
            <h4 class="text-xs font-mono font-bold text-[#F8FAFC] uppercase tracking-wider" data-i18n="product.toast_added_title">Item Ditambahkan</h4>
            <p id="toast-message" class="text-[11px] text-[#94A3B8] font-mono truncate" data-i18n="product.toast_added_desc">Pesanan masuk ke keranjang.</p>
        </div>
    </div>

    {/* Image Lightbox */}
    <div
        id="lightbox"
        style="display: none;"
        class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm flex flex-col justify-center items-center opacity-0 transition-opacity duration-200"
    >
        <button
            id="close-lightbox"
            class="yg-btn-icon absolute top-4 right-4 z-50 text-[#F8FAFC]"
            aria-label="Tutup Lightbox"
        >
            <span class="i-lucide-x text-base"></span>
        </button>
        <div class="relative w-full max-w-5xl aspect-video flex items-center justify-center p-4">
            <img
                id="lightbox-img"
                src=""
                alt="Product preview"
                class="max-h-[80vh] max-w-full object-contain rounded-lg border border-[#222634]"
            />
        </div>
    </div>

    <main class="yg-shell pt-4 md:pt-6 pb-36 lg:pb-28" data-product-title={product.name} data-product-slug={product.slug}>
        <nav
            class="flex py-3 text-[#64748B] text-[10px] font-mono uppercase tracking-wider overflow-x-auto"
            aria-label="Breadcrumb"
        >
            <ol class="flex items-center space-x-2 whitespace-nowrap">
                <li><a href="/" class="hover:text-[#00E5FF] transition-colors" data-i18n="nav.home">HOME</a></li>
                <li><span class="text-[#262B3D]">/</span></li>
                <li>
                    <a href={`/category/${categorySlug}`} class="hover:text-[#00E5FF] transition-colors">
                        {categoryName}
                    </a>
                </li>
                <li><span class="text-[#262B3D]">/</span></li>
                <li class="text-[#F8FAFC] font-bold truncate max-w-[200px]">{product.name}</li>
            </ol>
        </nav>

        {/* 2-Column Responsive Layout */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start mt-2">
            
            {/* Kolom Kiri: Galeri + Tab Spesifikasi & Deskripsi */}
            <div class="lg:col-span-7 w-full space-y-6">
                <div class="space-y-3">
                    <div
                        class="relative rounded-lg overflow-hidden border border-[#222634] bg-[#0D0F15] aspect-video cursor-pointer group flex items-center justify-center"
                        id="trigger-lightbox"
                    >
                        <div class="absolute top-2.5 right-2.5 bg-[#090A0F]/80 backdrop-blur-sm px-2 py-1 rounded border border-[#222634] text-[#F8FAFC] text-[10px] font-mono flex items-center gap-1 z-20 pointer-events-none">
                            <span class="i-lucide-maximize-2 text-xs text-[#00E5FF]"></span>
                            <span>ZOOM</span>
                        </div>
                        {galleryImages.length > 0 && galleryImages[0] ? (
                            IS_PROD ? (
                                <Image
                                    src={prodMainSrc}
                                    alt={product.name}
                                    width={600}
                                    height={600}
                                    format="webp"
                                    class="w-full h-full object-contain bg-[#090A0F]"
                                    loading="eager"
                                />
                            ) : (
                                <img
                                    src={galleryImages[0]}
                                    alt={product.name}
                                    width="600"
                                    height="600"
                                    class="w-full h-full object-contain bg-[#090A0F]"
                                    loading="eager"
                                    decoding="async"
                                />
                            )
                        ) : (
                            <div class="flex items-center justify-center h-full text-[#64748B] text-xs font-mono">
                                NO VISUAL DATA
                            </div>
                        )}
                    </div>

                    {galleryImages.length > 1 && (
                        <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-none">
                            {galleryImages.map((img, index) => (
                                <button
                                    type="button"
                                    class={`gallery-thumb shrink-0 w-20 aspect-video bg-[#0D0F15] rounded-md border cursor-pointer overflow-hidden transition-all duration-150 ${index === 0 ? "border-[#00E5FF]" : "border-[#222634] opacity-60 hover:opacity-100 hover:border-[#2E3446]"}`}
                                    onclick={`window.changeImage(${index})`}
                                    aria-label={`Lihat gambar ${index + 1}`}
                                >
                                    {img ? (
                                        IS_PROD && prodGallerySrcs[index - 1] ? (
                                            <Image
                                                src={prodGallerySrcs[index - 1]}
                                                alt={`${product.name} gallery ${index + 1}`}
                                                width={300}
                                                height={300}
                                                format="webp"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                            />
                                        ) : IS_PROD && index === 0 && prodMainSrc ? (
                                            <Image
                                                src={prodMainSrc}
                                                alt={`${product.name} main`}
                                                width={300}
                                                height={300}
                                                format="webp"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <img
                                                src={img}
                                                alt={`${product.name} gallery ${index + 1}`}
                                                width="300"
                                                height="300"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        )
                                    ) : (
                                        <div class="w-full h-full bg-[#11131A] flex items-center justify-center text-[10px] text-[#64748B] font-mono">
                                            No Img
                                        </div>
                                    )}
                                </button>
                            ))}
                        </div>
                    )}
                </div>

                {/* Spesifikasi & Deskripsi Section */}
                <div class="space-y-4 pt-2">
                    {attributes.length > 0 && (
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#00E5FF] flex items-center gap-1.5">
                                    <span class="i-lucide-settings-2 text-xs"></span>
                                    <span data-i18n="product.specs_title">Spesifikasi Akun / Item</span>
                                </h2>
                                <span class="text-[10px] font-mono text-[#64748B]" data-i18n="product.specs_verified">Terverifikasi</span>
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                {attributes.map((attr: any) => {
                                    const style = getAttributeStyle(attr);
                                    return (
                                        <div class={`p-3 rounded-md flex flex-col justify-between gap-1.5 border border-[#222634] bg-[#0D0F15]`}>
                                            <div class="flex items-center gap-1.5 text-[#94A3B8]">
                                                <span class={`${style.icon} text-xs text-[#00E5FF]`} />
                                                <span class="text-[9px] font-mono font-bold uppercase tracking-wider">
                                                    {style.label}
                                                </span>
                                            </div>
                                            <div class={`text-xs md:text-sm font-mono font-bold ${style.valueClass} truncate`}>
                                                {attr.options?.[0] || "-"}
                                            </div>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    )}

                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <h2
                                class="text-xs font-mono font-bold uppercase tracking-wider text-[#00E5FF] flex items-center gap-1.5"
                                data-i18n="product.description"
                            >
                                <span class="i-lucide-file-text text-xs"></span>
                                <span>Deskripsi Produk</span>
                            </h2>
                            <span class="text-[10px] font-mono text-[#64748B]" data-i18n="product.official_guarantee">Garansi Resmi Yasui</span>
                        </div>

                        <div class="yg-card p-4 md:p-6 rounded-lg bg-[#11131A] border border-[#222634] relative">
                            <div
                                id="product-desc-content"
                                class="prose prose-invert prose-sm max-w-none text-[#94A3B8] leading-relaxed max-h-56 md:max-h-none overflow-hidden transition-all duration-300 relative [&_p]:text-xs md:[&_p]:text-sm [&_p]:leading-relaxed [&_p]:text-[#94A3B8] [&_p]:mb-3 [&_h1]:text-sm [&_h1]:font-bold [&_h1]:text-[#F8FAFC] [&_h1]:mb-2 [&_h2]:text-xs md:[&_h2]:text-sm [&_h2]:font-bold [&_h2]:text-[#00E5FF] [&_h2]:mb-2 [&_h3]:text-xs [&_h3]:font-bold [&_h3]:text-[#F8FAFC] [&_h3]:mb-1.5 [&_ul]:space-y-1.5 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:text-xs md:[&_li]:text-sm [&_li]:text-[#94A3B8] [&_a]:text-[#00E5FF] [&_a]:underline hover:[&_a]:text-[#33EBFF] [&_strong]:text-[#F8FAFC]"
                                set:html={sanitizeHtml(
                                    product.description || product.shortDescription,
                                )}
                            />

                            <div
                                id="desc-expand-wrapper"
                                class="md:hidden pt-8 -mt-10 bg-gradient-to-t from-[#11131A] via-[#11131A]/90 to-transparent relative z-10 flex justify-center"
                            >
                                <button
                                    type="button"
                                    id="desc-expand-btn"
                                    onclick="window.toggleDescription && window.toggleDescription()"
                                    class="yg-btn-secondary text-[11px] py-1.5 px-3 rounded-full flex items-center gap-1"
                                >
                                    <span id="desc-btn-text" data-i18n="product.read_more">Baca Selengkapnya</span>
                                    <span id="desc-btn-icon" class="i-lucide-chevron-down text-xs transition-transform duration-200"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {/* Kolom Kanan: Sticky Purchase Box */}
            <div class="lg:col-span-5 w-full relative">
                <div class="sticky top-24 yg-card p-5 md:p-6 rounded-lg bg-[#11131A] border border-[#222634] space-y-5 shadow-2xl">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-2">
                            <span class={isAccount ? "yg-badge-instant" : "yg-badge-online"} data-i18n={isAccount ? "product.instant_delivery_badge" : "product.online_delivery_badge"}>
                                {isAccount ? "INSTANT DELIVERY" : "ONLINE DELIVERY"}
                            </span>
                            <span class="text-[10px] font-mono text-[#64748B] uppercase">
                                {categoryName}
                            </span>
                        </div>

                        <h1 class="text-lg md:text-2xl font-extrabold text-[#F8FAFC] tracking-tight leading-snug mb-3">
                            {product.name}
                        </h1>

                        <div class="flex items-center gap-2.5 mb-3 text-xs font-mono">
                            <span class="yg-badge-emerald">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span data-i18n="product.stock_ready">Stok Siap Kirim</span>
                            </span>
                            <span class="text-[#94A3B8] text-[11px]" data-i18n="product.auto_process">Proses Otomatis 1–5 Menit</span>
                        </div>

                        {/* Price Tag */}
                        <div class="flex items-baseline gap-3 py-3 border-y border-[#222634]">
                            {hasDiscount && (
                                <div class="flex flex-col items-start">
                                    <span class="bg-red-500/10 border border-red-500/30 text-red-400 font-mono text-[10px] px-1.5 py-0.2 rounded font-bold mb-0.5">
                                        <span data-i18n="product.save">HEMAT</span> {discountPercent}%
                                    </span>
                                    <span
                                        class="text-xs text-[#64748B] line-through font-mono tabular-nums price-tag"
                                        data-price-idr={pRegular}
                                    >
                                        {product.regularPrice}
                                    </span>
                                </div>
                            )}
                            <span
                                class="yg-price text-2xl md:text-3xl text-[#00E5FF] price-tag"
                                data-price-idr={pPrice}
                            >
                                {product.price || "Rp 0"}
                            </span>
                        </div>
                    </div>

                    {/* Trust Summary Cards */}
                    <div class="grid grid-cols-2 gap-2 text-xs font-mono">
                        <div class="p-2.5 rounded-md bg-[#0D0F15] border border-[#222634] flex items-center gap-2">
                            <span class="i-lucide-zap text-[#00E5FF] text-base shrink-0"></span>
                            <div>
                                <span class="block text-[11px] font-bold text-[#F8FAFC]" data-i18n="product.instant_delivery">Instant Delivery</span>
                                <span class="text-[9px] text-[#94A3B8]" data-i18n="product.auto_credentials">Kredensial Otomatis</span>
                            </div>
                        </div>
                        <div class="p-2.5 rounded-md bg-[#0D0F15] border border-[#222634] flex items-center gap-2">
                            <span class="i-lucide-shield-check text-emerald-400 text-base shrink-0"></span>
                            <div>
                                <span class="block text-[11px] font-bold text-[#F8FAFC]" data-i18n="product.warranty_30d">Garansi 30 Hari</span>
                                <span class="text-[9px] text-[#94A3B8]" data-i18n="product.anti_hackback">100% Anti-Hackback</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-2.5">
                        <button
                            type="button"
                            onclick={`window.openLiveChatModal && window.openLiveChatModal(${JSON.stringify(product.name)})`}
                            class="w-full py-2 px-3 rounded-md bg-[#161922] hover:bg-[#1E2230] border border-[#222634] hover:border-[#00E5FF]/40 text-[#94A3B8] hover:text-[#00E5FF] text-[11px] font-mono transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
                        >
                            <div class="i-lucide-headset text-xs text-[#00E5FF]"></div>
                            <span data-i18n="product.ask_admin">Tanya Admin tentang Akun Ini</span>
                        </button>
                    </div>

                    {/* Desktop Single Purchase Form (Hidden on Mobile < lg) */}
                    <form id="order-form" class="hidden lg:block space-y-4">
                        <div
                            id="auth-user-view"
                            class="hidden bg-[#00E5FF]/5 border border-[#00E5FF]/25 rounded-md p-3 space-y-2 text-xs font-mono"
                        >
                            <div class="flex items-center justify-between border-b border-[#00E5FF]/20 pb-1.5">
                                <span class="text-[#00E5FF] font-bold flex items-center gap-1">
                                    <span class="i-lucide-badge-check text-xs"></span>
                                    <span data-i18n="product.verified_member">Member Terverifikasi</span>
                                </span>
                                <button
                                    type="button"
                                    onclick="window.toggleEditContact && window.toggleEditContact()"
                                    class="text-[10px] text-[#94A3B8] hover:text-[#00E5FF] underline cursor-pointer"
                                    data-i18n="product.change_data"
                                >
                                    [Ubah Data]
                                </button>
                            </div>
                            <div class="text-[#F8FAFC] truncate">
                                <span class="text-[#64748B] text-[10px] uppercase">Email: </span>
                                <strong id="auth-display-email">...</strong>
                            </div>
                            <div class="text-[#94A3B8] truncate">
                                <span class="text-[#64748B] text-[10px] uppercase">Kontak: </span>
                                <strong id="auth-display-contact" class="text-[#F8FAFC]">...</strong>
                            </div>
                        </div>

                        <div id="guest-user-view" class="space-y-3">
                            <div class="space-y-1">
                                <label
                                    for="user-email-input"
                                    class="text-[10px] font-mono font-bold text-[#94A3B8] uppercase flex justify-between"
                                >
                                    <span data-i18n="product.email_label">Email Penerima (Wajib)</span>
                                    <span class="text-[9px] text-[#00E5FF]" data-i18n="product.email_purpose">Pengiriman Akun</span>
                                </label>
                                <input
                                    type="email"
                                    id="user-email-input"
                                    name="user_email"
                                    required
                                    autocomplete="email"
                                    class="yg-input !h-10 !text-xs !bg-[#0D0F17]"
                                    placeholder="nama@email.com"
                                />
                            </div>

                            <div class="grid grid-cols-3 gap-2">
                                <div class="col-span-1 space-y-1">
                                    <label for="contact-method-select" class="text-[10px] font-mono font-bold text-[#94A3B8] uppercase" data-i18n="product.contact_method">
                                        Metode
                                    </label>
                                    <select
                                        id="contact-method-select"
                                        name="contact_method"
                                        class="yg-select w-full !h-10 !text-xs"
                                        onchange="window.updateContactPlaceholder && window.updateContactPlaceholder('order-form')"
                                    >
                                        <option value="whatsapp">WhatsApp</option>
                                        <option value="discord">Discord</option>
                                    </select>
                                </div>
                                <div class="col-span-2 space-y-1">
                                    <label for="contact-value-input" class="text-[10px] font-mono font-bold text-[#94A3B8] uppercase" data-i18n="product.contact_label">
                                        Nomor WA / Discord ID
                                    </label>
                                    <input
                                        type="tel"
                                        id="contact-value-input"
                                        name="contact_value"
                                        required
                                        autocomplete="tel"
                                        class="yg-input !h-10 !text-xs !bg-[#0D0F17]"
                                        placeholder="0812-3456-xxxx"
                                        pattern="^08[0-9]{8,13}$"
                                        title="Nomor WhatsApp harus diawali 08 dan terdiri dari 10-15 angka"
                                    />
                                </div>
                            </div>

                            {showPlayerIdField && (
                                <div id="game-player-id-field" class="space-y-1">
                                    <label for="player-id-input" class="text-[10px] font-mono font-bold text-[#94A3B8] uppercase flex justify-between">
                                        <span data-i18n="product.player_id_label">Username Roblox / ID Pemain</span>
                                        <span class="text-[9px] text-[#00E5FF] font-mono" data-i18n="product.player_id_purpose">(Item / Gift / Trade)</span>
                                    </label>
                                    <input
                                        type="text"
                                        id="player-id-input"
                                        name="player_in_game_id"
                                        autocomplete="off"
                                        class="yg-input !h-10 !text-xs !bg-[#0D0F17]"
                                        placeholder="Contoh: RobloxUsername atau ID Akun"
                                        data-i18n-placeholder="product.player_id_placeholder"
                                    />
                                </div>
                            )}

                            <p class="text-[10px] font-mono text-[#94A3B8] leading-tight flex items-center gap-1.5 pt-0.5">
                                <span class="i-lucide-shield-check text-[#00E5FF] text-xs shrink-0"></span>
                                <span data-i18n="product.credentials_note">Kredensial login dikirim otomatis ke email di atas pasca konfirmasi bayar.</span>
                            </p>
                        </div>

                        {/* CTA Buttons */}
                        <div class="grid grid-cols-2 gap-2.5 pt-2">
                            <button
                                type="button"
                                id="btn-add-to-cart"
                                onclick="window.submitOrderForm && window.submitOrderForm(false)"
                                class="yg-btn-secondary py-3 text-xs"
                                data-i18n="product.add_to_cart"
                            >
                                + Keranjang
                            </button>
                            <button
                                type="button"
                                id="btn-buy-now"
                                onclick="window.submitOrderForm && window.submitOrderForm(true)"
                                class="yg-btn-primary py-3 text-xs"
                                data-i18n="product.buy_now"
                            >
                                Beli Sekarang
                            </button>
                        </div>
                    </form>

                    {/* Official Gateway Security Note */}
                    <div class="pt-3 border-t border-[#222634] text-[11px] font-mono text-[#94A3B8] space-y-2">
                        <div class="flex items-center gap-2">
                            <span class="i-lucide-credit-card text-[#00E5FF] text-xs"></span>
                            <span data-i18n="product.secure_payment_note">Pembayaran Aman via Duitku (QRIS / VA / E-Wallet)</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="i-lucide-headset text-[#00E5FF] text-xs"></span>
                            <span data-i18n="product.cs_ready_note">Bantuan CS Siap 24/7 via WhatsApp & Live Chat</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {/* Related Products */}
        {relatedProducts.length > 0 && (
            <section aria-labelledby="related-products-title" class="mt-14 pt-8 border-t border-[#222634]">
                <div class="flex items-center gap-2 mb-5">
                    <span class="w-1 h-4 bg-[#00E5FF] rounded-sm" aria-hidden="true"></span>
                    <h2 id="related-products-title" class="text-xs md:text-sm font-bold text-[#F8FAFC] uppercase tracking-wider" data-i18n="product.you_might_like">
                        Produk Terkait Lainnya
                    </h2>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-3 md:gap-4">
                    {relatedProducts.map((item) => {
                        const priceVal = parsePrice(item.price);
                        const regularVal = parsePrice(item.regularPrice);
                        const hasDiscount = regularVal > priceVal;
                        const discount = hasDiscount
                            ? Math.round(((regularVal - priceVal) / regularVal) * 100)
                            : 0;

                        return (
                            <a
                                href={`/product/${item.slug}`}
                                class="yg-product-card group flex flex-col justify-between"
                            >
                                <div>
                                    <div class="aspect-video bg-[#090A0F] relative overflow-hidden border-b border-[#222634] flex items-center justify-center">
                                        {item.image && item.image.sourceUrl ? (
                                            <img
                                                src={normalizeImgUrl(item.image.sourceUrl)}
                                                alt={item.name}
                                                width="300"
                                                height="300"
                                                class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        ) : (
                                            <div class="flex items-center justify-center h-full text-[#64748B] text-xs font-mono">
                                                NO VISUAL
                                            </div>
                                        )}

                                        <div class="absolute top-2 left-2">
                                            <span class="yg-badge-overlay text-[10px]">
                                                {item.productCategories?.nodes[0]?.name || "GAME"}
                                            </span>
                                        </div>

                                        {hasDiscount && (
                                            <div class="absolute top-2 right-2 bg-[#090A0F]/90 backdrop-blur-md border border-red-500/40 text-red-400 font-mono text-[10px] px-1.5 py-0.5 rounded font-bold shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
                                                -{discount}%
                                            </div>
                                        )}
                                    </div>

                                    <div class="p-3">
                                        <h3 class="line-clamp-2 text-xs md:text-sm font-medium text-[#F8FAFC] leading-snug group-hover:text-[#00E5FF] transition-colors mb-2">
                                            {item.name}
                                        </h3>
                                    </div>
                                </div>

                                <div class="p-3 pt-0 border-t border-[#222634]/60 mt-auto">
                                    <div class="flex items-center justify-between pt-2">
                                        <div class="flex flex-col">
                                            {hasDiscount && (
                                                <span
                                                    class="price-tag text-[10px] text-[#64748B] line-through font-mono tabular-nums leading-none mb-0.5"
                                                    data-price-idr={regularVal}
                                                >
                                                    {item.regularPrice}
                                                </span>
                                            )}
                                            <span class="yg-price text-xs sm:text-sm md:text-base text-[#00E5FF] price-tag" data-price-idr={priceVal}>
                                                {item.price || "Rp 0"}
                                            </span>
                                        </div>
                                        <span class="text-[10px] font-mono text-emerald-400 flex items-center gap-1">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                            Ready
                                        </span>
                                    </div>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </section>
        )}
    </main>

    {/* Mobile Bottom Fixed Bar */}
    <div class="lg:hidden fixed bottom-[52px] left-0 right-0 bg-[#090A0F]/95 backdrop-blur-md border-t border-[#222634] px-4 py-2.5 z-40">
        <div class="flex items-center justify-between gap-3">
            <div class="flex flex-col min-w-0">
                {hasDiscount && (
                    <span class="text-[10px] text-[#64748B] line-through font-mono tabular-nums leading-none price-tag" data-price-idr={pRegular}>
                        {product.regularPrice}
                    </span>
                )}
                <span class="text-base font-mono font-bold text-[#00E5FF] leading-tight tabular-nums price-tag" data-price-idr={pPrice}>
                    {product.price || "Rp 0"}
                </span>
            </div>
            <div class="flex gap-2 flex-1 max-w-[240px]">
                <button
                    type="button"
                    onclick="window.openMobileDrawer && window.openMobileDrawer(false)"
                    class="yg-btn-secondary flex-1 py-2 text-[10px]"
                    data-i18n="product.add_to_cart"
                >
                    + Keranjang
                </button>
                <button
                    type="button"
                    onclick="window.openMobileDrawer && window.openMobileDrawer(true)"
                    class="yg-btn-primary flex-1 py-2 text-[10px]"
                    data-i18n="product.buy_now"
                >
                    Beli Langsung
                </button>
            </div>
        </div>
    </div>

    {/* Mobile Slide-Up Bottom Sheet Drawer */}
    <div
        id="mobile-drawer-backdrop"
        class="lg:hidden fixed inset-0 z-[120] bg-[#090A0F]/80 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none"
        aria-hidden="true"
    >
        <div
            id="mobile-drawer-sheet"
            class="absolute bottom-0 left-0 right-0 max-h-[85vh] bg-[#11131A] border-t border-[#222634] rounded-t-2xl p-5 shadow-2xl flex flex-col transform translate-y-full transition-transform duration-300 ease-out overflow-y-auto"
            onclick="event.stopPropagation()"
        >
            <div class="w-10 h-1 bg-[#222634] rounded-full mx-auto mb-3 shrink-0"></div>

            <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#222634]">
                <div class="min-w-0 pr-3">
                    <span class="text-[10px] font-mono text-[#00E5FF] uppercase tracking-wider block" data-i18n={isAccount ? "product.drawer_account_delivery" : "product.drawer_digital_delivery"}>
                        {isAccount ? "PENGIRIMAN AKUN" : "PENGIRIMAN DIGITAL"}
                    </span>
                    <h3 class="text-sm font-bold text-[#F8FAFC] font-mono truncate">
                        {product.name}
                    </h3>
                    <span class="yg-price text-sm text-[#00E5FF] tabular-nums mt-0.5 block" data-price-idr={pPrice}>
                        {product.price || "Rp 0"}
                    </span>
                </div>
                <button
                    type="button"
                    onclick="window.closeMobileDrawer && window.closeMobileDrawer()"
                    class="yg-btn-icon shrink-0"
                    aria-label="Tutup Form Pembelian"
                >
                    <span class="i-lucide-x text-sm"></span>
                </button>
            </div>

            <form id="mobile-drawer-form" class="space-y-4">
                <div
                    id="drawer-auth-user-view"
                    class="hidden bg-[#00E5FF]/5 border border-[#00E5FF]/25 rounded-md p-3 space-y-1.5 text-xs font-mono"
                >
                    <div class="flex items-center justify-between border-b border-[#00E5FF]/20 pb-1">
                        <span class="text-[#00E5FF] font-bold flex items-center gap-1 text-[11px]">
                            <span class="i-lucide-badge-check text-xs"></span>
                            <span data-i18n="product.verified_member">Member Terverifikasi</span>
                        </span>
                        <button
                            type="button"
                            onclick="window.toggleDrawerEditContact && window.toggleDrawerEditContact()"
                            class="text-[10px] text-[#94A3B8] hover:text-[#00E5FF] underline cursor-pointer"
                            data-i18n="product.change_data"
                        >
                            [Ubah Data]
                        </button>
                    </div>
                    <div class="text-[#F8FAFC] truncate text-[11px]">
                        <span class="text-[#64748B] text-[10px] uppercase">Email: </span>
                        <strong id="drawer-auth-display-email">...</strong>
                    </div>
                    <div class="text-[#94A3B8] truncate text-[11px]">
                        <span class="text-[#64748B] text-[10px] uppercase">Kontak: </span>
                        <strong id="drawer-auth-display-contact" class="text-[#F8FAFC]">...</strong>
                    </div>
                </div>

                <div id="drawer-guest-user-view" class="space-y-3">
                    <div class="space-y-1">
                        <label
                            for="drawer-email-input"
                            class="text-[10px] font-mono font-bold text-[#94A3B8] uppercase flex justify-between"
                        >
                            <span data-i18n="product.email_label">Email Penerima (Wajib)</span>
                            <span class="text-[9px] text-[#00E5FF]" data-i18n="product.email_purpose">Kirim Kredensial</span>
                        </label>
                        <input
                            type="email"
                            id="drawer-email-input"
                            name="user_email"
                            required
                            autocomplete="email"
                            class="yg-input !h-10 !text-xs !bg-[#0D0F17]"
                            placeholder="nama@email.com"
                        />
                    </div>

                    <div class="grid grid-cols-3 gap-2">
                        <div class="col-span-1 space-y-1">
                            <label for="drawer-contact-method-select" class="text-[10px] font-mono font-bold text-[#94A3B8] uppercase" data-i18n="product.contact_method">
                                Metode
                            </label>
                            <select
                                id="drawer-contact-method-select"
                                name="contact_method"
                                class="yg-select w-full !h-10 !text-xs"
                                onchange="window.updateContactPlaceholder && window.updateContactPlaceholder('mobile-drawer-form')"
                            >
                                <option value="whatsapp">WhatsApp</option>
                                <option value="discord">Discord</option>
                            </select>
                        </div>
                        <div class="col-span-2 space-y-1">
                            <label for="drawer-contact-value-input" class="text-[10px] font-mono font-bold text-[#94A3B8] uppercase" data-i18n="product.contact_label">
                                Nomor WA / Discord ID
                            </label>
                            <input
                                type="tel"
                                id="drawer-contact-value-input"
                                name="contact_value"
                                required
                                autocomplete="tel"
                                class="yg-input !h-10 !text-xs !bg-[#0D0F17]"
                                placeholder="0812-3456-xxxx"
                                pattern="^08[0-9]{8,13}$"
                                title="Nomor WhatsApp harus diawali 08 dan terdiri dari 10-15 angka"
                            />
                        </div>
                    </div>

                    {showPlayerIdField && (
                        <div class="space-y-1">
                            <label for="drawer-player-id-input" class="text-[10px] font-mono font-bold text-[#94A3B8] uppercase flex justify-between">
                                <span data-i18n="product.player_id_label">Username Roblox / ID Pemain</span>
                                <span class="text-[9px] text-[#00E5FF] font-mono" data-i18n="product.player_id_purpose">(Item / Gift / Trade)</span>
                            </label>
                            <input
                                type="text"
                                id="drawer-player-id-input"
                                name="player_in_game_id"
                                autocomplete="off"
                                class="yg-input !h-10 !text-xs !bg-[#0D0F17]"
                                placeholder="Contoh: RobloxUsername atau ID Akun"
                                data-i18n-placeholder="product.player_id_placeholder"
                            />
                        </div>
                    )}

                    <p class="text-[10px] font-mono text-[#94A3B8] leading-tight flex items-center gap-1.5 pt-0.5">
                        <span class="i-lucide-shield-check text-[#00E5FF] text-xs shrink-0"></span>
                        <span data-i18n="product.credentials_note">Kredensial login dikirim otomatis ke email di atas pasca pembayaran.</span>
                    </p>
                </div>

                <div class="pt-2">
                    <button
                        type="submit"
                        id="drawer-submit-btn"
                        class="w-full yg-btn-primary py-3 text-xs"
                        data-i18n="product.continue_checkout"
                    >
                        Lanjutkan Checkout
                    </button>
                </div>
            </form>
        </div>
    </div>

    <style>
        /* Ensure floating CS widget stays safely above mobile bottom action bar */
        :global(#mobile-cs-container) {
            bottom: 124px !important;
        }
    </style>

    <script is:inline define:vars={{ product, galleryImages, pPrice }}>
        const clientGallery = galleryImages;
        const lightbox = document.getElementById("lightbox");
        const lbImg = document.getElementById("lightbox-img");
        const closeBtn = document.getElementById("close-lightbox");
        const trigger = document.getElementById("trigger-lightbox");

        const closeLb = () => {
            if (lightbox) {
                lightbox.classList.add("opacity-0");
                setTimeout(() => (lightbox.style.display = "none"), 200);
            }
        };

        window.openLightbox = (index) => {
            if (clientGallery[index] && lbImg && lightbox) {
                lbImg.src = clientGallery[index];
                lightbox.style.display = "flex";
                setTimeout(() => lightbox.classList.remove("opacity-0"), 10);
            }
        };

        window.changeImage = (index) => {
            const mainImg = document.querySelector("#trigger-lightbox img");
            if (mainImg && clientGallery[index]) {
                mainImg.src = clientGallery[index];
                mainImg.srcset = "";

                const thumbs = document.querySelectorAll(".gallery-thumb");
                thumbs.forEach((t, i) => {
                    if (i === index) {
                        t.classList.remove("border-[#222634]", "opacity-60");
                        t.classList.add("border-[#00E5FF]");
                    } else {
                        t.classList.add("border-[#222634]", "opacity-60");
                        t.classList.remove("border-[#00E5FF]");
                    }
                });
            }
        };

        if (trigger) {
            trigger.addEventListener("click", () => {
                const currentSrc = document.querySelector("#trigger-lightbox img")?.src;
                if (currentSrc && lbImg && lightbox) {
                    lbImg.src = currentSrc;
                    lightbox.style.display = "flex";
                    setTimeout(() => lightbox.classList.remove("opacity-0"), 10);
                }
            });
        }
        if (closeBtn) closeBtn.addEventListener("click", closeLb);
        if (lightbox) {
            lightbox.addEventListener("click", (e) => {
                if (e.target === lightbox) closeLb();
            });
        }

        function showToast(message) {
            const toast = document.getElementById("cyber-toast");
            const msgEl = document.getElementById("toast-message");
            if (!toast || !msgEl) return;
            msgEl.innerText = message;
            toast.classList.remove("translate-x-[150%]");
            toast.classList.add("translate-x-0");
            setTimeout(() => {
                toast.classList.remove("translate-x-0");
                toast.classList.add("translate-x-[150%]");
            }, 3500);
        }

        let drawerDirectBuy = false;

        window.openMobileDrawer = (isDirectBuy) => {
            drawerDirectBuy = isDirectBuy;
            const backdrop = document.getElementById("mobile-drawer-backdrop");
            const sheet = document.getElementById("mobile-drawer-sheet");
            const submitBtn = document.getElementById("drawer-submit-btn");

            if (submitBtn) {
                submitBtn.innerText = isDirectBuy ? "Lanjutkan Checkout" : "Lanjutkan ke Keranjang";
            }

            if (backdrop && sheet) {
                backdrop.classList.remove("opacity-0", "pointer-events-none");
                backdrop.classList.add("opacity-100", "pointer-events-auto");
                backdrop.setAttribute("aria-hidden", "false");
                sheet.classList.remove("translate-y-full");
                sheet.classList.add("translate-y-0");
            }
        };

        window.closeMobileDrawer = () => {
            const backdrop = document.getElementById("mobile-drawer-backdrop");
            const sheet = document.getElementById("mobile-drawer-sheet");
            if (backdrop && sheet) {
                sheet.classList.add("translate-y-full");
                sheet.classList.remove("translate-y-0");
                backdrop.classList.add("opacity-0", "pointer-events-none");
                backdrop.classList.remove("opacity-100", "pointer-events-auto");
                backdrop.setAttribute("aria-hidden", "true");
            }
        };

        const drawerBackdrop = document.getElementById("mobile-drawer-backdrop");
        if (drawerBackdrop) {
            drawerBackdrop.addEventListener("click", () => {
                window.closeMobileDrawer();
            });
        }

        function checkUserSession() {
            const session = window.getSession ? window.getSession() : null;
            const savedEmail = session?.email || localStorage.getItem("yasui_buyer_email");
            const savedWa = localStorage.getItem("yasui_buyer_wa") || "";
            const savedDiscord = localStorage.getItem("yasui_buyer_discord") || "";
            const prefContact = savedWa || (savedDiscord ? `[Discord] ${savedDiscord}` : "");

            const forms = [document.getElementById("order-form"), document.getElementById("mobile-drawer-form")];
            forms.forEach((form) => {
                if (!form) return;
                const emailInp = form.querySelector('[name="user_email"]');
                const contactInp = form.querySelector('[name="contact_value"]');
                const methodSel = form.querySelector('[name="contact_method"]');

                if (emailInp && savedEmail && !emailInp.value) {
                    emailInp.value = savedEmail;
                }
                if (contactInp && !contactInp.value) {
                    if (savedWa) {
                        if (methodSel) methodSel.value = "whatsapp";
                        contactInp.value = savedWa;
                    } else if (savedDiscord) {
                        if (methodSel) methodSel.value = "discord";
                        contactInp.value = savedDiscord;
                    }
                }
            });

            if (savedEmail && prefContact) {
                const authViews = [document.getElementById("auth-user-view"), document.getElementById("drawer-auth-user-view")];
                const guestViews = [document.getElementById("guest-user-view"), document.getElementById("drawer-guest-user-view")];
                const emails = [document.getElementById("auth-display-email"), document.getElementById("drawer-auth-display-email")];
                const contacts = [document.getElementById("auth-display-contact"), document.getElementById("drawer-auth-display-contact")];

                authViews.forEach((v) => v && v.classList.remove("hidden"));
                guestViews.forEach((v) => v && v.classList.add("hidden"));
                emails.forEach((e) => e && (e.innerText = savedEmail));
                contacts.forEach((c) => c && (c.innerText = prefContact));
            }
        }

        window.toggleEditContact = () => {
            const authView = document.getElementById("auth-user-view");
            const guestView = document.getElementById("guest-user-view");
            if (authView && guestView) {
                authView.classList.toggle("hidden");
                guestView.classList.toggle("hidden");
            }
        };

        window.toggleDrawerEditContact = () => {
            const authView = document.getElementById("drawer-auth-user-view");
            const guestView = document.getElementById("drawer-guest-user-view");
            if (authView && guestView) {
                authView.classList.toggle("hidden");
                guestView.classList.toggle("hidden");
            }
        };

        window.toggleDescription = () => {
            const desc = document.getElementById("product-desc-content");
            const btnText = document.getElementById("desc-btn-text");
            const btnIcon = document.getElementById("desc-btn-icon");
            const fade = document.getElementById("desc-expand-wrapper");

            if (!desc) return;
            const isCollapsed = desc.classList.contains("max-h-56");

            if (isCollapsed) {
                desc.classList.remove("max-h-56");
                if (btnText) btnText.innerText = "Tutup Deskripsi";
                if (btnIcon) btnIcon.classList.add("rotate-180");
                if (fade) fade.classList.remove("-mt-10", "bg-gradient-to-t");
            } else {
                desc.classList.add("max-h-56");
                if (btnText) btnText.innerText = "Baca Selengkapnya";
                if (btnIcon) btnIcon.classList.remove("rotate-180");
                if (fade) fade.classList.add("-mt-10", "bg-gradient-to-t");
            }
        };

        window.updateContactPlaceholder = (formId) => {
            const form = typeof formId === "string" ? document.getElementById(formId) : (formId || document.getElementById("order-form"));
            if (!form) return;
            const methodSelect = form.querySelector('[name="contact_method"]');
            const valueInput = form.querySelector('[name="contact_value"]');

            if (methodSelect && valueInput) {
                const isWA = methodSelect.value === "whatsapp";
                if (isWA) {
                    valueInput.type = "tel";
                    valueInput.placeholder = "0812-3456-xxxx";
                    valueInput.pattern = "^08[0-9]{8,13}$";
                } else {
                    valueInput.type = "text";
                    valueInput.placeholder = "Username#1234";
                    valueInput.pattern = "^.{3,32}$";
                }
            }
        };

        function getCart() {
            try {
                return JSON.parse(localStorage.getItem("yasui_cart") || "[]");
            } catch {
                return [];
            }
        }

        function saveCart(cart) {
            localStorage.setItem("yasui_cart", JSON.stringify(cart));
            document.dispatchEvent(new Event("yasui-cart-changed"));
        }

        window.submitOrderForm = (isDirectBuy, sourceForm) => {
            const form = sourceForm || document.getElementById("order-form");
            if (!form) return;

            if (!form.checkValidity()) {
                form.reportValidity();
                form.scrollIntoView({ behavior: "smooth", block: "center" });
                return;
            }

            const formData = new FormData(form);
            const userEmail = formData.get("user_email") || "";
            const contactMethod = formData.get("contact_method") || "whatsapp";
            const contactValue = formData.get("contact_value") || "";
            const playerInGameId = formData.get("player_in_game_id") || "";

            if (userEmail) {
                localStorage.setItem("yasui_buyer_email", userEmail);
            }
            if (contactMethod === "whatsapp" && contactValue) {
                localStorage.setItem("yasui_buyer_wa", contactValue);
            } else if (contactMethod === "discord" && contactValue) {
                localStorage.setItem("yasui_buyer_discord", contactValue);
            }

            const item = {
                id: product.databaseId || (product.id ? parseInt(atob(product.id).split(":")[1]) : 0),
                globalId: product.id,
                name: product.name,
                slug: product.slug,
                price: pPrice || (product.rawPrice ? parseInt(product.rawPrice) : 0),
                image: document.querySelector("#trigger-lightbox img")?.src || "",
                email: userEmail,
                contactMethod: contactMethod,
                contactValue: contactValue,
                playerInGameId: playerInGameId,
                wa: contactMethod === "whatsapp" ? contactValue : `[Discord] ${contactValue}`,
                timestamp: Date.now(),
            };

            const cart = getCart();
            cart.push(item);
            saveCart(cart);

            window.closeMobileDrawer();

            if (isDirectBuy) {
                window.location.href = "/cart";
            } else {
                showToast(`"${product.name}" ditambahkan ke keranjang!`);
                checkUserSession();
            }
        };

        const drawerFormEl = document.getElementById("mobile-drawer-form");
        if (drawerFormEl) {
            drawerFormEl.addEventListener("submit", (e) => {
                e.preventDefault();
                window.submitOrderForm(drawerDirectBuy, drawerFormEl);
            });
        }

        checkUserSession();
    </script>
</Layout>
