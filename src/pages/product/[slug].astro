---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { parsePrice } from "../../lib/price";
import { getProductBySlug, getProducts, normalizeProduct } from "../../lib/wc";
import { sanitizeHtml } from "../../lib/sanitize";
import TopupGamepassConsole from "../../components/TopupGamepassConsole.astro";

const IS_PROD = import.meta.env.PROD;

const normalizeImgUrl = (url: string | null) => {
    if (!url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};

const { slug } = Astro.params;
let product: any = null;
let relatedProducts: any[] = [];
let galleryImages: any[] = [];
let prodMainSrc: any = null;
let prodGallerySrcs: any[] = [];

try {
    const rawProduct = await getProductBySlug(slug);
    if (rawProduct) {
        product = normalizeProduct(rawProduct);

        const rawMain = product.images?.[0]?.src || null;
        const rawGallery = (product.images || []).slice(1).map((img: any) => img.src);

        galleryImages = rawMain ? [normalizeImgUrl(rawMain)] : [];
        const proxyGallery = rawGallery.map((u: string) => normalizeImgUrl(u));
        galleryImages = [...galleryImages, ...proxyGallery];

        prodMainSrc = rawMain;
        prodGallerySrcs = rawGallery;

        const firstCategoryId = rawProduct.categories?.[0]?.id;
        if (firstCategoryId) {
            try {
                const rawRelated = await getProducts({ category: firstCategoryId, per_page: 5 });
                relatedProducts = (rawRelated || [])
                    .filter((p: any) => p.id !== rawProduct.id)
                    .slice(0, 4)
                    .map(normalizeProduct);
            } catch (e: any) {
                console.warn("Related product fetch warning:", e.message);
            }
        }
    }
} catch (error: any) {
    console.error("[Product REST Error]:", error);
}

if (!product) {
    return Astro.redirect("/404");
}

const pPrice = parsePrice(product.price);
const pRegular = parsePrice(product.regularPrice);
const hasDiscount = pRegular > pPrice;
const discountPercent = hasDiscount
    ? Math.round(((pRegular - pPrice) / pRegular) * 100)
    : 0;

const stockQuantity = product.stockQuantity ?? (product.stock_quantity !== null && product.stock_quantity !== undefined ? Number(product.stock_quantity) : null);
const stockMax = stockQuantity && stockQuantity > 0 ? Math.min(stockQuantity, 99) : 99;
const isOutOfStock = product.stockStatus === "OUT_OF_STOCK" || (stockQuantity !== null && stockQuantity <= 0);

const attributes = product.attributes?.nodes || [];

const getAttributeStyle = (attr: any) => {
    const lowerName = attr.name.toLowerCase();
    const value = attr.options?.[0] || "";
    const lowerValue = value.toLowerCase();

    if (lowerName.includes("age") || lowerName.includes("umur") || lowerName.includes("band")) {
        const isOld = lowerValue.startsWith("old") || lowerValue.includes("tua");
        return {
            icon: isOld ? "i-lucide-hourglass" : "i-lucide-sparkles",
            label: isOld ? "AKUN TUA" : "FRESH",
            valueClass: isOld ? "text-[#94A3B8]" : "text-emerald-400",
            wrapperClass: "border-[#222634] bg-[#0D0F15]",
        };
    }

    if (lowerName.includes("server")) {
        return {
            icon: "i-lucide-globe",
            label: "SERVER",
            valueClass: "text-[#00E5FF]",
            wrapperClass: "border-[#222634] bg-[#0D0F15]",
        };
    }

    if (
        lowerName.includes("tier") ||
        lowerName.includes("rank") ||
        lowerName.includes("account")
    ) {
        let colorClass = "text-[#94A3B8]";
        if (lowerValue.includes("fresh") || lowerValue.includes("new"))
            colorClass = "text-emerald-400";
        else if (lowerValue.includes("mid")) colorClass = "text-[#00E5FF]";
        else if (lowerValue.includes("end") || lowerValue.includes("high"))
            colorClass = "text-amber-400";

        return {
            icon: "i-lucide-bar-chart-2",
            label: "TIER / RANK",
            valueClass: colorClass,
            wrapperClass: "border-[#222634] bg-[#0D0F15]",
        };
    }

    return {
        icon: "i-lucide-tag",
        label: attr.name.toUpperCase(),
        valueClass: "text-[#94A3B8]",
        wrapperClass: "border-[#222634] bg-[#0D0F15]",
    };
};

const categoryName = product.categories?.[0]?.name || product.productCategories?.nodes?.[0]?.name || "Game";
const categorySlug = product.categories?.[0]?.slug || product.productCategories?.nodes?.[0]?.slug || "categories";

const allCategorySlugs = [
    ...(product.categories || []).map((c: any) => c.slug || ""),
    ...(product.productCategories?.nodes || []).map((c: any) => c.slug || "")
].map((s: string) => s.toLowerCase());

const allCategoryNames = [
    ...(product.categories || []).map((c: any) => c.name || ""),
    ...(product.productCategories?.nodes || []).map((c: any) => c.name || "")
].map((s: string) => s.toLowerCase());

const allCategoryTokens = [...allCategorySlugs, ...allCategoryNames];
const prodNameLower = (product.name || "").toLowerCase();

const subModeParam = Astro.url.searchParams.get("sub_mode")?.toLowerCase() || "";

const isSummonersWar = allCategoryTokens.some((t) => t.includes("summoners-war") || t.includes("sky arena")) || prodNameLower.includes("summoners war");

let isRobloxEcosystem = allCategoryTokens.some((t) =>
    t.includes("roblox") || t.includes("robux") || t.includes("blox-fruits") || t.includes("fish-it") ||
    t.includes("grow-a-garden") || t.includes("adopt-me") || t.includes("steal-a-brainrot") ||
    t.includes("fisch") || t.includes("anime-defenders") || t.includes("99-nights")
) || prodNameLower.includes("roblox") || prodNameLower.includes("blox fruits") || prodNameLower.includes("robux");

if (subModeParam === "gamepass") {
    isRobloxEcosystem = true;
}

const isGiftCategory = allCategoryTokens.some((t) =>
    t.includes("gift charisma") || t.includes("gift-charisma") ||
    t.includes("gift item") || t.includes("gift-item") ||
    t.includes("gift skin") || t.includes("gift-skin") ||
    t.includes("7 hari") || t.includes("7 days") || t.includes("7-hari")
) || prodNameLower.includes("gift charisma") || prodNameLower.includes("gift skin") || prodNameLower.includes("gift item");

const isGamepassCategory = allCategoryTokens.some((t) => t.includes("gamepass")) || prodNameLower.includes("gamepass");

const isRobloxItem = isRobloxEcosystem && (
    allCategoryTokens.some((t) =>
        t.includes("fruit") || t.includes("pet") ||
        t.includes("unit") || t.includes("fish") || t.includes("coins") ||
        t.includes("money") || t.includes("lock") || (t.includes("item") && !t.includes("gift"))
    ) || prodNameLower.includes("fruit") || prodNameLower.includes("pet") ||
    prodNameLower.includes("kitsune") || prodNameLower.includes("dragon") || prodNameLower.includes("leopard") ||
    prodNameLower.includes("buddha") || prodNameLower.includes("dough") || prodNameLower.includes("t-rex") ||
    prodNameLower.includes("mammoth")
) && !isGamepassCategory && !allCategoryTokens.some((t) => t.includes("akun") || t.includes("account"));

const isTopupCategory = allCategoryTokens.some((t) =>
    t.includes("top up") || t.includes("top-up") || t.includes("topup") ||
    t.includes("diamond") || t.includes("voucher") || t.includes("game card") ||
    t.includes("razer") || t.includes("garena") || t.includes("steam") ||
    t.includes("robux via login") || t.includes("robux-via-login") ||
    t.includes("robux via username") || t.includes("robux-via-username") ||
    t.includes("robux 5 hari") || t.includes("robux-5-hari") ||
    t.includes("gamepass")
) || prodNameLower.includes("top up") || prodNameLower.includes("topup") || prodNameLower.includes("diamond") || isGamepassCategory;

let mode: "account" | "roblox_item" | "game_gift" | "topup_gamepass" = "account";
if (subModeParam) {
    if (subModeParam === "roblox_item" || subModeParam === "fruit" || subModeParam === "item") mode = "roblox_item";
    else if (subModeParam === "game_gift" || subModeParam === "gift") mode = "game_gift";
    else if (subModeParam === "topup" || subModeParam === "gamepass") mode = "topup_gamepass";
    else if (subModeParam === "account" || subModeParam === "akun") mode = "account";
} else {
    if (isGamepassCategory) mode = "topup_gamepass";
    else if (isGiftCategory) mode = "game_gift";
    else if (isRobloxItem) mode = "roblox_item";
    else if (isTopupCategory && !allCategoryTokens.some((t) => t.includes("akun"))) mode = "topup_gamepass";
    else mode = "account";
}

const is7DaysGift = mode === "game_gift" && (
    allCategoryTokens.some((t) => t.includes("7 hari") || t.includes("7 days") || t.includes("7-hari") || t.includes("gift item") || t.includes("gift skin")) ||
    prodNameLower.includes("7 hari") || prodNameLower.includes("7 days") || prodNameLower.includes("skin") ||
    Astro.url.searchParams.get("gift_type") === "7days"
);

const schema = {
    "@context": "https://schema.org/",
    "@type": "Product",
    name: product.name,
    description: product.shortDescription,
    sku: product.slug,
    image: product.image?.sourceUrl,
    offers: {
        "@type": "Offer",
        priceCurrency: "IDR",
        price: product.rawPrice || 0,
        availability: isOutOfStock ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
        url: Astro.url.href,
    },
};
---

<Layout title={`${product.name} - Yasui Game`} description={product.shortDescription}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    {/* Tactical Cyber Toast */}
    <div
        id="cyber-toast"
        class="fixed top-20 right-4 z-[100] translate-x-[150%] transition-transform duration-300 flex items-center gap-3 bg-[#11131A] border border-[#00E5FF] p-3.5 rounded-md shadow-2xl max-w-xs md:max-w-md"
    >
        <div class="w-7 h-7 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/20 flex items-center justify-center shrink-0">
            <span class="i-lucide-check text-base"></span>
        </div>
        <div class="min-w-0">
            <h4 class="text-xs font-mono font-bold text-[#F8FAFC] uppercase tracking-wider" data-i18n="product.toast_added_title">Item Ditambahkan</h4>
            <p id="toast-message" class="text-[11px] text-[#94A3B8] font-mono truncate" data-i18n="product.toast_added_desc">Pesanan masuk ke keranjang.</p>
        </div>
    </div>

    {/* Image Lightbox */}
    <div
        id="lightbox"
        style="display: none;"
        class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm flex flex-col justify-center items-center opacity-0 transition-opacity duration-200"
    >
        <button
            id="close-lightbox"
            class="yg-btn-icon absolute top-4 right-4 z-50 text-[#F8FAFC]"
            aria-label="Tutup Lightbox"
        >
            <span class="i-lucide-x text-base"></span>
        </button>
        <div class="relative w-full max-w-5xl aspect-video flex items-center justify-center p-4">
            <img
                id="lightbox-img"
                src=""
                alt="Product preview"
                class="max-h-[80vh] max-w-full object-contain rounded-lg border border-[#222634]"
            />
        </div>
    </div>

    <main class="yg-shell pt-4 md:pt-6 pb-36 lg:pb-28" data-product-title={product.name} data-product-slug={product.slug} data-product-mode={mode}>
        <nav
            class="flex py-3 text-[#64748B] text-[10px] font-mono uppercase tracking-wider overflow-x-auto"
            aria-label="Breadcrumb"
        >
            <ol class="flex items-center space-x-2 whitespace-nowrap">
                <li><a href="/" class="hover:text-[#00E5FF] transition-colors" data-i18n="nav.home">HOME</a></li>
                <li><span class="text-[#262B3D]">/</span></li>
                <li>
                    <a href={`/category/${categorySlug}`} class="hover:text-[#00E5FF] transition-colors">
                        {categoryName}
                    </a>
                </li>
                <li><span class="text-[#262B3D]">/</span></li>
                <li class="text-[#F8FAFC] font-bold truncate max-w-[200px]">{product.name}</li>
            </ol>
        </nav>

        {mode === "topup_gamepass" ? (
            <TopupGamepassConsole
                product={product}
                relatedProducts={relatedProducts}
                categoryName={categoryName}
                categorySlug={categorySlug}
                isRoblox={isRobloxEcosystem}
            />
        ) : (
        /* 2-Column Responsive Layout */
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start mt-2">
            
            {/* Kolom Kiri: Galeri + Panduan/Spesifikasi + Deskripsi */}
            <div class="lg:col-span-7 w-full space-y-6">
                <div class="space-y-3">
                    <div
                        class="relative rounded-lg overflow-hidden border border-[#222634] bg-[#0D0F15] aspect-video cursor-pointer group flex items-center justify-center"
                        id="trigger-lightbox"
                    >
                        <div class="absolute top-2.5 right-2.5 bg-[#090A0F]/80 backdrop-blur-sm px-2 py-1 rounded border border-[#222634] text-[#F8FAFC] text-[10px] font-mono flex items-center gap-1 z-20 pointer-events-none">
                            <span class="i-lucide-maximize-2 text-xs text-[#00E5FF]"></span>
                            <span>ZOOM</span>
                        </div>
                        {galleryImages.length > 0 && galleryImages[0] ? (
                            IS_PROD ? (
                                <Image
                                    src={prodMainSrc}
                                    alt={product.name}
                                    width={600}
                                    height={600}
                                    format="webp"
                                    class="w-full h-full object-contain bg-[#090A0F]"
                                    loading="eager"
                                />
                            ) : (
                                <img
                                    src={galleryImages[0]}
                                    alt={product.name}
                                    width="600"
                                    height="600"
                                    class="w-full h-full object-contain bg-[#090A0F]"
                                    loading="eager"
                                    decoding="async"
                                />
                            )
                        ) : (
                            <div class="flex items-center justify-center h-full text-[#64748B] text-xs font-mono">
                                NO VISUAL DATA
                            </div>
                        )}
                    </div>

                    {galleryImages.length > 1 && (
                        <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-none">
                            {galleryImages.map((img, index) => (
                                <button
                                    type="button"
                                    class={`gallery-thumb shrink-0 w-20 aspect-video bg-[#0D0F15] rounded-md border cursor-pointer overflow-hidden transition-all duration-150 ${index === 0 ? "border-[#00E5FF]" : "border-[#222634] opacity-60 hover:opacity-100 hover:border-[#2E3446]"}`}
                                    onclick={`window.changeImage(${index})`}
                                    aria-label={`Lihat gambar ${index + 1}`}
                                >
                                    {img ? (
                                        IS_PROD && prodGallerySrcs[index - 1] ? (
                                            <Image
                                                src={prodGallerySrcs[index - 1]}
                                                alt={`${product.name} gallery ${index + 1}`}
                                                width={300}
                                                height={300}
                                                format="webp"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                            />
                                        ) : IS_PROD && index === 0 && prodMainSrc ? (
                                            <Image
                                                src={prodMainSrc}
                                                alt={`${product.name} main`}
                                                width={300}
                                                height={300}
                                                format="webp"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <img
                                                src={img}
                                                alt={`${product.name} gallery ${index + 1}`}
                                                width="300"
                                                height="300"
                                                class="w-full h-full object-cover"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        )
                                    ) : (
                                        <div class="w-full h-full bg-[#11131A] flex items-center justify-center text-[10px] text-[#64748B] font-mono">
                                            No Img
                                        </div>
                                    )}
                                </button>
                            ))}
                        </div>
                    )}
                </div>

                {/* Polymorphic Left Column: Mode-Specific Guide / Specifications */}
                {mode === "roblox_item" && (
                    <div class="rounded-lg bg-[#11131A] border border-[#222634] p-4 md:p-5 space-y-4">
                        <div class="flex items-center justify-between border-b border-[#222634] pb-3">
                            <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#00E5FF] flex items-center gap-1.5" data-i18n="product.item_delivery_guide">
                                <span class="i-lucide-package-check text-sm text-[#00E5FF]"></span>
                                <span>Panduan & Spesifikasi Terima Item</span>
                            </h2>
                            <span class="yg-badge-overlay-online text-[10px]">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span data-i18n="product.trade_ready">TRADE READY</span>
                            </span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div class="p-3 rounded-md bg-[#0D0F15] border border-[#222634] space-y-1">
                                <span class="text-[10px] font-mono text-[#64748B] uppercase block" data-i18n="product.item_delivery_method">Metode Penyerahan</span>
                                <div class="text-xs font-mono font-bold text-[#F8FAFC] flex items-center gap-1.5">
                                    <span class="i-lucide-arrow-left-right text-[#00E5FF] text-xs"></span>
                                    <span>In-Game Trade / Direct Gift</span>
                                </div>
                                <p class="text-[10px] text-[#94A3B8] font-mono" data-i18n="product.item_delivery_desc">In-Game Trade (Sea 2 / Sea 3 / Lobby) atau Direct In-Game Gift</p>
                            </div>
                            <div class="p-3 rounded-md bg-[#0D0F15] border border-[#222634] space-y-1">
                                <span class="text-[10px] font-mono text-[#64748B] uppercase block" data-i18n="product.item_est_time">Estimasi Waktu Kirim</span>
                                <div class="text-xs font-mono font-bold text-emerald-400 flex items-center gap-1.5">
                                    <span class="i-lucide-clock text-emerald-400 text-xs"></span>
                                    <span data-i18n="product.item_est_desc">5 – 15 Menit (Seller Online & Trade Ready)</span>
                                </div>
                                <p class="text-[10px] text-[#94A3B8] font-mono">Seller online langsung kirim link Private Server</p>
                            </div>
                        </div>

                        <div class="p-3.5 rounded-md bg-[#0D0F15] border border-[#222634] space-y-2">
                            <span class="text-[11px] font-mono font-bold text-[#00E5FF] uppercase tracking-wider flex items-center gap-1.5" data-i18n="product.item_steps_title">
                                <span class="i-lucide-list-ordered text-xs"></span>
                                <span>3 Langkah Mudah Transaksi Item:</span>
                            </span>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1 text-[11px] font-mono">
                                <div class="flex items-start gap-2">
                                    <span class="w-5 h-5 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/30 flex items-center justify-center text-[10px] font-bold shrink-0">1</span>
                                    <span class="text-[#94A3B8]" data-i18n="product.item_step_1">Masukkan @Username Roblox asli & nomor WhatsApp/Discord aktif</span>
                                </div>
                                <div class="flex items-start gap-2">
                                    <span class="w-5 h-5 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/30 flex items-center justify-center text-[10px] font-bold shrink-0">2</span>
                                    <span class="text-[#94A3B8]" data-i18n="product.item_step_2">Selesaikan pembayaran via QRIS, Virtual Account, atau E-Wallet</span>
                                </div>
                                <div class="flex items-start gap-2">
                                    <span class="w-5 h-5 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/30 flex items-center justify-center text-[10px] font-bold shrink-0">3</span>
                                    <span class="text-[#94A3B8]" data-i18n="product.item_step_3">Seller mengirimkan link Private Server / Direct Gift langsung di dalam game</span>
                                </div>
                            </div>
                        </div>

                        {attributes.length > 0 && (
                            <div class="pt-2 border-t border-[#222634]/60">
                                <span class="text-[10px] font-mono text-[#64748B] uppercase block mb-2">Atribut Item Tambahan</span>
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                    {attributes.map((attr: any) => {
                                        const style = getAttributeStyle(attr);
                                        return (
                                            <div class="p-2 rounded bg-[#0D0F15] border border-[#222634] text-[11px] font-mono">
                                                <span class="text-[9px] text-[#64748B] uppercase block">{attr.name}</span>
                                                <strong class={`${style.valueClass} truncate block`}>{attr.options?.[0] || "-"}</strong>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        )}
                    </div>
                )}

                {mode === "game_gift" && (
                    <div class="space-y-3">
                        {is7DaysGift ? (
                            <div class="bg-amber-500/10 border border-amber-500/30 text-amber-300 rounded-lg p-3.5 text-xs font-mono space-y-1">
                                <div class="font-bold flex items-center gap-1.5 uppercase tracking-wider" data-i18n="product.gift_7days_title">
                                    <span class="i-lucide-clock text-amber-400 text-sm"></span>
                                    <span>⏳ ATURAN GIFT 7 HARI</span>
                                </div>
                                <p class="text-[11px] text-amber-200/90 leading-relaxed" data-i18n="product.gift_7days_desc">
                                    Sesuai kebijakan resmi game, akun Anda wajib berteman (Follow) dengan akun pengirim kami di dalam game selama 7 hari sebelum item/skin dapat dikirimkan. Admin akan mengirimkan ID akun pengirim setelah pembayaran terkonfirmasi.
                                </p>
                            </div>
                        ) : (
                            <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 rounded-lg p-3.5 text-xs font-mono space-y-1">
                                <div class="font-bold flex items-center gap-1.5 uppercase tracking-wider" data-i18n="product.gift_charisma_title">
                                    <span class="i-lucide-zap text-emerald-400 text-sm"></span>
                                    <span>⚡ GIFT CHARISMA INSTAN</span>
                                </div>
                                <p class="text-[11px] text-emerald-200/90 leading-relaxed" data-i18n="product.gift_charisma_desc">
                                    Pengiriman charisma diproses langsung ke User ID & Server ID Anda tanpa perlu berteman 7 hari. Estimasi proses 5–15 menit pasca pembayaran terkonfirmasi.
                                </p>
                            </div>
                        )}

                        <div class="rounded-lg bg-[#11131A] border border-[#222634] p-4 md:p-5 space-y-3">
                            <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#00E5FF] flex items-center gap-1.5" data-i18n="product.gift_delivery_guide">
                                <span class="i-lucide-gift text-sm text-[#00E5FF]"></span>
                                <span>Panduan Pengiriman Gift In-Game</span>
                            </h2>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1 text-[11px] font-mono">
                                <div class="flex items-start gap-2">
                                    <span class="w-5 h-5 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/30 flex items-center justify-center text-[10px] font-bold shrink-0">1</span>
                                    <span class="text-[#94A3B8]" data-i18n="product.gift_step_1">Masukkan User ID, Zone ID, & Nickname in-game akun tujuan</span>
                                </div>
                                <div class="flex items-start gap-2">
