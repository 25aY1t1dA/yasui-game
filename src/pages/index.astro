---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import FlashSaleTimer from "../components/FlashSaleTimer.astro";
import { parsePrice } from "../lib/price";
import { getProducts, getCategories, getCategoryBySlug, getBanners, normalizeProduct } from "../lib/wc";

// --- HELPER IMAGE PROXY ---
const fixImgUrl = (url) => {
    if (!url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};

// --- HELPER UNTUK ASTRO IMAGE (OPTIMIZED) ---
const getOptimizedImgUrl = (url) => {
    return url || "";
};

let products = [];
let categories = [];
let flashSaleProducts = [];
let banners = [];
let connectionSuccess = false;

try {
    // 1. Fetch raw products & normalize
    const rawProducts = await getProducts({ per_page: 30 });
    products = (rawProducts || []).map(normalizeProduct);

    // 2. Fetch banners
    banners = await getBanners();

    // 3. Fetch categories
    const allCats = await getCategories({ per_page: 30, parent: 0, hide_empty: false });
    categories = (allCats || [])
        .filter((c) => c.slug !== "flash-sale" && c.slug !== "uncategorized" && c.slug !== "arsip-internal")
        .sort((a, b) => (b.count || 0) - (a.count || 0))
        .slice(0, 6)
        .map((c) => ({
            name: c.name,
            slug: c.slug,
            count: c.count,
            image: c.image?.src ? { sourceUrl: c.image.src } : null,
        }));

    // 4. Fetch Flash Sale category products if any
    try {
        const flashSaleCat = await getCategoryBySlug("flash-sale");
        if (flashSaleCat) {
            const rawFlash = await getProducts({ category: flashSaleCat.id, per_page: 8 });
            flashSaleProducts = (rawFlash || []).map(normalizeProduct);
        }
    } catch (e) {
        // Flash sale optional
    }

    connectionSuccess = true;
} catch (error) {
    console.error("❌ ERROR HOMEPAGE REST:", error.message);
}

if (categories.length === 0) {
    categories = [];
}

const getBadges = (product) => {
    const attrs = product.attributes?.nodes || [];
    const badges = [];

    const server = attrs.find((a) => a.name.toLowerCase().includes("server"));
    if (server && server.options && server.options.length > 0) {
        let val = server.options[0];
        badges.push({
            label: val.toUpperCase(),
            class: "border-cyan-500 text-cyan-400 bg-cyan-900/20",
        });
    }

    const tier = attrs.find(
        (a) =>
            a.name.toLowerCase().includes("tier") ||
            a.name.toLowerCase().includes("rank") ||
            a.name.toLowerCase().includes("account"),
    );
    if (tier && tier.options && tier.options.length > 0) {
        const val = tier.options[0];
        const lowerVal = val.toLowerCase();

        let colorClass = "border-gray-500 text-gray-400 bg-gray-900/20";

        if (lowerVal.includes("fresh") || lowerVal.includes("new")) {
            colorClass = "border-green-500 text-green-400 bg-green-900/20";
        } else if (lowerVal.includes("mid")) {
            colorClass = "border-blue-500 text-blue-400 bg-blue-900/20";
        } else if (lowerVal.includes("end") || lowerVal.includes("high")) {
            colorClass = "border-purple-500 text-purple-400 bg-purple-900/20";
        }

        badges.push({
            label: val.toUpperCase(),
            class: colorClass,
        });
    }

    return badges;
};
---

<Layout title="Yasui Game - Premium Game Accounts">
    <main class="max-w-7xl mx-auto px-4 pt-24 pb-8">
        <!-- 1. GAME POPULER (ITEMKU STYLE TOP QUICK NAVIGATION) -->
        <div class="mb-6 md:mb-8">
            <div class="flex items-center justify-between mb-3 md:mb-4">
                <div class="flex items-center gap-2">
                    <div class="w-1.5 h-4 md:h-5 bg-cyan-400 rounded-full shadow-[0_0_8px_rgba(34,211,238,0.8)]"></div>
                    <h2 class="text-xs md:text-sm font-black text-white uppercase tracking-wider">GAME POPULER</h2>
                </div>
                <a
                    href="/categories"
                    class="text-[11px] md:text-xs font-mono text-cyan-400 hover:text-cyan-300 flex items-center gap-1 transition"
                >
                    Lihat Semua <div class="i-lucide-chevron-right text-xs"></div>
                </a>
            </div>

            <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 sm:gap-3">
                {
                    categories.map((cat) => (
                        <a
                            href={`/category/${cat.slug}`}
                            class="group relative bg-gray-900/60 hover:bg-gray-850/80 border border-gray-800/80 hover:border-cyan-400/50 rounded-xl p-2 sm:p-3 flex flex-col items-center justify-center transition-all duration-200 hover:-translate-y-0.5 shadow-sm text-center"
                        >
                            {cat.count > 0 && (
                                <span class="absolute top-1.5 right-1.5 text-[8px] sm:text-[9px] font-mono font-bold px-1 py-0.2 rounded bg-black/70 border border-gray-800 text-gray-400 group-hover:text-cyan-400 group-hover:border-cyan-500/40 transition-colors">
                                    {cat.count}
                                </span>
                            )}
                            <div class="w-10 h-10 sm:w-12 sm:h-12 mb-1 sm:mb-1.5 rounded-xl bg-black/60 border border-gray-800 group-hover:border-cyan-500/40 p-1.5 transition-transform duration-200 group-hover:scale-105 flex items-center justify-center shadow-inner">
                                {cat.image ? (
                                    <img
                                        src={fixImgUrl(cat.image.sourceUrl)}
                                        alt={cat.name}
                                        class="w-full h-full object-contain filter drop-shadow-[0_2px_6px_rgba(0,0,0,0.6)]"
                                    />
                                ) : (
                                    <div class="i-lucide-gamepad-2 text-xl text-gray-500 group-hover:text-cyan-400" />
                                )}
                            </div>
                            <span class="text-[10px] sm:text-xs font-bold text-gray-200 group-hover:text-cyan-400 text-center uppercase tracking-tight line-clamp-1 w-full px-0.5 transition-colors">
                                {cat.name}
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- 2. PROMO BANNER CAROUSEL (ITEMKU STYLE: COMPACT & BOUNDED HEIGHT) -->
        <div class="mb-10">
            {
                banners.length > 0 ? (
                    <div class="relative w-full">
                        {/* COMPACT CAROUSEL FRAME (NO OVERPOWERING VIEWPORT HEIGHT) */}
                        <div class="relative w-full h-[120px] sm:h-[160px] md:h-[200px] lg:h-[220px] rounded-xl md:rounded-2xl overflow-hidden border border-gray-800/80 hover:border-cyan-500/40 bg-gray-950 shadow-md group transition-colors">
                            {/* SLIDES CONTAINER */}
                            <div
                                id="hero-carousel-track"
                                class="flex w-full h-full transition-transform duration-700 ease-out"
                                style="transform: translateX(0%);"
                            >
                                {banners.map((banner, index) => (
                                    <div class="w-full h-full flex-shrink-0 relative">
                                        {banner.featuredImage?.node?.sourceUrl ? (
                                            <img
                                                src={fixImgUrl(banner.featuredImage.node.sourceUrl)}
                                                alt={banner.featuredImage.node.altText || banner.title || "Promo Banner"}
                                                class="w-full h-full object-cover object-center select-none"
                                                loading={index === 0 ? "eager" : "lazy"}
                                            />
                                        ) : (
                                            <div class="w-full h-full bg-gray-900 flex items-center justify-center text-gray-600 font-mono text-xs">
                                                NO SIGNAL
                                            </div>
                                        )}

                                        {/* Subtle Vignette Gradient */}
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
                                    </div>
                                ))}
                            </div>

                            {/* PREV & NEXT BUTTONS (DESKTOP HOVER) */}
                            <button
                                id="hero-prev-btn"
                                aria-label="Previous Slide"
                                class="hidden md:flex absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/60 hover:bg-cyan-400 hover:text-black border border-white/10 text-white items-center justify-center transition backdrop-blur-md opacity-0 group-hover:opacity-100 shadow-md z-20"
                            >
                                <div class="i-lucide-chevron-left text-lg"></div>
                            </button>
                            <button
                                id="hero-next-btn"
                                aria-label="Next Slide"
                                class="hidden md:flex absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/60 hover:bg-cyan-400 hover:text-black border border-white/10 text-white items-center justify-center transition backdrop-blur-md opacity-0 group-hover:opacity-100 shadow-md z-20"
                            >
                                <div class="i-lucide-chevron-right text-lg"></div>
                            </button>

                            {/* PROGRESS PILL INDICATORS */}
                            <div class="absolute bottom-2.5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-20 bg-black/50 backdrop-blur-md px-2.5 py-1 rounded-full border border-white/10">
                                {banners.map((_, i) => (
                                    <button
                                        class={`hero-indicator h-1 rounded-full transition-all duration-300 ${i === 0 ? "w-6 bg-cyan-400" : "w-1.5 bg-gray-600 hover:bg-gray-400"}`}
                                        data-index={i}
                                        aria-label={`Slide ${i + 1}`}
                                    ></button>
                                ))}
                            </div>
                        </div>

                        {/* CLIENT JAVASCRIPT: UNIFIED CAROUSEL ENGINE */}
                        <script is:inline>
                            (function() {
                                function initHeroCarousel() {
                                    const track = document.getElementById("hero-carousel-track");
                                    if (!track) return;

                                    const prevBtn = document.getElementById("hero-prev-btn");
                                    const nextBtn = document.getElementById("hero-next-btn");
                                    const indicators = document.querySelectorAll(".hero-indicator");
                                    const total = indicators.length;
                                    if (total <= 1) return;

                                    let current = 0;
                                    let timer = null;
                                    let isHovered = false;

                                    function goToSlide(index) {
                                        current = (index + total) % total;
                                        track.style.transform = `translateX(-${current * 100}%)`;

                                        indicators.forEach((ind, i) => {
                                            if (i === current) {
                                                ind.className = "hero-indicator h-1 rounded-full transition-all duration-300 w-6 bg-cyan-400";
                                            } else {
                                                ind.className = "hero-indicator h-1 rounded-full transition-all duration-300 w-1.5 bg-gray-600 hover:bg-gray-400";
                                            }
                                        });
                                    }

                                    function startAutoPlay() {
                                        stopAutoPlay();
                                        timer = setInterval(() => {
                                            if (!isHovered) {
                                                goToSlide(current + 1);
                                            }
                                        }, 5000);
                                    }

                                    function stopAutoPlay() {
                                        if (timer) clearInterval(timer);
                                    }

                                    prevBtn?.addEventListener("click", () => {
                                        goToSlide(current - 1);
                                        startAutoPlay();
                                    });

                                    nextBtn?.addEventListener("click", () => {
                                        goToSlide(current + 1);
                                        startAutoPlay();
                                    });

                                    indicators.forEach((ind, i) => {
                                        ind.addEventListener("click", () => {
                                            goToSlide(i);
                                            startAutoPlay();
                                        });
                                    });

                                    const container = track.parentElement;
                                    if (container) {
                                        container.addEventListener("mouseenter", () => { isHovered = true; });
                                        container.addEventListener("mouseleave", () => { isHovered = false; });

                                        // Touch Swipe Gesture for Mobile
                                        let touchStartX = 0;
                                        let touchEndX = 0;

                                        container.addEventListener("touchstart", (e) => {
                                            touchStartX = e.changedTouches[0].screenX;
                                            isHovered = true;
                                        }, { passive: true });

                                        container.addEventListener("touchend", (e) => {
                                            touchEndX = e.changedTouches[0].screenX;
                                            isHovered = false;
                                            const diff = touchStartX - touchEndX;
                                            if (Math.abs(diff) > 40) {
                                                if (diff > 0) {
                                                    goToSlide(current + 1);
                                                } else {
                                                    goToSlide(current - 1);
                                                }
                                                startAutoPlay();
                                            }
                                        }, { passive: true });
                                    }

                                    startAutoPlay();
                                }

                                if (document.readyState === "loading") {
                                    document.addEventListener("DOMContentLoaded", initHeroCarousel);
                                } else {
                                    initHeroCarousel();
                                }
                            })();
                        </script>
                    </div>
                ) : null
            }
        </div>

        {
            flashSaleProducts.length > 0 && (
                <div class="mb-12 border border-red-900/50 bg-red-950/10 p-4 relative overflow-hidden">
                    <div class="absolute inset-0 bg-[url('/assets/noise.png')] opacity-10 pointer-events-none" />
                    <FlashSaleTimer />

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
                        {flashSaleProducts.map((item) => {
                            const priceVal = parsePrice(item.price);
                            const regularVal = parsePrice(item.regularPrice);
                            const hasDiscount = regularVal > priceVal;
                            const discount = hasDiscount
                                ? Math.round(
                                      ((regularVal - priceVal) / regularVal) *
                                          100,
                                  )
                                : 0;

                            return (
                                <a
                                    href={`/product/${item.slug}`}
                                    class="cyber-card bg-black border border-red-500/50 hover:border-red-500 transition-all duration-300 group hover:-translate-y-1 block relative shadow-[0_0_15px_rgba(220,38,38,0.15)]"
                                >
                                    {/* BADGE HOT DEAL */}
                                    <div class="absolute -top-1 -left-1 z-10 bg-red-600 text-white px-2 py-0.5 text-[10px] font-black italic shadow-lg border border-red-400 rotate-[-5deg]">
                                        HOT DEAL 🔥
                                    </div>

                                    <div class="aspect-video bg-gray-900 relative overflow-hidden border-b border-red-900/30">
                                        {item.image ? (
                                            <img
                                                src={fixImgUrl(
                                                    item.image.sourceUrl,
                                                )}
                                                alt={item.name}
                                                class="w-full h-full object-contain transition duration-500 filter brightness-90 group-hover:brightness-100"
                                            />
                                        ) : (
                                            <div class="flex items-center justify-center h-full text-gray-700 text-xs">
                                                NO IMAGE
                                            </div>
                                        )}

                                        {/* DISCOUNT BADGE */}
                                        {hasDiscount && (
                                            <div class="absolute top-2 right-0 bg-yellow-500 text-black px-2 py-0.5 text-[10px] font-black italic skew-x-[-10deg]">
                                                -{discount}%
                                            </div>
                                        )}
                                    </div>
                                    <div class="p-4">
                                        {/* ATTRIBUTE BADGES */}
                                        <div class="flex flex-wrap gap-1 mb-2">
                                            {getBadges(item).map((badge) => (
                                                <span
                                                    class={`text-[9px] font-bold px-1.5 py-0.5 rounded border border-opacity-50 uppercase tracking-wider ${badge.class}`}
                                                >
                                                    {badge.label}
                                                </span>
                                            ))}
                                        </div>
                                        <h4 class="text-xs md:text-sm font-bold text-gray-200 leading-snug mb-3 line-clamp-2 h-[2.5em] group-hover:text-red-400 transition">
                                            {item.name}
                                        </h4>
                                        <div class="flex items-center justify-between border-t border-gray-800 pt-3">
                                            <div class="flex flex-col">
                                                {hasDiscount && (
                                                    <span
                                                        class="price-tag text-[10px] text-gray-500 line-through decoration-red-500 decoration-2 font-mono leading-none mb-0.5"
                                                        data-price-idr={
                                                            regularVal
                                                        }
                                                    >
                                                        {item.regularPrice}
                                                    </span>
                                                )}
                                                <span
                                                    class="price-tag text-red-400 font-mono text-sm md:text-base font-bold text-shadow-red"
                                                    data-price-idr={priceVal}
                                                >
                                                    {item.price || "Rp 0"}
                                                </span>
                                            </div>
                                            <div class="w-6 h-6 bg-red-900/30 text-red-500 flex items-center justify-center hover:bg-red-500 hover:text-white transition skew-x-[-10deg]">
                                                <div class="i-lucide-flame text-xs skew-x-[10deg]" />
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                </div>
            )
        }

        <div class="flex items-center justify-between mb-3 md:mb-4">
            <div class="flex items-center gap-2">
                <div class="w-1.5 h-4 md:h-5 bg-cyan-400 rounded-full shadow-[0_0_8px_rgba(34,211,238,0.8)]"></div>
                <h2
                    class="text-xs md:text-sm font-black text-white uppercase tracking-wider"
                    data-i18n="home.admin_rec"
                >
                    REKOMENDASI ADMIN
                </h2>
            </div>
            <span class="text-[11px] md:text-xs font-mono text-gray-500">
                Pilihan Akun Terbaik
            </span>
        </div>

        {
            !connectionSuccess && (
                <div class="p-8 text-center border border-dashed border-red-900 bg-red-900/10 rounded-none mb-8">
                    <p
                        class="text-red-400 font-bold"
                        data-i18n="home.waiting_conn"
                    >
                        ⚠️ Menunggu koneksi ke WordPress...
                    </p>
                </div>
            )
        }

        <!-- QUICK CATEGORY FILTER TABS (ITEMKU & STEAM STYLE) -->
        <div class="flex items-center gap-1.5 md:gap-2 overflow-x-auto pb-2.5 mb-5 scrollbar-none text-xs font-bold uppercase tracking-wider">
            <button
                type="button"
                class="admin-rec-filter active-filter-tab px-3 py-1.5 rounded-lg border border-cyan-400 bg-cyan-950/60 text-cyan-400 text-[11px] md:text-xs transition cursor-pointer flex-shrink-0"
                data-category="all"
            >
                SEMUA
            </button>
            {
                categories.map((cat) => (
                    <button
                        type="button"
                        class="admin-rec-filter px-3 py-1.5 rounded-lg border border-gray-800 bg-gray-900/60 text-gray-400 hover:text-white hover:border-gray-700 text-[11px] md:text-xs transition cursor-pointer flex-shrink-0"
                        data-category={cat.slug}
                    >
                        {cat.name}
                    </button>
                ))
            }
        </div>

        <!-- CURATED PRODUCTS GRID (INITIAL 10 PRODUCTS) -->
        <div id="admin-rec-grid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4">
            {
                products.map((item, index) => {
                    const priceVal = parsePrice(item.price);
                    const regularVal = parsePrice(item.regularPrice);
                    const hasDiscount = regularVal > priceVal;
                    const discount = hasDiscount
                        ? Math.round(
                              ((regularVal - priceVal) / regularVal) * 100,
                          )
                        : 0;

                    const itemCatSlugs = (item.categories || []).map((c) => c.slug).join(",");

                    return (
                        <a
                            href={`/product/${item.slug}`}
                            class={`admin-rec-card cyber-card bg-gray-900/60 border border-gray-800 hover:border-cyan-400 transition-all duration-300 group hover:-translate-y-1 block relative shadow-md rounded-xl overflow-hidden ${index >= 10 ? "hidden" : ""}`}
                            data-category={itemCatSlugs}
                        >
                            <div class="aspect-video bg-black relative overflow-hidden border-b border-gray-800 flex items-center justify-center">
                                {item.image ? (
                                    <img
                                        src={fixImgUrl(item.image.sourceUrl)}
                                        alt={item.name}
                                        class="w-full h-full object-contain transition duration-500 filter brightness-90 group-hover:brightness-100"
                                        loading={index < 4 ? "eager" : "lazy"}
                                    />
                                ) : (
                                    <div
                                        class="flex items-center justify-center h-full text-gray-700 text-xs"
                                        data-i18n="home.no_image"
                                    >
                                        NO IMAGE
                                    </div>
                                )}
                                <div class="absolute top-1.5 left-1.5 bg-black/80 backdrop-blur px-1.5 py-0.5 rounded text-[8px] sm:text-[9px] text-cyan-400 font-bold uppercase tracking-wider border border-gray-800">
                                    {item.productCategories?.nodes[0]?.name || "GAME"}
                                </div>

                                {/* DISCOUNT BADGE */}
                                {hasDiscount && (
                                    <div class="absolute top-1.5 right-0 bg-red-600 text-white px-2 py-0.5 text-[9px] sm:text-[10px] font-black italic shadow-md border-l border-red-400">
                                        <span data-i18n="product.save">HEMAT</span> {discount}%
                                    </div>
                                )}
                            </div>

                            <div class="p-2.5 sm:p-3.5">
                                {/* ATTRIBUTE BADGES */}
                                <div class="flex flex-wrap gap-1 mb-1.5">
                                    {getBadges(item).map((badge) => (
                                        <span
                                            class={`text-[8px] sm:text-[9px] font-bold px-1.5 py-0.5 rounded border border-opacity-50 uppercase tracking-wider ${badge.class}`}
                                        >
                                            {badge.label}
                                        </span>
                                    ))}
                                </div>
                                <h4 class="text-[11px] sm:text-xs md:text-sm font-bold text-gray-200 leading-snug mb-2 sm:mb-3 line-clamp-2 h-[2.6em] group-hover:text-cyan-400 transition">
                                    {item.name}
                                </h4>
                                <div class="flex items-center justify-between border-t border-gray-800/80 pt-2.5">
                                    <div class="flex flex-col">
                                        {hasDiscount && (
                                            <span
                                                class="price-tag text-[9px] sm:text-[10px] text-gray-500 line-through decoration-red-500 decoration-1 font-mono leading-none mb-0.5"
                                                data-price-idr={regularVal}
                                            >
                                                {item.regularPrice}
                                            </span>
                                        )}
                                        <span
                                            class="price-tag text-cyan-400 font-mono text-xs sm:text-sm md:text-base font-bold"
                                            data-price-idr={priceVal}
                                        >
                                            {item.price || "Rp 0"}
                                        </span>
                                    </div>
                                    <div class="w-6 h-6 rounded bg-gray-800 text-gray-400 flex items-center justify-center group-hover:bg-cyan-400 group-hover:text-black transition">
                                        <div class="i-lucide-plus text-xs" />
                                    </div>
                                </div>
                            </div>
                        </a>
                    );
                })
            }
        </div>

        {/* EMPTY STATE JIKA FILTER KATEGORI TIDAK ADA PRODUK */}
        <div id="admin-rec-empty" class="hidden py-12 text-center border border-dashed border-gray-800 rounded-xl my-6">
            <div class="i-lucide-package-open text-3xl text-gray-600 mx-auto mb-2"></div>
            <p class="text-xs text-gray-400 font-mono">Belum ada akun di kategori ini.</p>
        </div>

        <!-- LOAD MORE & JELAJAHI SEMUA PRODUK -->
        <div class="mt-8 mb-12 flex flex-col sm:flex-row items-center justify-center gap-3">
            <button
                id="btn-load-more"
                type="button"
                class="w-full sm:w-auto px-6 py-3 rounded-xl border border-cyan-500/40 bg-cyan-950/40 hover:bg-cyan-400 hover:text-black text-cyan-400 text-xs font-black uppercase tracking-wider transition-all duration-300 shadow-[0_0_15px_rgba(34,211,238,0.15)] flex items-center justify-center gap-2 cursor-pointer"
            >
                <div class="i-lucide-chevron-down text-base"></div>
                <span>MUAT LEBIH BANYAK</span>
                <span id="load-more-counter" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-black/50 text-cyan-300 font-bold"></span>
            </button>

            <a
                href="/search"
                class="w-full sm:w-auto px-6 py-3 rounded-xl border border-gray-800 hover:border-gray-700 bg-gray-900/60 hover:bg-gray-800 text-gray-400 hover:text-white text-xs font-bold uppercase tracking-wider transition flex items-center justify-center gap-2"
            >
                <span>Jelajahi Semua Produk</span>
                <div class="i-lucide-arrow-right text-sm"></div>
            </a>
        </div>

        <!-- CLIENT SCRIPT UNTUK LOAD MORE & FILTER TABS -->
        <script is:inline>
            (function() {
                function initAdminRecCatalog() {
                    const cards = Array.from(document.querySelectorAll(".admin-rec-card"));
                    const loadMoreBtn = document.getElementById("btn-load-more");
                    const counterSpan = document.getElementById("load-more-counter");
                    const filterButtons = document.querySelectorAll(".admin-rec-filter");
                    const emptyState = document.getElementById("admin-rec-empty");

                    if (!cards.length) return;

                    const BATCH_SIZE = 10;
                    let currentCategory = "all";
                    let visibleCount = BATCH_SIZE;

                    function updateDisplay() {
                        const matchingCards = cards.filter(card => {
                            if (currentCategory === "all") return true;
                            const cats = card.getAttribute("data-category") || "";
                            return cats.split(",").includes(currentCategory);
                        });

                        cards.forEach(card => card.classList.add("hidden"));

                        matchingCards.forEach((card, index) => {
                            if (index < visibleCount) {
                                card.classList.remove("hidden");
                            } else {
                                card.classList.add("hidden");
                            }
                        });

                        if (matchingCards.length === 0) {
                            if (emptyState) emptyState.classList.remove("hidden");
                        } else {
                            if (emptyState) emptyState.classList.add("hidden");
                        }

                        const remaining = Math.max(0, matchingCards.length - visibleCount);
                        if (loadMoreBtn) {
                            if (remaining > 0) {
                                loadMoreBtn.classList.remove("hidden");
                                if (counterSpan) counterSpan.innerText = `+${Math.min(remaining, BATCH_SIZE)}`;
                            } else {
                                loadMoreBtn.classList.add("hidden");
                            }
                        }
                    }

                    if (loadMoreBtn) {
                        loadMoreBtn.addEventListener("click", () => {
                            visibleCount += BATCH_SIZE;
                            updateDisplay();
                        });
                    }

                    filterButtons.forEach(btn => {
                        btn.addEventListener("click", () => {
                            filterButtons.forEach(b => {
                                b.className = "admin-rec-filter px-3 py-1.5 rounded-lg border border-gray-800 bg-gray-900/60 text-gray-400 hover:text-white hover:border-gray-700 text-[11px] md:text-xs transition cursor-pointer flex-shrink-0";
                            });
                            btn.className = "admin-rec-filter active-filter-tab px-3 py-1.5 rounded-lg border border-cyan-400 bg-cyan-950/60 text-cyan-400 text-[11px] md:text-xs transition cursor-pointer flex-shrink-0";

                            currentCategory = btn.getAttribute("data-category") || "all";
                            visibleCount = BATCH_SIZE;
                            updateDisplay();
                        });
                    });

                    updateDisplay();
                }

                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", initAdminRecCatalog);
                } else {
                    initAdminRecCatalog();
                }
            })();
        </script>
    </main>
</Layout>
