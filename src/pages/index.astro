---
import Layout from "../layouts/Layout.astro";
import FlashSaleTimer from "../components/FlashSaleTimer.astro";
import HeroSlider from "../components/HeroSlider.astro";
import { parsePrice } from "../lib/price";
import { getProducts, getCategories, getCategoryBySlug, getBanners, normalizeProduct } from "../lib/wc";

const fixImgUrl = (url: string | null) => {
    if (!url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};

let products: any[] = [];
let categories: any[] = [];
let flashSaleProducts: any[] = [];
let banners: any[] = [];
let connectionSuccess = false;

try {
    const rawProducts = await getProducts({ per_page: 30 });
    products = (rawProducts || []).map(normalizeProduct);

    banners = await getBanners();

    const allCats = await getCategories({ per_page: 30, parent: 0, hide_empty: false });
    categories = (allCats || [])
        .filter((c: any) => c.slug !== "flash-sale" && c.slug !== "uncategorized" && c.slug !== "arsip-internal")
        .sort((a: any, b: any) => (b.count || 0) - (a.count || 0))
        .slice(0, 6)
        .map((c: any) => ({
            name: c.name,
            slug: c.slug,
            count: c.count,
            image: c.image?.src ? { sourceUrl: c.image.src } : null,
        }));

    try {
        const flashSaleCat = await getCategoryBySlug("flash-sale");
        if (flashSaleCat) {
            const rawFlash = await getProducts({ category: flashSaleCat.id, per_page: 8 });
            flashSaleProducts = (rawFlash || []).map(normalizeProduct);
        }
    } catch {
        // Flash sale is optional
    }

    connectionSuccess = true;
} catch (error: any) {
    console.error("❌ ERROR HOMEPAGE REST:", error.message);
}

const getBadges = (product: any) => {
    const attrs = product.attributes?.nodes || [];
    const badges: any[] = [];

    const server = attrs.find((a: any) => a.name.toLowerCase().includes("server"));
    if (server && server.options && server.options.length > 0) {
        const val = server.options[0];
        badges.push({
            label: val.toUpperCase(),
            class: "yg-badge-cyan",
        });
    }

    const tier = attrs.find(
        (a: any) =>
            a.name.toLowerCase().includes("tier") ||
            a.name.toLowerCase().includes("rank") ||
            a.name.toLowerCase().includes("account"),
    );
    if (tier && tier.options && tier.options.length > 0) {
        const val = tier.options[0];
        const lowerVal = val.toLowerCase();

        let badgeClass = "yg-badge-gray";
        if (lowerVal.includes("fresh") || lowerVal.includes("new")) {
            badgeClass = "yg-badge-emerald";
        } else if (lowerVal.includes("mid")) {
            badgeClass = "yg-badge-cyan";
        } else if (lowerVal.includes("end") || lowerVal.includes("high")) {
            badgeClass = "yg-badge-yellow";
        }

        badges.push({
            label: val.toUpperCase(),
            class: badgeClass,
        });
    }

    return badges;
};
---

<Layout title="Yasui Game - High-Trust RMT Marketplace">
    <main class="yg-shell pt-4 md:pt-6 pb-12">
        <section aria-labelledby="featured-games-title" class="mb-8">
            <div class="flex items-center justify-between mb-3.5">
                <div class="flex items-center gap-2">
                    <span class="w-1 h-4 bg-[#00E5FF] rounded-sm" aria-hidden="true"></span>
                    <h2 id="featured-games-title" class="text-xs md:text-sm font-bold text-[#F8FAFC] uppercase tracking-wider" data-i18n="home.popular_catalog">
                        Katalog Game Populer
                    </h2>
                </div>
                <a
                    href="/categories"
                    class="text-xs font-mono text-[#00E5FF] hover:underline flex items-center gap-1 transition-colors"
                >
                    <span data-i18n="home.view_all">Lihat Semua</span>
                    <span class="i-lucide-arrow-right text-xs" aria-hidden="true"></span>
                </a>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 sm:gap-3">
                {categories.map((cat) => (
                    <a
                        href={`/category/${cat.slug}`}
                        class="group relative yg-card-interactive p-3 flex flex-col items-center justify-center text-center gap-2"
                    >
                        {cat.count > 0 && (
                            <span class="absolute top-2 right-2 text-[10px] font-mono tabular-nums px-1.5 py-0.2 rounded bg-[#0D0F15] border border-[#222634] text-[#94A3B8] group-hover:text-[#00E5FF] group-hover:border-[#00E5FF]/30 transition-colors">
                                {cat.count}
                            </span>
                        )}
                        <div class="w-12 h-12 rounded-lg bg-[#0D0F15] border border-[#222634] group-hover:border-[#00E5FF]/30 p-2 transition-transform duration-200 group-hover:scale-105 flex items-center justify-center">
                            {cat.image ? (
                                <img
                                    src={fixImgUrl(cat.image.sourceUrl)}
                                    alt={cat.name}
                                    class="w-full h-full object-contain"
                                    loading="lazy"
                                />
                            ) : (
                                <span class="i-lucide-gamepad-2 text-xl text-[#64748B] group-hover:text-[#00E5FF] transition-colors" />
                            )}
                        </div>
                        <span class="text-xs font-medium text-[#F8FAFC] group-hover:text-[#00E5FF] uppercase tracking-tight line-clamp-1 w-full transition-colors">
                            {cat.name}
                        </span>
                    </a>
                ))}
            </div>
        </section>

        {banners.length > 0 ? (
            <section aria-label="Promo Banners" class="mb-10">
                <div class="relative w-full h-[150px] sm:h-[200px] md:h-[260px] lg:h-[300px] rounded-lg overflow-hidden border border-[#222634] bg-[#0D0F15] group">
                    <div
                        id="hero-carousel-track"
                        class="flex w-full h-full transition-transform duration-500 ease-out"
                        style="transform: translateX(0%);"
                    >
                        {banners.map((banner, index) => (
                            <div class="w-full h-full shrink-0 relative">
                                {banner.featuredImage?.node?.sourceUrl ? (
                                    <img
                                        src={fixImgUrl(banner.featuredImage.node.sourceUrl)}
                                        alt={banner.featuredImage.node.altText || banner.title || "Promo Banner"}
                                        class="w-full h-full object-cover object-center select-none"
                                        loading={index === 0 ? "eager" : "lazy"}
                                    />
                                ) : (
                                    <div class="w-full h-full bg-[#11131A] flex items-center justify-center text-[#64748B] font-mono text-xs">
                                        OFFLINE SIGNAL
                                    </div>
                                )}
                                <div class="absolute inset-0 bg-gradient-to-t from-[#090A0F] via-transparent to-transparent pointer-events-none"></div>
                            </div>
                        ))}
                    </div>

                    <button
                        id="hero-prev-btn"
                        aria-label="Previous Slide"
                        class="yg-btn-icon absolute left-3 top-1/2 -translate-y-1/2 hidden md:flex opacity-0 group-hover:opacity-100 z-20"
                    >
                        <span class="i-lucide-chevron-left text-base" aria-hidden="true" />
                    </button>
                    <button
                        id="hero-next-btn"
                        aria-label="Next Slide"
                        class="yg-btn-icon absolute right-3 top-1/2 -translate-y-1/2 hidden md:flex opacity-0 group-hover:opacity-100 z-20"
                    >
                        <span class="i-lucide-chevron-right text-base" aria-hidden="true" />
                    </button>

                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-20 bg-[#090A0F]/85 backdrop-blur-sm px-2.5 py-1 rounded border border-[#222634]">
                        {banners.map((_, i) => (
                            <button
                                class={`hero-indicator h-1.5 rounded-full transition-all duration-300 cursor-pointer ${i === 0 ? "w-5 bg-[#00E5FF]" : "w-2 bg-[#262B3D] hover:bg-[#64748B]"}`}
                                data-index={i}
                                aria-label={`Slide ${i + 1}`}
                            />
                        ))}
                    </div>
                </div>
            </section>
        ) : (
            <section aria-label="Promo Slider" class="mb-10">
                <HeroSlider />
            </section>
        )}

        {flashSaleProducts.length > 0 && (
            <section aria-labelledby="flash-sale-title" class="mb-10 p-4 md:p-5 rounded-lg border border-[#222634] bg-[#0D0F15]">
                <FlashSaleTimer />

                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4 mt-4">
                    {flashSaleProducts.map((item) => {
                        const priceVal = parsePrice(item.price);
                        const regularVal = parsePrice(item.regularPrice);
                        const hasDiscount = regularVal > priceVal;
                        const discount = hasDiscount
                            ? Math.round(((regularVal - priceVal) / regularVal) * 100)
                            : 0;
                        const isAccount = (item.categories || []).some((c: any) => c.slug?.includes("akun") || c.name?.toLowerCase().includes("akun"));

                        return (
                            <a
                                href={`/product/${item.slug}`}
                                class="yg-product-card group flex flex-col justify-between"
                            >
                                <div>
                                    <div class="aspect-video bg-[#090A0F] relative overflow-hidden border-b border-[#222634] flex items-center justify-center">
                                        {item.image ? (
                                            <img
                                                src={fixImgUrl(item.image.sourceUrl)}
                                                alt={item.name}
                                                class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="flex items-center justify-center h-full text-[#64748B] text-xs font-mono">
                                                NO VISUAL
                                            </div>
                                        )}

                                        <div class="absolute top-2 left-2">
                                            <span class={isAccount ? "yg-badge-overlay" : "yg-badge-overlay-online"} data-i18n={isAccount ? "badge.instant" : "badge.online"}>
                                                {isAccount ? "INSTANT" : "ONLINE"}
                                            </span>
                                        </div>

                                        {hasDiscount && (
                                            <div class="absolute top-2 right-2 bg-[#090A0F]/90 backdrop-blur-md border border-red-500/40 text-red-400 font-mono text-[10px] px-1.5 py-0.5 rounded font-bold shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
                                                -{discount}%
                                            </div>
                                        )}
                                    </div>

                                    <div class="p-3">
                                        <div class="flex flex-wrap gap-1 mb-1.5">
                                            {getBadges(item).map((badge) => (
                                                 <span class={badge.class}>
                                                     {badge.label}
                                                 </span>
                                             ))}
                                         </div>
                                         <h3 class="line-clamp-2 text-xs md:text-sm font-medium text-[#F8FAFC] leading-snug group-hover:text-[#00E5FF] transition-colors mb-2">
                                             {item.name}
                                         </h3>
                                     </div>
                                 </div>

                                 <div class="p-3 pt-0 border-t border-[#222634]/60 mt-auto">
                                     <div class="flex items-center justify-between pt-2">
                                         <div class="flex flex-col">
                                             {hasDiscount && (
                                                 <span
                                                     class="price-tag text-[10px] text-[#64748B] line-through font-mono tabular-nums leading-none mb-0.5"
                                                     data-price-idr={regularVal}
                                                 >
                                                     {item.regularPrice}
                                                 </span>
                                             )}
                                             <span
                                                 class="yg-price text-sm md:text-base text-[#00E5FF]"
                                                 data-price-idr={priceVal}
                                             >
                                                 {item.price || "Rp 0"}
                                             </span>
                                         </div>
                                         <span class="text-[10px] font-mono text-emerald-400 flex items-center gap-1">
                                             <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                             <span data-i18n="badge.ready">Ready</span>
                                         </span>
                                     </div>
                                 </div>
                            </a>
                        );
                    })}
                </div>
            </section>
        )}

        <section aria-labelledby="catalog-recommendation-title">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <span class="w-1 h-4 bg-[#00E5FF] rounded-sm" aria-hidden="true"></span>
                    <h2
                        id="catalog-recommendation-title"
                        class="text-xs md:text-sm font-bold text-[#F8FAFC] uppercase tracking-wider"
                        data-i18n="home.admin_rec"
                    >
                        Katalog Unggulan
                    </h2>
                </div>
                <span class="text-xs font-mono text-[#64748B]" data-i18n="home.verified_badge">
                    Terverifikasi Yasui Game
                </span>
            </div>

            {!connectionSuccess && (
                <div class="p-6 text-center border border-dashed border-red-500/30 bg-red-950/10 rounded-lg mb-6">
                    <p class="text-red-400 text-xs font-mono" data-i18n="home.waiting_conn">
                        Sinkronisasi katalog WooCommerce sedang berlangsung...
                    </p>
                </div>
            )}

            <div class="flex items-center gap-1.5 md:gap-2 overflow-x-auto pb-2.5 mb-5 scrollbar-none text-xs font-mono uppercase tracking-wider">
                <button
                    type="button"
                    class="admin-rec-filter active-filter-tab px-3 py-1.5 rounded-md border border-[#00E5FF] bg-[#00E5FF]/10 text-[#00E5FF] text-xs transition-colors cursor-pointer shrink-0 font-semibold"
                    data-category="all"
                    data-i18n="home.filter_all"
                >
                    SEMUA
                </button>
                {categories.map((cat) => (
                    <button
                        type="button"
                        class="admin-rec-filter px-3 py-1.5 rounded-md border border-[#222634] bg-[#11131A] text-[#94A3B8] hover:text-[#F8FAFC] hover:border-[#2E3446] text-xs transition-colors cursor-pointer shrink-0"
                        data-category={cat.slug}
                    >
                        {cat.name}
                    </button>
                ))}
            </div>

            <div id="admin-rec-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4">
                {products.map((item, index) => {
                    const priceVal = parsePrice(item.price);
                    const regularVal = parsePrice(item.regularPrice);
                    const hasDiscount = regularVal > priceVal;
                    const discount = hasDiscount
                        ? Math.round(((regularVal - priceVal) / regularVal) * 100)
                        : 0;

                    const itemCatSlugs = (item.categories || []).map((c: any) => c.slug).join(",");
                    const isAccount = itemCatSlugs.includes("akun") || (item.name || "").toLowerCase().includes("akun");

                    return (
                        <a
                            href={`/product/${item.slug}`}
                            class={`admin-rec-card yg-product-card group flex flex-col justify-between ${index >= 10 ? "hidden" : ""}`}
                            data-category={itemCatSlugs}
                        >
                            <div>
                                <div class="aspect-video bg-[#090A0F] relative overflow-hidden border-b border-[#222634] flex items-center justify-center">
                                    {item.image ? (
                                        <img
                                            src={fixImgUrl(item.image.sourceUrl)}
                                            alt={item.name}
                                            class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
                                            loading={index < 4 ? "eager" : "lazy"}
                                        />
                                    ) : (
                                        <div
                                            class="flex items-center justify-center h-full text-[#64748B] text-xs font-mono"
                                            data-i18n="home.no_image"
                                        >
                                            NO IMAGE
                                        </div>
                                    )}

                                    <div class="absolute top-2 left-2">
                                        <span class={isAccount ? "yg-badge-overlay" : "yg-badge-overlay-online"} data-i18n={isAccount ? "badge.instant" : "badge.online"}>
                                            {isAccount ? "INSTANT" : "ONLINE"}
                                        </span>
                                    </div>

                                    {hasDiscount && (
                                        <div class="absolute top-2 right-2 bg-[#090A0F]/90 backdrop-blur-md border border-red-500/40 text-red-400 font-mono text-[10px] px-1.5 py-0.5 rounded font-bold shadow-[0_2px_8px_rgba(0,0,0,0.85)]">
                                            -{discount}%
                                        </div>
                                    )}
                                </div>

                                <div class="p-3">
                                    <div class="flex items-center justify-between gap-1 mb-1.5">
                                        <span class="text-[10px] font-mono text-[#94A3B8] truncate">
                                            {item.productCategories?.nodes[0]?.name || "GAME"}
                                        </span>
                                        <div class="flex flex-wrap gap-1">
                                            {getBadges(item).slice(0, 1).map((badge) => (
                                                <span class={badge.class}>
                                                    {badge.label}
                                                </span>
                                            ))}
                                        </div>
                                    </div>

                                    <h3 class="line-clamp-2 text-xs md:text-sm font-medium text-[#F8FAFC] leading-snug group-hover:text-[#00E5FF] transition-colors mb-2">
                                        {item.name}
                                    </h3>
                                </div>
                            </div>

                            <div class="p-3 pt-0 border-t border-[#222634]/60 mt-auto">
                                <div class="flex items-center justify-between pt-2">
                                    <div class="flex flex-col">
                                        {hasDiscount && (
                                            <span
                                                class="price-tag text-[10px] text-[#64748B] line-through font-mono tabular-nums leading-none mb-0.5"
                                                data-price-idr={regularVal}
                                            >
                                                {item.regularPrice}
                                            </span>
                                        )}
                                        <span
                                            class="yg-price text-xs sm:text-sm md:text-base text-[#00E5FF]"
                                            data-price-idr={priceVal}
                                        >
                                            {item.price || "Rp 0"}
                                        </span>
                                    </div>
                                    <span class="text-[10px] font-mono text-emerald-400 flex items-center gap-1">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                        <span data-i18n="home.stock_ready">Stok Ready</span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>

            <div id="admin-rec-empty" class="hidden py-12 text-center border border-dashed border-[#222634] rounded-lg my-6 bg-[#0D0F15]">
                <div class="i-lucide-package-open text-2xl text-[#64748B] mx-auto mb-2"></div>
                <p class="text-xs text-[#94A3B8] font-mono" data-i18n="home.empty_cat">Belum ada akun di kategori ini.</p>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
                <button
                    id="btn-load-more"
                    type="button"
                    class="w-full sm:w-auto yg-btn-primary px-5 py-2.5 text-xs"
                >
                    <span class="i-lucide-chevron-down text-sm" aria-hidden="true"></span>
                    <span data-i18n="home.load_more">Muat Lebih Banyak</span>
                    <span id="load-more-counter" class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-black/40 text-[#090A0F] font-bold"></span>
                </button>

                <a
                    href="/search"
                    class="w-full sm:w-auto yg-btn-secondary px-5 py-2.5 text-xs"
                >
                    <span data-i18n="home.explore_all">Jelajahi Semua Produk</span>
                    <span class="i-lucide-arrow-right text-xs" aria-hidden="true"></span>
                </a>
            </div>
        </section>

        <script>
            function initIndexFeatures() {
                // Carousel
                const track = document.getElementById("hero-carousel-track");
                const prevBtn = document.getElementById("hero-prev-btn");
                const nextBtn = document.getElementById("hero-next-btn");
                const indicators = document.querySelectorAll(".hero-indicator");
                const total = indicators.length;

                if (track && total > 1) {
                    let current = 0;
                    let timer: any = null;
                    let isHovered = false;

                    const goToSlide = (index: number) => {
                        current = (index + total) % total;
                        track.style.transform = `translateX(-${current * 100}%)`;
                        indicators.forEach((ind, i) => {
                            if (i === current) {
                                ind.className = "hero-indicator h-1.5 rounded-full transition-all duration-300 w-5 bg-[#00E5FF]";
                            } else {
                                ind.className = "hero-indicator h-1.5 rounded-full transition-all duration-300 w-2 bg-[#262B3D] hover:bg-[#64748B]";
                            }
                        });
                    };

                    const startAutoPlay = () => {
                        stopAutoPlay();
                        timer = setInterval(() => {
                            if (!isHovered) goToSlide(current + 1);
                        }, 5000);
                    };

                    const stopAutoPlay = () => {
                        if (timer) clearInterval(timer);
                    };

                    prevBtn?.addEventListener("click", () => { goToSlide(current - 1); startAutoPlay(); });
                    nextBtn?.addEventListener("click", () => { goToSlide(current + 1); startAutoPlay(); });
                    indicators.forEach((ind, i) => {
                        ind.addEventListener("click", () => { goToSlide(i); startAutoPlay(); });
                    });

                    const container = track.parentElement;
                    if (container) {
                        container.addEventListener("mouseenter", () => { isHovered = true; });
                        container.addEventListener("mouseleave", () => { isHovered = false; });
                    }
                    startAutoPlay();
                }

                // Catalog filter & load more
                const cards = Array.from(document.querySelectorAll<HTMLElement>(".admin-rec-card"));
                const loadMoreBtn = document.getElementById("btn-load-more");
                const counterSpan = document.getElementById("load-more-counter");
                const filterButtons = document.querySelectorAll<HTMLButtonElement>(".admin-rec-filter");
                const emptyState = document.getElementById("admin-rec-empty");

                if (!cards.length) return;

                const BATCH_SIZE = 10;
                let currentCategory = "all";
                let visibleCount = BATCH_SIZE;

                function updateDisplay() {
                    const matchingCards = cards.filter(card => {
                        if (currentCategory === "all") return true;
                        const cats = card.getAttribute("data-category") || "";
                        return cats.split(",").includes(currentCategory);
                    });

                    cards.forEach(card => card.classList.add("hidden"));
                    matchingCards.forEach((card, index) => {
                        if (index < visibleCount) {
                            card.classList.remove("hidden");
                        } else {
                            card.classList.add("hidden");
                        }
                    });

                    if (emptyState) {
                        emptyState.classList.toggle("hidden", matchingCards.length > 0);
                    }

                    const remaining = Math.max(0, matchingCards.length - visibleCount);
                    if (loadMoreBtn) {
                        if (remaining > 0) {
                            loadMoreBtn.classList.remove("hidden");
                            if (counterSpan) counterSpan.innerText = `+${Math.min(remaining, BATCH_SIZE)}`;
                        } else {
                            loadMoreBtn.classList.add("hidden");
                        }
                    }
                }

                loadMoreBtn?.addEventListener("click", () => {
                    visibleCount += BATCH_SIZE;
                    updateDisplay();
                });

                filterButtons.forEach(btn => {
                    btn.addEventListener("click", () => {
                        filterButtons.forEach(b => {
                            b.className = "admin-rec-filter px-3 py-1.5 rounded-md border border-[#222634] bg-[#11131A] text-[#94A3B8] hover:text-[#F8FAFC] hover:border-[#2E3446] text-xs transition-colors cursor-pointer shrink-0";
                        });
                        btn.className = "admin-rec-filter active-filter-tab px-3 py-1.5 rounded-md border border-[#00E5FF] bg-[#00E5FF]/10 text-[#00E5FF] text-xs transition-colors cursor-pointer shrink-0 font-semibold";

                        currentCategory = btn.getAttribute("data-category") || "all";
                        visibleCount = BATCH_SIZE;
                        updateDisplay();
                    });
                });

                updateDisplay();
            }

            initIndexFeatures();
            document.addEventListener("astro:page-load", initIndexFeatures);
        </script>
    </main>
</Layout>
