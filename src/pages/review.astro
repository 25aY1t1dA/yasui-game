---
import Layout from "../layouts/Layout.astro";
import { getProductBySlug, getProductById, normalizeProduct } from "../lib/wc";

const slug = Astro.url.searchParams.get("slug");
const productId = Astro.url.searchParams.get("id");

let product = null;
let error = null;

if (slug) {
    try {
        const rawProduct = await getProductBySlug(slug);
        if (rawProduct) {
            product = normalizeProduct(rawProduct);
        } else {
            error = "Produk tidak ditemukan.";
        }
    } catch (err) {
        console.error("Review Page Error:", err);
        error = "Gagal memuat data produk.";
    }
} else if (productId) {
    try {
        const rawProduct = await getProductById(productId);
        if (rawProduct) {
            product = normalizeProduct(rawProduct);
        } else {
            error = "Produk tidak ditemukan.";
        }
    } catch (err) {
        console.error("Review Page Error:", err);
        error = "Gagal memuat data produk.";
    }
} else {
    error = "Link tidak valid (Produk tidak ditentukan).";
}

// Image Proxy Helper
const fixImgUrl = (url) => {
    if (!url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};
---

<Layout
    title={product ? `Review ${product.name} | Yasui Game` : "Review | Yasui Game"}
    description="Berikan ulasan dan testimoni pengalaman Anda berbelanja di Yasui Game."
>
    <script is:inline>
        window.i18nData = {
            id: {
                placeholderName: "Nama Samaran / Asli",
                placeholderEmail: "contoh@email.com",
                placeholderContent: "Ceritakan pengalaman Anda membeli akun ini...",
                submitBtn: "Kirim Ulasan",
                submitLoading: "MENGIRIM...",
                ratingError: "Rating bintang wajib diisi!",
                errorConnection: "Terjadi kesalahan koneksi.",
                errorUnknown: "Gagal mengirim ulasan: "
            },
            en: {
                placeholderName: "Nickname / Real Name",
                placeholderEmail: "example@email.com",
                placeholderContent: "Share your experience buying this account...",
                submitBtn: "Submit Review",
                submitLoading: "SENDING...",
                ratingError: "Star rating is required!",
                errorConnection: "Connection error occurred.",
                errorUnknown: "Failed to submit review: "
            }
        };
    </script>

    <main class="max-w-2xl mx-auto px-4 pt-4 md:pt-6 pb-20">
        <div class="flex justify-end mb-6">
            <div class="flex bg-[#11131A] border border-[#222634] rounded-lg p-1">
                <button
                    id="btn-id"
                    onclick="window.selectLanguage ? window.selectLanguage('id') : switchLang('id')"
                    class="px-3 py-1 rounded text-[10px] font-mono font-bold transition-all bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/40 cursor-pointer"
                >
                    ID
                </button>
                <button
                    id="btn-en"
                    onclick="window.selectLanguage ? window.selectLanguage('en') : switchLang('en')"
                    class="px-3 py-1 rounded text-[10px] font-mono font-bold text-[#94A3B8] hover:text-white transition-all cursor-pointer border border-transparent"
                >
                    EN
                </button>
            </div>
        </div>

        {
            !product ? (
                <div class="text-center py-16 border border-[#222634] bg-[#11131A] rounded-lg p-6">
                    <div class="i-lucide-alert-circle text-4xl text-red-400 mx-auto mb-4" />
                    <h1 class="text-lg font-bold text-white mb-2 font-mono uppercase">
                        <span class="lang-id">Produk Tidak Ditemukan</span>
                        <span class="lang-en hidden">Product Not Found</span>
                    </h1>
                    <p class="text-[#94A3B8] text-xs font-mono mb-6">
                        <span class="lang-id">{error || "Silakan hubungi Admin untuk mendapatkan link yang benar."}</span>
                        <span class="lang-en hidden">{error === "Link tidak valid (Slug tidak ditemukan)." ? "Invalid Link (Slug not found)." : "Please contact Admin to get the correct link."}</span>
                    </p>
                    <a
                        href="/"
                        class="yg-btn-secondary inline-block text-xs"
                    >
                        <span class="lang-id">Kembali ke Beranda</span>
                        <span class="lang-en hidden">Back to Home</span>
                    </a>
                </div>
            ) : (
                <div>
                    <div class="flex items-center gap-4 mb-6 bg-[#11131A] border border-[#222634] p-4 rounded-lg">
                        <div class="w-16 h-16 bg-[#0D0F15] border border-[#222634] rounded-lg overflow-hidden shrink-0 flex items-center justify-center">
                            {product.image ? (
                                <img
                                    src={fixImgUrl(product.image.sourceUrl)}
                                    alt={product.name}
                                    class="w-full h-full object-cover"
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center text-[#64748B] text-[10px] font-mono">
                                    NO IMG
                                </div>
                            )}
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-[10px] text-[#00E5FF] font-bold uppercase tracking-wider font-mono mb-1 block">
                                <span class="lang-id">Berikan Ulasan Untuk</span>
                                <span class="lang-en hidden">Write Review For</span>
                            </span>
                            <h1 class="text-base font-bold text-white leading-tight truncate">
                                {product.name}
                            </h1>
                        </div>
                    </div>

                    <form id="review-form" class="space-y-6">
                        <input
                            type="hidden"
                            name="product_id"
                            value={product.databaseId}
                        />
                        
                        <div class="bg-[#11131A] border border-[#222634] p-6 rounded-lg text-center space-y-3">
                            <label class="text-xs font-bold text-[#F8FAFC] uppercase tracking-wider font-mono">
                                <span class="lang-id">Beri Rating Bintang</span>
                                <span class="lang-en hidden">Give Star Rating</span>
                            </label>
                            <div class="flex justify-center gap-2" id="star-container">
                                {[1, 2, 3, 4, 5].map((star) => (
                                    <button
                                        type="button"
                                        class="star-btn text-[#33394D] hover:text-amber-400 transition-colors p-1 cursor-pointer"
                                        data-value={star}
                                        aria-label={`Bintang ${star}`}
                                    >
                                        <div class="i-lucide-star w-8 h-8 fill-current"></div>
                                    </button>
                                ))}
                            </div>
                            <input
                                type="hidden"
                                name="rating"
                                id="rating-input"
                                required
                            />
                            <div id="rating-error" class="text-red-400 text-xs font-mono hidden">Rating wajib diisi!</div>
                        </div>

                        <div class="bg-[#11131A] border border-[#222634] p-6 rounded-lg space-y-4">
                            <div class="space-y-1.5">
                                <label class="text-[10px] font-bold text-[#F8FAFC] uppercase font-mono tracking-wider">
                                    <span class="lang-id">Nama Anda (Opsional)</span>
                                    <span class="lang-en hidden">Your Name (Optional)</span>
                                </label>
                                <input
                                    type="text"
                                    name="author"
                                    id="input-author"
                                    class="yg-input"
                                    placeholder="Nama Samaran / Asli"
                                />
                            </div>

                            <div class="space-y-1.5">
                                <label class="text-[10px] font-bold text-[#F8FAFC] uppercase font-mono tracking-wider">
                                    <span class="lang-id">Email (Wajib - Tidak Dipublikasikan) <span class="text-red-400">*</span></span>
                                    <span class="lang-en hidden">Email (Required - Not Published) <span class="text-red-400">*</span></span>
                                </label>
                                <input
                                    type="email"
                                    name="email"
                                    id="input-email"
                                    required
                                    class="yg-input"
                                    placeholder="contoh@email.com"
                                />
                            </div>

                            <div class="space-y-1.5">
                                <label class="text-[10px] font-bold text-[#F8FAFC] uppercase font-mono tracking-wider">
                                    <span class="lang-id">Ulasan Pengalaman <span class="text-red-400">*</span></span>
                                    <span class="lang-en hidden">Your Review Experience <span class="text-red-400">*</span></span>
                                </label>
                                <textarea
                                    name="content"
                                    id="input-content"
                                    rows="4"
                                    required
                                    class="yg-input resize-y"
                                    placeholder="Ceritakan pengalaman Anda membeli akun ini..."
                                ></textarea>
                            </div>
                        </div>

                        <button
                            type="submit"
                            id="submit-btn"
                            class="yg-btn-primary w-full py-3.5 uppercase tracking-wider font-mono text-xs flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            <span class="lang-id">Kirim Ulasan</span>
                            <span class="lang-en hidden">Submit Review</span>
                        </button>
                    </form>

                    <div id="success-message" class="hidden text-center py-16 bg-[#11131A] border border-emerald-500/40 rounded-lg p-6">
                        <div class="w-16 h-16 bg-emerald-950/40 border border-emerald-500/40 rounded-lg flex items-center justify-center mx-auto mb-4 text-emerald-400">
                            <div class="i-lucide-check-circle text-3xl"></div>
                        </div>
                        <h2 class="text-xl font-bold text-white mb-2 uppercase tracking-tight font-mono">
                            <span class="lang-id">Terima Kasih!</span>
                            <span class="lang-en hidden">Thank You!</span>
                        </h2>
                        <p class="text-[#94A3B8] text-xs font-mono max-w-sm mx-auto leading-relaxed">
                            <span class="lang-id">Ulasan Anda telah kami terima dan akan segera tampil setelah diverifikasi sistem.</span>
                            <span class="lang-en hidden">Your review has been received and will appear after system verification.</span>
                        </p>
                        <a href="/" class="mt-6 yg-btn-secondary inline-block text-xs font-mono">
                            <span class="lang-id">Kembali ke Beranda</span>
                            <span class="lang-en hidden">Back to Home</span>
                        </a>
                    </div>
                </div>
            )
        }
    </main>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // --- 1. LANGUAGE SWITCHING LOGIC ---
            let currentLang = 'id';
            const btnId = document.getElementById('btn-id');
            const btnEn = document.getElementById('btn-en');
            const inputAuthor = document.getElementById('input-author');
            const inputEmail = document.getElementById('input-email');
            const inputContent = document.getElementById('input-content');
            const errorMsg = document.getElementById("rating-error");

            window.switchLang = (lang) => {
                currentLang = lang;
                const data = window.i18nData[lang];

                // 1. Toggle UI Classes
                if (lang === 'id') {
                    document.querySelectorAll('.lang-id').forEach(el => el.classList.remove('hidden'));
                    document.querySelectorAll('.lang-en').forEach(el => el.classList.add('hidden'));
                    
                    if(btnId) {
                        btnId.className = "px-3 py-1 rounded text-[10px] font-mono font-bold transition-all bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/40 cursor-pointer";
                        btnEn.className = "px-3 py-1 rounded text-[10px] font-mono font-bold text-[#94A3B8] hover:text-white transition-all cursor-pointer border border-transparent";
                    }
                } else {
                    document.querySelectorAll('.lang-en').forEach(el => el.classList.remove('hidden'));
                    document.querySelectorAll('.lang-id').forEach(el => el.classList.add('hidden'));

                    if(btnEn) {
                        btnEn.className = "px-3 py-1 rounded text-[10px] font-mono font-bold transition-all bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/40 cursor-pointer";
                        btnId.className = "px-3 py-1 rounded text-[10px] font-mono font-bold text-[#94A3B8] hover:text-white transition-all cursor-pointer border border-transparent";
                    }
                }

                // 2. Update Placeholders
                if(inputAuthor) inputAuthor.placeholder = data.placeholderName;
                if(inputEmail) inputEmail.placeholder = data.placeholderEmail;
                if(inputContent) inputContent.placeholder = data.placeholderContent;
                
                // 3. Update Error Message if visible
                if(errorMsg && !errorMsg.classList.contains('hidden')) {
                    errorMsg.innerText = data.ratingError;
                }
            };

            const initialLang = localStorage.getItem('yasui_lang') || 'id';
            switchLang(initialLang);
            window.addEventListener('yasui-lang-change', (e) => {
                switchLang(e.detail?.lang || localStorage.getItem('yasui_lang') || 'id');
            });

            // --- 2. FORM LOGIC ---
            const form = document.getElementById("review-form");
            if (form) {
                const starContainer = document.getElementById("star-container");
                const ratingInput = document.getElementById("rating-input");
                const submitBtn = document.getElementById("submit-btn");
                const successMsg = document.getElementById("success-message");

                // Star Logic
                const stars = starContainer.querySelectorAll(".star-btn");
                stars.forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const val = btn.getAttribute("data-value");
                        ratingInput.value = val;
                        if(errorMsg) errorMsg.classList.add('hidden');

                        // Visual Update
                        stars.forEach((s) => {
                            const sVal = s.getAttribute("data-value");
                            if (sVal <= val) {
                                s.classList.remove("text-[#33394D]");
                                s.classList.add("text-amber-400");
                            } else {
                                s.classList.add("text-[#33394D]");
                                s.classList.remove("text-amber-400");
                            }
                        });
                    });
                });

                // Submit Logic
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const i18n = window.i18nData[currentLang];

                    if (!ratingInput.value) {
                        if(errorMsg) {
                            errorMsg.innerText = i18n.ratingError;
                            errorMsg.classList.remove('hidden');
                        }
                        return;
                    }

                    // Loading State
                    const originalText = submitBtn.innerText;
                    submitBtn.innerText = i18n.submitLoading;
                    submitBtn.disabled = true;

                    const formData = new FormData(form);
                    const payload = {
                        review: {
                            commentOn: formData.get("product_id"),
                            rating: formData.get("rating"),
                            author: formData.get("author") || "Guest",
                            email: formData.get("email"),
                            content: formData.get("content"),
                        },
                    };

                    try {
                        const res = await fetch("/api/submit-review", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(payload),
                        });
                        
                        const json = await res.json();

                        if (json.success) {
                            form.classList.add("hidden");
                            successMsg.classList.remove("hidden");
                            if(currentLang === 'en') {
                                switchLang('en');
                            }
                        } else {
                            alert(i18n.errorUnknown + (json.error || "Unknown Error"));
                            submitBtn.innerText = originalText;
                            submitBtn.disabled = false;
                        }
                    } catch (err) {
                        console.error(err);
                        alert(i18n.errorConnection);
                        submitBtn.innerText = originalText;
                        submitBtn.disabled = false;
                    }
                });
            }
        });
    </script>
</Layout>
