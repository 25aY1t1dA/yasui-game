---
// src/pages/cart.astro
import Layout from "../layouts/Layout.astro";
import { translations } from "../lib/translations";
---

<Layout
    title="Keranjang Belanja - Yasui Game"
    description="Kelola produk dan akun game dalam keranjang belanja Yasui Game"
    showFooter={false}
>
    <div
        id="cyber-modal"
        class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm hidden flex-col justify-center items-center p-4"
    >
        <div
            class="relative bg-gray-900 border border-gray-700 w-full max-w-sm p-6 rounded-2xl shadow-[0_0_30px_rgba(0,0,0,0.8)] modal-animate"
        >
            <div
                class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500 via-transparent to-cyan-500 rounded-t-2xl"
            >
            </div>

            <div class="flex items-center gap-3 mb-4">
                <div
                    class="w-10 h-10 bg-gray-800 rounded-xl flex items-center justify-center border border-gray-700"
                >
                    <div
                        id="modal-icon"
                        class="i-lucide-alert-triangle text-xl text-yellow-500"
                    >
                    </div>
                </div>
                <div>
                    <h3
                        id="modal-title"
                        class="text-white font-black uppercase tracking-wider text-sm"
                    >
                        SYSTEM WARNING
                    </h3>
                    <p class="text-[10px] text-gray-500 font-mono">
                        Confirm Action
                    </p>
                </div>
            </div>

            <p
                id="modal-message"
                class="text-gray-300 text-sm mb-6 leading-relaxed"
            >
                Are you sure you want to proceed?
            </p>

            <div class="flex gap-3" id="modal-actions"></div>
        </div>
    </div>

    <main class="max-w-3xl mx-auto px-4 pt-20 sm:pt-24 pb-44 md:pb-28">
        <div class="flex items-center justify-between mb-4">
            <a
                href="/"
                class="text-xs font-bold text-gray-400 hover:text-white flex items-center gap-1.5 transition"
                data-i18n="cart.continue_shopping"
            >
                <div class="i-lucide-arrow-left text-sm"></div> LANJUT BELANJA
            </a>
            <div
                class="text-xs font-bold text-cyan-400 uppercase tracking-widest font-mono"
            >
                SECURE CART
            </div>
        </div>

        <nav
            class="flex items-center gap-6 mb-6 border-b border-gray-800"
            aria-label="Cart Navigation"
        >
            <button
                id="btn-tab-cart"
                onclick="switchTab('cart')"
                class="pb-3 border-b-2 border-cyan-400 text-white font-bold text-xs uppercase tracking-wider flex items-center gap-2 transition cursor-pointer"
            >
                <div class="i-lucide-shopping-cart text-sm"></div>
                <span data-i18n="cart.title">KERANJANG</span>
            </button>
            <button
                id="btn-tab-transactions"
                onclick="switchTab('transactions')"
                class="pb-3 border-b-2 border-transparent text-gray-500 hover:text-gray-300 font-bold text-xs uppercase tracking-wider flex items-center gap-2 transition cursor-pointer"
            >
                <div class="i-lucide-history text-sm"></div>
                <span>RIWAYAT TRANSAKSI</span>
            </button>
        </nav>

        <section id="tab-cart">
            <div id="cart-empty" class="hidden text-center py-16 sm:py-20 bg-gray-900/30 border border-gray-800/80 rounded-2xl p-8">
                <div
                    class="i-lucide-shopping-cart text-5xl sm:text-6xl text-gray-700 mx-auto mb-4"
                >
                </div>
                <h2
                    class="text-lg sm:text-xl font-bold text-gray-400 mb-2"
                    data-i18n="cart.empty_title"
                >
                    Keranjang Kosong
                </h2>
                <p
                    class="text-xs text-gray-500 mb-6 max-w-sm mx-auto"
                    data-i18n="cart.empty_desc"
                >
                    Belum ada item yang siap dicheckout. Yuk cari akun impianmu di katalog!
                </p>
                <a
                    href="/"
                    class="inline-flex items-center gap-2 text-cyan-400 border border-cyan-400/50 hover:border-cyan-400 px-6 py-2.5 rounded-xl hover:bg-cyan-400 hover:text-black transition font-bold text-xs uppercase shadow-[0_0_15px_rgba(34,211,238,0.15)]"
                    data-i18n="cart.find_game"
                >
                    <div class="i-lucide-gamepad-2 text-sm"></div>
                    <span>Cari Game</span>
                </a>
            </div>

            <div
                id="cart-header"
                class="hidden items-center justify-between mb-4 px-1"
            >
                <div class="flex items-center gap-3">
                    <input
                        type="checkbox"
                        id="select-all"
                        class="cyber-checkbox"
                        onclick="toggleSelectAll(this)"
                    />
                    <label
                        for="select-all"
                        class="text-xs font-bold text-gray-400 cursor-pointer select-none"
                        data-i18n="cart.select_all">Pilih Semua</label
                    >
                </div>
                <button
                    onclick="removeSelected()"
                    class="text-[11px] text-red-400 hover:text-red-300 transition font-bold uppercase flex items-center gap-1.5 cursor-pointer"
                    data-i18n="cart.delete_selected"
                >
                    <div class="i-lucide-trash-2 text-xs"></div> Hapus Dipilih
                </button>
            </div>

            <div id="cart-content" class="space-y-3"></div>

            <div
                id="cart-footer"
                class="fixed bottom-[52px] md:bottom-0 left-0 right-0 bg-black/95 border-t border-gray-800 p-3 sm:p-4 hidden z-40 backdrop-blur-lg shadow-[0_-5px_20px_rgba(0,0,0,0.8)]"
            >
                <div
                    class="max-w-3xl mx-auto flex items-center justify-between gap-4"
                >
                    <div class="flex flex-col">
                        <div
                            class="text-[10px] text-gray-500 uppercase font-bold mb-0.5"
                        >
                            <span data-i18n="cart.total_selected"
                                >Total Dipilih</span
                            > (<span id="selected-count">0</span>)
                        </div>
                        <div
                            class="text-lg sm:text-xl font-mono font-bold text-cyan-400 leading-none"
                            id="cart-total"
                        >
                            Rp 0
                        </div>
                    </div>
                    <button
                        id="checkout-btn"
                        onclick="proceedToCheckout()"
                        class="bg-cyan-400 hover:bg-cyan-300 text-black font-black uppercase px-6 sm:px-8 py-2.5 sm:py-3 rounded-xl transition shadow-[0_0_20px_rgba(34,211,238,0.25)] text-xs sm:text-sm cursor-pointer disabled-btn"
                        data-i18n="cart.checkout"
                    >
                        CHECKOUT
                    </button>
                </div>
            </div>
        </section>

        <section id="tab-transactions" class="hidden">
            <div id="transactions-empty" class="hidden text-center py-16 sm:py-20 bg-gray-900/30 border border-gray-800/80 rounded-2xl p-8">
                <div
                    class="i-lucide-history text-5xl sm:text-6xl text-gray-700 mx-auto mb-4"
                >
                </div>
                <h2 class="text-lg sm:text-xl font-bold text-gray-400 mb-2">
                    Belum Ada Riwayat
                </h2>
                <p class="text-xs text-gray-500 mb-6 max-w-sm mx-auto">
                    Riwayat pesanan yang sudah dibuat di akun kamu dapat dipantau di halaman Pesanan Saya.
                </p>
                <a
                    href="/orders"
                    class="inline-flex items-center gap-2 text-cyan-400 border border-cyan-400/50 hover:border-cyan-400 px-6 py-2.5 rounded-xl hover:bg-cyan-400 hover:text-black transition font-bold text-xs uppercase shadow-[0_0_15px_rgba(34,211,238,0.15)]"
                >
                    <div class="i-lucide-receipt text-sm"></div>
                    <span>Buka Pesanan Saya</span>
                </a>
            </div>
            <div id="transactions-content" class="space-y-4"></div>
        </section>
    </main>

    <style>
        .cyber-checkbox {
            appearance: none;
            width: 18px;
            height: 18px;
            border: 1px solid #374151;
            border-radius: 4px;
            background: #000;
            cursor: pointer;
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .cyber-checkbox:checked {
            background: #22d3ee;
            border-color: #22d3ee;
            box-shadow: 0 0 10px rgba(34, 211, 238, 0.4);
        }
        .cyber-checkbox:checked::after {
            content: "✓";
            color: #000;
            font-weight: 900;
            font-size: 13px;
        }

        .disabled-btn {
            opacity: 0.5;
            cursor: not-allowed !important;
            background-color: #374151 !important;
            color: #9ca3af !important;
            box-shadow: none !important;
        }

        @keyframes modalPop {
            0% {
                transform: scale(0.9);
                opacity: 0;
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }
        .modal-animate {
            animation: modalPop 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
    </style>

    <script is:inline define:vars={{ translations }}>
        const USD_RATE = 16000;

        // --- TRANSLATION LOGIC ---
        function updatePageTranslations() {
            const currentLang = localStorage.getItem("yasui_lang") || "id";
            const t = translations[currentLang] || translations["id"];

            document.querySelectorAll("[data-i18n]").forEach((el) => {
                const key = el.getAttribute("data-i18n");
                if (t && t[key]) {
                    const icon = el.querySelector("[class^='i-lucide-']");
                    if (icon) {
                        const iconHTML = icon.outerHTML;
                        el.innerHTML = iconHTML + " " + t[key];
                    } else {
                        el.innerText = t[key];
                    }
                }
            });
        }

        updatePageTranslations();
        document.addEventListener("yasui-lang-change", updatePageTranslations);

        // --- ROBUST PRICE PARSER ---
        function parsePrice(priceStr) {
            if (!priceStr) return 0;
            let str = String(priceStr).trim();
            if (/^\d+$/.test(str)) {
                return parseInt(str, 10);
            }
            if (str.match(/[,.]00$/)) {
                str = str.substring(0, str.length - 3);
            }
            const clean = str.replace(/\D/g, "");
            return parseInt(clean, 10) || 0;
        }

        function formatMoney(n) {
            const curr = localStorage.getItem("yasui_currency") || "IDR";
            const num = parsePrice(n);
            return curr === "USD"
                ? new Intl.NumberFormat("en-US", {
                      style: "currency",
                      currency: "USD",
                  }).format(num / USD_RATE)
                : new Intl.NumberFormat("id-ID", {
                      style: "currency",
                      currency: "IDR",
                      minimumFractionDigits: 0,
                  }).format(num);
        }

        // --- CUSTOM MODAL SYSTEM ---
        const modal = document.getElementById("cyber-modal");
        const modalTitle = document.getElementById("modal-title");
        const modalMsg = document.getElementById("modal-message");
        const modalIcon = document.getElementById("modal-icon");
        const modalActions = document.getElementById("modal-actions");
        let modalResolve = null;

        window.showConfirm = (
            message,
            title = "KONFIRMASI HAPUS",
            type = "danger",
        ) => {
            return new Promise((resolve) => {
                modalResolve = resolve;
                modalTitle.innerText = title;
                modalMsg.innerText = message;

                if (type === "danger") {
                    modalIcon.className =
                        "i-lucide-alert-octagon text-xl text-red-500";
                } else {
                    modalIcon.className =
                        "i-lucide-info text-xl text-cyan-400";
                }

                const confirmClass =
                    type === "danger"
                        ? "bg-red-500 hover:bg-red-400 text-white"
                        : "bg-cyan-400 hover:bg-white text-black";

                modalActions.innerHTML = `
                    <button onclick="closeModal(false)" class="flex-1 border border-gray-600 text-gray-400 font-bold text-xs uppercase py-2.5 rounded-xl hover:bg-gray-800 transition cursor-pointer">
                        Batal
                    </button>
                    <button onclick="closeModal(true)" class="flex-1 ${confirmClass} font-black text-xs uppercase py-2.5 rounded-xl shadow-lg transition cursor-pointer">
                        Ya, Hapus
                    </button>
                `;

                modal.classList.remove("hidden");
                modal.classList.add("flex");
            });
        };

        window.showAlert = (message, title = "PERHATIAN") => {
            return new Promise((resolve) => {
                modalResolve = resolve;
                modalTitle.innerText = title;
                modalMsg.innerText = message;
                modalIcon.className =
                    "i-lucide-info text-xl text-cyan-400";

                modalActions.innerHTML = `
                    <button onclick="closeModal(true)" class="w-full bg-cyan-400 hover:bg-cyan-300 text-black font-black text-xs uppercase py-2.5 rounded-xl transition shadow-lg cursor-pointer">
                        MENGERTI
                    </button>
                `;

                modal.classList.remove("hidden");
                modal.classList.add("flex");
            });
        };

        window.closeModal = (result) => {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            if (modalResolve) modalResolve(result);
        };

        // --- CART CORE LOGIC ---
        function getCart() {
            let cart = [];
            try {
                cart = JSON.parse(localStorage.getItem("yasui_cart") || "[]");
            } catch (e) {
                cart = [];
            }
            let updated = false;
            cart = cart.map((item) => {
                if (typeof item.selected === "undefined") {
                    item.selected = true;
                    updated = true;
                }
                return item;
            });
            if (updated) {
                localStorage.setItem("yasui_cart", JSON.stringify(cart));
            }
            return cart;
        }

        function updateCartBadges() {
            const count = getCart().length;
            const globalBadge = document.getElementById("global-cart-badge");
            const mobileBadge = document.getElementById("mobile-cart-badge");
            if (globalBadge) {
                globalBadge.innerText = count;
                globalBadge.classList.toggle("hidden", count === 0);
            }
            if (mobileBadge) {
                mobileBadge.innerText = count;
                mobileBadge.classList.toggle("hidden", count === 0);
            }
        }

        function saveCart(cart) {
            localStorage.setItem("yasui_cart", JSON.stringify(cart));
            window.dispatchEvent(new Event("storage"));
            renderCart();
            updateCartBadges();
        }

        window.toggleItem = (index) => {
            let cart = getCart();
            if (cart[index]) {
                cart[index].selected = !cart[index].selected;
                saveCart(cart);
            }
        };

        window.toggleSelectAll = (el) => {
            let cart = getCart();
            const newState = el.checked;
            cart = cart.map((item) => ({ ...item, selected: newState }));
            saveCart(cart);
        };

        window.removeItem = async (index) => {
            const confirmed = await showConfirm(
                "Apakah Anda yakin ingin menghapus item ini dari keranjang?",
            );
            if (!confirmed) return;

            let cart = getCart();
            cart.splice(index, 1);
            saveCart(cart);
        };

        window.removeSelected = async () => {
            let cart = getCart();
            if (!cart.some((i) => i.selected)) {
                await showAlert("Pilih item yang ingin dihapus terlebih dahulu!");
                return;
            }

            const confirmed = await showConfirm(
                "Tindakan ini akan menghapus semua item yang dicentang dari keranjang belanja. Lanjutkan?",
                "HAPUS ITEM TERPILIH",
            );
            if (!confirmed) return;

            cart = cart.filter((item) => !item.selected);
            saveCart(cart);
        };

        // Smooth Checkout Transition
        window.proceedToCheckout = async () => {
            const cart = getCart();
            const selectedItems = cart.filter((i) => i.selected);

            if (selectedItems.length === 0) {
                await showAlert(
                    "Pilih minimal 1 produk untuk melanjutkan checkout.",
                    "KERANJANG KOSONG",
                );
                return;
            }

            window.location.href = "/checkout";
        };

        function renderCart() {
            const cart = getCart();
            const container = document.getElementById("cart-content");
            const emptyState = document.getElementById("cart-empty");
            const header = document.getElementById("cart-header");
            const footer = document.getElementById("cart-footer");
            const totalEl = document.getElementById("cart-total");
            const countEl = document.getElementById("selected-count");
            const checkoutBtn = document.getElementById("checkout-btn");
            const selectAllBox = document.getElementById("select-all");

            if (!container) return;

            if (cart.length === 0) {
                container.innerHTML = "";
                emptyState?.classList.remove("hidden");
                header?.classList.add("hidden");
                header?.classList.remove("flex");
                footer?.classList.add("hidden");
                return;
            }

            emptyState?.classList.add("hidden");
            header?.classList.remove("hidden");
            header?.classList.add("flex");
            footer?.classList.remove("hidden");

            let total = 0;
            let selectedCount = 0;
            let allSelected = true;

            container.innerHTML = cart
                .map((item, index) => {
                    const price = parsePrice(item.price);
                    if (item.selected) {
                        total += price;
                        selectedCount++;
                    } else {
                        allSelected = false;
                    }

                    return `
                    <div class="bg-gray-900/60 border ${item.selected ? "border-cyan-500/50 bg-cyan-950/20 shadow-[0_0_15px_rgba(34,211,238,0.1)]" : "border-gray-800"} rounded-xl p-3 sm:p-4 flex gap-3 sm:gap-4 items-start relative group transition-all duration-300">
                        <div class="pt-1">
                            <input type="checkbox" class="cyber-checkbox" 
                                ${item.selected ? "checked" : ""} 
                                onchange="toggleItem(${index})"
                            >
                        </div>
                        <div class="w-16 h-16 sm:w-20 sm:h-20 bg-black rounded-lg overflow-hidden shrink-0 border border-gray-800">
                            <img src="${item.image || "/favicon.svg"}" alt="${item.name || "Produk"}" class="w-full h-full object-cover ${item.selected ? "opacity-100" : "opacity-60"}">
                        </div>
                        <div class="flex-1 min-w-0 pr-8">
                            <h3 class="text-xs sm:text-sm font-bold ${item.selected ? "text-white" : "text-gray-400"} truncate transition-colors">${item.name}</h3>
                            <div class="${item.selected ? "text-cyan-400" : "text-gray-500"} font-mono font-bold text-xs sm:text-sm my-1 transition-colors">${formatMoney(price)}</div>
                            
                            ${item.email || item.wa ? `
                            <div class="text-[10px] text-gray-500 font-mono mt-1 flex flex-wrap gap-2">
                                ${item.email ? `<span><span class="text-gray-600">Email:</span> ${item.email}</span>` : ""}
                                ${item.wa ? `<span><span class="text-gray-600">Kontak:</span> ${item.wa}</span>` : ""}
                            </div>
                            ` : ""}
                        </div>
                        <button onclick="removeItem(${index})" class="text-gray-600 hover:text-red-400 p-2 absolute top-2 right-2 transition cursor-pointer" title="Hapus Item">
                            <div class="i-lucide-trash-2 text-sm sm:text-base"></div>
                        </button>
                    </div>
                `;
                })
                .join("");

            if (totalEl) totalEl.innerText = formatMoney(total);
            if (countEl) countEl.innerText = selectedCount;
            if (selectAllBox) selectAllBox.checked = cart.length > 0 && allSelected;

            if (checkoutBtn) {
                if (selectedCount === 0) {
                    checkoutBtn.classList.add("disabled-btn");
                    checkoutBtn.disabled = true;
                } else {
                    checkoutBtn.classList.remove("disabled-btn");
                    checkoutBtn.disabled = false;
                }
            }
        }

        renderCart();
        updateCartBadges();

        // --- TABS & TRANSACTIONS LOGIC ---
        window.switchTab = (tabName) => {
            const tabCart = document.getElementById("tab-cart");
            const tabTrans = document.getElementById("tab-transactions");
            const btnCart = document.getElementById("btn-tab-cart");
            const btnTrans = document.getElementById("btn-tab-transactions");
            const footer = document.getElementById("cart-footer");

            if (tabName === "cart") {
                tabCart?.classList.remove("hidden");
                tabTrans?.classList.add("hidden");

                btnCart?.classList.add("border-cyan-400", "text-white");
                btnCart?.classList.remove("border-transparent", "text-gray-500");

                btnTrans?.classList.remove("border-cyan-400", "text-white");
                btnTrans?.classList.add("border-transparent", "text-gray-500");

                if (getCart().length > 0) footer?.classList.remove("hidden");

                const url = new URL(window.location);
                url.searchParams.set("tab", "cart");
                window.history.pushState({}, "", url);
            } else {
                tabCart?.classList.add("hidden");
                tabTrans?.classList.remove("hidden");

                btnCart?.classList.remove("border-cyan-400", "text-white");
                btnCart?.classList.add("border-transparent", "text-gray-500");

                btnTrans?.classList.add("border-cyan-400", "text-white");
                btnTrans?.classList.remove("border-transparent", "text-gray-500");

                footer?.classList.add("hidden");
                renderTransactions();

                const url = new URL(window.location);
                url.searchParams.set("tab", "transactions");
                window.history.pushState({}, "", url);
            }
        };

        function getTransactions() {
            try {
                return JSON.parse(
                    localStorage.getItem("yasui_transactions") || "[]",
                );
            } catch (e) {
                return [];
            }
        }

        function renderTransactions() {
            const txs = getTransactions();
            const container = document.getElementById("transactions-content");
            const empty = document.getElementById("transactions-empty");

            if (!container) return;

            if (txs.length === 0) {
                container.innerHTML = "";
                empty?.classList.remove("hidden");
                return;
            }

            empty?.classList.add("hidden");
            container.innerHTML = txs
                .map((tx) => {
                    const statusColor =
                        tx.status === "PAID"
                            ? "text-emerald-400 border-emerald-500/40 bg-emerald-950/20"
                            : tx.status === "PENDING"
                              ? "text-yellow-400 border-yellow-500/40 bg-yellow-950/20"
                              : "text-gray-400 border-gray-700 bg-black/50";
                    return `
                        <div class="bg-gray-900/50 border border-gray-800 rounded-xl p-4">
                            <div class="flex justify-between items-start mb-3">
                                <div>
                                    <div class="text-[10px] text-gray-500 font-mono mb-1">ID: ${tx.id || "-"}</div>
                                    <div class="text-xs font-bold text-white">${tx.date || "Baru Saja"}</div>
                                </div>
                                <div class="text-[11px] font-bold ${statusColor} border px-2 py-0.5 rounded-lg">
                                    ${tx.status || "PENDING"}
                                </div>
                            </div>
                            <div class="space-y-2 mb-3">
                                ${(tx.items || [])
                                    .map(
                                        (item) => `
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 bg-black rounded-lg overflow-hidden shrink-0 border border-gray-800">
                                            <img src="${item.image || "/favicon.svg"}" class="w-full h-full object-cover">
                                        </div>
                                        <div class="min-w-0">
                                            <div class="text-xs font-bold text-gray-300 truncate">${item.name}</div>
                                            <div class="text-[10px] text-cyan-400 font-mono">${formatMoney(item.price)}</div>
                                        </div>
                                    </div>
                                `,
                                    )
                                    .join("")}
                            </div>
                            <div class="border-t border-gray-800/80 pt-3 flex justify-between items-center">
                                <div class="text-[10px] text-gray-500 font-mono uppercase">TOTAL ORDER</div>
                                <div class="text-sm font-bold text-cyan-400 font-mono">${formatMoney(tx.total || 0)}</div>
                            </div>
                        </div>
                    `;
                })
                .join("");
        }

        // Initialize Tab based on URL
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get("tab") === "transactions") {
            window.switchTab("transactions");
        } else {
            window.switchTab("cart");
        }
    </script>
</Layout>
