---
// src/pages/cart.astro
import Layout from "../layouts/Layout.astro";
import { translations } from "../lib/translations";
---

<Layout
    title="Keranjang Belanja - Yasui Game"
    description="Kelola produk dan akun game dalam keranjang belanja Yasui Game"
    showFooter={false}
>
    <div
        id="cyber-modal"
        class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-sm hidden flex-col justify-center items-center p-4"
    >
        <div
            class="relative bg-[#11131A] border border-[#222634] w-full max-w-sm p-6 rounded-lg shadow-2xl modal-animate"
        >
            <div class="flex items-center gap-3 mb-4">
                <div
                    class="w-10 h-10 bg-[#161922] rounded-md flex items-center justify-center border border-[#222634]"
                >
                    <div
                        id="modal-icon"
                        class="i-lucide-alert-triangle text-xl text-amber-400"
                    >
                    </div>
                </div>
                <div>
                    <h3
                        id="modal-title"
                        class="text-[#F8FAFC] font-bold uppercase tracking-wider text-xs"
                    >
                        KONFIRMASI
                    </h3>
                    <p class="text-[10px] text-[#64748B] font-mono">
                        System Prompt
                    </p>
                </div>
            </div>

            <p
                id="modal-message"
                class="text-[#94A3B8] text-xs mb-6 leading-relaxed"
            >
                Apakah Anda yakin ingin melanjutkan tindakan ini?
            </p>

            <div class="flex gap-2.5" id="modal-actions"></div>
        </div>
    </div>

    <main class="max-w-3xl mx-auto px-4 pt-4 md:pt-6 pb-44 md:pb-28">
        <div class="flex items-center justify-between mb-4">
            <a
                href="/"
                class="text-xs font-semibold text-[#94A3B8] hover:text-[#F8FAFC] flex items-center gap-1.5 transition-colors"
                data-i18n="cart.continue_shopping"
            >
                <div class="i-lucide-arrow-left text-sm"></div> LANJUT BELANJA
            </a>
            <div
                class="text-[11px] font-mono font-medium text-[#00E5FF] uppercase tracking-widest flex items-center gap-1.5"
            >
                <div class="i-lucide-shield-check text-xs"></div> SECURE CART
            </div>
        </div>

        <nav
            class="flex items-center gap-6 mb-6 border-b border-[#222634]"
            aria-label="Cart Navigation"
        >
            <button
                id="btn-tab-cart"
                onclick="switchTab('cart')"
                class="pb-3 border-b-2 border-[#00E5FF] text-[#F8FAFC] font-semibold text-xs uppercase tracking-wider flex items-center gap-2 transition-colors cursor-pointer"
            >
                <div class="i-lucide-shopping-cart text-sm"></div>
                <span data-i18n="cart.title">KERANJANG</span>
            </button>
            <button
                id="btn-tab-transactions"
                onclick="switchTab('transactions')"
                class="pb-3 border-b-2 border-transparent text-[#64748B] hover:text-[#94A3B8] font-semibold text-xs uppercase tracking-wider flex items-center gap-2 transition-colors cursor-pointer"
            >
                <div class="i-lucide-history text-sm"></div>
                <span data-i18n="cart.tab_history">RIWAYAT TRANSAKSI</span>
            </button>
        </nav>

        <section id="tab-cart">
            <div id="cart-empty" class="hidden text-center py-16 sm:py-20 bg-[#11131A] border border-[#222634] rounded-lg p-8">
                <div
                    class="i-lucide-shopping-cart text-5xl sm:text-6xl text-[#222634] mx-auto mb-4"
                >
                </div>
                <h2
                    class="text-base sm:text-lg font-bold text-[#F8FAFC] mb-2"
                    data-i18n="cart.empty_title"
                >
                    Keranjang Belanja Kosong
                </h2>
                <p
                    class="text-xs text-[#94A3B8] mb-6 max-w-sm mx-auto"
                    data-i18n="cart.empty_desc"
                >
                    Belum ada item yang siap dicheckout. Silakan jelajahi katalog game untuk menemukan akun idaman Anda.
                </p>
                <a
                    href="/"
                    class="yg-btn-primary"
                    data-i18n="cart.find_game"
                >
                    <div class="i-lucide-gamepad-2 text-sm"></div>
                    <span>Cari Game</span>
                </a>
            </div>

            <div
                id="cart-header"
                class="hidden items-center justify-between mb-4 px-1"
            >
                <div class="flex items-center gap-2.5">
                    <input
                        type="checkbox"
                        id="select-all"
                        class="cyber-checkbox"
                        onclick="toggleSelectAll(this)"
                    />
                    <label
                        for="select-all"
                        class="text-xs font-semibold text-[#94A3B8] cursor-pointer select-none"
                        data-i18n="cart.select_all">Pilih Semua</label
                    >
                </div>
                <button
                    onclick="removeSelected()"
                    class="text-[11px] text-red-400 hover:text-red-300 transition-colors font-mono font-medium uppercase flex items-center gap-1.5 cursor-pointer"
                    data-i18n="cart.delete_selected"
                >
                    <div class="i-lucide-trash-2 text-xs"></div> Hapus Dipilih
                </button>
            </div>

            <div id="cart-content" class="space-y-3"></div>

            <div
                id="cart-footer"
                class="fixed bottom-[52px] md:bottom-0 left-0 right-0 bg-[#0D0F15]/95 border-t border-[#222634] p-3 sm:p-4 hidden z-40 backdrop-blur-md shadow-2xl"
            >
                <div
                    class="max-w-3xl mx-auto flex items-center justify-between gap-4"
                >
                    <div class="flex flex-col">
                        <div
                            class="text-[10px] text-[#64748B] uppercase font-mono font-semibold mb-0.5"
                        >
                            <span data-i18n="cart.total_selected"
                                >Total Dipilih</span
                            > (<span id="selected-count" class="text-[#F8FAFC]">0</span> item)
                        </div>
                        <div
                            class="text-lg sm:text-xl font-mono font-bold text-[#00E5FF] tabular-nums leading-none"
                            id="cart-total"
                        >
                            Rp 0
                        </div>
                    </div>
                    <button
                        id="checkout-btn"
                        onclick="proceedToCheckout()"
                        class="yg-btn-primary px-6 sm:px-8 py-2.5 sm:py-3 text-xs sm:text-sm"
                        data-i18n="cart.checkout"
                    >
                        LANJUT CHECKOUT
                    </button>
                </div>
            </div>
        </section>

        <section id="tab-transactions" class="hidden">
            <div id="transactions-empty" class="hidden text-center py-16 sm:py-20 bg-[#11131A] border border-[#222634] rounded-lg p-8">
                <div
                    class="i-lucide-history text-5xl sm:text-6xl text-[#222634] mx-auto mb-4"
                >
                </div>
                <h2 class="text-base sm:text-lg font-bold text-[#F8FAFC] mb-2" data-i18n="cart.no_history_title">
                    Belum Ada Riwayat
                </h2>
                <p class="text-xs text-[#94A3B8] mb-6 max-w-sm mx-auto" data-i18n="cart.no_history_desc">
                    Riwayat pesanan yang sudah dibuat di akun kamu dapat dipantau di halaman Pesanan Saya.
                </p>
                <a
                    href="/orders"
                    class="yg-btn-secondary"
                    data-i18n="cart.open_orders"
                >
                    <div class="i-lucide-receipt text-sm text-[#00E5FF]"></div>
                    <span>Buka Pesanan Saya</span>
                </a>
            </div>
            <div id="transactions-content" class="space-y-3"></div>
        </section>
    </main>

    <style>
        .cyber-checkbox {
            appearance: none;
            width: 18px;
            height: 18px;
            border: 1px solid #222634;
            border-radius: 4px;
            background: #0D0F15;
            cursor: pointer;
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s ease;
        }
        .cyber-checkbox:hover {
            border-color: #00E5FF;
        }
        .cyber-checkbox:checked {
            background: #00E5FF;
            border-color: #00E5FF;
        }
        .cyber-checkbox:checked::after {
            content: "✓";
            color: #090A0F;
            font-weight: 900;
            font-size: 12px;
            line-height: 1;
        }

        .disabled-btn {
            opacity: 0.45 !important;
            cursor: not-allowed !important;
            pointer-events: none;
        }

        @keyframes modalPop {
            0% {
                transform: scale(0.96);
                opacity: 0;
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }
        .modal-animate {
            animation: modalPop 0.15s ease-out;
        }
    </style>

    <script is:inline define:vars={{ translations }}>
        const USD_RATE = 16000;

        // --- TRANSLATION LOGIC ---
        function updatePageTranslations() {
            const currentLang = localStorage.getItem("yasui_lang") || "id";
            const t = translations[currentLang] || translations["id"];

            document.querySelectorAll("[data-i18n]").forEach((el) => {
                const key = el.getAttribute("data-i18n");
                if (t && t[key]) {
                    const icon = el.querySelector("[class^='i-lucide-']");
                    if (icon) {
                        const iconHTML = icon.outerHTML;
                        el.innerHTML = iconHTML + " " + t[key];
                    } else {
                        el.innerText = t[key];
                    }
                }
            });
        }

        updatePageTranslations();
        document.addEventListener("yasui-lang-change", updatePageTranslations);
        document.addEventListener("yasui-currency-change", () => {
            renderCart();
            if (document.getElementById("tab-transactions")?.classList.contains("hidden") === false) {
                renderTransactions();
            }
        });

        // --- ROBUST PRICE PARSER ---
        function parsePrice(priceStr) {
            if (!priceStr) return 0;
            let str = String(priceStr).trim();
            if (/^\d+$/.test(str)) {
                return parseInt(str, 10);
            }
            if (str.match(/[,.]00$/)) {
                str = str.substring(0, str.length - 3);
            }
            const clean = str.replace(/\D/g, "");
            return parseInt(clean, 10) || 0;
        }

        function formatMoney(n) {
            const curr = localStorage.getItem("yasui_currency") || "IDR";
            const num = parsePrice(n);
            return curr === "USD"
                ? new Intl.NumberFormat("en-US", {
                      style: "currency",
                      currency: "USD",
                  }).format(num / USD_RATE)
                : new Intl.NumberFormat("id-ID", {
                      style: "currency",
                      currency: "IDR",
                      minimumFractionDigits: 0,
                  }).format(num);
        }

        // --- CUSTOM MODAL SYSTEM ---
        const modal = document.getElementById("cyber-modal");
        const modalTitle = document.getElementById("modal-title");
        const modalMsg = document.getElementById("modal-message");
        const modalIcon = document.getElementById("modal-icon");
        const modalActions = document.getElementById("modal-actions");
        let modalResolve = null;

        window.showConfirm = (
            message,
            title = "KONFIRMASI HAPUS",
            type = "danger",
        ) => {
            return new Promise((resolve) => {
                modalResolve = resolve;
                modalTitle.innerText = title;
                modalMsg.innerText = message;

                if (type === "danger") {
                    modalIcon.className =
                        "i-lucide-alert-octagon text-xl text-red-500";
                } else {
                    modalIcon.className =
                        "i-lucide-info text-xl text-cyan-400";
                }

                const confirmClass =
                    type === "danger"
                        ? "yg-btn-danger"
                        : "yg-btn-primary";

                modalActions.innerHTML = `
                    <button onclick="closeModal(false)" class="yg-btn-secondary flex-1 py-2 text-xs">
                        Batal
                    </button>
                    <button onclick="closeModal(true)" class="${confirmClass} flex-1 py-2 text-xs">
                        Ya, Hapus
                    </button>
                `;

                modal.classList.remove("hidden");
                modal.classList.add("flex");
            });
        };

        window.showAlert = (message, title = "PERHATIAN") => {
            return new Promise((resolve) => {
                modalResolve = resolve;
                modalTitle.innerText = title;
                modalMsg.innerText = message;
                modalIcon.className =
                    "i-lucide-info text-xl text-[#00E5FF]";

                modalActions.innerHTML = `
                    <button onclick="closeModal(true)" class="yg-btn-primary w-full py-2.5 text-xs">
                        MENGERTI
                    </button>
                `;

                modal.classList.remove("hidden");
                modal.classList.add("flex");
            });
        };

        window.closeModal = (result) => {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            if (modalResolve) modalResolve(result);
        };

        // --- CART CORE LOGIC ---
        function getCart() {
            let cart = [];
            try {
                cart = JSON.parse(localStorage.getItem("yasui_cart") || "[]");
            } catch (e) {
                cart = [];
            }
            let updated = false;
            cart = cart.map((item) => {
                if (typeof item.selected === "undefined") {
                    item.selected = true;
                    updated = true;
                }
                return item;
            });
            if (updated) {
                localStorage.setItem("yasui_cart", JSON.stringify(cart));
            }
            return cart;
        }

        function updateCartBadges() {
            const count = getCart().length;
            const globalBadge = document.getElementById("global-cart-badge");
            const mobileBadge = document.getElementById("mobile-cart-badge");
            if (globalBadge) {
                globalBadge.innerText = count;
                globalBadge.classList.toggle("hidden", count === 0);
            }
            if (mobileBadge) {
                mobileBadge.innerText = count;
                mobileBadge.classList.toggle("hidden", count === 0);
            }
        }

        function saveCart(cart) {
            localStorage.setItem("yasui_cart", JSON.stringify(cart));
            window.dispatchEvent(new Event("storage"));
            renderCart();
            updateCartBadges();
        }

        window.toggleItem = (index) => {
            let cart = getCart();
            if (cart[index]) {
                cart[index].selected = !cart[index].selected;
                saveCart(cart);
            }
        };

        window.toggleSelectAll = (el) => {
            let cart = getCart();
            const newState = el.checked;
            cart = cart.map((item) => ({ ...item, selected: newState }));
            saveCart(cart);
        };

        window.removeItem = async (index) => {
            const confirmed = await showConfirm(
                "Apakah Anda yakin ingin menghapus item ini dari keranjang?",
            );
            if (!confirmed) return;

            let cart = getCart();
            cart.splice(index, 1);
            saveCart(cart);
        };

        window.removeSelected = async () => {
            let cart = getCart();
            if (!cart.some((i) => i.selected)) {
                await showAlert("Pilih item yang ingin dihapus terlebih dahulu!");
                return;
            }

            const confirmed = await showConfirm(
                "Tindakan ini akan menghapus semua item yang dicentang dari keranjang belanja. Lanjutkan?",
                "HAPUS ITEM TERPILIH",
            );
            if (!confirmed) return;

            cart = cart.filter((item) => !item.selected);
            saveCart(cart);
        };

        // Smooth Checkout Transition
        window.proceedToCheckout = async () => {
            const cart = getCart();
            const selectedItems = cart.filter((i) => i.selected);

            if (selectedItems.length === 0) {
                await showAlert(
                    "Pilih minimal 1 produk untuk melanjutkan checkout.",
                    "KERANJANG KOSONG",
                );
                return;
            }

            window.location.href = "/checkout";
        };

        function renderCart() {
            const cart = getCart();
            const container = document.getElementById("cart-content");
            const emptyState = document.getElementById("cart-empty");
            const header = document.getElementById("cart-header");
            const footer = document.getElementById("cart-footer");
            const totalEl = document.getElementById("cart-total");
            const countEl = document.getElementById("selected-count");
            const checkoutBtn = document.getElementById("checkout-btn");
            const selectAllBox = document.getElementById("select-all");

            if (!container) return;

            if (cart.length === 0) {
                container.innerHTML = "";
                emptyState?.classList.remove("hidden");
                header?.classList.add("hidden");
                header?.classList.remove("flex");
                footer?.classList.add("hidden");
                return;
            }

            emptyState?.classList.add("hidden");
            header?.classList.remove("hidden");
            header?.classList.add("flex");
            footer?.classList.remove("hidden");

            let total = 0;
            let selectedCount = 0;
            let allSelected = true;

            container.innerHTML = cart
                .map((item, index) => {
                    const price = parsePrice(item.price);
                    if (item.selected) {
                        total += price;
                        selectedCount++;
                    } else {
                        allSelected = false;
                    }

                    return `
                    <div class="bg-[#11131A] border ${item.selected ? "border-[#00E5FF] bg-[#00E5FF]/5" : "border-[#222634]"} rounded-lg p-3 sm:p-4 flex gap-3 sm:gap-4 items-start relative group transition-colors">
                        <div class="pt-1">
                            <input type="checkbox" class="cyber-checkbox" 
                                ${item.selected ? "checked" : ""} 
                                onchange="toggleItem(${index})"
                            >
                        </div>
                        <div class="w-16 h-16 sm:w-20 sm:h-20 bg-[#0D0F15] rounded-md overflow-hidden shrink-0 border border-[#222634]">
                            <img src="${item.image || "/favicon.svg"}" alt="${item.name || "Produk"}" class="w-full h-full object-cover ${item.selected ? "opacity-100" : "opacity-60"}">
                        </div>
                        <div class="flex-1 min-w-0 pr-8">
                            <h3 class="text-xs sm:text-sm font-semibold ${item.selected ? "text-[#F8FAFC]" : "text-[#94A3B8]"} truncate transition-colors">${item.name}</h3>
                            <div class="${item.selected ? "text-[#00E5FF]" : "text-[#64748B]"} font-mono font-bold text-xs sm:text-sm my-1 tabular-nums transition-colors">${formatMoney(price)}</div>
                            
                            ${item.email || item.wa ? `
                            <div class="text-[10px] text-[#64748B] font-mono mt-1 flex flex-wrap gap-2">
                                ${item.email ? `<span><span class="text-[#475569]">Email:</span> <span class="text-[#94A3B8]">${item.email}</span></span>` : ""}
                                ${item.wa ? `<span><span class="text-[#475569]">Kontak:</span> <span class="text-[#94A3B8]">${item.wa}</span></span>` : ""}
                            </div>
                            ` : ""}
                        </div>
                        <button onclick="removeItem(${index})" class="text-[#64748B] hover:text-red-400 p-2 absolute top-2 right-2 transition-colors cursor-pointer" title="Hapus Item">
                            <div class="i-lucide-trash-2 text-sm sm:text-base"></div>
                        </button>
                    </div>
                `;
                })
                .join("");

            if (totalEl) totalEl.innerText = formatMoney(total);
            if (countEl) countEl.innerText = selectedCount;
            if (selectAllBox) selectAllBox.checked = cart.length > 0 && allSelected;

            if (checkoutBtn) {
                if (selectedCount === 0) {
                    checkoutBtn.classList.add("disabled-btn");
                    checkoutBtn.disabled = true;
                } else {
                    checkoutBtn.classList.remove("disabled-btn");
                    checkoutBtn.disabled = false;
                }
            }
        }

        renderCart();
        updateCartBadges();

        // --- TABS & TRANSACTIONS LOGIC ---
        window.switchTab = (tabName) => {
            const tabCart = document.getElementById("tab-cart");
            const tabTrans = document.getElementById("tab-transactions");
            const btnCart = document.getElementById("btn-tab-cart");
            const btnTrans = document.getElementById("btn-tab-transactions");
            const footer = document.getElementById("cart-footer");

            if (tabName === "cart") {
                tabCart?.classList.remove("hidden");
                tabTrans?.classList.add("hidden");

                btnCart?.classList.add("border-[#00E5FF]", "text-[#F8FAFC]");
                btnCart?.classList.remove("border-transparent", "text-[#64748B]");

                btnTrans?.classList.remove("border-[#00E5FF]", "text-[#F8FAFC]");
                btnTrans?.classList.add("border-transparent", "text-[#64748B]");

                if (getCart().length > 0) footer?.classList.remove("hidden");

                const url = new URL(window.location);
                url.searchParams.set("tab", "cart");
                window.history.pushState({}, "", url);
            } else {
                tabCart?.classList.add("hidden");
                tabTrans?.classList.remove("hidden");

                btnCart?.classList.remove("border-[#00E5FF]", "text-[#F8FAFC]");
                btnCart?.classList.add("border-transparent", "text-[#64748B]");

                btnTrans?.classList.add("border-[#00E5FF]", "text-[#F8FAFC]");
                btnTrans?.classList.remove("border-transparent", "text-[#64748B]");

                footer?.classList.add("hidden");
                renderTransactions();

                const url = new URL(window.location);
                url.searchParams.set("tab", "transactions");
                window.history.pushState({}, "", url);
            }
        };

        function getTransactions() {
            try {
                return JSON.parse(
                    localStorage.getItem("yasui_transactions") || "[]",
                );
            } catch (e) {
                return [];
            }
        }

        function renderTransactions() {
            const txs = getTransactions();
            const container = document.getElementById("transactions-content");
            const empty = document.getElementById("transactions-empty");

            if (!container) return;

            if (txs.length === 0) {
                container.innerHTML = "";
                empty?.classList.remove("hidden");
                return;
            }

            empty?.classList.add("hidden");
            container.innerHTML = txs
                .map((tx) => {
                    const statusColor =
                        tx.status === "PAID"
                            ? "yg-badge-emerald"
                            : tx.status === "PENDING"
                              ? "yg-badge-yellow"
                              : "yg-badge-gray";
                    return `
                        <div class="bg-[#11131A] border border-[#222634] rounded-lg p-4 transition-colors">
                            <div class="flex justify-between items-start mb-3">
                                <div>
                                    <div class="text-[10px] text-[#64748B] font-mono mb-0.5">ID: ${tx.id || "-"}</div>
                                    <div class="text-xs font-semibold text-[#F8FAFC]">${tx.date || "Baru Saja"}</div>
                                </div>
                                <div class="${statusColor}">
                                    ${tx.status || "PENDING"}
                                </div>
                            </div>
                            <div class="space-y-2 mb-3">
                                ${(tx.items || [])
                                    .map(
                                        (item) => `
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 bg-[#0D0F15] rounded-md overflow-hidden shrink-0 border border-[#222634]">
                                            <img src="${item.image || "/favicon.svg"}" class="w-full h-full object-cover">
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="text-xs font-medium text-[#F8FAFC] truncate">${item.name}</div>
                                            <div class="text-[10px] text-[#00E5FF] font-mono tabular-nums">${formatMoney(item.price)}</div>
                                        </div>
                                    </div>
                                `,
                                    )
                                    .join("")}
                            </div>
                            <div class="border-t border-[#222634] pt-3 flex justify-between items-center">
                                <div class="text-[10px] text-[#64748B] font-mono uppercase font-semibold">TOTAL ORDER</div>
                                <div class="text-xs font-mono font-bold text-[#00E5FF] tabular-nums">${formatMoney(tx.total || 0)}</div>
                            </div>
                        </div>
                    `;
                })
                .join("");
        }

        // Initialize Tab based on URL
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get("tab") === "transactions") {
            window.switchTab("transactions");
        } else {
            window.switchTab("cart");
        }
    </script>
</Layout>
