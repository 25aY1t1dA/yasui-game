                    id="reset-filter-mobile"
                    class="flex-1 py-4 border border-gray-700 text-gray-400 font-bold rounded-xl hover:bg-white/5 hover:text-white hover:border-white transition tracking-widest text-xs"
                    data-i18n="search.reset">RESET</button
                >
