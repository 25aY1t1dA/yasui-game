---
import Layout from "../layouts/Layout.astro";
import { parsePrice } from "../lib/price";
import { getProducts, getCategories, normalizeProduct } from "../lib/wc";

const fixImgUrl = (url: any) => {
    if (!url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};

let products: any[] = [];
let allCategories: any[] = [];
let serverOptions: any[] = [];
let tierOptions: any[] = [];
let connectionSuccess = false;

try {
    const rawProducts = await getProducts({ per_page: 100 });
    const rawCategories = await getCategories({ per_page: 50, hide_empty: false });

    products = (rawProducts || []).map((raw: any) => {
        const p = normalizeProduct(raw);
        const cats = p.categories?.map((c: any) => c.name) || [];
        const attrs = p.attributes?.nodes || [];
        
        let type = "other";
        if (cats.some((c: string) => c.toLowerCase().includes("akun"))) {
            type = "account";
        } else if (
            cats.some((c: string) => /item|voucher|top\s*up|jasa/i.test(c))
        ) {
            type = "item";
        }

        const flatAttrs: any = {};
        attrs.forEach((a: any) => {
            const name = a.name.toLowerCase();
            if (name.includes('server')) flatAttrs.server = a.options;
            if (name.includes('tier') || name.includes('rank')) flatAttrs.tier = a.options;
        });

        return {
            name: p.name,
            slug: p.slug,
            image: p.image?.sourceUrl ? fixImgUrl(p.image.sourceUrl) : null,
            priceRaw: parsePrice(p.price),
            priceFmt: p.price || "Rp 0",
            categories: cats,
            stock: p.stockStatus,
            type: type,
            attrs: flatAttrs
        };
    });

    const serverCounts: Record<string, number> = {};
    const tierCounts: Record<string, number> = {};

    products.forEach((p) => {
        if (p.attrs.server) {
            p.attrs.server.forEach((val: string) => {
                serverCounts[val] = (serverCounts[val] || 0) + 1;
            });
        }
        if (p.attrs.tier) {
            p.attrs.tier.forEach((val: string) => {
                tierCounts[val] = (tierCounts[val] || 0) + 1;
            });
        }
    });

    serverOptions = Object.entries(serverCounts).map(([k, v]) => ({ value: k, count: v }));
    tierOptions = Object.entries(tierCounts).map(([k, v]) => ({ value: k, count: v }));

    allCategories = (rawCategories || []).map((c: any) => ({
        name: c.name,
        slug: c.slug,
        count: c.count
    }));

    connectionSuccess = true;
} catch (error: any) {
    console.error("❌ SEARCH PAGE FETCH ERROR:", error.message);
}

const initialQuery = Astro.url.searchParams.get("q") || "";
---

<Layout title="Pencarian Katalog - Yasui Game" description="Cari dan filter katalog akun game, item, dan voucher terverifikasi.">
    <main class="yg-shell pt-4 md:pt-6 pb-24 min-h-screen">
        <header class="mb-8">
            <h1 class="text-xl md:text-3xl font-extrabold text-[#F8FAFC] tracking-tight uppercase mb-4" data-i18n="search.title">
                Pencarian Katalog
            </h1>
            <div class="relative flex items-center">
                <span class="i-lucide-search absolute left-3.5 text-[#64748B] text-base pointer-events-none" />
                <input
                    type="text"
                    id="main-search"
                    class="yg-input !h-12 !pl-11 !pr-4 !text-sm !bg-[#0D0F17]"
                    placeholder="Ketik nama game, monster Summoners War, atau item Roblox..."
                    data-i18n-placeholder="search.placeholder"
                    value={initialQuery}
                    autocomplete="off"
                />
            </div>
        </header>

        <div class="flex flex-col lg:flex-row gap-6 relative items-start">
            {/* Desktop Filter Sidebar */}
            <aside class="hidden lg:block w-72 shrink-0 space-y-4 sticky top-24">
                <div class="flex items-center justify-between pb-2 border-b border-[#222634]">
                    <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#F8FAFC] flex items-center gap-2">
                        <span class="i-lucide-sliders-horizontal text-[#00E5FF] text-xs"></span>
                        <span data-i18n="search.filter">FILTER PRODUK</span>
                    </h2>
                    <button
                        id="reset-all-desktop"
                        class="text-[11px] font-mono text-[#64748B] hover:text-[#00E5FF] underline cursor-pointer"
                        data-i18n="search.reset_all"
                    >
                        Reset Semua
                    </button>
                </div>

                {/* Filter Product Type */}
                <div class="yg-card p-4 rounded-lg bg-[#11131A] border border-[#222634]">
                    <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8] mb-2.5" data-i18n="search.product_type">
                        Tipe Produk
                    </h3>
                    <div class="space-y-1.5 text-xs font-mono">
                        <label class="flex items-center gap-2.5 cursor-pointer py-1 text-[#94A3B8] hover:text-[#F8FAFC] transition-colors">
                            <input
                                type="radio"
                                name="filter-type"
                                value="all"
                                checked
                                class="accent-[#00E5FF]"
                            />
                            <span data-i18n="search.type_all">Semua Tipe</span>
                        </label>
                        <label class="flex items-center gap-2.5 cursor-pointer py-1 text-[#94A3B8] hover:text-[#F8FAFC] transition-colors">
                            <input
                                type="radio"
                                name="filter-type"
                                value="account"
                                class="accent-[#00E5FF]"
                            />
                            <span data-i18n="search.type_account">Hanya Akun</span>
                        </label>
                        <label class="flex items-center gap-2.5 cursor-pointer py-1 text-[#94A3B8] hover:text-[#F8FAFC] transition-colors">
                            <input
                                type="radio"
                                name="filter-type"
                                value="item"
                                class="accent-[#00E5FF]"
                            />
                            <span data-i18n="search.type_item">Item / Voucher / Robux</span>
                        </label>
                    </div>
                </div>

                {/* Server Filter */}
                {serverOptions.length > 0 && (
                    <div class="yg-card p-4 rounded-lg bg-[#11131A] border border-[#222634]">
                        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8] mb-2.5">
                            Server
                        </h3>
                        <div class="space-y-1 max-h-36 overflow-y-auto pr-1 text-xs font-mono custom-scrollbar">
                            {serverOptions.map((opt) => (
                                <label class="flex items-center justify-between gap-2 cursor-pointer py-1 text-[#94A3B8] hover:text-[#F8FAFC] transition-colors">
                                    <div class="flex items-center gap-2">
                                        <input
                                            type="checkbox"
                                            value={opt.value}
                                            class="filter-server accent-[#00E5FF]"
                                        />
                                        <span>{opt.value}</span>
                                    </div>
                                    <span class="text-[10px] text-[#64748B] tabular-nums">
                                        {opt.count}
                                    </span>
                                </label>
                            ))}
                        </div>
                    </div>
                )}

                {/* Tier Filter */}
                {tierOptions.length > 0 && (
                    <div class="yg-card p-4 rounded-lg bg-[#11131A] border border-[#222634]">
                        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8] mb-2.5">
                            Tier / Rank
                        </h3>
                        <div class="space-y-1 max-h-36 overflow-y-auto pr-1 text-xs font-mono custom-scrollbar">
                            {tierOptions.map((opt) => (
                                <label class="flex items-center justify-between gap-2 cursor-pointer py-1 text-[#94A3B8] hover:text-[#F8FAFC] transition-colors">
                                    <div class="flex items-center gap-2">
                                        <input
                                            type="checkbox"
                                            value={opt.value}
                                            class="filter-tier accent-[#00E5FF]"
                                        />
                                        <span>{opt.value}</span>
                                    </div>
                                    <span class="text-[10px] text-[#64748B] tabular-nums">
                                        {opt.count}
                                    </span>
                                </label>
                            ))}
                        </div>
                    </div>
                )}

                {/* Category Filter */}
                <div class="yg-card p-4 rounded-lg bg-[#11131A] border border-[#222634]">
                    <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8] mb-2.5" data-i18n="search.category">
                        Kategori Game
                    </h3>
                    <div class="relative mb-2">
                        <input
                            type="text"
                            id="cat-search"
                            placeholder="Cari kategori..."
                            data-i18n="search.category_placeholder"
                            class="yg-input !h-9 !text-xs !bg-[#0D0F17]"
                        />
                    </div>
                    <div id="cat-list-desktop" class="space-y-1 max-h-48 overflow-y-auto pr-1 text-xs font-mono custom-scrollbar">
                        {allCategories.map((cat: any) => (
                            <label class="flex items-center justify-between gap-2 cursor-pointer py-1 text-[#94A3B8] hover:text-[#F8FAFC] transition-colors cat-item">
                                <div class="flex items-center gap-2 min-w-0">
                                    <input
                                        type="checkbox"
                                        value={cat.name}
                                        class="filter-category accent-[#00E5FF] shrink-0"
                                    />
                                    <span class="truncate cat-name">{cat.name}</span>
                                </div>
                                <span class="text-[10px] text-[#64748B] tabular-nums shrink-0">
                                    {cat.count}
                                </span>
                            </label>
                        ))}
                    </div>
                </div>

                {/* Price Range */}
                <div class="yg-card p-4 rounded-lg bg-[#11131A] border border-[#222634]">
                    <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8] mb-2.5" data-i18n="search.price_range">
                        Rentang Harga (IDR)
                    </h3>
                    <div class="space-y-2">
                        <input
                            type="number"
                            id="filter-min"
                            placeholder="Harga Minimum"
                            data-i18n-placeholder="search.price_min"
                            class="yg-input !h-9 !text-xs !bg-[#0D0F17]"
                        />
                        <input
                            type="number"
                            id="filter-max"
                            placeholder="Harga Maksimum"
                            data-i18n-placeholder="search.price_max"
                            class="yg-input !h-9 !text-xs !bg-[#0D0F17]"
                        />
                    </div>
                </div>
            </aside>

            {/* Results Grid Area */}
            <div class="flex-1 min-w-0">
                <div class="flex flex-col sm:flex-row justify-between items-center mb-4 pb-3 border-b border-[#222634] gap-3">
                    <p class="text-xs font-mono text-[#94A3B8]">
                        <span data-i18n="search.showing_text">Menampilkan</span>
                        <strong id="result-count" class="text-[#00E5FF] tabular-nums mx-1">{products.length}</strong>
                        <span data-i18n="search.product_text">produk katalog</span>
                    </p>
                    <select
                        id="sort-select"
                        class="yg-select !h-10 !text-xs"
                    >
                        <option value="newest" data-i18n="search.sort.newest">Terbaru</option>
                        <option value="cheapest" data-i18n="search.sort.cheapest">Harga Terendah</option>
                        <option value="expensive" data-i18n="search.sort.expensive">Harga Tertinggi</option>
                    </select>
                </div>

                <div
                    id="product-grid"
                    class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-3 md:gap-4"
                >
                </div>

                <div
                    id="empty-state"
                    class="hidden flex-col items-center justify-center py-16 text-center border border-dashed border-[#222634] rounded-lg bg-[#0D0F15] my-6"
                >
                    <div class="i-lucide-package-search text-3xl text-[#64748B] mb-2"></div>
                    <h3 class="text-sm font-bold text-[#F8FAFC] uppercase tracking-wide" data-i18n="search.empty.title">
                        Produk Tidak Ditemukan
                    </h3>
                    <p class="text-xs text-[#94A3B8] font-mono mt-1" data-i18n="search.empty.desc">
                        Coba kata kunci lain atau sesuaikan filter Anda.
                    </p>
                </div>
            </div>
        </div>
    </main>

    {/* Mobile Filter Floating CTA */}
    <div class="lg:hidden fixed bottom-20 left-0 right-0 z-40 flex justify-center pointer-events-none px-4">
        <button
            id="mobile-filter-btn"
            class="pointer-events-auto yg-btn-primary !rounded-full px-5 py-2.5 shadow-2xl flex items-center gap-2 text-xs font-mono uppercase"
        >
            <span class="i-lucide-sliders-horizontal text-sm"></span>
            <span data-i18n="search.mobile.filter_sort">Filter & Urutkan</span>
        </button>
    </div>

    {/* Mobile Filter Drawer */}
    <div id="mobile-filter-modal" class="fixed inset-0 z-[60] hidden">
        <div
            class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity duration-300 opacity-0"
            id="mobile-filter-overlay"
        ></div>
        <div
            class="absolute bottom-0 left-0 right-0 bg-[#11131A] border-t border-[#222634] rounded-t-xl flex flex-col max-h-[85vh] transform transition-transform duration-300 translate-y-full shadow-2xl"
            id="mobile-filter-content"
        >
            <div class="w-full flex justify-center pt-2.5 pb-1">
                <div class="w-10 h-1 bg-[#222634] rounded-full"></div>
            </div>

            <div class="px-5 py-3 border-b border-[#222634] flex justify-between items-center">
                <div>
                    <h3 class="text-sm font-bold text-[#F8FAFC] uppercase tracking-wide" data-i18n="search.mobile.filter_sort">
                        Filter & Pengurutan
                    </h3>
                </div>
                <button
                    id="close-filter-mobile"
                    class="yg-btn-icon !w-8 !h-8 text-[#94A3B8] hover:text-[#F8FAFC]"
                >
                    <span class="i-lucide-x text-sm"></span>
                </button>
            </div>

            <div class="overflow-y-auto p-5 space-y-5 pb-28">
                <div class="space-y-2">
                    <label class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8]" data-i18n="search.sort_by">
                        Urutkan Berdasarkan
                    </label>
                    <select
                        id="mobile-sort-select"
                        class="yg-select w-full !h-11 !text-xs"
                    >
                        <option value="newest" data-i18n="search.sort.newest">Terbaru</option>
                        <option value="cheapest" data-i18n="search.sort.cheapest">Harga Terendah</option>
                        <option value="expensive" data-i18n="search.sort.expensive">Harga Tertinggi</option>
                    </select>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8]" data-i18n="search.product_type">
                        Tipe Produk
                    </label>
                    <div class="grid grid-cols-3 gap-2">
                        <label class="cursor-pointer">
                            <input type="radio" name="mobile-filter-type" value="all" checked class="peer sr-only" />
                            <div class="text-center p-2 rounded-md border border-[#222634] bg-[#0D0F15] text-xs font-mono text-[#94A3B8] peer-checked:bg-[#00E5FF]/10 peer-checked:text-[#00E5FF] peer-checked:border-[#00E5FF] transition-colors" data-i18n="search.type_all">
                                SEMUA
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="mobile-filter-type" value="account" class="peer sr-only" />
                            <div class="text-center p-2 rounded-md border border-[#222634] bg-[#0D0F15] text-xs font-mono text-[#94A3B8] peer-checked:bg-[#00E5FF]/10 peer-checked:text-[#00E5FF] peer-checked:border-[#00E5FF] transition-colors" data-i18n="search.type_account">
                                AKUN
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="mobile-filter-type" value="item" class="peer sr-only" />
                            <div class="text-center p-2 rounded-md border border-[#222634] bg-[#0D0F15] text-xs font-mono text-[#94A3B8] peer-checked:bg-[#00E5FF]/10 peer-checked:text-[#00E5FF] peer-checked:border-[#00E5FF] transition-colors" data-i18n="search.type_item">
                                ITEM
                            </div>
                        </label>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8]" data-i18n="search.price_range">
                        Rentang Harga (IDR)
                    </label>
                    <div class="flex gap-2">
                        <input type="number" id="mobile-min" placeholder="Min" data-i18n-placeholder="search.price_min" class="yg-input !h-10 !text-xs !bg-[#0D0F17]" />
                        <input type="number" id="mobile-max" placeholder="Max" data-i18n-placeholder="search.price_max" class="yg-input !h-10 !text-xs !bg-[#0D0F17]" />
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-mono font-bold uppercase tracking-wider text-[#94A3B8]" data-i18n="search.category">
                        Kategori Game
                    </label>
                    <input
                        type="text"
                        id="mobile-cat-search"
                        placeholder="Cari kategori..."
                        data-i18n-placeholder="search.category_placeholder"
                        class="yg-input !h-9 !text-xs !bg-[#0D0F17] mb-2"
                    />
                    <div id="mobile-cat-list" class="grid grid-cols-2 gap-2 max-h-40 overflow-y-auto pr-1 custom-scrollbar">
                        {allCategories.map((cat: any) => (
                            <label class="flex items-center gap-2 p-2 border border-[#222634] rounded-md bg-[#0D0F15] cursor-pointer cat-item-mobile">
                                <input
                                    type="checkbox"
                                    value={cat.name}
                                    class="filter-category-mobile accent-[#00E5FF]"
                                />
                                <span class="text-xs text-[#94A3B8] cat-name-mobile truncate font-mono">
                                    {cat.name}
                                </span>
                            </label>
                        ))}
                    </div>
                </div>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-4 bg-[#11131A] border-t border-[#222634] flex gap-3 z-10">
                <button
                    id="reset-filter-mobile"
                    class="yg-btn-secondary flex-1 py-2.5 text-xs"
                    data-i18n="search.reset"
                >
                    RESET
                </button>
                <button
                    id="apply-filter-mobile"
                    class="yg-btn-primary flex-[2] py-2.5 text-xs"
                    data-i18n="search.apply"
                >
                    TERAPKAN
                </button>
            </div>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ initialProducts: products }}>
    let products = initialProducts;
    let filteredProducts = [...products];
    const USD_RATE = 16000;

    const grid = document.getElementById("product-grid");
    const emptyState = document.getElementById("empty-state");
    const searchInput = document.getElementById("main-search");
    const countEl = document.getElementById("result-count");
    const sortSelect = document.getElementById("sort-select");

    const catCheckboxes = document.querySelectorAll(".filter-category");
    const serverCheckboxes = document.querySelectorAll(".filter-server");
    const tierCheckboxes = document.querySelectorAll(".filter-tier");
    const minInput = document.getElementById("filter-min");
    const maxInput = document.getElementById("filter-max");
    const catSearchInput = document.getElementById("cat-search");
    const catListItems = document.querySelectorAll(".cat-item");
    const typeRadios = document.querySelectorAll('input[name="filter-type"]');

    serverCheckboxes.forEach(cb => cb.addEventListener("change", applyFilter));
    tierCheckboxes.forEach(cb => cb.addEventListener("change", applyFilter));

    const mobileCatCheckboxes = document.querySelectorAll(".filter-category-mobile");
    const mobileMin = document.getElementById("mobile-min");
    const mobileMax = document.getElementById("mobile-max");
    const mobileSort = document.getElementById("mobile-sort-select");
    const mobileCatSearch = document.getElementById("mobile-cat-search");
    const mobileCatItems = document.querySelectorAll(".cat-item-mobile");
    const mobileTypeRadios = document.querySelectorAll('input[name="mobile-filter-type"]');
    const mobileModal = document.getElementById("mobile-filter-modal");
    const mobileContent = document.getElementById("mobile-filter-content");
    const mobileOverlay = document.getElementById("mobile-filter-overlay");

    function getCurrency() {
        return localStorage.getItem("yasui_currency") || "IDR";
    }

    function formatPrice(priceIdr) {
        const curr = getCurrency();
        if (curr === "USD") {
            return new Intl.NumberFormat("en-US", {
                style: "currency",
                currency: "USD",
            }).format(priceIdr / USD_RATE);
        }
        return new Intl.NumberFormat("id-ID", {
            style: "currency",
            currency: "IDR",
            minimumFractionDigits: 0,
        }).format(priceIdr);
    }

    function render() {
        if (!grid || !emptyState || !countEl) return;

        if (filteredProducts.length === 0) {
            grid.style.display = "none";
            emptyState.style.display = "flex";
            emptyState.classList.remove("hidden");
            countEl.innerText = "0";
            return;
        }

        grid.style.display = "grid";
        grid.innerHTML = "";
        emptyState.style.display = "none";
        countEl.innerText = String(filteredProducts.length);

        const html = filteredProducts.map((p) => {
            const isAccount = p.type === "account" || (p.name || "").toLowerCase().includes("akun");
            const badgeClass = isAccount ? "yg-badge-instant" : "yg-badge-online";
            const badgeKey = isAccount ? "home.instant_badge" : "home.online_badge";
            const badgeLabel = isAccount ? "INSTANT" : "ONLINE";
            const catLabel = p.categories[0] || "GAME";

            return `
                <a href="/product/${p.slug}" class="yg-product-card group flex flex-col justify-between">
                    <div>
                        <div class="aspect-video bg-[#090A0F] relative overflow-hidden border-b border-[#222634] flex items-center justify-center">
                            ${p.image
                                ? `<img src="${p.image}" alt="${p.name}" loading="lazy" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105" />`
                                : `<div class="flex items-center justify-center h-full text-[#64748B] text-xs font-mono">NO VISUAL</div>`
                            }
                            <div class="absolute top-2 left-2">
                                <span class="${badgeClass} text-[10px]" data-i18n="${badgeKey}">${badgeLabel}</span>
                            </div>
                        </div>
                        <div class="p-3">
                            <span class="text-[10px] font-mono text-[#94A3B8] block truncate mb-1">${catLabel}</span>
                            <h4 class="line-clamp-2 text-xs md:text-sm font-medium text-[#F8FAFC] leading-snug group-hover:text-[#00E5FF] transition-colors mb-2">
                                ${p.name}
                            </h4>
                        </div>
                    </div>
                    <div class="p-3 pt-0 border-t border-[#222634]/60 mt-auto">
                        <div class="flex items-center justify-between pt-2">
                            <span class="yg-price text-xs sm:text-sm md:text-base text-[#00E5FF]" data-price-idr="${p.priceRaw}">
                                ${formatPrice(p.priceRaw)}
                            </span>
                            <span class="text-[10px] font-mono text-emerald-400 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                <span data-i18n="badge.ready">Ready</span>
                            </span>
                        </div>
                    </div>
                </a>
            `;
        }).join("");

        grid.innerHTML = html;
        if (typeof window.applyTranslations === "function") window.applyTranslations();
    }

    function applyFilter() {
        const keyword = (searchInput?.value || "").toLowerCase();

        const checkedCats = new Set([
            ...Array.from(catCheckboxes).filter((c) => c.checked).map((c) => c.value),
            ...Array.from(mobileCatCheckboxes).filter((c) => c.checked).map((c) => c.value),
        ]);

        const checkedServers = new Set(
            Array.from(serverCheckboxes).filter(c => c.checked).map(c => c.value)
        );
        const checkedTiers = new Set(
            Array.from(tierCheckboxes).filter(c => c.checked).map(c => c.value)
        );

        let selectedType = "all";
        const deskType = document.querySelector('input[name="filter-type"]:checked');
        const mobType = document.querySelector('input[name="mobile-filter-type"]:checked');

        if (deskType && deskType.value !== "all") selectedType = deskType.value;
        if (mobType && mobType.value !== "all") selectedType = mobType.value;

        const min = parseInt(minInput?.value) || parseInt(mobileMin?.value) || 0;
        const max = parseInt(maxInput?.value) || parseInt(mobileMax?.value) || Infinity;

        filteredProducts = products.filter((p) => {
            if (keyword && !p.name.toLowerCase().includes(keyword)) return false;

            if (selectedType !== "all") {
                if (selectedType === "account" && p.type !== "account") return false;
                if (selectedType === "item" && p.type !== "item") return false;
            }

            if (checkedCats.size > 0 && !p.categories.some((c) => checkedCats.has(c))) return false;

            if (checkedServers.size > 0) {
                if (!p.attrs.server) return false;
                if (!p.attrs.server.some(s => checkedServers.has(s))) return false;
            }

            if (checkedTiers.size > 0) {
                if (!p.attrs.tier) return false;
                if (!p.attrs.tier.some(t => checkedTiers.has(t))) return false;
            }

            if (p.priceRaw < min || p.priceRaw > max) return false;
            return true;
        });

        const sortVal = sortSelect?.value || mobileSort?.value || "newest";
        if (sortVal === "cheapest") {
            filteredProducts.sort((a, b) => a.priceRaw - b.priceRaw);
        } else if (sortVal === "expensive") {
            filteredProducts.sort((a, b) => b.priceRaw - a.priceRaw);
        }

        render();
    }

    function filterCategories(inputEl, items) {
        if (!inputEl) return;
        const query = inputEl.value.toLowerCase();
        items.forEach((item) => {
            const nameEl = item.querySelector(inputEl.id === "cat-search" ? ".cat-name" : ".cat-name-mobile");
            const name = (nameEl?.innerText || "").toLowerCase();
            item.style.display = name.includes(query) ? "flex" : "none";
        });
    }

    function resetAll() {
        if (searchInput) searchInput.value = "";
        if (minInput) minInput.value = "";
        if (maxInput) maxInput.value = "";
        catCheckboxes.forEach((c) => (c.checked = false));
        serverCheckboxes.forEach((c) => (c.checked = false));
        tierCheckboxes.forEach((c) => (c.checked = false));
        typeRadios.forEach((r) => { r.checked = r.value === "all"; });

        if (mobileMin) mobileMin.value = "";
        if (mobileMax) mobileMax.value = "";
        mobileCatCheckboxes.forEach((c) => (c.checked = false));
        mobileTypeRadios.forEach((r) => { r.checked = r.value === "all"; });

        if (catSearchInput) catSearchInput.value = "";
        if (mobileCatSearch) mobileCatSearch.value = "";
        filterCategories(catSearchInput, catListItems);
        filterCategories(mobileCatSearch, mobileCatItems);

        applyFilter();
    }

    searchInput?.addEventListener("input", applyFilter);
    sortSelect?.addEventListener("change", (e) => {
        if (mobileSort) mobileSort.value = e.target.value;
        applyFilter();
    });

    catCheckboxes.forEach((c) => c.addEventListener("change", applyFilter));
    typeRadios.forEach((r) => r.addEventListener("change", applyFilter));
    minInput?.addEventListener("input", applyFilter);
    maxInput?.addEventListener("input", applyFilter);
    document.getElementById("reset-all-desktop")?.addEventListener("click", resetAll);

    catSearchInput?.addEventListener("input", () => filterCategories(catSearchInput, catListItems));

    mobileSort?.addEventListener("change", (e) => {
        if (sortSelect) sortSelect.value = e.target.value;
        applyFilter();
    });
    mobileCatSearch?.addEventListener("input", () => filterCategories(mobileCatSearch, mobileCatItems));
    mobileTypeRadios.forEach((r) => r.addEventListener("change", applyFilter));

    const mobileBtn = document.getElementById("mobile-filter-btn");
    mobileBtn?.addEventListener("click", () => {
        if (!mobileModal || !mobileContent || !mobileOverlay) return;
        mobileModal.classList.remove("hidden");
        setTimeout(() => {
            mobileContent.classList.remove("translate-y-full");
            mobileOverlay.classList.remove("opacity-0");
        }, 10);
    });

    const closeMobile = () => {
        if (!mobileModal || !mobileContent || !mobileOverlay) return;
        mobileContent.classList.add("translate-y-full");
        mobileOverlay.classList.add("opacity-0");
        setTimeout(() => mobileModal.classList.add("hidden"), 300);
    };

    document.getElementById("close-filter-mobile")?.addEventListener("click", closeMobile);
    mobileOverlay?.addEventListener("click", closeMobile);
    document.getElementById("apply-filter-mobile")?.addEventListener("click", () => {
        applyFilter();
        closeMobile();
    });
    document.getElementById("reset-filter-mobile")?.addEventListener("click", resetAll);

    document.addEventListener("yasui-currency-change", render);
    document.addEventListener("yasui-lang-change", render);
    applyFilter();
</script>

