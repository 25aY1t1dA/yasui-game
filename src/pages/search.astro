                    id="apply-filter-mobile"
                    class="flex-[2] py-4 bg-cyan-400 text-black font-black rounded-xl shadow-[0_0_20px_rgba(34,211,238,0.3)] hover:shadow-[0_0_30px_rgba(34,211,238,0.5)] hover:scale-[1.02] active:scale-[0.98] transition tracking-widest text-xs flex items-center justify-center gap-2"
                >
