                </button>
            </div>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ initialProducts: products }}>
    // --- STATE MANAGEMENT ---
    let products = initialProducts;
    let filteredProducts = [...products];
    const USD_RATE = 16000;

    // DOM Elements
    const grid = document.getElementById("product-grid");
    const emptyState = document.getElementById("empty-state");
    const searchInput = document.getElementById("main-search");
    const countEl = document.getElementById("result-count");
    const sortSelect = document.getElementById("sort-select");

    // Desktop Filter Elements
    const catCheckboxes = document.querySelectorAll(".filter-category");
    const serverCheckboxes = document.querySelectorAll(".filter-server");
    const tierCheckboxes = document.querySelectorAll(".filter-tier");
    const minInput = document.getElementById("filter-min");
    const maxInput = document.getElementById("filter-max");
    const catSearchInput = document.getElementById("cat-search");
    const catListItems = document.querySelectorAll(".cat-item");
    const typeRadios = document.querySelectorAll('input[name="filter-type"]');
    
    // Add Event Listeners for new filters
    serverCheckboxes.forEach(cb => cb.addEventListener("change", applyFilter));
    tierCheckboxes.forEach(cb => cb.addEventListener("change", applyFilter));

    // Mobile Elements
    const mobileCatCheckboxes = document.querySelectorAll(
        ".filter-category-mobile",
    );
    const mobileMin = document.getElementById("mobile-min");
    const mobileMax = document.getElementById("mobile-max");
    const mobileSort = document.getElementById("mobile-sort-select");
    const mobileCatSearch = document.getElementById("mobile-cat-search");
    const mobileCatItems = document.querySelectorAll(".cat-item-mobile");
    const mobileTypeRadios = document.querySelectorAll(
        'input[name="mobile-filter-type"]',
    );
    const mobileModal = document.getElementById("mobile-filter-modal");
    const mobileContent = document.getElementById("mobile-filter-content");
    const mobileOverlay = document.getElementById("mobile-filter-overlay");

    // --- CURRENCY HELPER ---
    function getCurrency() {
        return localStorage.getItem("yasui_currency") || "IDR";
    }

    function formatPrice(priceIdr) {
        const curr = getCurrency();
        if (curr === "USD") {
            return new Intl.NumberFormat("en-US", {
                style: "currency",
                currency: "USD",
            }).format(priceIdr / USD_RATE);
        }
        return new Intl.NumberFormat("id-ID", {
            style: "currency",
            currency: "IDR",
            minimumFractionDigits: 0,
        }).format(priceIdr);
    }

    // --- RENDER LOGIC ---
    function render() {
        if (filteredProducts.length === 0) {
            // Force hidden grid and show empty state using Display property to avoid class conflicts
            grid.style.display = "none";
            emptyState.style.display = "flex";
            emptyState.classList.remove("hidden"); // Ensure CSS hidden class is removed
            countEl.innerText = "0";
            return;
        }

        // Show grid
        grid.style.display = "grid";
        grid.innerHTML = ""; // Clear first to prevent duplicates
        emptyState.style.display = "none"; // Force hide empty state
        countEl.innerText = filteredProducts.length;

        // Render Cards
        const html = filteredProducts
            .map(
                (p) => `
            <a href="/product/${p.slug}" class="cyber-card bg-gray-900/50 border border-gray-800 hover:border-cyan-400 transition-all duration-300 group block relative shadow-lg">
                <div class="aspect-video bg-black relative overflow-hidden border-b border-gray-800">
                    ${
                        p.image
                            ? `<img src="${p.image}" alt="${p.name}" loading="lazy" class="w-full h-full object-contain transition duration-500 filter brightness-90 group-hover:brightness-100" />`
                            : `<div class="flex items-center justify-center h-full text-gray-700 text-xs">NO IMAGE</div>`
                    }
                    <div class="absolute top-0 left-0 bg-black/80 backdrop-blur px-2 py-1 border-r border-b border-gray-800">
                        <span class="text-[9px] text-cyan-400 font-bold uppercase tracking-wider">${p.categories[0] || "GAME"}</span>
                    </div>
                </div>
                <div class="p-4">
                    <h4 class="text-xs md:text-sm font-bold text-gray-200 leading-snug mb-3 line-clamp-2 h-[2.5em] group-hover:text-cyan-400 transition">
                        ${p.name}
                    </h4>
                    <div class="flex items-center justify-between border-t border-gray-800 pt-3">
                        <span class="price-tag text-cyan-400 font-mono text-sm md:text-base font-bold" data-price-idr="${p.priceRaw}">
                            ${formatPrice(p.priceRaw)}
                        </span>
                    </div>
                </div>
            </a>
        `,
            )
            .join("");

        grid.innerHTML = html;
    }

    // --- FILTER LOGIC ---
    function applyFilter() {
        const keyword = searchInput.value.toLowerCase();

        // Get Categories (Checked checkboxes)
        const checkedCats = new Set([
            ...Array.from(catCheckboxes)
                .filter((c) => c.checked)
                .map((c) => c.value),
            ...Array.from(mobileCatCheckboxes)
                .filter((c) => c.checked)
                .map((c) => c.value),
        ]);

        // Smart Filters (Server & Tier)
        const checkedServers = new Set(
            Array.from(serverCheckboxes).filter(c => c.checked).map(c => c.value)
        );
        const checkedTiers = new Set(
            Array.from(tierCheckboxes).filter(c => c.checked).map(c => c.value)
        );

        // Get Type
        let selectedType = "all";
        const deskType = document.querySelector(
            'input[name="filter-type"]:checked',
        );
        const mobType = document.querySelector(
            'input[name="mobile-filter-type"]:checked',
        );

        // Use whichever is not default if possible
        if (deskType && deskType.value !== "all") selectedType = deskType.value;
        if (mobType && mobType.value !== "all") selectedType = mobType.value;

        // Get Price
        const min = parseInt(minInput.value) || parseInt(mobileMin.value) || 0;
        const max =
            parseInt(maxInput.value) || parseInt(mobileMax.value) || Infinity;

        filteredProducts = products.filter((p) => {
            if (keyword && !p.name.toLowerCase().includes(keyword))
                return false;

            // Type Filter
            if (selectedType !== "all") {
                if (selectedType === "account" && p.type !== "account")
                    return false;
                if (selectedType === "item" && p.type !== "item") return false;
            }

            if (
                checkedCats.size > 0 &&
                !p.categories.some((c) => checkedCats.has(c))
            )
                return false;

            // Attribute Filtering (AND between types, OR within type)
            if (checkedServers.size > 0) {
                // If product has no server info, but user selected server filter -> hide
                if (!p.attrs.server) return false;
                // Check if product matches ANY selected server
                if (!p.attrs.server.some(s => checkedServers.has(s))) return false;
            }

            if (checkedTiers.size > 0) {
                if (!p.attrs.tier) return false;
                if (!p.attrs.tier.some(t => checkedTiers.has(t))) return false;
            }

            if (p.priceRaw < min || p.priceRaw > max) return false;
            return true;
        });

        // Sync Sort Selects
        const sortVal = sortSelect.value || mobileSort.value;

        if (sortVal === "cheapest") {
            filteredProducts.sort((a, b) => a.priceRaw - b.priceRaw);
        } else if (sortVal === "expensive") {
            filteredProducts.sort((a, b) => b.priceRaw - a.priceRaw);
        }

        render();
    }

    // --- CATEGORY SEARCH LOGIC ---
    function filterCategories(inputEl, items) {
        const query = inputEl.value.toLowerCase();
        items.forEach((item) => {
            const name = item
                .querySelector(
                    inputEl.id === "cat-search"
                        ? ".cat-name"
                        : ".cat-name-mobile",
                )
                .innerText.toLowerCase();
            if (name.includes(query)) {
                item.style.display = "flex";
            } else {
                item.style.display = "none";
            }
        });
    }

    // --- RESET LOGIC ---
    function resetAll() {
        searchInput.value = "";
        minInput.value = "";
        maxInput.value = "";
        catCheckboxes.forEach((c) => (c.checked = false));
        typeRadios.forEach((r) =>
            r.value === "all" ? (r.checked = true) : (r.checked = false),
        );

        // Reset Mobile Inputs too
        mobileMin.value = "";
        mobileMax.value = "";
        mobileCatCheckboxes.forEach((c) => (c.checked = false));
        mobileTypeRadios.forEach((r) =>
            r.value === "all" ? (r.checked = true) : (r.checked = false),
        );

        // Reset Category Search
        catSearchInput.value = "";
        mobileCatSearch.value = "";
        filterCategories(catSearchInput, catListItems);
        filterCategories(mobileCatSearch, mobileCatItems);

        applyFilter();
    }

    // --- LISTENERS ---
    searchInput.addEventListener("input", applyFilter);
    sortSelect.addEventListener("change", (e) => {
        mobileSort.value = e.target.value; // sync
        applyFilter();
    });

    // Desktop Listeners
    catCheckboxes.forEach((c) => c.addEventListener("change", applyFilter));
    typeRadios.forEach((r) => r.addEventListener("change", applyFilter));
    minInput.addEventListener("input", applyFilter);
    maxInput.addEventListener("input", applyFilter);
    document
        .getElementById("reset-all-desktop")
        .addEventListener("click", resetAll);

    // Category Search Listener
    catSearchInput.addEventListener("input", () =>
        filterCategories(catSearchInput, catListItems),
    );

    // Mobile Listeners
    mobileSort.addEventListener("change", (e) => {
        sortSelect.value = e.target.value; // sync
        applyFilter();
    });
    mobileCatSearch.addEventListener("input", () =>
        filterCategories(mobileCatSearch, mobileCatItems),
    );
    mobileTypeRadios.forEach((r) => r.addEventListener("change", applyFilter));

    // Mobile Modal Logic
    document
        .getElementById("mobile-filter-btn")
        .addEventListener("click", () => {
            mobileModal.classList.remove("hidden");
            // Animate In
            setTimeout(() => {
                mobileContent.classList.remove("translate-y-full");
                mobileOverlay.classList.remove("opacity-0");
            }, 10);
        });

    const closeMobile = () => {
        mobileContent.classList.add("translate-y-full");
        mobileOverlay.classList.add("opacity-0");
        setTimeout(() => mobileModal.classList.add("hidden"), 300);
    };

    document
        .getElementById("close-filter-mobile")
        .addEventListener("click", closeMobile);
    mobileOverlay.addEventListener("click", closeMobile);

    document
        .getElementById("apply-filter-mobile")
        .addEventListener("click", () => {
            applyFilter();
            closeMobile();
        });

    document
        .getElementById("reset-filter-mobile")
        .addEventListener("click", resetAll);

    document.addEventListener("yasui-currency-change", render);

    // Initial Trigger
    applyFilter();
</script>

<style>
    /* Custom Scrollbar for sidebar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #111;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #333;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #22d3ee;
    }

    /* Cyberpunk Search Input Clip Path */
    .clip-path-search {
        clip-path: polygon(
            0 0,
            100% 0,
            100% calc(100% - 10px),
            calc(100% - 10px) 100%,
            0 100%
        );
    }
</style>
