---
// src/pages/categories.astro
import Layout from "../layouts/Layout.astro";
import { getCategories } from "../lib/wc";
import {
    ROBLOX_SPOTLIGHT_GAMES,
    ROBLOX_QUICK_SERVICES,
    NON_ROBLOX_SUBCATEGORIES_MAP,
    getGameEcosystem,
    type SubCategoryPill
} from "../data/catalog";
import gameIconsRaw from "../../scripts/maintenance/game-icons.json";

export const prerender = false;

const fixImgUrl = (url: string | null) => {
    if (typeof url !== "string" || !url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};

const gameIcons = gameIconsRaw as Record<string, any>;

const getFallbackIcon = (slug: string): string | null => {
    const entry = gameIcons[slug];
    if (!entry) return null;
    return entry.roblox?.imageUrl || entry.playStore?.imageUrl || entry.appStore?.imageUrl || null;
};

let rawWcCategories: any[] = [];
let error: string | null = null;

try {
    const fetched = await getCategories({ per_page: 100, hide_empty: false, parent: 0 });
    rawWcCategories = (fetched || []).filter((cat: any) =>
        cat.slug !== "flash-sale" &&
        cat.slug !== "uncategorized" &&
        cat.slug !== "arsip-internal"
    );
} catch (e: any) {
    console.error("Error fetching root categories:", e);
    error = e.message;
}

const countMap = new Map<string, number>();
const imageMap = new Map<string, string>();

rawWcCategories.forEach((cat: any) => {
    countMap.set(cat.slug, cat.count || 0);
    if (cat.image?.src) {
        imageMap.set(cat.slug, cat.image.src);
    }
});

// 1. Roblox Spotlight Games with live/fallback images & subcategories
const robloxSpotlight = ROBLOX_SPOTLIGHT_GAMES.map((game) => {
    const liveImg = imageMap.get(game.slug) || getFallbackIcon(game.slug) || game.image;
    const count = countMap.get(game.slug);
    return {
        ...game,
        image: liveImg,
        count: count !== undefined ? count : null
    };
});

// 2. Non-Roblox and Voucher Games: Build rich items for directory
const existingNonRobloxSlugs = new Set<string>();

const nonRobloxList = rawWcCategories
    .filter((cat: any) => cat.slug !== "roblox")
    .map((cat: any) => {
        existingNonRobloxSlugs.add(cat.slug);
        const ecosystem = getGameEcosystem(cat.slug);
        const subCats: SubCategoryPill[] = NON_ROBLOX_SUBCATEGORIES_MAP[cat.slug] || [
            { name: "Katalog Siap", slug: cat.slug, isHot: true }
        ];
        const iconUrl = cat.image?.src || getFallbackIcon(cat.slug);

        return {
            name: cat.name,
            slug: cat.slug,
            count: cat.count || 0,
            ecosystem,
            image: iconUrl,
            subCategories: subCats
        };
    })
    // Sort: Summoners War first (top vendor), then active items count descending, then alphabetical
    .sort((a, b) => {
        if (a.slug === "summoners-war-sky-arena") return -1;
        if (b.slug === "summoners-war-sky-arena") return 1;
        if (b.count !== a.count) return b.count - a.count;
        return a.name.localeCompare(b.name, "id");
    });

const totalCount = robloxSpotlight.length + nonRobloxList.length;
---

<Layout
    title="Katalog Game & Semesta RMT - Yasui Game"
    description="Jelajahi seluruh kategori game Roblox, Mobile & PC, dan Voucher digital terverifikasi dengan navigasi sub-kategori instan di Yasui Game."
>
    <main class="yg-shell pt-4 md:pt-6 pb-20">
        <!-- Breadcrumb Navigation -->
        <nav
            class="flex py-2 text-[#64748B] text-[10px] font-mono uppercase tracking-wider overflow-x-auto"
            aria-label="Breadcrumb"
        >
            <ol class="flex items-center space-x-2 whitespace-nowrap">
                <li><a href="/" class="hover:text-[#00E5FF] transition-colors" data-i18n="nav.home">HOME</a></li>
                <li><span class="text-[#262B3D]">/</span></li>
                <li class="text-[#F8FAFC] font-bold" data-i18n="categories.breadcrumb">KATALOG GAME</li>
            </ol>
        </nav>

        <!-- Catalog Header -->
        <header class="mb-6 pb-5 border-b border-[#222634] flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h1
                    class="text-xl md:text-3xl font-extrabold text-[#F8FAFC] tracking-tight uppercase"
                    data-i18n="categories.title"
                >
                    Katalog Game & Semesta RMT
                </h1>
                <p
                    class="text-xs md:text-sm text-[#94A3B8] mt-1"
                    data-i18n="categories.subtitle"
                >
                    Pusat transaksi akun, item, dan voucher bergaransi dengan navigasi subkategori instan.
                </p>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-[#11131A] border border-[#222634] text-xs font-mono">
                    <span class="text-[#94A3B8]" data-i18n="categories.total_games">Total Game</span>:
                    <strong class="text-[#00E5FF] tabular-nums">{totalCount}</strong>
                </div>
                <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-emerald-950/20 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Trade Ready</span>
                </div>
            </div>
        </header>

        {error && (
            <div class="p-4 text-center border border-dashed border-red-500/30 bg-red-950/20 rounded-lg mb-6">
                <p class="text-red-400 text-xs font-mono">
                    Gagal menyinkronkan katalog WooCommerce: {error}. Menampilkan cache katalog offline.
                </p>
            </div>
        )}

        <!-- ================================================================= -->
        <!-- BAGIAN 1: COMMAND SEARCH & ECOSYSTEM FILTER TABS                  -->
        <!-- ================================================================= -->
        <section class="mb-6 space-y-3" aria-label="Filter dan Pencarian Katalog">
            <div class="flex flex-col sm:flex-row gap-2.5 items-stretch">
                <!-- Command Search Input -->
                <div class="relative flex-1">
                    <span class="i-lucide-search absolute left-3.5 top-1/2 -translate-y-1/2 text-[#64748B] text-sm pointer-events-none" />
                    <input
                        id="catalog-command-search"
                        type="search"
                        placeholder="Ketik nama game, item, atau subkategori (cth: Blox Fruits, MLBB, Fruit, Top Up)..."
                        data-i18n-placeholder="categories.search_command_placeholder"
                        autocomplete="off"
                        class="yg-input !h-11 !pl-10 !pr-10 !text-xs !bg-[#0D0F15]"
                    />
                    <button
                        id="clear-command-search"
                        type="button"
                        aria-label="Bersihkan pencarian"
                        class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-[#64748B] hover:text-[#00E5FF] text-sm"
                    >
                        <span class="i-lucide-x" />
                    </button>
                </div>

                <!-- Ecosystem Quick Tabs -->
                <nav class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none" aria-label="Tab Ekosistem">
                    <button
                        type="button"
                        class="ecosystem-tab active-tab shrink-0 px-3.5 h-11 rounded-md border text-xs font-mono font-semibold whitespace-nowrap transition-colors bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]"
                        data-ecosystem="all"
                    >
                        <span data-i18n="categories.filter_all">Semua Game</span>
                    </button>
                    <button
                        type="button"
                        class="ecosystem-tab shrink-0 px-3.5 h-11 rounded-md border text-xs font-mono font-medium whitespace-nowrap transition-colors bg-[#11131A] text-[#94A3B8] border-[#222634] hover:text-[#F8FAFC] hover:border-[#2E3446]"
                        data-ecosystem="roblox"
                    >
                        <span data-i18n="categories.filter_roblox">🔥 Roblox Games Area</span>
                    </button>
                    <button
                        type="button"
                        class="ecosystem-tab shrink-0 px-3.5 h-11 rounded-md border text-xs font-mono font-medium whitespace-nowrap transition-colors bg-[#11131A] text-[#94A3B8] border-[#222634] hover:text-[#F8FAFC] hover:border-[#2E3446]"
                        data-ecosystem="mobile_pc"
                    >
                        <span data-i18n="categories.filter_mobile_pc">⚔️ Mobile & PC Games</span>
                    </button>
                    <button
                        type="button"
                        class="ecosystem-tab shrink-0 px-3.5 h-11 rounded-md border text-xs font-mono font-medium whitespace-nowrap transition-colors bg-[#11131A] text-[#94A3B8] border-[#222634] hover:text-[#F8FAFC] hover:border-[#2E3446]"
                        data-ecosystem="voucher"
                    >
                        <span data-i18n="categories.filter_voucher">🎟️ Voucher & PIN</span>
                    </button>
                </nav>
            </div>
        </section>

        <!-- ================================================================= -->
        <!-- BAGIAN 2: HERO SPOTLIGHT "ROBLOX GAMES AREA" (TAMPIL PALING ATAS)  -->
        <!-- ================================================================= -->
        <section
            id="roblox-spotlight-section"
            class="bg-[#11131A] border border-[#00E5FF]/35 rounded-xl p-5 md:p-6 mb-8 relative transition-all duration-200"
            aria-labelledby="roblox-area-heading"
        >
            <!-- Spotlight Header -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-5 pb-4 border-b border-[#222634]">
                <div>
                    <div class="flex items-center gap-2 mb-1.5">
                        <span class="yg-badge-overlay text-[10px] font-mono tracking-wider">
                            ⚡ ROBLOX ECOSYSTEM HUB
                        </span>
                        <span class="text-emerald-400 font-mono text-[11px] flex items-center gap-1.5 ml-1">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span data-i18n="roblox_area.trade_ready">Trade & Gift Ready</span>
                        </span>
                    </div>
                    <h2
                        id="roblox-area-heading"
                        class="text-base sm:text-lg md:text-xl font-extrabold text-[#F8FAFC] tracking-tight uppercase"
                        data-i18n="roblox_area.title"
                    >
                        ROBLOX GAMES AREA — POPULER & VIRAL
                    </h2>
                    <p class="text-xs text-[#94A3B8] mt-0.5" data-i18n="roblox_area.subtitle">
                        Pusat transaksi akun, fruit, gamepass, item, dan mata uang game Roblox terverifikasi.
                    </p>
                </div>

                <a
                    href="/category/roblox"
                    class="shrink-0 inline-flex items-center gap-1.5 text-xs font-mono font-medium text-[#00E5FF] hover:underline"
                >
                    <span data-i18n="roblox_area.view_all_hub">Semua 260+ Game Roblox</span>
                    <span class="i-lucide-arrow-right text-xs" />
                </a>
            </div>

            <!-- Quick Platform & Robux Services Bar -->
            <div class="mb-5 pb-4 border-b border-[#222634]/60">
                <span class="block text-[10px] font-mono uppercase tracking-wider text-[#64748B] mb-2" data-i18n="roblox_area.quick_services">
                    Layanan Robux & Platform:
                </span>
                <div class="flex flex-wrap gap-2">
                    {ROBLOX_QUICK_SERVICES.map((srv) => (
                        <a
                            href={`/category/${srv.slug}`}
                            class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-[#0D0F15] border border-[#222634] hover:border-[#00E5FF]/40 text-xs font-mono text-[#F8FAFC] hover:text-[#00E5FF] transition-colors"
                        >
                            <span class={`${srv.icon} text-[#00E5FF] text-xs`} />
                            <span>{srv.name}</span>
                            {srv.badge && (
                                <span class="text-[9px] px-1 py-0.2 rounded bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/20 font-bold">
                                    {srv.badge}
                                </span>
                            )}
                        </a>
                    ))}
                </div>
            </div>

            <!-- Featured Roblox Game Cards Grid with Subcategory Pills -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
                {robloxSpotlight.map((game) => (
                    <article
                        class="roblox-game-card yg-card-interactive group p-3.5 flex flex-col justify-between gap-3 relative rounded-lg"
                        data-game-slug={game.slug}
                        data-game-name={game.name.toLowerCase()}
                        data-subs={game.subCategories.map((s) => s.name.toLowerCase()).join(" ")}
                        data-aliases={(game.aliases || []).join(" ").toLowerCase()}
                    >
                        <div>
                            <!-- Thumbnail & Badges -->
                            <div class="aspect-video bg-[#0D0F15] rounded border border-[#222634] relative overflow-hidden flex items-center justify-center mb-2.5">
                                {game.image ? (
                                    <img
                                        src={fixImgUrl(game.image)}
                                        alt={game.name}
                                        loading="lazy"
                                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                                    />
                                ) : (
                                    <span class="text-base font-mono font-bold text-[#00E5FF]/60">
                                        {game.name.slice(0, 2).toUpperCase()}
                                    </span>
                                )}

                                <div class="absolute top-1.5 left-1.5">
                                    <span class="yg-badge-overlay-online text-[9px] px-1.5 py-0.2">
                                        ROBLOX
                                    </span>
                                </div>

                                {game.badge && (
                                    <div class="absolute top-1.5 right-1.5">
                                        <span class="yg-badge-overlay text-[9px] px-1.5 py-0.2">
                                            {game.badge}
                                        </span>
                                    </div>
                                )}
                            </div>

                            <!-- Title (Direct to game category) -->
                            <a
                                href={`/category/${game.slug}`}
                                class="text-sm font-bold text-[#F8FAFC] group-hover:text-[#00E5FF] transition-colors leading-snug line-clamp-1 block uppercase tracking-tight"
                            >
                                {game.name}
                            </a>

                            <!-- Subcategories Label -->
                            <span class="block text-[10px] font-mono text-[#64748B] uppercase tracking-wider mt-1 mb-2" data-i18n="roblox_area.sub_label">
                                Subkategori:
                            </span>

                            <!-- Killer UX: Quick Sub-Category Pills -->
                            <div class="flex flex-wrap gap-1.5">
                                {game.subCategories.map((sub) => (
                                    <a
                                        href={`/category/${sub.slug}`}
                                        class:list={[
                                            "px-2 py-0.8 rounded text-[10px] font-mono font-medium transition-colors whitespace-nowrap",
                                            sub.isHot
                                                ? "bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/40 hover:bg-[#00E5FF]/20"
                                                : "bg-[#0D0F15] text-[#94A3B8] border border-[#222634] hover:border-[#00E5FF]/50 hover:text-[#00E5FF] hover:bg-[#161922]"
                                        ]}
                                        title={`Buka subkategori ${sub.name} di ${game.name}`}
                                    >
                                        {sub.name}
                                    </a>
                                ))}
                            </div>
                        </div>

                        <!-- Card Action Footer -->
                        <div class="pt-2.5 border-t border-[#222634]/60 flex items-center justify-between mt-auto">
                            <span class="text-[10px] font-mono text-[#64748B]">
                                {game.count !== null && game.count > 0 ? (
                                    <span><strong class="text-[#00E5FF] tabular-nums">{game.count}</strong> Produk</span>
                                ) : (
                                    <span>Katalog Siap</span>
                                )}
                            </span>
                            <a
                                href={`/category/${game.slug}`}
                                class="text-[11px] font-mono text-[#00E5FF] hover:underline inline-flex items-center gap-1"
                            >
                                <span data-i18n="categories.view_game">Buka Game</span>
                                <span class="i-lucide-arrow-right text-xs" />
                            </a>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Full Hub Footer Strip -->
            <div class="mt-5 pt-4 border-t border-[#222634]/60 text-center">
                <a
                    href="/category/roblox"
                    class="inline-flex items-center gap-2 px-5 py-2 rounded-md bg-[#0D0F15] border border-[#00E5FF]/30 text-xs font-mono text-[#F8FAFC] hover:border-[#00E5FF] hover:text-[#00E5FF] transition-colors"
                >
                    <span class="i-lucide-grid text-sm text-[#00E5FF]" />
                    <span data-i18n="roblox_area.view_all_hub">Jelajahi Seluruh 260+ Game Roblox di Hub Direktori</span>
                    <span class="i-lucide-arrow-right text-xs text-[#00E5FF]" />
                </a>
            </div>
        </section>

        <!-- ================================================================= -->
        <!-- BAGIAN 3: DIREKTORI GAME NON-ROBLOX & VOUCHER                     -->
        <!-- ================================================================= -->
        <section id="other-games-section" aria-labelledby="other-games-heading">
            <header class="flex items-end justify-between gap-3 mb-4">
                <div>
                    <h2
                        id="other-games-heading"
                        class="text-base sm:text-lg md:text-xl font-extrabold text-[#F8FAFC] tracking-tight uppercase"
                        data-i18n="categories.other_games_title"
                    >
                        Direktori Game & Voucher Lainnya
                    </h2>
                    <p class="text-xs text-[#94A3B8] mt-0.5" data-i18n="categories.other_games_desc">
                        Akun game mobile & PC, top up langsung, dan voucher resmi bergaransi.
                    </p>
                </div>
                <span id="other-games-count" class="text-xs font-mono text-[#64748B] whitespace-nowrap tabular-nums">
                    {nonRobloxList.length} game terdaftar
                </span>
            </header>

            <div id="other-games-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
                {nonRobloxList.map((game) => (
                    <article
                        class="non-roblox-card yg-card-interactive group p-3.5 flex flex-col justify-between gap-3 relative rounded-lg"
                        data-game-slug={game.slug}
                        data-game-name={game.name.toLowerCase()}
                        data-ecosystem={game.ecosystem}
                        data-subs={game.subCategories.map((s) => s.name.toLowerCase()).join(" ")}
                    >
                        <div>
                            <!-- Header Info with Thumbnail & Count Badge -->
                            <div class="flex items-start gap-3 mb-3">
                                <div class="w-12 h-12 rounded-lg bg-[#0D0F15] border border-[#222634] p-1.5 flex items-center justify-center shrink-0 overflow-hidden group-hover:border-[#00E5FF]/40 transition-colors">
                                    {game.image ? (
                                        <img
                                            src={fixImgUrl(game.image)}
                                            alt={game.name}
                                            class="w-full h-full object-contain"
                                            loading="lazy"
                                        />
                                    ) : (
                                        <span class="i-lucide-gamepad-2 text-xl text-[#64748B] group-hover:text-[#00E5FF] transition-colors" />
                                    )}
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between gap-1 mb-1">
                                        <span class="text-[9px] font-mono uppercase tracking-wider px-1.5 py-0.2 rounded bg-[#0D0F15] border border-[#222634] text-[#94A3B8]">
                                            {game.ecosystem === "voucher" ? "VOUCHER" : "MOBILE / PC"}
                                        </span>
                                        <span class="text-[10px] font-mono tabular-nums px-1.5 py-0.2 rounded bg-[#0D0F15] border border-[#222634] text-[#94A3B8] group-hover:text-[#00E5FF] group-hover:border-[#00E5FF]/30 transition-colors">
                                            {game.count > 0 ? `${game.count} Item` : "Ready"}
                                        </span>
                                    </div>
                                    <a
                                        href={`/category/${game.slug}`}
                                        class="text-xs sm:text-sm font-semibold text-[#F8FAFC] group-hover:text-[#00E5FF] transition-colors leading-tight line-clamp-1 block uppercase"
                                    >
                                        {game.name}
                                    </a>
                                </div>
                            </div>

                            <!-- Subcategories Label -->
                            <span class="block text-[10px] font-mono text-[#64748B] uppercase tracking-wider mb-2" data-i18n="categories.quick_subcategories">
                                Subkategori Cepat:
                            </span>

                            <!-- Killer UX: Quick Sub-Category Pills for Non-Roblox -->
                            <div class="flex flex-wrap gap-1.5">
                                {game.subCategories.map((sub) => (
                                    <a
                                        href={`/category/${sub.slug}`}
                                        class:list={[
                                            "px-2 py-0.8 rounded text-[10px] font-mono font-medium transition-colors whitespace-nowrap",
                                            sub.isHot
                                                ? "bg-[#00E5FF]/10 text-[#00E5FF] border border-[#00E5FF]/35 hover:bg-[#00E5FF]/20"
                                                : "bg-[#0D0F15] text-[#94A3B8] border border-[#222634] hover:border-[#00E5FF]/40 hover:text-[#00E5FF] hover:bg-[#161922]"
                                        ]}
                                        title={`Buka subkategori ${sub.name} di ${game.name}`}
                                    >
                                        {sub.name}
                                    </a>
                                ))}
                            </div>
                        </div>

                        <!-- Card Action Footer -->
                        <div class="pt-2.5 border-t border-[#222634]/60 flex items-center justify-between mt-auto">
                            <span class="text-[10px] font-mono text-[#64748B]">
                                {game.slug === "summoners-war-sky-arena" ? (
                                    <span class="text-[#00E5FF] font-semibold">Specialty Store</span>
                                ) : (
                                    <span>Terverifikasi</span>
                                )}
                            </span>
                            <a
                                href={`/category/${game.slug}`}
                                class="text-[11px] font-mono text-[#00E5FF] hover:underline inline-flex items-center gap-1"
                            >
                                <span data-i18n="categories.view_game">Buka Game</span>
                                <span class="i-lucide-arrow-right text-xs" />
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <!-- No Results Fallback -->
        <div id="no-catalog-results" class="hidden py-14 px-4 text-center rounded-xl border border-dashed border-[#222634] bg-[#0D0F15] my-8">
            <div class="i-lucide-search-x text-3xl text-[#64748B] mx-auto mb-2" />
            <p class="text-sm font-semibold text-[#F8FAFC]" data-i18n="categories.empty">Game atau subkategori tidak ditemukan.</p>
            <p class="text-xs text-[#94A3B8] mt-1 font-mono" data-i18n="categories.empty_desc">Coba gunakan kata kunci lain atau reset filter ekosistem.</p>
            <button
                id="reset-catalog-filter"
                type="button"
                class="mt-4 yg-btn-secondary text-xs px-4 py-2"
            >
                Reset Filter & Pencarian
            </button>
        </div>
    </main>

    <script>
        function initCategoriesPage() {
            const searchInput = document.getElementById("catalog-command-search") as HTMLInputElement | null;
            const clearBtn = document.getElementById("clear-command-search") as HTMLButtonElement | null;
            const resetBtn = document.getElementById("reset-catalog-filter") as HTMLButtonElement | null;
            const tabs = document.querySelectorAll<HTMLButtonElement>(".ecosystem-tab");

            const robloxSection = document.getElementById("roblox-spotlight-section");
            const otherSection = document.getElementById("other-games-section");
            const otherCount = document.getElementById("other-games-count");
            const emptyState = document.getElementById("no-catalog-results");

            const robloxCards = Array.from(document.querySelectorAll<HTMLElement>(".roblox-game-card"));
            const nonRobloxCards = Array.from(document.querySelectorAll<HTMLElement>(".non-roblox-card"));

            if (!searchInput) return;

            let currentEcosystem = "all";

            function normalize(text: string): string {
                return text.normalize("NFKD").replace(/\p{M}/gu, "").toLowerCase().trim();
            }

            function applyFilters() {
                const query = normalize(searchInput?.value || "");
                if (clearBtn) {
                    clearBtn.style.display = query ? "block" : "none";
                }

                let visibleRoblox = 0;
                let visibleNonRoblox = 0;

                // 1. Filter Roblox Spotlight Cards
                const showRobloxSection = currentEcosystem === "all" || currentEcosystem === "roblox";

                robloxCards.forEach((card) => {
                    const name = normalize(card.dataset.gameName || "");
                    const subs = normalize(card.dataset.subs || "");
                    const aliases = normalize(card.dataset.aliases || "");

                    const matchesQuery = !query || name.includes(query) || subs.includes(query) || aliases.includes(query);

                    if (showRobloxSection && matchesQuery) {
                        card.style.display = "flex";
                        visibleRoblox++;
                    } else {
                        card.style.display = "none";
                    }
                });

                if (robloxSection) {
                    robloxSection.style.display = showRobloxSection && visibleRoblox > 0 ? "block" : "none";
                }

                // 2. Filter Non-Roblox Cards
                const showOtherSection = currentEcosystem === "all" || currentEcosystem === "mobile_pc" || currentEcosystem === "voucher";

                nonRobloxCards.forEach((card) => {
                    const name = normalize(card.dataset.gameName || "");
                    const subs = normalize(card.dataset.subs || "");
                    const eco = card.dataset.ecosystem || "";

                    const matchesEcosystem =
                        currentEcosystem === "all" ||
                        (currentEcosystem === "mobile_pc" && eco === "mobile_pc") ||
                        (currentEcosystem === "voucher" && eco === "voucher");

                    const matchesQuery = !query || name.includes(query) || subs.includes(query);

                    if (showOtherSection && matchesEcosystem && matchesQuery) {
                        card.style.display = "flex";
                        visibleNonRoblox++;
                    } else {
                        card.style.display = "none";
                    }
                });

                if (otherSection) {
                    otherSection.style.display = showOtherSection && visibleNonRoblox > 0 ? "block" : "none";
                }

                if (otherCount) {
                    otherCount.textContent = `${visibleNonRoblox} game ditampilkan`;
                }

                // 3. Empty State
                const totalVisible = (showRobloxSection ? visibleRoblox : 0) + (showOtherSection ? visibleNonRoblox : 0);
                if (emptyState) {
                    emptyState.style.display = totalVisible === 0 ? "block" : "none";
                }
            }

            // Tab click handling
            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    tabs.forEach((t) => {
                        t.className = "ecosystem-tab shrink-0 px-3.5 h-11 rounded-md border text-xs font-mono font-medium whitespace-nowrap transition-colors bg-[#11131A] text-[#94A3B8] border-[#222634] hover:text-[#F8FAFC] hover:border-[#2E3446]";
                    });
                    tab.className = "ecosystem-tab active-tab shrink-0 px-3.5 h-11 rounded-md border text-xs font-mono font-semibold whitespace-nowrap transition-colors bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]";

                    currentEcosystem = tab.dataset.ecosystem || "all";
                    applyFilters();
                });
            });

            // Search input handling
            searchInput.addEventListener("input", applyFilters);

            clearBtn?.addEventListener("click", () => {
                searchInput.value = "";
                searchInput.focus();
                applyFilters();
            });

            resetBtn?.addEventListener("click", () => {
                searchInput.value = "";
                currentEcosystem = "all";
                tabs.forEach((t) => {
                    const isAll = t.dataset.ecosystem === "all";
                    t.className = isAll
                        ? "ecosystem-tab active-tab shrink-0 px-3.5 h-11 rounded-md border text-xs font-mono font-semibold whitespace-nowrap transition-colors bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]"
                        : "ecosystem-tab shrink-0 px-3.5 h-11 rounded-md border text-xs font-mono font-medium whitespace-nowrap transition-colors bg-[#11131A] text-[#94A3B8] border-[#222634] hover:text-[#F8FAFC] hover:border-[#2E3446]";
                });
                applyFilters();
            });

            // Hotkey handler: '/' or 'Cmd+K' to focus search
            const handleKeyDown = (e: KeyboardEvent) => {
                if (e.key === "/" && document.activeElement !== searchInput && !(document.activeElement instanceof HTMLInputElement || document.activeElement instanceof HTMLTextAreaElement)) {
                    e.preventDefault();
                    searchInput.focus();
                } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
                    e.preventDefault();
                    searchInput.focus();
                } else if (e.key === "Escape" && document.activeElement === searchInput) {
                    searchInput.value = "";
                    applyFilters();
                    searchInput.blur();
                }
            };

            window.addEventListener("keydown", handleKeyDown);
            applyFilters();
        }

        initCategoriesPage();
        document.addEventListener("astro:page-load", initCategoriesPage);
    </script>
</Layout>
