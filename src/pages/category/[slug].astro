---
import Layout from "../../layouts/Layout.astro";
import { parsePrice } from "../../lib/price";
import { getCategoryBySlug, getCategoryById, getCategories, getProducts, normalizeProduct } from "../../lib/wc";
import RobloxHub from "../../components/RobloxHub.astro";
import CatalogSort from "../../components/CatalogSort.astro";
import { searchScore } from "../../lib/search";

export const prerender = false;

// --- HELPER IMAGE PROXY ---
const fixImgUrl = (url: string | null) => {
    if (!url) return null;
    return `/img-proxy?src=${encodeURIComponent(url)}`;
};

const { slug } = Astro.params;
if (slug === "summoners-war") return Astro.redirect("/category/summoners-war-sky-arena", 301);
let category: any = null;
let subCategories: any[] = [];
let products: any[] = [];
let ancestors: any[] = [];
let catalogTypes: any[] = [];
let catalogRoot: any = null;
let loadFailed = false;
let hasNextPage = false;
const query = Astro.url.searchParams.get("q")?.trim() || "";
const sort = Astro.url.searchParams.get("sort") || "newest";
const page = Math.max(1, Math.min(1000, Number.parseInt(Astro.url.searchParams.get("page") || "1") || 1));
const sortOptions: Record<string, any> = {
    newest: { orderby: "date", order: "desc" },
    cheapest: { orderby: "price", order: "asc" },
    expensive: { orderby: "price", order: "desc" },
    popular: { orderby: "popularity", order: "desc" }
};

try {
    const rawCategory = await getCategoryBySlug(slug);
    if (rawCategory) {
        let parentData = null;
        if (rawCategory.parent) {
            try {
                let parentId = rawCategory.parent;
                const seen = new Set([rawCategory.id]);
                while (parentId && !seen.has(parentId)) {
                    seen.add(parentId);
                    const found = await getCategoryById(parentId);
                    if (!parentData) parentData = { node: found };
                    ancestors.unshift(found);
                    parentId = found.parent;
                }
            } catch (e: any) {
                console.error("⚠️ Gagal fetch parent category:", e);
            }
        }

        category = {
            id: rawCategory.id,
            name: slug === "blox-fruits-fruit" ? "Fruit" : rawCategory.name,
            description: rawCategory.description || "",
            parent: parentData
        };

        // Fetch subcategories
        let rawSubs: any[] = [];
        let subPage = 1;
        while (subPage <= 5) {
            const batch = await getCategories({ parent: rawCategory.id, hide_empty: false, per_page: 100, page: subPage });
            if (!batch || batch.length === 0) break;
            rawSubs = rawSubs.concat(batch);
            if (batch.length < 100) break;
            subPage++;
        }
        subCategories = (rawSubs || []).map((sub: any) => ({
            id: sub.id,
            name: sub.name,
            slug: sub.slug,
            count: sub.count,
            image: sub.image?.src ? { sourceUrl: sub.image.src } : null,
        }));

        // Fetch products
        const robloxIndex = ancestors.findIndex((item) => item.slug === "roblox");
        if (robloxIndex >= 0) {
            catalogRoot = ancestors[robloxIndex + 1] || rawCategory;
            catalogTypes = catalogRoot.id === rawCategory.id ? rawSubs : await getCategories({ parent: catalogRoot.id, hide_empty: false, per_page: 100 });
            catalogTypes = catalogTypes.map((type: any) => ({ ...type, name: type.slug === "blox-fruits-fruit" ? "Fruit" : type.name }));
        } else if (slug !== "roblox") {
            catalogRoot = parentData?.node || rawCategory;
            if (catalogRoot.id === rawCategory.id) {
                catalogTypes = rawSubs;
            } else {
                for (let typePage = 1; typePage <= 5; typePage++) {
                    const batch = await getCategories({ parent: catalogRoot.id, hide_empty: false, per_page: 100, page: typePage });
                    catalogTypes.push(...batch);
                    if (batch.length < 100) break;
                }
            }
        }

        let rawProds: any[] = [];
        if (slug !== "roblox" && query) {
            const candidates: any[] = [];
            for (let productPage = 1; ; productPage++) {
                const batch = await getProducts({ category: rawCategory.id, status: "publish", per_page: 100, page: productPage, ...(sortOptions[sort] || sortOptions.newest) });
                candidates.push(...batch);
                if (batch.length < 100) break;
            }
            const matched = candidates.filter((item: any) => searchScore(item.name, query) > 0);
            hasNextPage = matched.length > page * 24;
            rawProds = matched.slice((page - 1) * 24, page * 24);
        } else if (slug !== "roblox") {
            rawProds = await getProducts({ category: rawCategory.id, status: "publish", per_page: 24, page, ...(sortOptions[sort] || sortOptions.newest) });
            hasNextPage = rawProds.length === 24;
        }
        products = (rawProds || []).map(normalizeProduct);
    }
} catch (error: any) {
    loadFailed = true;
    console.error("❌ ERROR KATEGORI REST:", error);
}

if (!category) return Astro.redirect("/404");

const isRobloxDescendant = ancestors.some((item) => item.slug === "roblox");
const isParentCategory = slug === "roblox";
const pageLink = (nextPage: number) => {
    const url = new URL(Astro.url);
    url.searchParams.set("page", String(nextPage));
    return url.pathname + url.search;
};

const isSummonersWar = ancestors.some((item) => item.slug === "summoners-war-sky-arena") || slug === "summoners-war-sky-arena";
const isRobloxCategory = slug === "roblox";

const getBadges = (product: any) => {
    const attrs = product.attributes?.nodes || [];
    const badges: any[] = [];

    const server = attrs.find((a: any) => a.name.toLowerCase().includes("server"));
    if (server && server.options && server.options.length > 0) {
        const val = server.options[0];
        badges.push({
            label: val.toUpperCase(),
            class: "yg-badge-cyan",
        });
    }

    const tier = attrs.find(
        (a: any) =>
            a.name.toLowerCase().includes("tier") ||
            a.name.toLowerCase().includes("rank") ||
            a.name.toLowerCase().includes("account"),
    );
    if (tier && tier.options && tier.options.length > 0) {
        const val = tier.options[0];
        const lowerVal = val.toLowerCase();

        let colorClass = "yg-badge-gray";
        let i18nKey = "";
        if (lowerVal.includes("fresh") || lowerVal.includes("new")) {
            colorClass = "yg-badge-emerald";
            i18nKey = "badge.fresh";
        } else if (lowerVal.includes("mid")) {
            colorClass = "yg-badge-cyan";
        } else if (lowerVal.includes("end") || lowerVal.includes("high")) {
            colorClass = "yg-badge-yellow";
        } else if (lowerVal.includes("old") || lowerVal.includes("tua")) {
            colorClass = "yg-badge-gray";
            i18nKey = "badge.old";
        }

        badges.push({
            label: val.toUpperCase(),
            class: colorClass,
            i18nKey: i18nKey || undefined
        });
    }

    return badges;
};
---

<Layout title={`${category.name} - Yasui Game`} description={category.description}>
    <main class="yg-shell pt-4 md:pt-6 pb-16">
        <nav
            class="flex py-3 text-[#64748B] text-[10px] font-mono uppercase tracking-wider overflow-x-auto"
            aria-label="Breadcrumb"
        >
            <ol class="flex items-center space-x-2 whitespace-nowrap">
                <li>
                    <a href="/" class="hover:text-[#00E5FF] transition-colors" data-i18n="nav.home">HOME</a>
                </li>
                {ancestors.map((ancestor) => (
                    <>
                        <li><span class="text-[#262B3D]">/</span></li>
                        <li>
                            <a href={`/category/${ancestor.slug}`} class="hover:text-[#00E5FF] transition-colors">
                                {ancestor.name}
                            </a>
                        </li>
                    </>
                ))}
                <li><span class="text-[#262B3D]">/</span></li>
                <li class="text-[#F8FAFC] font-bold truncate max-w-[180px]">
                    {category.name}
                </li>
            </ol>
        </nav>

        <header class="flex items-center gap-3.5 md:gap-4 mb-6 pb-5 border-b border-[#222634]">
            <div class="w-12 h-12 md:w-14 md:h-14 bg-[#11131A] border border-[#222634] rounded-lg flex items-center justify-center shrink-0">
                <span class="i-lucide-gamepad-2 text-xl md:text-2xl text-[#00E5FF]" />
            </div>
            <div>
                <h1 class="text-lg md:text-2xl font-extrabold text-[#F8FAFC] tracking-tight uppercase">
                    {category.name}
                </h1>
                <p class="text-[11px] md:text-xs text-[#94A3B8] font-mono mt-0.5">
                    {isRobloxCategory ? (
                        <span data-i18n="category.roblox_subtitle">Robux, akun, dan kebutuhan game Roblox</span>
                    ) : isRobloxDescendant ? (
                        <span><span data-i18n="category.official_catalog_prefix">Katalog</span> {category.name} <span data-i18n="category.official_catalog_suffix">Resmi Yasui Game</span></span>
                    ) : (
                        <span><span data-i18n="category.marketplace_prefix">Marketplace & Akun</span> {category.name}</span>
                    )}
                </p>
            </div>
        </header>

        {isRobloxCategory && <RobloxHub categories={subCategories} failed={loadFailed} />}

        {!isRobloxCategory && catalogRoot && (
            <section class="mb-6 space-y-3" aria-label="Filter katalog">
                <nav class="flex gap-1.5 overflow-x-auto pb-2 scrollbar-none" aria-label="Tipe produk">
                    {[{ ...catalogRoot, name: "Semua", isAll: true }, ...catalogTypes].map((type) => (
                        <a
                            href={`/category/${type.slug}`}
                            aria-current={type.slug === slug ? "page" : undefined}
                            class:list={[
                                "shrink-0 px-3.5 py-1.5 rounded-md border text-xs font-mono font-medium whitespace-nowrap transition-colors",
                                type.slug === slug
                                    ? "bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF] font-semibold"
                                    : "bg-[#11131A] text-[#94A3B8] border-[#222634] hover:text-[#F8FAFC] hover:border-[#2E3446]"
                            ]}
                        >
                            {type.isAll ? <span data-i18n="catalog.all">Semua</span> : <span>{type.name}</span>}
                        </a>
                    ))}
                </nav>

                <form class="flex flex-col sm:flex-row gap-2.5" method="get">
                    <div class="flex-1 relative flex items-center">
                        <span class="i-lucide-search text-[#64748B] text-xs absolute left-3 pointer-events-none" aria-hidden="true" />
                        <label for="catalog-search-q" class="sr-only"><span data-i18n="catalog.search_label">Cari produk</span> {catalogRoot.name}</label>
                        <input
                            id="catalog-search-q"
                            type="search"
                            name="q"
                            value={query}
                            placeholder={`Cari produk di ${catalogRoot.name}...`}
                            data-i18n-placeholder="catalog.search_placeholder"
                            class="yg-input !h-11 !pl-9 !pr-3 !bg-[#0D0F17]"
                        />
                    </div>
                    <div class="flex gap-2 sm:w-80 shrink-0">
                        <CatalogSort value={sort} />
                        <button type="submit" class="yg-btn-primary h-11 px-4 text-xs shrink-0">
                            <span data-i18n="catalog.apply">Terapkan</span>
                        </button>
                    </div>
                </form>
            </section>
        )}

        {/* --- Non-Roblox Subcategories Grid --- */}
        {!catalogRoot && !isRobloxCategory && subCategories.length > 0 && (
            <div class="mb-8">
                <h3 class="text-xs font-mono uppercase tracking-widest text-[#94A3B8] font-bold mb-3" data-i18n="catalog.subcategories">
                    Subkategori Game
                </h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5 md:gap-3">
                    {subCategories.map((sub) => (
                        <a
                            href={`/category/${sub.slug}`}
                            class="yg-card-interactive group p-3 flex flex-col items-center justify-center text-center gap-2 rounded-lg"
                        >
                            <div class="w-12 h-12 rounded-md bg-[#0D0F15] border border-[#222634] p-1.5 flex items-center justify-center overflow-hidden">
                                {sub.image ? (
                                    <img src={fixImgUrl(sub.image.sourceUrl)} alt={sub.name} class="w-full h-full object-contain" />
                                ) : (
                                    <span class="i-lucide-box text-xl text-[#64748B] group-hover:text-[#00E5FF] transition-colors" />
                                )}
                            </div>
                            <span class="text-xs font-medium text-[#F8FAFC] group-hover:text-[#00E5FF] transition-colors line-clamp-1 w-full">
                                {sub.name}
                            </span>
                            {sub.count !== null && (
                                <span class="text-[10px] font-mono text-[#64748B]">
                                    {sub.count} <span data-i18n="catalog.item_suffix">Item</span>
                                </span>
                            )}
                        </a>
                    ))}
                </div>
            </div>
        )}

        {category.parent?.node && (
            <div class="mb-4">
                <a
                    href={`/category/${category.parent.node.slug}`}
                    class="inline-flex items-center gap-1.5 text-xs text-[#00E5FF] hover:underline font-mono uppercase tracking-wider transition-colors"
                >
                    <span class="i-lucide-arrow-left text-xs" />
                    <span><span data-i18n="catalog.back_to">Kembali ke</span> {category.parent.node.name}</span>
                </a>
            </div>
        )}

        {/* --- SW Filter Bar (Server + Age Band) --- */}
        {isSummonersWar && products.length > 0 && (
            <div id="sw-filter-bar" class="mb-6 p-3.5 md:p-4 rounded-lg bg-[#11131A] border border-[#222634] flex flex-wrap items-center gap-3 md:gap-5 text-xs font-mono">
                <div class="flex items-center gap-1.5 flex-wrap" role="group" aria-label="Filter server">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-[#94A3B8] mr-1 flex items-center gap-1">
                        <span class="i-lucide-globe text-xs text-[#00E5FF]" />
                        <span data-i18n="catalog.filter_server">Server:</span>
                    </span>
                    <button data-sw-filter="server" data-sw-value="" class="sw-filter-btn px-2.5 py-1 rounded-md border border-[#00E5FF] bg-[#00E5FF]/10 text-[#00E5FF] font-semibold transition-colors cursor-pointer" data-i18n="catalog.all">Semua</button>
                    {["Asia", "Europe", "Global"].map((s) => (
                        <button data-sw-filter="server" data-sw-value={s} class="sw-filter-btn px-2.5 py-1 rounded-md border border-[#222634] bg-[#0D0F15] text-[#94A3B8] hover:border-[#2E3446] hover:text-[#F8FAFC] transition-colors cursor-pointer">{s}</button>
                    ))}
                </div>

                <div class="flex items-center gap-1.5 flex-wrap" role="group" aria-label="Filter umur akun">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-[#94A3B8] mr-1 flex items-center gap-1">
                        <span class="i-lucide-clock text-xs text-[#00E5FF]" />
                        <span data-i18n="catalog.filter_age">Umur:</span>
                    </span>
                    <button data-sw-filter="age" data-sw-value="" class="sw-filter-btn px-2.5 py-1 rounded-md border border-[#00E5FF] bg-[#00E5FF]/10 text-[#00E5FF] font-semibold transition-colors cursor-pointer" data-i18n="catalog.all">Semua</button>
                    {["Fresh (1-3 Days)", "Fresh (4-7 Days)", "Fresh (8-30 Days)", "Old"].map((a) => (
                        <button data-sw-filter="age" data-sw-value={a} class="sw-filter-btn px-2.5 py-1 rounded-md border border-[#222634] bg-[#0D0F15] text-[#94A3B8] hover:border-[#2E3446] hover:text-[#F8FAFC] transition-colors cursor-pointer">{a}</button>
                    ))}
                </div>

                <button id="sw-filter-reset" class="ml-auto text-xs font-mono text-[#64748B] hover:text-[#00E5FF] underline hidden cursor-pointer" data-i18n="catalog.reset_filter">
                    Reset Filter
                </button>
            </div>
        )}

        {/* --- Product Grid --- */}
        {products.length === 0 ? (
            !isRobloxCategory && !isParentCategory && (
                <div class="py-12 px-4 text-center border border-dashed border-[#222634] rounded-lg bg-[#0D0F15]">
                    <div class="i-lucide-package-open text-2xl text-[#64748B] mx-auto mb-2" />
                    <p class="text-xs text-[#F8FAFC]">
                        {loadFailed ? (
                            <span data-i18n="catalog.load_failed">Katalog belum berhasil dimuat. Silakan muat ulang halaman.</span>
                        ) : query ? (
                            <span><span data-i18n="catalog.no_match_prefix">Tidak ada produk yang cocok dengan</span> "{query}".</span>
                        ) : (
                            <span><span data-i18n="catalog.no_products_prefix">Belum ada produk untuk kategori</span> {category.name}.</span>
                        )}
                    </p>
                    {isRobloxDescendant && (
                        <a href={query ? `/category/${slug}` : "/category/roblox"} class="inline-block mt-3 text-xs font-mono text-[#00E5FF] hover:underline">
                            {query ? (
                                <span data-i18n="catalog.clear_search">Hapus filter pencarian</span>
                            ) : (
                                <span data-i18n="catalog.view_other_roblox">Lihat game Roblox lainnya</span>
                            )}
                        </a>
                    )}
                </div>
            )
        ) : (
            <div id="katalog-products" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4">
                {products.map((item) => {
                    const swAttrs = isSummonersWar ? (item.attributes?.nodes || []) : [];
                    const swServer = swAttrs.find((a: any) => a.name.toLowerCase() === "server")?.options?.join("|") || "";
                    const swAge = swAttrs.find((a: any) => /age|umur|fresh|band/i.test(a.name))?.options?.join("|") || "";
                    const isOutOfStock = item.stockStatus === "OUT_OF_STOCK" || item.stockStatus === "outofstock";
                    
                    const itemCategories = [
                        ...(item.categories || []).map((c: any) => c.slug || ""),
                        ...(item.productCategories?.nodes || []).map((c: any) => c.slug || "")
                    ].map((s: string) => s.toLowerCase());

                    const currentCatSlug = (slug || "").toLowerCase();
                    const prodName = (item.name || "").toLowerCase();

                    let itemSubMode = "";
                    if (currentCatSlug.includes("gamepass") || itemCategories.some(c => c.includes("gamepass")) || prodName.includes("gamepass")) {
                        itemSubMode = "gamepass";
                    } else if (currentCatSlug.includes("top-up") || currentCatSlug.includes("topup") || itemCategories.some(c => c.includes("top-up") || c.includes("topup")) || prodName.includes("top up") || prodName.includes("topup") || prodName.includes("diamond")) {
                        itemSubMode = "topup";
                    } else if (currentCatSlug.includes("gift-charisma") || currentCatSlug.includes("gift-item") || currentCatSlug.includes("7-hari") || itemCategories.some(c => c.includes("gift") || c.includes("7-hari")) || prodName.includes("gift charisma") || prodName.includes("gift item") || prodName.includes("gift skin")) {
                        itemSubMode = "game_gift";
                    } else if (currentCatSlug.includes("fruit") || currentCatSlug.includes("pet") || itemCategories.some(c => c.includes("fruit") || c.includes("pet")) || prodName.includes("fruit") || prodName.includes("pet")) {
                        itemSubMode = "roblox_item";
                    } else if (currentCatSlug.includes("akun") || itemCategories.some(c => c.includes("akun")) || prodName.includes("akun")) {
                        itemSubMode = "account";
                    }

                    const isAccount = itemSubMode === "account" || isSummonersWar || (!itemSubMode && (prodName.includes("akun") || itemCategories.some(c => c.includes("akun"))));
                    const productHref = itemSubMode ? `/product/${item.slug}?sub_mode=${itemSubMode}` : `/product/${item.slug}`;

                    let overlayBadgeText = isAccount ? "INSTANT" : "ONLINE";
                    let overlayBadgeKey = isAccount ? "badge.instant" : "badge.online";
                    let overlayBadgeClass = isAccount ? "yg-badge-overlay" : "yg-badge-overlay-online";
                    if (itemSubMode === "gamepass") {
                        overlayBadgeText = "GAMEPASS";
                        overlayBadgeKey = "badge.gamepass";
                        overlayBadgeClass = "yg-badge-overlay";
                    } else if (itemSubMode === "topup") {
                        overlayBadgeText = "TOP UP";
                        overlayBadgeKey = "badge.topup";
                        overlayBadgeClass = "yg-badge-overlay";
                    } else if (itemSubMode === "game_gift") {
                        overlayBadgeText = "GIFT";
                        overlayBadgeKey = "badge.gift";
                        overlayBadgeClass = "yg-badge-overlay";
                    } else if (itemSubMode === "roblox_item") {
                        overlayBadgeText = "ITEM";
                        overlayBadgeKey = "badge.item";
                        overlayBadgeClass = "yg-badge-overlay-online";
                    } else if (itemSubMode === "account") {
                        overlayBadgeText = "AKUN";
                        overlayBadgeKey = "badge.account";
                        overlayBadgeClass = "yg-badge-overlay";
                    }

                    return (
                        <a
                            href={productHref}
                            data-sw-server={swServer}
                            data-sw-age={swAge}
                            data-sub-mode={itemSubMode}
                            class="yg-product-card group flex flex-col justify-between"
                        >
                            <div>
                                <div class="aspect-video bg-[#090A0F] relative overflow-hidden border-b border-[#222634] flex items-center justify-center">
                                    {item.image ? (
                                        <img
                                            src={fixImgUrl(item.image.sourceUrl)}
                                            alt={item.name}
                                            class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="flex items-center justify-center h-full text-[#64748B] text-xs font-mono" data-i18n="badge.no_visual">
                                            NO VISUAL
                                        </div>
                                    )}

                                    <div class="absolute top-2 left-2">
                                        <span class={overlayBadgeClass} data-i18n={overlayBadgeKey}>
                                            {overlayBadgeText}
                                        </span>
                                    </div>

                                    {isOutOfStock && (
                                        <div class="absolute top-2 right-2 bg-[#090A0F]/90 backdrop-blur-md border border-red-500/40 text-red-400 font-mono text-[10px] px-1.5 py-0.5 rounded font-bold shadow-[0_2px_8px_rgba(0,0,0,0.85)]" data-i18n="badge.sold_out">
                                            HABIS
                                        </div>
                                    )}
                                </div>

                                <div class="p-3">
                                    <div class="flex items-center justify-between gap-1 mb-1.5">
                                        <span class="text-[10px] font-mono text-[#94A3B8] truncate">
                                            {item.productCategories?.nodes[0]?.name || "GAME"}
                                        </span>
                                        <div class="flex flex-wrap gap-1">
                                            {getBadges(item).slice(0, 1).map((badge) => (
                                                <span class={badge.class} data-i18n={badge.i18nKey || undefined}>
                                                    {badge.label}
                                                </span>
                                            ))}
                                        </div>
                                    </div>

                                    <h4 class="line-clamp-2 text-xs md:text-sm font-medium text-[#F8FAFC] leading-snug group-hover:text-[#00E5FF] transition-colors mb-2">
                                        {item.name}
                                    </h4>
                                </div>
                            </div>

                            <div class="p-3 pt-0 border-t border-[#222634]/60 mt-auto">
                                <div class="flex items-center justify-between pt-2">
                                    <span
                                        class="yg-price text-xs sm:text-sm md:text-base text-[#00E5FF]"
                                        data-price-idr={parsePrice(item.price) || 0}
                                    >
                                        {item.price || "Rp 0"}
                                    </span>
                                    <span class={`text-[10px] font-mono flex items-center gap-1 ${isOutOfStock ? "text-red-400" : "text-emerald-400"}`}>
                                        <span class={`w-1.5 h-1.5 rounded-full ${isOutOfStock ? "bg-red-400" : "bg-emerald-400"}`}></span>
                                        <span data-i18n={isOutOfStock ? "badge.sold_out" : "badge.ready"}>{isOutOfStock ? "Kosong" : "Ready"}</span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>
        )}

        {!isRobloxCategory && (page > 1 || hasNextPage) && (
            <nav aria-label="Halaman produk" class="flex justify-center items-center gap-3 mt-10 text-xs font-mono">
                {page > 1 && (
                    <a href={pageLink(page - 1)} class="yg-btn-secondary px-4 py-2">
                        <span>← <span data-i18n="pagination.prev">Sebelumnya</span></span>
                    </a>
                )}
                <span class="px-3 py-2 text-[#94A3B8] bg-[#0D0F15] border border-[#222634] rounded-md">
                    <span data-i18n="pagination.page">Halaman</span> <strong class="text-[#F8FAFC]">{page}</strong>
                </span>
                {hasNextPage && (
                    <a href={pageLink(page + 1)} class="yg-btn-secondary px-4 py-2">
                        <span><span data-i18n="pagination.next">Berikutnya</span> →</span>
                    </a>
                )}
            </nav>
        )}
    </main>
</Layout>

<style>
    .sw-hidden { display: none !important; }
</style>

<script is:inline>
    (function initSwFilter() {
        const bar = document.getElementById("sw-filter-bar");
        if (!bar) return;
        const ACTIVE = ["border-[#00E5FF]", "bg-[#00E5FF]/10", "text-[#00E5FF]", "font-semibold"];
        const INACTIVE = ["border-[#222634]", "bg-[#0D0F15]", "text-[#94A3B8]"];
        const state = { server: "", age: "" };

        const cards = Array.from(document.querySelectorAll("#katalog-products > a[data-sw-server], #katalog-products > a[data-sw-age]"));
        const emptyNote = document.createElement("p");
        emptyNote.className = "sw-hidden col-span-full text-center text-xs font-mono text-[#94A3B8] py-8";
        emptyNote.setAttribute("data-i18n", "catalog.empty_spec_filter");
        emptyNote.textContent = "Tidak ada akun yang cocok dengan filter spesifikasi ini.";

        function apply() {
            let visible = 0;
            cards.forEach((card) => {
                const okServer = !state.server || (card.dataset.swServer || "").split("|").includes(state.server);
                const okAge = !state.age || (card.dataset.swAge || "").split("|").includes(state.age);
                const show = okServer && okAge;
                card.classList.toggle("sw-hidden", !show);
                if (show) visible++;
            });
            const grid = document.getElementById("katalog-products");
            if (grid) {
                emptyNote.classList.toggle("sw-hidden", !(visible === 0 && cards.length > 0));
                if (emptyNote.parentElement !== grid && cards.length > 0) grid.appendChild(emptyNote);
            }
            const resetBtn = document.getElementById("sw-filter-reset");
            if (resetBtn) resetBtn.classList.toggle("hidden", !state.server && !state.age);
        }

        bar.querySelectorAll(".sw-filter-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const group = btn.dataset.swFilter;
                state[group] = btn.dataset.swValue || "";
                bar.querySelectorAll(`[data-sw-filter="${group}"]`).forEach((b) => {
                    const on = (b.dataset.swValue || "") === state[group];
                    b.classList.remove(...ACTIVE, ...INACTIVE);
                    b.classList.add(...(on ? ACTIVE : INACTIVE));
                });
                apply();
            });
        });

        document.getElementById("sw-filter-reset")?.addEventListener("click", () => {
            state.server = "";
            state.age = "";
            bar.querySelectorAll(".sw-filter-btn").forEach((b) => {
                const on = !(b.dataset.swValue || "");
                b.classList.remove(...ACTIVE, ...INACTIVE);
                b.classList.add(...(on ? ACTIVE : INACTIVE));
            });
            apply();
        });
    })();
</script>
