---
// src/pages/order-pay.astro
import Layout from "../layouts/Layout.astro";
import { getOrder, updateOrder } from "../lib/wc";
import QRCode from "qrcode";

const orderId = Astro.url.searchParams.get("id");
const orderKey = Astro.url.searchParams.get("key") || "";

if (!orderId) {
    return Astro.redirect("/cart");
}

let order = null;
let errorMsg = null;
let qrDataUrl = null;
let vaNumber = null;
let paymentMethod = "SP";
let paymentMethodName = "QRIS";
let paymentUrl = null;
let expiryTime = null;
let merchantOrderId = null;
let isExpired = false;

try {
    order = await getOrder(orderId);

    if (!order || !order.id) {
        errorMsg = "Pesanan tidak ditemukan di sistem.";
    } else if (!orderKey || order.order_key !== orderKey) {
        errorMsg = "Akses Ditolak: Kunci verifikasi pesanan (key) tidak valid atau hilang.";
        order = null;
    } else if (order.status === "processing" || order.status === "completed") {
        return Astro.redirect(`/order-success?id=${order.id}&key=${order.order_key}`);
    } else {
        const meta = order.meta_data || [];
        const findMeta = (k) => meta.find(m => m.key === k)?.value;

        merchantOrderId = findMeta("_duitku_merchant_order_id");
        paymentMethod = findMeta("_duitku_payment_method") || "SP";
        paymentMethodName = findMeta("_duitku_payment_method_name") || "QRIS";
        vaNumber = findMeta("_duitku_va_number");
        const qrString = findMeta("_duitku_qr_string");
        paymentUrl = findMeta("_duitku_payment_url");

        const orderCreatedMs = new Date(order.date_created).getTime();
        const defaultExpiryMs = orderCreatedMs + 15 * 60 * 1000;
        expiryTime = findMeta("_duitku_expiry_time")
            ? Number(findMeta("_duitku_expiry_time"))
            : defaultExpiryMs;

        isExpired =
            Date.now() >= expiryTime ||
            order.status === "cancelled" ||
            order.status === "failed";

        if (isExpired && (order.status === "pending" || order.status === "on-hold")) {
            try {
                await updateOrder(order.id, { status: "cancelled" });
                order.status = "cancelled";
            } catch (updateErr) {
                console.warn("Auto cancel expired order warning:", updateErr.message);
            }
        }

        if (qrString && !isExpired) {
            qrDataUrl = await QRCode.toDataURL(qrString, {
                width: 320,
                margin: 2,
                color: {
                    dark: "#000000",
                    light: "#ffffff"
                }
            });
        }
    }
} catch (e) {
    console.error("Order Pay Error:", e);
    errorMsg = e.message || "Gagal memuat detail pembayaran.";
}

const formattedTotal = order ? `Rp ${Number(order.total).toLocaleString("id-ID")}` : "Rp 0";
const isCard = paymentMethod === "VC" || paymentMethod === "credit_card" || paymentMethodName?.toLowerCase().includes("card") || paymentMethodName?.toLowerCase().includes("visa");
const isQris = !isCard && (!!qrDataUrl || paymentMethod === "SP" || paymentMethod === "LQ" || paymentMethod === "GQ");
const isVa = !isCard && !!vaNumber;
const lineItems = order?.line_items || [];
const firstItemName = lineItems[0]?.name || "Akun Game / Voucher";
const pageTitle = isExpired ? `[KADALUARSA] Pesanan #${orderId} - Yasui Game` : `Pembayaran Pesanan #${orderId} - Yasui Game`;
---

<Layout title={pageTitle} showFooter={false}>
    <div class="max-w-2xl w-full mx-auto p-4 md:p-8 space-y-6">
        <header class="flex items-center justify-between pb-6 border-b border-[#222634]">
            <div class="flex items-center gap-3">
                <a href="/" class="flex items-center gap-1.5 group">
                    <span class="text-lg font-black text-[#F8FAFC] tracking-wider font-mono">
                        YASUI<span class="text-[#00E5FF]">GAME</span>
                    </span>
                </a>
                <span id="header-status-badge" class={`text-[10px] px-2 py-0.5 font-mono font-medium uppercase tracking-wider rounded border ${isExpired ? 'bg-red-500/10 text-red-400 border-red-500/25' : 'bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]/25'}`}>
                    {isExpired ? 'GATEWAY EXPIRED' : 'HEADLESS GATEWAY'}
                </span>
            </div>
            <div class="text-right">
                <span class="text-[10px] text-[#64748B] uppercase block font-mono font-semibold" data-i18n="order_pay.deadline">Batas Waktu Bayar</span>
                <div id="countdown-timer" class="text-sm font-bold flex items-center justify-end gap-1.5 font-mono tabular-nums">
                    <div class={`i-lucide-clock text-xs ${isExpired ? 'text-red-400' : 'text-[#00E5FF] animate-pulse'}`}></div>
                    <span id="timer-text" class={isExpired ? 'text-red-400' : 'text-[#00E5FF]'}>
                        {isExpired ? 'KADALUARSA' : '15:00'}
                    </span>
                </div>
            </div>
        </header>

        <main>
            {errorMsg ? (
                <div class="bg-[#11131A] border border-red-500/40 p-8 rounded-lg text-center">
                    <div class="w-14 h-14 bg-red-500/10 border border-red-500/30 rounded-md flex items-center justify-center mx-auto mb-4 text-red-400 text-2xl">
                        <div class="i-lucide-alert-triangle"></div>
                    </div>
                    <h2 class="text-base font-bold text-[#F8FAFC] uppercase tracking-wider mb-2">Terjadi Kesalahan</h2>
                    <p class="text-xs text-[#94A3B8] leading-relaxed mb-6 font-mono">{errorMsg}</p>
                    <a
                        href="/cart"
                        class="yg-btn-danger text-xs px-6 py-2.5"
                    >
                        Kembali ke Keranjang
                    </a>
                </div>
            ) : (
                <div class="space-y-6">
                    <div id="expired-payment-container" class={isExpired ? "" : "hidden"}>
                        <div class="bg-[#11131A] border border-red-500/30 p-6 md:p-8 rounded-lg text-center">
                            <div class="w-16 h-16 bg-red-500/10 border border-red-500/30 rounded-md flex items-center justify-center mx-auto mb-4 text-red-400 text-3xl">
                                <div class="i-lucide-clock-alert"></div>
                            </div>

                            <div class="inline-flex items-center gap-1.5 bg-red-500/10 border border-red-500/25 px-2.5 py-1 rounded text-[10px] font-mono font-medium text-red-400 uppercase tracking-widest mb-3">
                                <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
                                TRANSAKSI KADALUARSA
                            </div>

                            <h1 class="text-lg md:text-xl font-bold text-[#F8FAFC] uppercase tracking-wider mb-2">
                                Waktu Pembayaran Telah Habis
                            </h1>
                            <p class="text-xs text-[#94A3B8] max-w-md mx-auto leading-relaxed mb-6 font-mono">
                                Sesi pembayaran untuk Pesanan <span class="text-red-400 font-bold">#{order.id}</span> telah melewati batas waktu. Kode QRIS / Nomor VA ini telah dinonaktifkan secara otomatis oleh gateway pembayaran.
                            </p>

                            <div class="bg-[#0D0F15] border-l-2 border-red-500 p-4 text-left max-w-md mx-auto mb-6 text-xs font-mono space-y-1 rounded-r">
                                <div class="text-red-400 font-semibold flex items-center gap-1.5">
                                    <div class="i-lucide-shield-alert text-sm"></div> Peringatan Gateway:
                                </div>
                                <p class="text-[#94A3B8] text-[11px] leading-relaxed">
                                    Jangan melakukan transfer ke kode ini lagi. Dana yang ditransfer ke kode yang sudah kedaluwarsa tidak dapat diverifikasi otomatis.
                                </p>
                            </div>

                            <div class="bg-[#0D0F15] border border-[#222634] p-3.5 rounded-lg max-w-md mx-auto mb-6 text-xs font-mono flex justify-between items-center">
                                <div class="text-left">
                                    <span class="text-[#64748B] block text-[10px]" data-i18n="order_pay.total_bill">TOTAL TAGIHAN</span>
                                    <span class="text-[#F8FAFC] font-bold tabular-nums yg-price" data-price-idr={order ? Number(order.total) : 0}>{formattedTotal}</span>
                                </div>
                                <div class="text-right">
                                    <span class="text-[#64748B] block text-[10px]" data-i18n="order_pay.product">PRODUK</span>
                                    <span class="text-[#94A3B8] font-medium truncate max-w-[180px]">{firstItemName}</span>
                                </div>
                            </div>

                            <div class="space-y-3 max-w-md mx-auto">
                                <button
                                    type="button"
                                    id="btn-reorder"
                                    class="yg-btn-danger w-full py-3.5 text-xs font-mono font-bold tracking-wider flex items-center justify-center gap-2"
                                >
                                    <div class="i-lucide-refresh-cw text-sm"></div>
                                    <span data-i18n="order_pay.reorder">Pesan Ulang (Buat Kode Baru)</span>
                                </button>

                                <div class="grid grid-cols-2 gap-2">
                                    <a
                                        href="/orders"
                                        class="yg-btn-secondary text-[11px] py-2 px-3 flex items-center justify-center gap-1.5"
                                    >
                                        <div class="i-lucide-receipt text-xs text-[#00E5FF]"></div> <span data-i18n="nav.my_orders">Riwayat Pesanan</span>
                                    </a>
                                    <a
                                        href="/"
                                        class="yg-btn-secondary text-[11px] py-2 px-3 flex items-center justify-center gap-1.5"
                                    >
                                        <div class="i-lucide-home text-xs"></div> <span data-i18n="nav.home">Beranda</span>
                                    </a>
                                </div>

                                <button
                                    type="button"
                                    onclick={`window.openLiveChatModal && window.openLiveChatModal('Pesanan #${order?.id}', '${order?.id}')`}
                                    class="w-full yg-btn-secondary text-xs py-2.5 flex items-center justify-center gap-1.5 font-mono cursor-pointer border-[#00E5FF]/40 text-[#00E5FF] hover:bg-[#00E5FF]/10"
                                >
                                    <div class="i-lucide-headset text-xs text-[#00E5FF]"></div>
                                    <span data-i18n="chat.order_help_btn">Butuh Bantuan untuk Order Ini? Chat Admin</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div id="active-payment-container" class={isExpired ? "hidden" : "space-y-6"}>
                        <div class="bg-[#11131A] border border-[#222634] p-4 rounded-lg flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-2.5 h-2.5 rounded-full bg-[#00E5FF] animate-pulse"></div>
                                <div>
                                    <h1 class="text-xs font-bold text-[#F8FAFC] uppercase tracking-wider" data-i18n="order_pay.waiting_payment">
                                        Menunggu Pembayaran
                                    </h1>
                                    <p class="text-[10px] text-[#64748B] font-mono">
                                        Invoice #{order.id} • {paymentMethodName}
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] text-[#64748B] uppercase font-mono block" data-i18n="order_pay.total_bill">Total Tagihan</span>
                                <span class="text-base md:text-lg font-mono font-bold text-[#00E5FF] tabular-nums yg-price" data-price-idr={order ? Number(order.total) : 0}>
                                    {formattedTotal}
                                </span>
                            </div>
                        </div>

                        <div class="bg-[#11131A] border border-[#222634] p-6 md:p-8 rounded-lg relative">
                            {isQris && (
                                <div class="flex flex-col items-center text-center">
                                    <div class="inline-flex items-center gap-2 bg-[#00E5FF]/10 border border-[#00E5FF]/25 px-3 py-1 rounded-full mb-4">
                                        <div class="i-lucide-qr-code text-[#00E5FF] text-xs"></div>
                                        <span class="text-[10px] text-[#00E5FF] font-mono font-semibold uppercase tracking-wider" data-i18n="order_pay.scan_qris">
                                            Scan QRIS • Bebas Biaya Layanan
                                        </span>
                                    </div>

                                    <div class="relative bg-white p-3 rounded-lg border border-[#222634] overflow-hidden">
                                        {qrDataUrl ? (
                                            <img
                                                src={qrDataUrl}
                                                id="qris-image"
                                                alt="QRIS Payment"
                                                class="w-60 h-60 md:w-68 md:h-68 object-contain"
                                            />
                                        ) : (
                                            <div class="w-60 h-60 flex items-center justify-center text-[#64748B] font-mono text-xs">
                                                Membuat QRIS...
                                            </div>
                                        )}
                                    </div>

                                    <div class="mt-4 flex items-center gap-3 w-full max-w-xs justify-center">
                                        {qrDataUrl && (
                                            <a
                                                href={qrDataUrl}
                                                download={`QRIS-YASUI-${order.id}.png`}
                                                class="yg-btn-secondary w-full text-xs py-2 px-4 flex items-center justify-center gap-2 font-mono"
                                            >
                                                <div class="i-lucide-download text-sm text-[#00E5FF]"></div> Simpan Gambar QR
                                            </a>
                                        )}
                                    </div>

                                    <div class="mt-6 pt-6 border-t border-[#222634] w-full text-left">
                                        <p class="text-[11px] font-semibold text-[#94A3B8] uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                            <div class="i-lucide-smartphone text-[#00E5FF]"></div> Mendukung Seluruh Pembayaran Digital:
                                        </p>
                                        <div class="flex flex-wrap gap-1.5">
                                            {["BCA Mobile", "GoPay", "OVO", "DANA", "ShopeePay", "Livin Mandiri", "BRImo", "BNI Mobile", "LinkAja"].map((app) => (
                                                <span class="text-[10px] bg-[#0D0F15] text-[#94A3B8] border border-[#222634] px-2 py-1 rounded font-mono">
                                                    {app}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            )}

                            {isVa && (
                                <div class="space-y-6">
                                    <div class="text-center">
                                        <span class="text-xs text-[#94A3B8] uppercase tracking-wider font-semibold block mb-1">
                                            Nomor Virtual Account {paymentMethodName}
                                        </span>
                                        <p class="text-xs text-[#64748B] font-mono mb-4">
                                            Transfer tepat sesuai nominal tagihan agar sistem otomatis memverifikasi pesanan Anda.
                                        </p>

                                        <div class="bg-[#0D0F15] border border-[#222634] p-4 rounded-lg flex items-center justify-between gap-3">
                                            <span id="va-number" class="text-xl md:text-2xl font-mono font-bold text-[#00E5FF] tracking-wider tabular-nums select-all">
                                                {vaNumber}
                                            </span>
                                            <button
                                                type="button"
                                                id="btn-copy-va"
                                                class="yg-btn-primary text-xs px-3.5 py-2 flex items-center gap-1.5 flex-shrink-0"
                                            >
                                                <div class="i-lucide-copy text-sm"></div>
                                                <span id="copy-text">Salin</span>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="bg-[#0D0F15]/60 border border-[#222634] p-4 rounded-lg space-y-2 text-xs font-mono">
                                        <div class="flex justify-between py-1 border-b border-[#222634]/60">
                                            <span class="text-[#64748B]">Nama Penerima:</span>
                                            <span class="text-[#F8FAFC] font-semibold">YASUI GAME / DUITKU</span>
                                        </div>
                                        <div class="flex justify-between py-1 border-b border-[#222634]/60">
                                            <span class="text-[#64748B]">Total Pembayaran:</span>
                                            <span class="text-[#00E5FF] font-bold tabular-nums">{formattedTotal}</span>
                                        </div>
                                        <div class="flex justify-between py-1">
                                            <span class="text-[#64748B]">Status Tagihan:</span>
                                            <span class="text-amber-400 font-semibold uppercase">MENUNGGU TRANSFER</span>
                                        </div>
                                    </div>

                                    <div class="border-t border-[#222634] pt-4 text-xs text-[#94A3B8] space-y-2">
                                        <p class="font-semibold text-[#F8FAFC] uppercase tracking-wider text-[11px]">
                                            Panduan Pembayaran Virtual Account:
                                        </p>
                                        <ol class="list-decimal list-inside space-y-1 text-[11px] leading-relaxed font-mono text-[#94A3B8]">
                                            <li>Buka aplikasi Mobile Banking / ATM pilihan Anda.</li>
                                            <li>Pilih menu <strong class="text-[#F8FAFC]">Transfer ➔ Virtual Account</strong>.</li>
                                            <li>Masukkan nomor VA di atas (<code class="text-[#00E5FF]">{vaNumber}</code>).</li>
                                            <li>Periksa nama penerima dan nominal tagihan (<strong class="text-[#F8FAFC]">{formattedTotal}</strong>).</li>
                                            <li>Konfirmasi transaksi dan simpan bukti transfer.</li>
                                        </ol>
                                    </div>
                                </div>
                            )}

                            {isCard && (
                                <div class="space-y-6">
                                    <div class="text-center">
                                        <div class="inline-flex items-center gap-2 bg-[#00E5FF]/10 border border-[#00E5FF]/25 px-3 py-1 rounded-full mb-3">
                                            <div class="i-lucide-credit-card text-[#00E5FF] text-xs"></div>
                                            <span class="text-[10px] text-[#00E5FF] font-mono font-semibold uppercase tracking-wider">
                                                3D-SECURE 2.0 PROTECTED GATEWAY
                                            </span>
                                        </div>
                                        <h2 class="text-sm md:text-base font-bold text-[#F8FAFC] uppercase tracking-wider">
                                            Pembayaran Kartu Kredit / Debit Global
                                        </h2>
                                        <p class="text-xs text-[#94A3B8] max-w-md mx-auto font-mono mt-1 leading-relaxed">
                                            Mendukung kartu Visa, Mastercard, dan JCB dari seluruh dunia dengan standar enkripsi PCI-DSS Level 1.
                                        </p>
                                    </div>

                                    <div class="flex items-center justify-center gap-2 py-2.5 border-y border-[#222634] bg-[#0D0F15] flex-wrap">
                                        <div class="px-2.5 py-1 rounded bg-[#11131A] border border-[#222634] text-[11px] font-mono font-bold tracking-wider text-blue-400">
                                            VISA
                                        </div>
                                        <div class="px-2.5 py-1 rounded bg-[#11131A] border border-[#222634] text-[11px] font-mono font-bold tracking-wider text-red-400">
                                            Mastercard
                                        </div>
                                        <div class="px-2.5 py-1 rounded bg-[#11131A] border border-[#222634] text-[11px] font-mono font-bold tracking-wider text-emerald-400">
                                            JCB
                                        </div>
                                        <div class="px-2.5 py-1 rounded bg-[#11131A] border border-[#222634] text-[11px] font-mono font-bold tracking-wider text-[#00E5FF]">
                                            AMEX
                                        </div>
                                    </div>

                                    <div class="bg-[#0D0F15] border border-[#222634] p-4 rounded-lg space-y-2 text-xs font-mono">
                                        <div class="flex justify-between py-1 border-b border-[#222634]/60">
                                            <span class="text-[#64748B]">Nomor Pesanan:</span>
                                            <span class="text-[#F8FAFC] font-semibold">#{order.id}</span>
                                        </div>
                                        <div class="flex justify-between py-1 border-b border-[#222634]/60">
                                            <span class="text-[#64748B]">Total Tagihan (IDR):</span>
                                            <span class="text-[#00E5FF] font-bold tabular-nums">{formattedTotal}</span>
                                        </div>
                                        <div class="flex justify-between py-1 border-b border-[#222634]/60">
                                            <span class="text-[#64748B]">Estimasi Valuta Asing:</span>
                                            <span class="text-[#94A3B8] tabular-nums">
                                                ≈ ${(Number(order.total) / 16000).toFixed(2)} USD
                                            </span>
                                        </div>
                                        <div class="flex justify-between py-1">
                                            <span class="text-[#64748B]">Protokol Keamanan:</span>
                                            <span class="text-emerald-400 font-semibold flex items-center gap-1">
                                                <div class="i-lucide-shield-check text-xs"></div> 3D Secure OTP & PCI-DSS
                                            </span>
                                        </div>
                                    </div>

                                    <div class="space-y-3">
                                        <a
                                            href={paymentUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="yg-btn-primary w-full py-4 text-xs font-mono font-bold tracking-wider flex items-center justify-center gap-2 group"
                                        >
                                            <div class="i-lucide-lock text-sm"></div>
                                            <span>Lanjutkan ke Pembayaran Kartu (3D-Secure)</span>
                                            <div class="i-lucide-external-link text-sm group-hover:translate-x-0.5 transition-transform"></div>
                                        </a>

                                        <p class="text-[11px] text-[#64748B] text-center font-mono leading-relaxed">
                                            Portal resmi Duitku akan dibuka di tab baru. Setelah verifikasi OTP, halaman ini akan otomatis mengonfirmasi pesanan Anda.
                                        </p>
                                    </div>
                                </div>
                            )}

                            {!isQris && !isVa && !isCard && paymentUrl && (
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-14 h-14 bg-[#00E5FF]/10 border border-[#00E5FF]/30 rounded-md flex items-center justify-center mx-auto text-[#00E5FF] text-2xl">
                                        <div class="i-lucide-external-link"></div>
                                    </div>
                                    <h3 class="text-xs font-bold text-[#F8FAFC] uppercase tracking-wider">
                                        Selesaikan di Gateway Pembayaran
                                    </h3>
                                    <p class="text-xs text-[#94A3B8] max-w-sm mx-auto font-mono">
                                        Metode pembayaran ini membutuhkan otorisasi langsung di portal Duitku.
                                    </p>
                                    <a
                                        href={paymentUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="yg-btn-primary inline-flex items-center gap-2 text-xs px-6 py-3 tracking-wider font-mono"
                                    >
                                        Buka Pembayaran Sekarang <div class="i-lucide-arrow-right text-sm"></div>
                                    </a>
                                </div>
                            )}

                            <div class="mt-8 pt-6 border-t border-[#222634] flex flex-col md:flex-row items-center justify-between gap-4">
                                <div class="flex items-center gap-2 text-xs text-[#94A3B8] font-mono">
                                    <div class="w-2 h-2 rounded-full bg-[#00E5FF] animate-ping"></div>
                                    <span id="polling-label">Mendeteksi transaksi masuk secara otomatis...</span>
                                </div>

                                <button
                                    type="button"
                                    id="btn-manual-check"
                                    class="w-full md:w-auto yg-btn-secondary text-[11px] px-4 py-2 flex items-center justify-center gap-2 font-mono"
                                >
                                    <div id="check-icon" class="i-lucide-refresh-cw text-xs text-[#00E5FF]"></div>
                                    <span>Cek Status Sekarang</span>
                                </button>
                            </div>

                            <div class="mt-4 pt-4 border-t border-[#222634]/70 flex flex-col sm:flex-row items-center justify-between gap-3 bg-[#0D0F15] p-3 rounded-lg border border-[#222634]">
                                <div class="flex items-center gap-2 text-xs text-[#94A3B8] font-mono text-center sm:text-left">
                                    <div class="i-lucide-shield-question text-base text-[#00E5FF] shrink-0"></div>
                                    <span>Kendala pembayaran atau ingin konfirmasi manual?</span>
                                </div>
                                <button
                                    type="button"
                                    onclick={`window.openLiveChatModal && window.openLiveChatModal('Pesanan #${order?.id}', '${order?.id}')`}
                                    class="w-full sm:w-auto yg-btn-secondary text-xs py-2 px-3.5 flex items-center justify-center gap-1.5 font-mono cursor-pointer shrink-0 border-[#00E5FF]/40 text-[#00E5FF] hover:bg-[#00E5FF]/10"
                                >
                                    <div class="i-lucide-headset text-xs text-[#00E5FF]"></div>
                                    <span data-i18n="chat.order_help_btn">Butuh Bantuan untuk Order Ini? Chat Admin</span>
                                </button>
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-xs text-[#64748B] px-1 font-mono">
                            <a href="/cart" class="hover:text-red-400 transition-colors flex items-center gap-1">
                                <div class="i-lucide-arrow-left text-xs"></div> Batal & Ubah Pesanan
                            </a>
                            <span>ID Referensi: #{merchantOrderId || order.id}</span>
                        </div>
                    </div>
                </div>
            )}
        </main>

        <footer class="text-center pt-6 border-t border-[#222634] text-[11px] text-[#64748B] font-mono">
            &copy; {new Date().getFullYear()} Yasui Game • 256-Bit SSL Encrypted Gaming Marketplace
        </footer>
    </div>

    <script id="order-items-json" type="application/json" set:html={JSON.stringify(lineItems.map(item => ({
        id: item.product_id || item.id,
        productId: item.product_id || item.id,
        name: item.name,
        price: item.price || item.total,
        quantity: item.quantity || 1,
        image: item.image?.src || null
    })))}></script>

    <script is:inline define:vars={{ orderId, orderKey, expiryTime, isExpired }}>
        let isChecking = false;
        let checkInterval = null;

        // Auto-register order to recent orders for contextual chat
        try {
            if (orderId) {
                const rec = JSON.parse(localStorage.getItem("yasui_recent_orders") || "[]");
                const cleanId = String(orderId).trim();
                if (!rec.includes(cleanId)) {
                    rec.unshift(cleanId);
                    localStorage.setItem("yasui_recent_orders", JSON.stringify(rec.slice(0, 10)));
                }
            }
        } catch (e) {}

        function copyVaNumber() {
            const vaEl = document.getElementById("va-number");
            const textEl = document.getElementById("copy-text");
            const btnEl = document.getElementById("btn-copy-va");

            if (!vaEl) return;
            const textToCopy = vaEl.innerText.trim();

            navigator.clipboard.writeText(textToCopy).then(() => {
                if (textEl) textEl.innerText = "TERSALIN!";
                btnEl?.classList.remove("bg-cyan-400");
                btnEl?.classList.add("bg-green-400");
                setTimeout(() => {
                    if (textEl) textEl.innerText = "Salin";
                    btnEl?.classList.add("bg-cyan-400");
                    btnEl?.classList.remove("bg-green-400");
                }, 2500);
            });
        }

        function reorderThisOrder() {
            try {
                const raw = document.getElementById("order-items-json")?.textContent;
                const items = raw ? JSON.parse(raw) : [];
                const currentCart = JSON.parse(localStorage.getItem("yasui_cart") || "[]");

                items.forEach(item => {
                    const targetId = String(item.productId || item.id);
                    const existingIdx = currentCart.findIndex(c => String(c.id) === targetId);
                    if (existingIdx >= 0) {
                        currentCart[existingIdx].quantity = (currentCart[existingIdx].quantity || 1) + (item.quantity || 1);
                        currentCart[existingIdx].selected = true;
                    } else {
                        currentCart.push({
                            id: targetId,
                            name: item.name,
                            price: item.price,
                            rawPrice: item.price,
                            quantity: item.quantity || 1,
                            selected: true,
                            image: item.image ? { sourceUrl: item.image } : null
                        });
                    }
                });

                localStorage.setItem("yasui_cart", JSON.stringify(currentCart));
                window.location.href = "/checkout";
            } catch (e) {
                console.error("Reorder error:", e);
                window.location.href = "/cart";
            }
        }

        function triggerClientExpiry() {
            if (checkInterval) clearInterval(checkInterval);

            const activeContainer = document.getElementById("active-payment-container");
            const expiredContainer = document.getElementById("expired-payment-container");
            const headerBadge = document.getElementById("header-status-badge");
            const timerText = document.getElementById("timer-text");

            if (activeContainer) activeContainer.classList.add("hidden");
            if (expiredContainer) expiredContainer.classList.remove("hidden");

            if (headerBadge) {
                headerBadge.className = "text-[10px] px-2 py-0.5 font-bold uppercase tracking-widest bg-red-950/80 text-red-400 border border-red-800/80";
                headerBadge.innerText = "GATEWAY KADALUARSA";
            }

            if (timerText) {
                timerText.className = "text-red-500";
                timerText.innerText = "KADALUARSA";
            }

            fetch(`/api/payment/check-status?id=${orderId}&key=${encodeURIComponent(orderKey)}`).catch(() => {});
        }

        function initCountdown() {
            if (isExpired) return;

            const timerText = document.getElementById("timer-text");
            if (!timerText) return;

            const targetTime = Number(expiryTime) || (Date.now() + 15 * 60 * 1000);

            const updateTimer = () => {
                const diff = Math.max(0, targetTime - Date.now());
                const mins = Math.floor(diff / 60000);
                const secs = Math.floor((diff % 60000) / 1000);

                timerText.innerText = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;

                if (diff <= 0) {
                    triggerClientExpiry();
                }
            };

            updateTimer();
            const timerInterval = setInterval(() => {
                const diff = targetTime - Date.now();
                if (diff <= 0) {
                    clearInterval(timerInterval);
                    triggerClientExpiry();
                } else {
                    updateTimer();
                }
            }, 1000);
        }

        async function checkPaymentStatus(isManual = false) {
            if (isChecking || isExpired) return;
            isChecking = true;

            const checkIcon = document.getElementById("check-icon");
            const pollingLabel = document.getElementById("polling-label");

            if (checkIcon) checkIcon.classList.add("animate-spin");
            if (isManual && pollingLabel) pollingLabel.innerText = "Memeriksa status ke Duitku...";

            try {
                const res = await fetch(`/api/payment/check-status?id=${orderId}&key=${encodeURIComponent(orderKey)}`);
                const data = await res.json();

                if (data.success && data.status === "paid") {
                    if (pollingLabel) pollingLabel.innerText = "Pembayaran Dikonfirmasi! Mengalihkan...";
                    localStorage.removeItem("yasui_cart");

                    setTimeout(() => {
                        window.location.href = `/order-success?id=${orderId}&key=${encodeURIComponent(orderKey)}`;
                    }, 800);
                    return;
                } else if (data.status === "expired" || data.status === "failed") {
                    triggerClientExpiry();
                    return;
                } else {
                    if (isManual && pollingLabel) {
                        pollingLabel.innerText = "Pembayaran belum terdeteksi. Silakan coba sesaat lagi.";
                        setTimeout(() => {
                            pollingLabel.innerText = "Mendeteksi transaksi masuk secara otomatis...";
                        }, 3000);
                    }
                }
            } catch (err) {
                console.error("Gagal memeriksa status:", err);
            } finally {
                isChecking = false;
                if (checkIcon) checkIcon.classList.remove("animate-spin");
            }
        }

        document.getElementById("btn-copy-va")?.addEventListener("click", copyVaNumber);
        document.getElementById("btn-reorder")?.addEventListener("click", reorderThisOrder);
        document.getElementById("btn-manual-check")?.addEventListener("click", () => checkPaymentStatus(true));

        if (!isExpired) {
            initCountdown();
            checkInterval = setInterval(() => {
                checkPaymentStatus(false);
            }, 4000);
        }
    </script>
</Layout>
