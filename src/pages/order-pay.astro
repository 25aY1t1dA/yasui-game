---
// src/pages/order-pay.astro
import Layout from "../layouts/Layout.astro";
import { getOrder, updateOrder } from "../lib/wc";
import { IDR_TO_USD_RATE } from "../lib/price";
import { translations } from "../lib/translations";
import QRCode from "qrcode";

const orderId = Astro.url.searchParams.get("id");
const orderKey = Astro.url.searchParams.get("key") || "";

if (!orderId) {
    return Astro.redirect("/cart");
}

let order = null;
let errorMsg = null;
let qrDataUrl = null;
let vaNumber = null;
let paymentMethod = "SP";
let paymentMethodName = "QRIS";
let paymentUrl = null;
let expiryTime = null;
let merchantOrderId = null;
let isExpired = false;

let isCrypto = false;
let cryptoExpectedAmount = null;
let cryptoTokenSymbol = "USDT";
let cryptoNetwork = null;
let cryptoNetworkName = null;
let cryptoWalletAddress = null;
let cryptoContractAddress = null;
let cryptoContractDisplay = null;
let cryptoQrDataUrl = null;

try {
    order = await getOrder(orderId);

    if (!order || !order.id) {
        errorMsg = "Pesanan tidak ditemukan di sistem.";
    } else if (!orderKey || order.order_key !== orderKey) {
        errorMsg = "Akses Ditolak: Kunci verifikasi pesanan (key) tidak valid atau hilang.";
        order = null;
    } else if (order.status === "processing" || order.status === "completed") {
        return Astro.redirect(`/order-success?id=${order.id}&key=${order.order_key}`);
    } else {
        const meta = order.meta_data || [];
        const findMeta = (k) => meta.find(m => m.key === k)?.value;

        const isCryptoOrder = Boolean(findMeta("_crypto_payment_channel") || order.payment_method === "crypto");
        const orderCreatedMs = new Date(order.date_created).getTime();

        if (isCryptoOrder) {
            isCrypto = true;
            paymentMethod = findMeta("_crypto_payment_channel") || "CRYPTO_USDT_BEP20";
            cryptoExpectedAmount = findMeta("_crypto_expected_amount");
            cryptoTokenSymbol = findMeta("_crypto_token_symbol") || "USDT";
            cryptoNetwork = findMeta("_crypto_network");
            cryptoNetworkName = findMeta("_crypto_network_name") || "Crypto Direct";
            cryptoWalletAddress = findMeta("_crypto_wallet_address");
            cryptoContractAddress = findMeta("_crypto_contract_address");
            cryptoContractDisplay = findMeta("_crypto_contract_display");
            paymentMethodName = cryptoNetworkName;
            merchantOrderId = `CRYPTO-${order.id}`;

            const defaultCryptoExpiry = orderCreatedMs + 60 * 60 * 1000;
            expiryTime = findMeta("_crypto_expiry_time")
                ? Number(findMeta("_crypto_expiry_time"))
                : defaultCryptoExpiry;

            isExpired =
                Date.now() >= expiryTime ||
                order.status === "cancelled" ||
                order.status === "failed";

            if (cryptoWalletAddress && !isExpired) {
                cryptoQrDataUrl = await QRCode.toDataURL(cryptoWalletAddress, {
                    width: 320,
                    margin: 2,
                    color: {
                        dark: "#000000",
                        light: "#ffffff"
                    }
                });
            }
        } else {
            merchantOrderId = findMeta("_duitku_merchant_order_id");
            paymentMethod = findMeta("_duitku_payment_method") || "SP";
            paymentMethodName = findMeta("_duitku_payment_method_name") || "QRIS";
            vaNumber = findMeta("_duitku_va_number");
            const qrString = findMeta("_duitku_qr_string");
            paymentUrl = findMeta("_duitku_payment_url");

            const defaultExpiryMs = orderCreatedMs + 15 * 60 * 1000;
            expiryTime = findMeta("_duitku_expiry_time")
                ? Number(findMeta("_duitku_expiry_time"))
                : defaultExpiryMs;

            isExpired =
                Date.now() >= expiryTime ||
                order.status === "cancelled" ||
                order.status === "failed";

            if (qrString && !isExpired) {
                qrDataUrl = await QRCode.toDataURL(qrString, {
                    width: 320,
                    margin: 2,
                    color: {
                        dark: "#000000",
                        light: "#ffffff"
                    }
                });
            }
        }

        if (isExpired && (order.status === "pending" || order.status === "on-hold")) {
            try {
                await updateOrder(order.id, { status: "cancelled" });
                order.status = "cancelled";
            } catch (updateErr) {
                console.warn("Auto cancel expired order warning:", updateErr.message);
            }
        }
    }
} catch (e) {
    console.error("Order Pay Error:", e);
    errorMsg = e.message || "Gagal memuat detail pembayaran.";
}

const formattedTotal = order ? `Rp ${Number(order.total).toLocaleString("id-ID")}` : "Rp 0";
const isCard = !isCrypto && (paymentMethod === "VC" || paymentMethod === "credit_card" || paymentMethodName?.toLowerCase().includes("card") || paymentMethodName?.toLowerCase().includes("visa"));
const isQris = !isCrypto && !isCard && (!!qrDataUrl || paymentMethod === "SP" || paymentMethod === "LQ" || paymentMethod === "GQ");
const isVa = !isCrypto && !isCard && !!vaNumber;
const lineItems = order?.line_items || [];
const firstItemName = lineItems[0]?.name || "Akun Game / Voucher";
const pageTitle = isExpired ? `[KADALUARSA] Pesanan #${orderId} - Yasui Game` : `Pembayaran Pesanan #${orderId} - Yasui Game`;
---

<Layout title={pageTitle} showFooter={false} noindex={true}>
    <div class="max-w-2xl w-full mx-auto p-4 md:p-8 space-y-6">
        <header class="flex items-center justify-between pb-6 border-b border-[#222634]">
            <div class="flex items-center gap-3">
                <a href="/" class="flex items-center gap-1.5 group">
                    <span class="text-lg font-black text-[#F8FAFC] tracking-wider font-mono">
                        YASUI<span class="text-[#00E5FF]">GAME</span>
                    </span>
                </a>
                <span id="header-status-badge" class={`text-[10px] px-2 py-0.5 font-mono font-medium uppercase tracking-wider rounded border ${isExpired ? 'bg-red-500/10 text-red-400 border-red-500/25' : (isCrypto ? 'bg-amber-500/10 text-amber-400 border-amber-500/25' : 'bg-[#00E5FF]/10 text-[#00E5FF] border-[#00E5FF]/25')}`} data-i18n={isExpired ? 'order_pay.gateway_expired' : (isCrypto ? 'order_pay.terminal_title' : 'order_pay.gateway_title')}>
                    {isExpired ? 'GATEWAY EXPIRED' : (isCrypto ? 'CRYPTO ON-CHAIN TERMINAL' : 'HEADLESS GATEWAY')}
                </span>
            </div>
            <div class="text-right">
                <span class="text-[10px] text-[#64748B] uppercase block font-mono font-semibold" data-i18n="order_pay.deadline">Batas Waktu Bayar</span>
                <div id="countdown-timer" class="text-sm font-bold flex items-center justify-end gap-1.5 font-mono tabular-nums">
                    <div class={`i-lucide-clock text-xs ${isExpired ? 'text-red-400' : 'text-[#00E5FF] animate-pulse'}`}></div>
                    <span id="timer-text" class={isExpired ? 'text-red-400' : 'text-[#00E5FF]'} data-i18n={isExpired ? 'order_pay.expired_status' : undefined}>
                        {isExpired ? 'KADALUARSA' : '15:00'}
                    </span>
                </div>
            </div>
        </header>

        <main>
            {errorMsg ? (
                <div class="bg-[#11131A] border border-red-500/40 p-8 rounded-lg text-center">
                    <div class="w-14 h-14 bg-red-500/10 border border-red-500/30 rounded-md flex items-center justify-center mx-auto mb-4 text-red-400 text-2xl">
                        <div class="i-lucide-alert-triangle"></div>
                    </div>
                    <h2 class="text-base font-bold text-[#F8FAFC] uppercase tracking-wider mb-2">Terjadi Kesalahan</h2>
                    <p class="text-xs text-[#94A3B8] leading-relaxed mb-6 font-mono">{errorMsg}</p>
                    <a
                        href="/cart"
                        class="yg-btn-danger text-xs px-6 py-2.5"
                        data-i18n="checkout.back_to_cart"
                    >
                        Kembali ke Keranjang
                    </a>
                </div>
            ) : (
                <div class="space-y-6">
                    <div id="expired-payment-container" class={isExpired ? "" : "hidden"}>
                        <div class="bg-[#11131A] border border-red-500/30 p-6 md:p-8 rounded-lg text-center">
                            <div class="w-16 h-16 bg-red-500/10 border border-red-500/30 rounded-md flex items-center justify-center mx-auto mb-4 text-red-400 text-3xl">
                                <div class="i-lucide-clock-alert"></div>
                            </div>

                            <div class="inline-flex items-center gap-1.5 bg-red-500/10 border border-red-500/25 px-2.5 py-1 rounded text-[10px] font-mono font-medium text-red-400 uppercase tracking-widest mb-3">
                                <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
                                <span data-i18n="order_pay.tx_expired_badge">TRANSAKSI KADALUARSA</span>
                            </div>

                            <h1 class="text-lg md:text-xl font-bold text-[#F8FAFC] uppercase tracking-wider mb-2" data-i18n="order_pay.time_up_title">
                                Waktu Pembayaran Telah Habis
                            </h1>
                            <p class="text-xs text-[#94A3B8] max-w-md mx-auto leading-relaxed mb-6 font-mono">
                                Sesi pembayaran untuk Pesanan <span class="text-red-400 font-bold">#{order.id}</span> telah melewati batas waktu. Tagihan ini telah dinonaktifkan secara otomatis.
                            </p>

                            <div class="bg-[#0D0F15] border-l-2 border-red-500 p-4 text-left max-w-md mx-auto mb-6 text-xs font-mono space-y-1 rounded-r">
                                <div class="text-red-400 font-semibold flex items-center gap-1.5">
                                    <div class="i-lucide-shield-alert text-sm"></div> <span data-i18n="order_pay.gateway_warning">Peringatan Gateway:</span>
                                </div>
                                <p class="text-[#94A3B8] text-[11px] leading-relaxed" data-i18n="order_pay.warning_expired_text">
                                    Jangan melakukan transfer ke kode atau alamat ini lagi. Dana yang ditransfer ke pesanan kedaluwarsa tidak dapat diverifikasi otomatis.
                                </p>
                            </div>

                            <div class="bg-[#0D0F15] border border-[#222634] p-3.5 rounded-lg max-w-md mx-auto mb-6 text-xs font-mono flex justify-between items-center">
                                <div class="text-left">
                                    <span class="text-[#64748B] block text-[10px]" data-i18n="order_pay.total_bill">TOTAL TAGIHAN</span>
                                    {isCrypto ? (
                                        <span class="text-[#F8FAFC] font-bold tabular-nums font-mono">{cryptoExpectedAmount} {cryptoTokenSymbol}</span>
                                    ) : (
                                        <span class="text-[#F8FAFC] font-bold tabular-nums yg-price" data-price-idr={order ? Number(order.total) : 0}>{formattedTotal}</span>
                                    )}
                                </div>
                                <div class="text-right">
                                    <span class="text-[#64748B] block text-[10px]" data-i18n="order_pay.product">PRODUK</span>
                                    <span class="text-[#94A3B8] font-medium truncate max-w-[180px]">{firstItemName}</span>
                                </div>
                            </div>

                            <div class="space-y-3 max-w-md mx-auto">
                                <button
                                    type="button"
                                    id="btn-reorder"
                                    class="yg-btn-danger w-full py-3.5 text-xs font-mono font-bold tracking-wider flex items-center justify-center gap-2"
                                >
                                    <div class="i-lucide-refresh-cw text-sm"></div>
                                    <span data-i18n="order_pay.reorder">Pesan Ulang (Buat Kode Baru)</span>
                                </button>

                                <div class="grid grid-cols-2 gap-2">
                                    <a
                                        href="/orders"
                                        class="yg-btn-secondary text-[11px] py-2 px-3 flex items-center justify-center gap-1.5"
                                    >
                                        <div class="i-lucide-receipt text-xs text-[#00E5FF]"></div> <span data-i18n="nav.my_orders">Riwayat Pesanan</span>
                                    </a>
                                    <a
                                        href="/"
                                        class="yg-btn-secondary text-[11px] py-2 px-3 flex items-center justify-center gap-1.5"
                                    >
                                        <div class="i-lucide-home text-xs"></div> <span data-i18n="nav.home">Beranda</span>
                                    </a>
                                </div>

                                <button
                                    type="button"
                                    onclick={`window.openLiveChatModal && window.openLiveChatModal('Pesanan #${order?.id}', '${order?.id}')`}
                                    class="w-full yg-btn-secondary text-xs py-2.5 flex items-center justify-center gap-1.5 font-mono cursor-pointer border-[#00E5FF]/40 text-[#00E5FF] hover:bg-[#00E5FF]/10"
                                >
                                    <div class="i-lucide-headset text-xs text-[#00E5FF]"></div>
                                    <span data-i18n="chat.order_help_btn">Butuh Bantuan untuk Order Ini? Chat Admin</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div id="active-payment-container" class={isExpired ? "hidden" : "space-y-6"}>
                        <div class="bg-[#11131A] border border-[#222634] p-4 rounded-lg flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-2.5 h-2.5 rounded-full bg-[#00E5FF] animate-pulse"></div>
                                <div>
                                    <h1 class="text-xs font-bold text-[#F8FAFC] uppercase tracking-wider" data-i18n="order_pay.waiting_payment">
                                        Menunggu Pembayaran
                                    </h1>
                                    <p class="text-[10px] text-[#64748B] font-mono">
                                        Invoice #{order.id} • {paymentMethodName}
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] text-[#64748B] uppercase font-mono block" data-i18n="order_pay.total_bill">Total Tagihan</span>
                                {isCrypto ? (
                                    <div class="flex flex-col items-end">
                                        <span class="text-base md:text-xl font-mono font-black text-[#00E5FF] tabular-nums">
                                            {cryptoExpectedAmount} {cryptoTokenSymbol}
                                        </span>
                                        <span class="text-[10px] text-[#64748B] font-mono">
                                            (≈ {formattedTotal})
                                        </span>
                                    </div>
                                ) : (
                                    <span class="text-base md:text-lg font-mono font-bold text-[#00E5FF] tabular-nums yg-price" data-price-idr={order ? Number(order.total) : 0}>
                                        {formattedTotal}
                                    </span>
                                )}
                            </div>
                        </div>

                        <div class="bg-[#11131A] border border-[#222634] p-6 md:p-8 rounded-lg relative">
                            {isCrypto && (
                                <div class="space-y-6 text-left">
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#222634]">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-9 h-9 rounded-lg bg-[#00E5FF]/10 border border-[#00E5FF]/30 flex items-center justify-center text-[#00E5FF] shrink-0">
                                                <div class="i-lucide-coins text-lg"></div>
                                            </div>
                                            <div>
                                                <div class="text-xs font-bold text-[#F8FAFC] tracking-wider uppercase font-mono flex items-center gap-1.5 flex-wrap">
                                                    <span>{cryptoNetworkName}</span>
                                                    <span class="text-[9px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-1.5 py-0.2 rounded font-mono">ON-CHAIN</span>
                                                </div>
                                                <p class="text-[10px] text-[#64748B] font-mono mt-0.5" data-i18n="order_pay.crypto_sub">
                                                    Non-Custodial Direct Gateway • 0% Biaya Gateway
                                                </p>
                                            </div>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-[10px] bg-[#00E5FF]/10 border border-[#00E5FF]/25 text-[#00E5FF] px-2.5 py-1 rounded font-mono font-semibold" data-i18n="order_pay.auto_verify">
                                                VERIFIKASI OTOMATIS
                                            </span>
                                        </div>
                                    </div>

                                    <div class="bg-[#0D0F15] border border-[#00E5FF]/40 rounded-xl p-4 sm:p-5 space-y-3">
                                        <div class="flex items-center justify-between">
                                            <span class="text-[11px] font-mono font-bold text-[#94A3B8] uppercase tracking-wider flex items-center gap-1.5">
                                                <div class="i-lucide-calculator text-[#00E5FF] text-xs"></div> <span data-i18n="order_pay.exact_amount_label">Nominal Wajib Ditransfer Tepat:</span>
                                            </span>
                                            <span class="text-[10px] font-mono text-[#00E5FF] bg-[#00E5FF]/10 px-2 py-0.5 rounded border border-[#00E5FF]/25 font-semibold" data-i18n="order_pay.micro_decimal_tag">
                                                MICRO-DECIMAL MATCH
                                            </span>
                                        </div>

                                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
                                            <div class="flex items-baseline gap-2">
                                                <span id="crypto-exact-amount" class="text-3xl sm:text-4xl font-mono font-black text-[#00E5FF] tracking-wider tabular-nums select-all">
                                                    {cryptoExpectedAmount}
                                                </span>
                                                <span class="text-lg font-mono font-bold text-[#F8FAFC]">
                                                    {cryptoTokenSymbol}
                                                </span>
                                                <span class="text-xs text-[#64748B] font-mono ml-1">
                                                    (≈ {formattedTotal})
                                                </span>
                                            </div>
                                            <button
                                                type="button"
                                                id="btn-copy-amount"
                                                class="yg-btn-primary text-xs px-4 py-2.5 flex items-center justify-center gap-1.5 shrink-0 font-mono tracking-wider"
                                            >
                                                <div class="i-lucide-copy text-sm"></div>
                                                <span id="copy-amount-label" data-i18n="order_pay.copy_amount">Salin Nominal</span>
                                            </button>
                                        </div>

                                        <div class="bg-amber-500/10 border-l-2 border-amber-500 p-3 rounded-r text-xs font-mono text-amber-300 flex items-start gap-2.5 mt-2">
                                            <div class="i-lucide-alert-triangle text-base shrink-0 mt-0.5 text-amber-400"></div>
                                            <div class="leading-relaxed text-[11px]">
                                                <strong data-i18n="order_pay.crypto_important_prefix">PENTING:</strong> Transfer tepat <strong>{cryptoExpectedAmount} {cryptoTokenSymbol}</strong> hingga 3 angka di belakang koma. Jangan dibulatkan agar mesin scanner on-chain otomatis mencocokkan pembayaran pesanan #{order.id} Anda!
                                            </div>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-center bg-[#0D0F15] border border-[#222634] p-5 rounded-xl">
                                        <div class="md:col-span-4 flex flex-col items-center text-center">
                                            <div class="bg-white p-2.5 rounded-lg border border-[#222634] inline-block shadow-lg">
                                                {cryptoQrDataUrl ? (
                                                    <img
                                                        src={cryptoQrDataUrl}
                                                        alt="Wallet Address QR"
                                                        class="w-44 h-44 sm:w-48 sm:h-48 object-contain"
                                                    />
                                                ) : (
                                                    <div class="w-44 h-44 flex items-center justify-center text-[#64748B] font-mono text-xs">
                                                        QR Dompet
                                                    </div>
                                                )}
                                            </div>
                                            <p class="text-[10px] text-[#64748B] font-mono mt-2 text-center" data-i18n="order_pay.scan_wallets">
                                                Pindai via Binance / TrustWallet / OKX
                                            </p>
                                        </div>

                                        <div class="md:col-span-8 space-y-3">
                                            <div>
                                                <label class="block text-xs font-semibold text-[#94A3B8] uppercase tracking-wider mb-1.5 font-mono">
                                                    <span data-i18n="order_pay.official_wallet_label">Alamat Dompet Penerima Resmi</span> ({cryptoTokenSymbol} {cryptoNetwork || ''}):
                                                </label>
                                                <div class="bg-[#11131A] border border-[#222634] p-3 rounded-lg flex items-center justify-between gap-2.5">
                                                    <span id="crypto-wallet-address" class="text-xs font-mono text-[#00E5FF] break-all select-all font-semibold">
                                                        {cryptoWalletAddress}
                                                    </span>
                                                    <button
                                                        type="button"
                                                        id="btn-copy-wallet"
                                                        class="yg-btn-secondary text-xs px-3.5 py-2 shrink-0 flex items-center gap-1 font-mono"
                                                    >
                                                        <div class="i-lucide-copy text-xs text-[#00E5FF]"></div>
                                                        <span id="copy-wallet-label" data-i18n="order_pay.copy_wallet">Salin Alamat</span>
                                                    </button>
                                                </div>
                                            </div>

                                            {cryptoContractAddress && (
                                                <div class="bg-[#11131A]/60 border border-[#222634]/60 p-2.5 rounded text-[11px] font-mono flex items-center justify-between gap-2">
                                                    <span class="text-[#64748B]" data-i18n="order_pay.official_contract">Kontrak Resmi Token:</span>
                                                    <span class="text-[#94A3B8] font-mono font-medium truncate max-w-[220px]" title={cryptoContractAddress}>
                                                        {cryptoContractDisplay || cryptoContractAddress}
                                                    </span>
                                                </div>
                                            )}

                                            <div class="text-[10px] font-mono text-emerald-400 flex items-center gap-1.5 bg-emerald-500/10 border border-emerald-500/20 p-2.5 rounded">
                                                <div class="i-lucide-shield-check text-xs text-emerald-400"></div>
                                                <span data-i18n="order_pay.zero_trust_contract">Zero-Trust: Smart contract diverifikasi on-chain mencegah token palsu.</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="bg-[#0D0F15] border border-[#00E5FF]/40 p-5 rounded-xl space-y-3">
                                        <div class="flex items-center justify-between">
                                            <label for="tx-hash-input" class="text-xs font-bold text-[#F8FAFC] uppercase tracking-wider flex items-center gap-1.5 font-mono">
                                                <div class="i-lucide-hash text-[#00E5FF]"></div>
                                                <span data-i18n="order_pay.tx_hash_label">Masukkan Transaction Hash (TxID / TxHash)</span>
                                            </label>
                                            <span class="text-[10px] text-[#00E5FF] font-mono bg-[#00E5FF]/10 px-2 py-0.5 rounded border border-[#00E5FF]/25 font-semibold" data-i18n="order_pay.realtime_verify_tag">
                                                VERIFIKASI REAL-TIME
                                            </span>
                                        </div>

                                        <p class="text-[11px] text-[#94A3B8] font-mono leading-relaxed" data-i18n="order_pay.tx_hash_help">
                                            Setelah Anda melakukan transfer dari wallet (TrustWallet, MetaMask) atau exchange (Binance, Indodax, Tokocrypto, Bybit), salin dan tempelkan <strong>TxHash / TxID</strong> di bawah ini:
                                        </p>

                                        <div class="flex flex-col sm:flex-row gap-2.5 pt-1">
                                            <input
                                                type="text"
                                                id="tx-hash-input"
                                                placeholder={cryptoNetwork === "TRON_TRC20" ? "Contoh: 4a2b1c... (TxID 64-karakter)" : "Contoh: 0x1a2b3c... (TxHash 64-karakter)"}
                                                class="yg-input flex-1 font-mono text-xs text-[#00E5FF] tracking-wider"
                                                autocomplete="off"
                                                spellcheck="false"
                                            />
                                            <button
                                                type="button"
                                                id="btn-verify-crypto"
                                                class="yg-btn-primary px-5 py-3 text-xs font-mono font-bold tracking-wider shrink-0 flex items-center justify-center gap-2 cursor-pointer shadow-[0_0_20px_rgba(0,229,255,0.2)]"
                                            >
                                                <div id="verify-spinner" class="i-lucide-zap text-sm"></div>
                                                <span id="verify-btn-label" data-i18n="order_pay.verify_btn_idle">⚡ Verifikasi Pembayaran On-Chain</span>
                                            </button>
                                        </div>

