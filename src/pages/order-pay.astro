---
// src/pages/order-pay.astro
import { getOrder, updateOrder } from "../lib/wc";
import QRCode from "qrcode";

const orderId = Astro.url.searchParams.get("id");

if (!orderId) {
    return Astro.redirect("/cart");
}

let order = null;
let errorMsg = null;
let qrDataUrl = null;
let vaNumber = null;
let paymentMethod = "SP";
let paymentMethodName = "QRIS";
let paymentUrl = null;
let expiryTime = null;
let merchantOrderId = null;
let isExpired = false;

try {
    order = await getOrder(orderId);

    if (!order || !order.id) {
        errorMsg = "Pesanan tidak ditemukan di sistem.";
    } else if (order.status === "processing" || order.status === "completed") {
        return Astro.redirect(`/order-success?id=${order.id}`);
    } else {
        const meta = order.meta_data || [];
        const findMeta = (k) => meta.find(m => m.key === k)?.value;

        merchantOrderId = findMeta("_duitku_merchant_order_id");
        paymentMethod = findMeta("_duitku_payment_method") || "SP";
        paymentMethodName = findMeta("_duitku_payment_method_name") || "QRIS";
        vaNumber = findMeta("_duitku_va_number");
        const qrString = findMeta("_duitku_qr_string");
        paymentUrl = findMeta("_duitku_payment_url");

        // Perhitungan waktu kadaluarsa akurat (15 Menit dari pembuatan)
        const orderCreatedMs = new Date(order.date_created).getTime();
        const defaultExpiryMs = orderCreatedMs + 15 * 60 * 1000;
        expiryTime = findMeta("_duitku_expiry_time")
            ? Number(findMeta("_duitku_expiry_time"))
            : defaultExpiryMs;

        // Cek status kadaluarsa
        isExpired =
            Date.now() >= expiryTime ||
            order.status === "cancelled" ||
            order.status === "failed";

        // Jika sudah kadaluarsa tapi status masih pending di WooCommerce, update ke cancelled
        if (isExpired && (order.status === "pending" || order.status === "on-hold")) {
            try {
                await updateOrder(order.id, { status: "cancelled" });
                order.status = "cancelled";
            } catch (updateErr) {
                console.warn("Auto cancel expired order warning:", updateErr.message);
            }
        }

        if (qrString && !isExpired) {
            qrDataUrl = await QRCode.toDataURL(qrString, {
                width: 320,
                margin: 2,
                color: {
                    dark: "#000000",
                    light: "#ffffff"
                }
            });
        }
    }
} catch (e) {
    console.error("Order Pay Error:", e);
    errorMsg = e.message || "Gagal memuat detail pembayaran.";
}

const formattedTotal = order ? `Rp ${Number(order.total).toLocaleString("id-ID")}` : "Rp 0";
const isCard = paymentMethod === "VC" || paymentMethod === "credit_card" || paymentMethodName?.toLowerCase().includes("card") || paymentMethodName?.toLowerCase().includes("visa");
const isQris = !isCard && (!!qrDataUrl || paymentMethod === "SP" || paymentMethod === "LQ" || paymentMethod === "GQ");
const isVa = !isCard && !!vaNumber;
const lineItems = order?.line_items || [];
const firstItemName = lineItems[0]?.name || "Akun Game / Voucher";
---

<html lang="id" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{isExpired ? `[KADALUARSA] Pesanan #${orderId}` : `Pembayaran Pesanan #${orderId}`} - Yasui Game</title>
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&display=swap"
            rel="stylesheet"
        />
        <style>
            body {
                font-family: "JetBrains Mono", monospace;
                background-color: #050505;
                background-image:
                    linear-gradient(rgba(34, 211, 238, 0.04) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(34, 211, 238, 0.04) 1px, transparent 1px);
                background-size: 32px 32px;
            }

            .cyber-panel {
                clip-path: polygon(
                    0 0,
                    100% 0,
                    100% calc(100% - 16px),
                    calc(100% - 16px) 100%,
                    0 100%
                );
            }

            .radar-pulse {
                box-shadow: 0 0 0 0 rgba(34, 211, 238, 0.7);
                animation: pulse 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
            }

            .radar-pulse-red {
                box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
                animation: pulseRed 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
            }

            @keyframes pulse {
                to {
                    box-shadow: 0 0 0 16px rgba(34, 211, 238, 0);
                }
            }

            @keyframes pulseRed {
                to {
                    box-shadow: 0 0 0 16px rgba(239, 68, 68, 0);
                }
            }

            .scan-line {
                width: 100%;
                height: 3px;
                background: linear-gradient(90deg, transparent, #22d3ee, transparent);
                animation: scanMove 2.2s ease-in-out infinite alternate;
            }

            @keyframes scanMove {
                0% { transform: translateY(0); opacity: 0.3; }
                50% { opacity: 1; }
                100% { transform: translateY(270px); opacity: 0.3; }
            }
        </style>
    </head>
    <body class="bg-black text-gray-200 min-h-screen flex flex-col justify-between p-4 md:p-8">
        <!-- HEADER TOP -->
        <header class="max-w-2xl w-full mx-auto flex items-center justify-between pb-6 border-b border-gray-800">
            <div class="flex items-center gap-3">
                <a href="/" class="flex items-center gap-2 group">
                    <span class="text-xl font-black text-white italic tracking-wider">
                        YASUI<span class="text-cyan-400">GAME</span>
                    </span>
                </a>
                <span id="header-status-badge" class={`text-[10px] px-2 py-0.5 font-bold uppercase tracking-widest ${isExpired ? 'bg-red-950/80 text-red-400 border border-red-800/80' : 'bg-cyan-950/80 text-cyan-400 border border-cyan-800/80'}`}>
                    {isExpired ? 'GATEWAY KADALUARSA' : 'HEADLESS GATEWAY'}
                </span>
            </div>
            <div class="text-right">
                <span class="text-[10px] text-gray-500 uppercase block font-bold">Waktu Pembayaran</span>
                <div id="countdown-timer" class="text-sm font-black flex items-center justify-end gap-1.5 font-mono">
                    <div class={`i-lucide-clock text-xs ${isExpired ? 'text-red-500' : 'text-red-400 animate-pulse'}`}></div>
                    <span id="timer-text" class={isExpired ? 'text-red-500' : 'text-red-400'}>
                        {isExpired ? 'KADALUARSA' : '15:00'}
                    </span>
                </div>
            </div>
        </header>

        <!-- MAIN CONTAINER -->
        <main class="max-w-xl w-full mx-auto my-6">
            {errorMsg ? (
                <div class="cyber-panel bg-gray-900 border border-red-500/60 p-8 text-center shadow-[0_0_30px_rgba(239,68,68,0.2)]">
                    <div class="w-16 h-16 bg-red-950/60 border border-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-red-400 text-3xl">
                        <div class="i-lucide-alert-triangle"></div>
                    </div>
                    <h2 class="text-lg font-black text-white uppercase tracking-wider mb-2">Terjadi Kesalahan</h2>
                    <p class="text-xs text-gray-400 leading-relaxed mb-6 font-mono">{errorMsg}</p>
                    <a
                        href="/cart"
                        class="inline-block bg-red-500 text-black font-black uppercase text-xs px-6 py-3 tracking-widest hover:bg-white transition"
                    >
                        KEMBALI KE KERANJANG
                    </a>
                </div>
            ) : (
                <div>
                    <!-- ========================================== -->
                    <!-- PANEL 1: EXPIRED STATE (KADALUARSA)       -->
                    <!-- ========================================== -->
                    <div id="expired-payment-container" class={isExpired ? "" : "hidden"}>
                        <div class="cyber-panel bg-gray-900/90 border border-red-500/60 p-6 md:p-8 relative shadow-[0_0_50px_rgba(239,68,68,0.25)] text-center">
                            <!-- Sudut Aksen Merah -->
                            <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-red-500 pointer-events-none"></div>
                            <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-red-500 pointer-events-none"></div>

                            <!-- Ikon Status -->
                            <div class="w-20 h-20 bg-red-950/80 border-2 border-red-500/80 rounded-full flex items-center justify-center mx-auto mb-4 text-red-500 text-4xl shadow-[0_0_30px_rgba(239,68,68,0.35)] radar-pulse-red">
                                <div class="i-lucide-clock-alert"></div>
                            </div>

                            <div class="inline-flex items-center gap-2 bg-red-950/80 border border-red-500/50 px-3 py-1 rounded-full mb-3">
                                <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
                                <span class="text-[10px] text-red-400 font-bold uppercase tracking-widest font-mono">
                                    STATUS: TRANSAKSI KADALUARSA
                                </span>
                            </div>

                            <h1 class="text-xl md:text-2xl font-black text-white uppercase tracking-wider mb-2">
                                Waktu Pembayaran Telah Habis
                            </h1>
                            <p class="text-xs text-gray-400 max-w-md mx-auto leading-relaxed mb-6 font-mono">
                                Sesi pembayaran untuk Pesanan <span class="text-red-400 font-bold">#{order.id}</span> telah melewati batas waktu 15 menit. Kode QRIS / Nomor VA ini telah otomatis dinonaktifkan oleh gateway pembayaran.
                            </p>

                            <!-- Peringatan Keamanan -->
                            <div class="bg-black/70 border-l-4 border-red-500 p-4 text-left max-w-md mx-auto mb-6 text-xs font-mono space-y-1">
                                <div class="text-red-400 font-bold flex items-center gap-1.5">
                                    <div class="i-lucide-shield-alert text-sm"></div> PERINGATAN SISTEM:
                                </div>
                                <p class="text-gray-400 text-[11px] leading-relaxed">
                                    Jangan melakukan pembayaran ke kode ini lagi. Dana yang ditransfer ke kode yang sudah kadaluarsa tidak dapat terverifikasi secara otomatis.
                                </p>
                            </div>

                            <!-- Ringkasan Order -->
                            <div class="bg-black/50 border border-gray-800 p-3.5 rounded-lg max-w-md mx-auto mb-6 text-xs font-mono flex justify-between items-center">
                                <div class="text-left">
                                    <span class="text-gray-500 block text-[10px]">TOTAL TAGIHAN</span>
                                    <span class="text-white font-bold">{formattedTotal}</span>
                                </div>
                                <div class="text-right">
                                    <span class="text-gray-500 block text-[10px]">PRODUK</span>
                                    <span class="text-gray-300 font-bold truncate max-w-[180px]">{firstItemName}</span>
                                </div>
                            </div>

                            <!-- Tombol Aksi Pesan Ulang & Navigasi -->
                            <div class="space-y-3 max-w-md mx-auto">
                                <button
                                    type="button"
                                    onclick="reorderThisOrder()"
                                    class="w-full bg-red-500 hover:bg-white hover:text-black text-black font-black uppercase py-3.5 rounded text-xs tracking-wider transition shadow-[0_0_20px_rgba(239,68,68,0.3)] flex items-center justify-center gap-2 cursor-pointer"
                                >
                                    <div class="i-lucide-refresh-cw text-sm"></div>
                                    <span>⚡ PESAN ULANG (BUAT KODE PEMBAYARAN BARU)</span>
                                </button>

                                <div class="grid grid-cols-2 gap-2">
                                    <a
                                        href="/orders"
                                        class="bg-gray-800 hover:bg-gray-700 text-white font-bold uppercase text-[11px] py-2.5 px-4 rounded border border-gray-700 text-center transition flex items-center justify-center gap-1.5 font-mono"
                                    >
                                        <div class="i-lucide-receipt text-xs text-cyan-400"></div> Riwayat Pesanan
                                    </a>
                                    <a
                                        href="/"
                                        class="bg-gray-800 hover:bg-gray-700 text-gray-300 font-bold uppercase text-[11px] py-2.5 px-4 rounded border border-gray-700 text-center transition flex items-center justify-center gap-1.5 font-mono"
                                    >
                                        <div class="i-lucide-home text-xs"></div> Beranda
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- PANEL 2: ACTIVE PAYMENT (AKTIF & VALID)   -->
                    <!-- ========================================== -->
                    <div id="active-payment-container" class={isExpired ? "hidden" : "space-y-6"}>
                        <!-- STATUS BANNER -->
                        <div class="bg-gray-900/60 border border-cyan-500/30 p-4 rounded flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-3 h-3 rounded-full bg-cyan-400 radar-pulse"></div>
                                <div>
                                    <h1 class="text-xs font-bold text-white uppercase tracking-widest">
                                        MENUNGGU PEMBAYARAN
                                    </h1>
                                    <p class="text-[10px] text-gray-400 font-mono">
                                        Pesanan #{order.id} • {paymentMethodName}
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] text-gray-500 uppercase block">Total Bayar</span>
                                <span class="text-base font-black text-cyan-400 font-mono">
                                    {formattedTotal}
                                </span>
                            </div>
                        </div>

                        <!-- CARD PEMBAYARAN UTAMA -->
                        <div class="cyber-panel bg-gray-900/80 border border-gray-800 p-6 md:p-8 relative shadow-[0_0_40px_rgba(0,0,0,0.8)]">
                            <!-- Sudut Aksen Cyan -->
                            <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-cyan-400 pointer-events-none"></div>
                            <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-cyan-400 pointer-events-none"></div>

                            {/* TAMPILAN 1: QRIS */}
                            {isQris && (
                                <div class="flex flex-col items-center text-center">
                                    <div class="inline-flex items-center gap-2 bg-black/60 border border-cyan-400/40 px-3 py-1 rounded-full mb-4">
                                        <div class="i-lucide-qr-code text-cyan-400 text-sm"></div>
                                        <span class="text-[10px] text-cyan-300 font-bold uppercase tracking-wider">
                                            Scan dengan QRIS Bebas Biaya
                                        </span>
                                    </div>

                                    <!-- QR CODE BOX -->
                                    <div class="relative bg-white p-4 rounded-xl shadow-[0_0_30px_rgba(34,211,238,0.25)] border-4 border-cyan-400/80 overflow-hidden group">
                                        <div class="scan-line absolute top-0 left-0 right-0 pointer-events-none z-10"></div>
                                        {qrDataUrl ? (
                                            <img
                                                src={qrDataUrl}
                                                id="qris-image"
                                                alt="QRIS Payment"
                                                class="w-64 h-64 md:w-72 md:h-72 object-contain"
                                            />
                                        ) : (
                                            <div class="w-64 h-64 flex items-center justify-center text-gray-400 font-mono text-xs">
                                                Generating QRIS...
                                            </div>
                                        )}
                                    </div>

                                    <!-- AKSI QRIS -->
                                    <div class="mt-4 flex items-center gap-3 w-full max-w-xs justify-center">
                                        {qrDataUrl && (
                                            <a
                                                href={qrDataUrl}
                                                download={`QRIS-YASUI-${order.id}.png`}
                                                class="w-full bg-gray-800 hover:bg-gray-700 text-white text-xs font-bold py-2.5 px-4 rounded border border-gray-700 flex items-center justify-center gap-2 transition"
                                            >
                                                <div class="i-lucide-download text-sm text-cyan-400"></div> Simpan Gambar QR
                                            </a>
                                        )}
                                    </div>

                                    <!-- PANDUAN APLIKASI -->
                                    <div class="mt-6 pt-6 border-t border-gray-800/80 w-full text-left">
                                        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                            <div class="i-lucide-smartphone text-cyan-400"></div> Mendukung Semua Aplikasi:
                                        </p>
                                        <div class="flex flex-wrap gap-1.5">
                                            {["BCA Mobile", "GoPay", "OVO", "DANA", "ShopeePay", "Livin Mandiri", "BRImo", "BNI Mobile", "LinkAja"].map((app) => (
                                                <span class="text-[10px] bg-black/60 text-gray-400 border border-gray-800 px-2 py-1 rounded font-mono">
                                                    {app}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            )}

                            {/* TAMPILAN 2: VIRTUAL ACCOUNT */}
                            {isVa && (
                                <div class="space-y-6">
                                    <div class="text-center">
                                        <span class="text-[11px] text-gray-400 uppercase tracking-widest font-bold block mb-1">
                                            Nomor Virtual Account {paymentMethodName}
                                        </span>
                                        <p class="text-xs text-gray-500 font-mono mb-4">
                                            Transfer tepat sesuai nominal tagihan agar diverifikasi otomatis.
                                        </p>

                                        <!-- VA NUMBER BOX -->
                                        <div class="bg-black/90 border-2 border-cyan-400/80 p-4 rounded-lg flex items-center justify-between gap-3 shadow-[0_0_25px_rgba(34,211,238,0.2)]">
                                            <span id="va-number" class="text-xl md:text-2xl font-black text-cyan-400 tracking-widest font-mono select-all">
                                                {vaNumber}
                                            </span>
                                            <button
                                                type="button"
                                                onclick="copyVaNumber()"
                                                id="btn-copy-va"
                                                class="bg-cyan-400 hover:bg-white text-black font-black text-xs px-3.5 py-2 rounded uppercase flex items-center gap-1.5 transition flex-shrink-0"
                                            >
                                                <div class="i-lucide-copy text-sm"></div>
                                                <span id="copy-text">SALIN</span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- DETAIL PEMBAYARAN -->
                                    <div class="bg-black/40 border border-gray-800 p-4 rounded space-y-2 text-xs font-mono">
                                        <div class="flex justify-between py-1 border-b border-gray-800/60">
                                            <span class="text-gray-500">Nama Penerima:</span>
                                            <span class="text-gray-300 font-bold">YASUI GAME / DUITKU</span>
                                        </div>
                                        <div class="flex justify-between py-1 border-b border-gray-800/60">
                                            <span class="text-gray-500">Total Pembayaran:</span>
                                            <span class="text-cyan-400 font-black">{formattedTotal}</span>
                                        </div>
                                        <div class="flex justify-between py-1">
                                            <span class="text-gray-500">Status Tagihan:</span>
                                            <span class="text-yellow-400 font-bold uppercase">MENUNGGU TRANSFER</span>
                                        </div>
                                    </div>

                                    <!-- CARA TRANSFER -->
                                    <div class="border-t border-gray-800 pt-4 text-xs text-gray-400 space-y-2">
                                        <p class="font-bold text-gray-300 uppercase tracking-wider text-[11px]">
                                            Cara Pembayaran via M-Banking:
                                        </p>
                                        <ol class="list-decimal list-inside space-y-1 text-[11px] leading-relaxed font-mono">
                                            <li>Buka aplikasi Mobile Banking pilihan Anda.</li>
                                            <li>Pilih menu <strong>Transfer ➔ Virtual Account</strong>.</li>
                                            <li>Masukkan nomor VA di atas (<code class="text-cyan-400">{vaNumber}</code>).</li>
                                            <li>Periksa nama penerima dan nominal tagihan (<strong class="text-white">{formattedTotal}</strong>).</li>
                                            <li>Konfirmasi dan selesaikan transaksi dengan PIN Anda.</li>
                                        </ol>
                                    </div>
                                </div>
                            )}

                            {/* TAMPILAN 3: KARTU KREDIT / DEBIT INTERNASIONAL (3D-SECURE) */}
                            {isCard && (
                                <div class="space-y-6">
                                    <div class="text-center">
                                        <div class="inline-flex items-center gap-2 bg-black/60 border border-cyan-400/40 px-3 py-1 rounded-full mb-3">
                                            <div class="i-lucide-credit-card text-cyan-400 text-sm"></div>
                                            <span class="text-[10px] text-cyan-300 font-bold uppercase tracking-wider font-mono">
                                                3D-SECURE 2.0 PROTECTED GATEWAY
                                            </span>
                                        </div>
                                        <h2 class="text-base md:text-lg font-black text-white uppercase tracking-wider">
                                            Pembayaran Kartu Kredit / Debit Global
                                        </h2>
                                        <p class="text-xs text-gray-400 max-w-md mx-auto font-mono mt-1 leading-relaxed">
                                            Mendukung kartu Visa, Mastercard, dan JCB dari seluruh dunia dengan enkripsi 256-bit standar PCI-DSS Level 1.
                                        </p>
                                    </div>

                                    <!-- BADGES JARINGAN KARTU INTERNASIONAL -->
                                    <div class="flex items-center justify-center gap-2.5 py-3 border-y border-gray-800/80 bg-black/40 flex-wrap">
                                        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded bg-gray-900 border border-gray-800 text-xs font-black tracking-wider text-blue-400 font-mono">
                                            VISA
                                        </div>
                                        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded bg-gray-900 border border-gray-800 text-xs font-black tracking-wider text-red-400 font-mono">
                                            Mastercard
                                        </div>
                                        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded bg-gray-900 border border-gray-800 text-xs font-black tracking-wider text-green-400 font-mono">
                                            JCB
                                        </div>
                                        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded bg-gray-900 border border-gray-800 text-xs font-black tracking-wider text-cyan-400 font-mono">
                                            AMEX
                                        </div>
                                    </div>

                                    <!-- DETAIL TAGIHAN KARTU -->
                                    <div class="bg-black/60 border border-gray-800 p-4 rounded-lg space-y-2.5 text-xs font-mono">
                                        <div class="flex justify-between py-1 border-b border-gray-800/60">
                                            <span class="text-gray-500">Nomor Pesanan:</span>
                                            <span class="text-white font-bold">#{order.id}</span>
                                        </div>
                                        <div class="flex justify-between py-1 border-b border-gray-800/60">
                                            <span class="text-gray-500">Total Tagihan (IDR):</span>
                                            <span class="text-cyan-400 font-black text-sm">{formattedTotal}</span>
                                        </div>
                                        <div class="flex justify-between py-1 border-b border-gray-800/60">
                                            <span class="text-gray-500">Estimasi Valuta Asing:</span>
                                            <span class="text-gray-300 font-mono">
                                                ≈ ${(Number(order.total) / 16000).toFixed(2)} USD
                                            </span>
                                        </div>
                                        <div class="flex justify-between py-1">
                                            <span class="text-gray-500">Protokol Keamanan:</span>
                                            <span class="text-green-400 font-bold flex items-center gap-1">
                                                <div class="i-lucide-shield-check text-xs"></div> 3D Secure OTP & PCI-DSS
                                            </span>
                                        </div>
                                    </div>

                                    <!-- ACTION BUTTON KE DUITKU 3D SECURE -->
                                    <div class="space-y-3">
                                        <a
                                            href={paymentUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="w-full bg-cyan-400 hover:bg-white text-black font-black uppercase py-4 rounded text-xs tracking-widest transition shadow-[0_0_25px_rgba(34,211,238,0.35)] flex items-center justify-center gap-2 group cursor-pointer"
                                        >
                                            <div class="i-lucide-lock text-sm"></div>
                                            <span>LANJUTKAN KE PEMBAYARAN KARTU (3D-SECURE)</span>
                                            <div class="i-lucide-external-link text-sm group-hover:translate-x-0.5 transition"></div>
                                        </a>

                                        <p class="text-[11px] text-gray-500 text-center font-mono leading-relaxed">
                                            Portal pembayaran resmi Duitku akan terbuka di tab baru. Setelah menyelesaikan input nomor kartu dan verifikasi OTP, halaman ini akan otomatis mendeteksi konfirmasi transaksi Anda tanpa perlu dimuat ulang.
                                        </p>
                                    </div>

                                    <!-- KEUNGGULAN KEAMANAN -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2 text-[11px] font-mono">
                                        <div class="bg-gray-900/50 border border-gray-800 p-3 rounded flex items-start gap-2.5">
                                            <div class="i-lucide-shield-check text-cyan-400 text-base flex-shrink-0 mt-0.5"></div>
                                            <div>
                                                <span class="text-white font-bold block">Tanpa Penyimpanan Data</span>
                                                <span class="text-gray-500">Yasui Game tidak pernah menyimpan data CVV maupun nomor kartu Anda.</span>
                                            </div>
                                        </div>
                                        <div class="bg-gray-900/50 border border-gray-800 p-3 rounded flex items-start gap-2.5">
                                            <div class="i-lucide-refresh-cw text-cyan-400 text-base flex-shrink-0 mt-0.5"></div>
                                            <div>
                                                <span class="text-white font-bold block">Auto-Sync Transaksi</span>
                                                <span class="text-gray-500">Status pesanan otomatis diverifikasi sistem secara real-time.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            )}

                            {/* TAMPILAN 4: ALTERNATIF / DIRECT PAYMENT URL LAINNYA */}
                            {!isQris && !isVa && !isCard && paymentUrl && (
                                <div class="text-center py-6 space-y-4">
                                    <div class="w-16 h-16 bg-cyan-950/80 border border-cyan-400 rounded-full flex items-center justify-center mx-auto text-cyan-400 text-3xl">
                                        <div class="i-lucide-external-link"></div>
                                    </div>
                                    <h3 class="text-sm font-bold text-white uppercase tracking-wider">
                                        Selesaikan di Gateway Pembayaran
                                    </h3>
                                    <p class="text-xs text-gray-400 max-w-sm mx-auto font-mono">
                                        Metode pembayaran ini membutuhkan otorisasi langsung di aplikasi pihak ketiga.
                                    </p>
                                    <a
                                        href={paymentUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-2 bg-cyan-400 text-black font-black uppercase text-xs px-6 py-3.5 tracking-widest hover:bg-white transition shadow-[0_0_20px_rgba(34,211,238,0.3)]"
                                    >
                                        BUKA PEMBAYARAN SEKARANG <div class="i-lucide-arrow-right text-sm"></div>
                                    </a>
                                </div>
                            )}

                            <!-- LIVE AUTO-VERIFICATION BAR -->
                            <div class="mt-8 pt-6 border-t border-gray-800/80 flex flex-col md:flex-row items-center justify-between gap-4">
                                <div class="flex items-center gap-2.5 text-xs text-gray-400 font-mono">
                                    <div class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></div>
                                    <span id="polling-label">Mendeteksi transaksi masuk secara otomatis...</span>
                                </div>

                                <button
                                    type="button"
                                    id="btn-manual-check"
                                    onclick="checkPaymentStatus(true)"
                                    class="w-full md:w-auto bg-gray-800 hover:bg-cyan-400 hover:text-black text-cyan-400 font-bold uppercase text-[11px] px-4 py-2.5 rounded border border-cyan-500/40 transition flex items-center justify-center gap-2 font-mono"
                                >
                                    <div id="check-icon" class="i-lucide-refresh-cw text-xs"></div>
                                    <span>CEK STATUS SEKARANG</span>
                                </button>
                            </div>
                        </div>

                        <!-- RINGKASAN ITEM & BATAL -->
                        <div class="flex items-center justify-between text-xs text-gray-500 px-2 font-mono">
                            <a href="/cart" class="hover:text-red-400 transition flex items-center gap-1">
                                <div class="i-lucide-arrow-left text-xs"></div> Batal & Ubah Pesanan
                            </a>
                            <span class="text-gray-600">ID Referensi: {merchantOrderId || order.id}</span>
                        </div>
                    </div>
                </div>
            )}
        </main>

        <!-- FOOTER -->
        <footer class="max-w-2xl w-full mx-auto text-center pt-6 border-t border-gray-900 text-[11px] text-gray-600 font-mono">
            &copy; {new Date().getFullYear()} Yasui Game • 256-Bit SSL Encrypted Gaming Marketplace
        </footer>

        <!-- DATA ITEMS PESANAN UNTUK FITUR REORDER -->
        <script id="order-items-json" type="application/json" set:html={JSON.stringify(lineItems.map(item => ({
            id: item.product_id || item.id,
            productId: item.product_id || item.id,
            name: item.name,
            price: item.price || item.total,
            quantity: item.quantity || 1,
            image: item.image?.src || null
        })))}></script>

        <!-- CLIENT SCRIPTS -->
        <script is:inline define:vars={{ orderId, expiryTime, isExpired }}>
            let isChecking = false;
            let checkInterval = null;

            // 1. SALIN NOMOR VA
            window.copyVaNumber = function () {
                const vaEl = document.getElementById("va-number");
                const textEl = document.getElementById("copy-text");
                const btnEl = document.getElementById("btn-copy-va");

                if (!vaEl) return;
                const textToCopy = vaEl.innerText.trim();

                navigator.clipboard.writeText(textToCopy).then(() => {
                    textEl.innerText = "TERSALIN!";
                    btnEl.classList.remove("bg-cyan-400");
                    btnEl.classList.add("bg-green-400");
                    setTimeout(() => {
                        textEl.innerText = "SALIN";
                        btnEl.classList.add("bg-cyan-400");
                        btnEl.classList.remove("bg-green-400");
                    }, 2500);
                });
            };

            // 2. REORDER / PESAN ULANG DARI HALAMAN INI
            window.reorderThisOrder = function () {
                try {
                    const raw = document.getElementById("order-items-json")?.textContent;
                    const items = raw ? JSON.parse(raw) : [];
                    const currentCart = JSON.parse(localStorage.getItem("yasui_cart") || "[]");

                    items.forEach(item => {
                        const targetId = String(item.productId || item.id);
                        const existingIdx = currentCart.findIndex(c => String(c.id) === targetId);
                        if (existingIdx >= 0) {
                            currentCart[existingIdx].quantity = (currentCart[existingIdx].quantity || 1) + (item.quantity || 1);
                            currentCart[existingIdx].selected = true;
                        } else {
                            currentCart.push({
                                id: targetId,
                                name: item.name,
                                price: item.price,
                                rawPrice: item.price,
                                quantity: item.quantity || 1,
                                selected: true,
                                image: item.image ? { sourceUrl: item.image } : null
                            });
                        }
                    });

                    localStorage.setItem("yasui_cart", JSON.stringify(currentCart));
                    window.location.href = "/checkout";
                } catch (e) {
                    console.error("Reorder error:", e);
                    window.location.href = "/cart";
                }
            };

            // 3. TRANSISI KADALUARSA DI SISI CLIENT
            function triggerClientExpiry() {
                if (checkInterval) clearInterval(checkInterval);

                const activeContainer = document.getElementById("active-payment-container");
                const expiredContainer = document.getElementById("expired-payment-container");
                const headerBadge = document.getElementById("header-status-badge");
                const timerText = document.getElementById("timer-text");

                if (activeContainer) activeContainer.classList.add("hidden");
                if (expiredContainer) expiredContainer.classList.remove("hidden");

                if (headerBadge) {
                    headerBadge.className = "text-[10px] px-2 py-0.5 font-bold uppercase tracking-widest bg-red-950/80 text-red-400 border border-red-800/80";
                    headerBadge.innerText = "GATEWAY KADALUARSA";
                }

                if (timerText) {
                    timerText.className = "text-red-500";
                    timerText.innerText = "KADALUARSA";
                }

                // Kirim signal ke server untuk update status WooCommerce ke cancelled
                fetch(`/api/payment/check-status?id=${orderId}`).catch(() => {});
            }

            // 4. COUNTDOWN TIMER
            function initCountdown() {
                if (isExpired) return;

                const timerText = document.getElementById("timer-text");
                if (!timerText) return;

                const targetTime = Number(expiryTime) || (Date.now() + 15 * 60 * 1000);

                const updateTimer = () => {
                    const diff = Math.max(0, targetTime - Date.now());
                    const mins = Math.floor(diff / 60000);
                    const secs = Math.floor((diff % 60000) / 1000);

                    timerText.innerText = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;

                    if (diff <= 0) {
                        triggerClientExpiry();
                    }
                };

                updateTimer();
                const timerInterval = setInterval(() => {
                    const diff = targetTime - Date.now();
                    if (diff <= 0) {
                        clearInterval(timerInterval);
                        triggerClientExpiry();
                    } else {
                        updateTimer();
                    }
                }, 1000);
            }

            // 5. REALTIME STATUS POLLING
            window.checkPaymentStatus = async function (isManual = false) {
                if (isChecking || isExpired) return;
                isChecking = true;

                const checkIcon = document.getElementById("check-icon");
                const pollingLabel = document.getElementById("polling-label");

                if (checkIcon) checkIcon.classList.add("animate-spin");
                if (isManual && pollingLabel) pollingLabel.innerText = "Memeriksa status ke Duitku...";

                try {
                    const res = await fetch(`/api/payment/check-status?id=${orderId}`);
                    const data = await res.json();

                    if (data.success && data.status === "paid") {
                        if (pollingLabel) pollingLabel.innerText = "Pembayaran Dikonfirmasi! Mengalihkan...";
                        // Hapus isi keranjang lokal
                        localStorage.removeItem("yasui_cart");

                        // Transisi ke halaman sukses
                        setTimeout(() => {
                            window.location.href = `/order-success?id=${orderId}`;
                        }, 800);
                        return;
                    } else if (data.status === "expired" || data.status === "failed") {
                        triggerClientExpiry();
                        return;
                    } else {
                        if (isManual && pollingLabel) {
                            pollingLabel.innerText = "Pembayaran belum terdeteksi. Silakan coba sesaat lagi.";
                            setTimeout(() => {
                                pollingLabel.innerText = "Mendeteksi transaksi masuk secara otomatis...";
                            }, 3000);
                        }
                    }
                } catch (err) {
                    console.error("Gagal memeriksa status:", err);
                } finally {
                    isChecking = false;
                    if (checkIcon) checkIcon.classList.remove("animate-spin");
                }
            };

            // Start Polling & Timer
            if (!isExpired) {
                initCountdown();
                // Polling otomatis setiap 4 detik
                checkInterval = setInterval(() => {
                    checkPaymentStatus(false);
                }, 4000);
            }
        </script>
    </body>
</html>
