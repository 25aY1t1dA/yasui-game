                                        </div>
                                        <div class="flex justify-between py-1 border-b border-[#222634]/60">
                                            <span class="text-[#64748B]" data-i18n="order_pay.total_bill">Total Tagihan (IDR):</span>
                                            <span class="text-[#00E5FF] font-bold tabular-nums">{formattedTotal}</span>
                                        </div>
                                        <div class="flex justify-between py-1 border-b border-[#222634]/60">
                                            <span class="text-[#64748B]">Estimasi Valuta Asing:</span>
                                            <span class="text-[#94A3B8] tabular-nums">
                                                ≈ ${(Number(order.total) / IDR_TO_USD_RATE).toFixed(2)} USD
                                            </span>
