                                        Metode pembayaran ini membutuhkan otorisasi langsung di portal Duitku.
                                    </p>
                                    <a
                                        href={paymentUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="yg-btn-primary inline-flex items-center gap-2 text-xs px-6 py-3 tracking-wider font-mono"
                                    >
                                        Buka Pembayaran Sekarang <div class="i-lucide-arrow-right text-sm"></div>
                                    </a>
                                </div>
                            )}

                            <div class="mt-8 pt-6 border-t border-[#222634] flex flex-col md:flex-row items-center justify-between gap-4">
                                <div class="flex items-center gap-2 text-xs text-[#94A3B8] font-mono">
                                    <div class="w-2 h-2 rounded-full bg-[#00E5FF] animate-ping"></div>
                                    <span id="polling-label" data-i18n="order_pay.polling_detecting">Mendeteksi transaksi masuk secara otomatis...</span>
                                </div>

                                <button
                                    type="button"
                                    id="btn-manual-check"
                                    class="w-full md:w-auto yg-btn-secondary text-[11px] px-4 py-2 flex items-center justify-center gap-2 font-mono"
                                >
                                    <div id="check-icon" class="i-lucide-refresh-cw text-xs text-[#00E5FF]"></div>
                                    <span data-i18n="order_pay.check_status_btn">Cek Status Sekarang</span>
                                </button>
                            </div>

                            <div class="mt-4 pt-4 border-t border-[#222634]/70 flex flex-col sm:flex-row items-center justify-between gap-3 bg-[#0D0F15] p-3 rounded-lg border border-[#222634]">
                                <div class="flex items-center gap-2 text-xs text-[#94A3B8] font-mono text-center sm:text-left">
                                    <div class="i-lucide-shield-question text-base text-[#00E5FF] shrink-0"></div>
                                    <span data-i18n="order_pay.help_prompt">Kendala pembayaran atau ingin konfirmasi manual?</span>
                                </div>
                                <button
                                    type="button"
                                    onclick={`window.openLiveChatModal && window.openLiveChatModal('Pesanan #${order?.id}', '${order?.id}')`}
                                    class="w-full sm:w-auto yg-btn-secondary text-xs py-2 px-3.5 flex items-center justify-center gap-1.5 font-mono cursor-pointer shrink-0 border-[#00E5FF]/40 text-[#00E5FF] hover:bg-[#00E5FF]/10"
                                >
                                    <div class="i-lucide-headset text-xs text-[#00E5FF]"></div>
                                    <span data-i18n="chat.order_help_btn">Butuh Bantuan untuk Order Ini? Chat Admin</span>
                                </button>
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-xs text-[#64748B] px-1 font-mono">
                            <a href="/cart" class="hover:text-red-400 transition-colors flex items-center gap-1">
                                <div class="i-lucide-arrow-left text-xs"></div> <span data-i18n="order_pay.cancel_order">Batal & Ubah Pesanan</span>
                            </a>
                            <span><span data-i18n="order_pay.ref_id">ID Referensi:</span> #{merchantOrderId || order.id}</span>
                        </div>
                    </div>
                </div>
            )}
        </main>

        <footer class="text-center pt-6 border-t border-[#222634] text-[11px] text-[#64748B] font-mono">
            &copy; {new Date().getFullYear()} Yasui Game • 256-Bit SSL Encrypted Gaming Marketplace
        </footer>
    </div>

    <script id="order-items-json" type="application/json" set:html={JSON.stringify(lineItems.map(item => ({
        id: item.product_id || item.id,
        productId: item.product_id || item.id,
        name: item.name,
        price: item.price || item.total,
        quantity: item.quantity || 1,
        image: item.image?.src || null
    })))}></script>

    <script is:inline define:vars={{ orderId, orderKey, expiryTime, isExpired, isCrypto, cryptoExpectedAmount, cryptoWalletAddress }}>
        let isChecking = false;
        let checkInterval = null;

        const t = (key, fallback) => {
            if (typeof window !== "undefined" && typeof window.t === "function") {
                return window.t(key, fallback);
            }
            return fallback !== undefined ? fallback : key;
        };

        // Auto-register order to recent orders for contextual chat
        try {
            if (orderId) {
                const rec = JSON.parse(localStorage.getItem("yasui_recent_orders") || "[]");
                const cleanId = String(orderId).trim();
                if (!rec.includes(cleanId)) {
                    rec.unshift(cleanId);
                    localStorage.setItem("yasui_recent_orders", JSON.stringify(rec.slice(0, 10)));
                }
            }
        } catch (e) {}

        function copyVaNumber() {
            const vaEl = document.getElementById("va-number");
            const textEl = document.getElementById("copy-text");
            const btnEl = document.getElementById("btn-copy-va");

            if (!vaEl) return;
            const textToCopy = vaEl.innerText.trim();

            navigator.clipboard.writeText(textToCopy).then(() => {
                if (textEl) textEl.innerText = t("order_pay.copied", "TERSALIN!");
                btnEl?.classList.remove("bg-cyan-400");
                btnEl?.classList.add("bg-green-400");
                setTimeout(() => {
                    if (textEl) textEl.innerText = t("order_pay.copy_va", "Salin Nomor VA");
                    btnEl?.classList.add("bg-cyan-400");
                    btnEl?.classList.remove("bg-green-400");
                }, 2500);
            });
        }

        function copyCryptoAmount() {
            const btnEl = document.getElementById("btn-copy-amount");
            const labelEl = document.getElementById("copy-amount-label");
            const textToCopy = String(cryptoExpectedAmount || document.getElementById("crypto-exact-amount")?.innerText || "").trim();
            if (!textToCopy) return;

            navigator.clipboard.writeText(textToCopy).then(() => {
                if (labelEl) labelEl.innerText = t("order_pay.copied", "TERSALIN!");
                btnEl?.classList.remove("yg-btn-primary");
                btnEl?.classList.add("bg-emerald-500", "text-black");
                setTimeout(() => {
                    if (labelEl) labelEl.innerText = t("order_pay.copy_amount", "Salin Nominal");
                    btnEl?.classList.remove("bg-emerald-500", "text-black");
                    btnEl?.classList.add("yg-btn-primary");
                }, 2500);
            });
        }

        function copyCryptoWallet() {
            const btnEl = document.getElementById("btn-copy-wallet");
            const labelEl = document.getElementById("copy-wallet-label");
            const textToCopy = String(cryptoWalletAddress || document.getElementById("crypto-wallet-address")?.innerText || "").trim();
            if (!textToCopy) return;

            navigator.clipboard.writeText(textToCopy).then(() => {
                if (labelEl) labelEl.innerText = t("order_pay.copied", "TERSALIN!");
                btnEl?.classList.remove("yg-btn-secondary");
                btnEl?.classList.add("bg-emerald-500", "text-black");
                setTimeout(() => {
                    if (labelEl) labelEl.innerText = t("order_pay.copy_wallet", "Salin Alamat");
                    btnEl?.classList.remove("bg-emerald-500", "text-black");
                    btnEl?.classList.add("yg-btn-secondary");
                }, 2500);
            });
        }

        async function verifyCryptoOnChain() {
            const txInput = document.getElementById("tx-hash-input");
            const feedbackEl = document.getElementById("crypto-verify-feedback");
            const verifyBtn = document.getElementById("btn-verify-crypto");
            const btnLabel = document.getElementById("verify-btn-label");
            const spinner = document.getElementById("verify-spinner");

            if (!txInput) return;
            const txHash = txInput.value.trim();

            if (!txHash) {
                if (feedbackEl) {
                    feedbackEl.className = "text-xs font-mono p-3 rounded-lg border bg-rose-950/80 border-rose-500/50 text-rose-300 block";
                    feedbackEl.innerText = t("order_pay.verify_msg_empty", "⚠️ Harap masukkan Transaction Hash (TxID / TxHash) Anda terlebih dahulu.");
                }
                txInput.focus();
                return;
            }

            if (verifyBtn) verifyBtn.setAttribute("disabled", "true");
            if (spinner) spinner.className = "i-lucide-loader-2 text-sm animate-spin";
            if (btnLabel) btnLabel.innerText = t("order_pay.verify_btn_loading", "Memverifikasi di Blockchain...");
            if (feedbackEl) {
                feedbackEl.className = "text-xs font-mono p-3 rounded-lg border bg-cyan-950/80 border-[#00E5FF]/40 text-[#00E5FF] block";
                feedbackEl.innerText = t("order_pay.verify_msg_connecting", "⏳ Sedang menghubungi node blockchain & memvalidasi bukti transfer...");
            }

            try {
                const res = await fetch("/api/payment/verify-crypto", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        orderId: orderId,
                        orderKey: orderKey,
                        txHash: txHash
                    })
                });
                const data = await res.json();

                if (data.success) {
                    if (feedbackEl) {
                        feedbackEl.className = "text-xs font-mono p-3 rounded-lg border bg-emerald-950/80 border-emerald-500/50 text-emerald-300 block";
                        feedbackEl.innerText = t("order_pay.verify_msg_success", "✅ SUKSES! Pembayaran on-chain berhasil diverifikasi! Mengalihkan...");
                    }
                    try { localStorage.removeItem("yasui_cart"); } catch (e) {}
                    setTimeout(() => {
                        window.location.href = data.redirectUrl || `/order-success?id=${orderId}&key=${encodeURIComponent(orderKey)}`;
                    }, 1200);
                } else {
                    if (feedbackEl) {
                        feedbackEl.className = "text-xs font-mono p-3 rounded-lg border bg-rose-950/80 border-rose-500/50 text-rose-300 block";
                        feedbackEl.innerText = (t("order_pay.verify_msg_fail", "❌ Verifikasi Gagal: ")) + (data.error || "Transaksi tidak valid atau belum terkonfirmasi.");
                    }
                    if (verifyBtn) verifyBtn.removeAttribute("disabled");
                    if (spinner) spinner.className = "i-lucide-zap text-sm";
                    if (btnLabel) btnLabel.innerText = t("order_pay.verify_btn_idle", "⚡ Verifikasi Pembayaran On-Chain");
                }
            } catch (err) {
                console.error("Crypto verification error:", err);
                if (feedbackEl) {
                    feedbackEl.className = "text-xs font-mono p-3 rounded-lg border bg-rose-950/80 border-rose-500/50 text-rose-300 block";
                    feedbackEl.innerText = t("order_pay.verify_msg_net_err", "❌ Terjadi gangguan jaringan saat memverifikasi on-chain. Silakan coba lagi.");
                }
                if (verifyBtn) verifyBtn.removeAttribute("disabled");
                if (spinner) spinner.className = "i-lucide-zap text-sm";
                if (btnLabel) btnLabel.innerText = t("order_pay.verify_btn_idle", "⚡ Verifikasi Pembayaran On-Chain");
            }
        }

        function reorderThisOrder() {
            try {
                const raw = document.getElementById("order-items-json")?.textContent;
                const items = raw ? JSON.parse(raw) : [];
                const currentCart = JSON.parse(localStorage.getItem("yasui_cart") || "[]");

                items.forEach(item => {
                    const targetId = String(item.productId || item.id);
                    const existingIdx = currentCart.findIndex(c => String(c.id) === targetId);
                    if (existingIdx >= 0) {
                        currentCart[existingIdx].quantity = (currentCart[existingIdx].quantity || 1) + (item.quantity || 1);
                        currentCart[existingIdx].selected = true;
                    } else {
                        currentCart.push({
                            id: targetId,
                            name: item.name,
                            price: item.price,
                            rawPrice: item.price,
                            quantity: item.quantity || 1,
                            selected: true,
                            image: item.image ? { sourceUrl: item.image } : null
                        });
                    }
                });

                localStorage.setItem("yasui_cart", JSON.stringify(currentCart));
                window.location.href = "/checkout";
            } catch (e) {
                console.error("Reorder error:", e);
                window.location.href = "/cart";
            }
        }

        function triggerClientExpiry() {
            if (checkInterval) clearInterval(checkInterval);

            const activeContainer = document.getElementById("active-payment-container");
            const expiredContainer = document.getElementById("expired-payment-container");
            const headerBadge = document.getElementById("header-status-badge");
            const timerText = document.getElementById("timer-text");

            if (activeContainer) activeContainer.classList.add("hidden");
            if (expiredContainer) expiredContainer.classList.remove("hidden");

            if (headerBadge) {
                headerBadge.className = "text-[10px] px-2 py-0.5 font-bold uppercase tracking-widest bg-red-950/80 text-red-400 border border-red-800/80";
                headerBadge.innerText = t("order_pay.gateway_expired", "GATEWAY KADALUARSA");
            }

            if (timerText) {
                timerText.className = "text-red-500";
                timerText.innerText = t("order_pay.expired_status", "KADALUARSA");
            }

            fetch(`/api/payment/check-status?id=${orderId}&key=${encodeURIComponent(orderKey)}`).catch(() => {});
        }

        function initCountdown() {
            if (isExpired) return;

            const timerText = document.getElementById("timer-text");
            if (!timerText) return;

            const targetTime = Number(expiryTime) || (Date.now() + 15 * 60 * 1000);

            const updateTimer = () => {
                const diff = Math.max(0, targetTime - Date.now());
                const mins = Math.floor(diff / 60000);
                const secs = Math.floor((diff % 60000) / 1000);

                timerText.innerText = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;

                if (diff <= 0) {
                    triggerClientExpiry();
                }
            };

            updateTimer();
            const timerInterval = setInterval(() => {
                const diff = targetTime - Date.now();
                if (diff <= 0) {
                    clearInterval(timerInterval);
                    triggerClientExpiry();
                } else {
                    updateTimer();
                }
            }, 1000);
        }

        async function checkPaymentStatus(isManual = false) {
            if (isChecking || isExpired) return;
            isChecking = true;

            const checkIcon = document.getElementById("check-icon");
            const pollingLabel = document.getElementById("polling-label");

            if (checkIcon) checkIcon.classList.add("animate-spin");
            if (isManual && pollingLabel) {
                pollingLabel.innerText = isCrypto 
                    ? t("order_pay.polling_checking_crypto", "Memeriksa status mutasi on-chain...") 
                    : t("order_pay.polling_checking_duitku", "Memeriksa status ke Duitku...");
            }

            try {
                const res = await fetch(`/api/payment/check-status?id=${orderId}&key=${encodeURIComponent(orderKey)}`);
                const data = await res.json();

                if (data.success && data.status === "paid") {
                    if (pollingLabel) pollingLabel.innerText = t("order_pay.polling_confirmed", "Pembayaran Dikonfirmasi! Mengalihkan...");
                    localStorage.removeItem("yasui_cart");

                    setTimeout(() => {
                        window.location.href = `/order-success?id=${orderId}&key=${encodeURIComponent(orderKey)}`;
                    }, 800);
                    return;
                } else if (data.status === "expired" || data.status === "failed") {
                    triggerClientExpiry();
                    return;
                } else {
                    if (isManual && pollingLabel) {
                        pollingLabel.innerText = t("order_pay.polling_not_detected", "Pembayaran belum terdeteksi. Silakan coba sesaat lagi.");
                        setTimeout(() => {
                            pollingLabel.innerText = t("order_pay.polling_detecting", "Mendeteksi transaksi masuk secara otomatis...");
                        }, 3000);
                    }
                }
            } catch (err) {
                console.error("Gagal memeriksa status:", err);
            } finally {
                isChecking = false;
                if (checkIcon) checkIcon.classList.remove("animate-spin");
            }
        }

        document.getElementById("btn-copy-va")?.addEventListener("click", copyVaNumber);
        document.getElementById("btn-copy-amount")?.addEventListener("click", copyCryptoAmount);
        document.getElementById("btn-copy-wallet")?.addEventListener("click", copyCryptoWallet);
        document.getElementById("btn-verify-crypto")?.addEventListener("click", verifyCryptoOnChain);
        document.getElementById("tx-hash-input")?.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                verifyCryptoOnChain();
            }
        });
        document.getElementById("btn-reorder")?.addEventListener("click", reorderThisOrder);
        document.getElementById("btn-manual-check")?.addEventListener("click", () => checkPaymentStatus(true));

        document.addEventListener("yasui-lang-change", () => {
            if (typeof window.applyTranslations === "function") {
                window.applyTranslations(document);
            }
        });

        if (!isExpired) {
            initCountdown();
            checkInterval = setInterval(() => {
                checkPaymentStatus(false);
            }, 4000);
        }
    </script>
</Layout>
