---
// src/pages/order-success.astro
import Layout from "../layouts/Layout.astro";
import { getOrder } from "../lib/wc";

const rawId = Astro.url.searchParams.get("id") || "UNKNOWN";
const orderKey = Astro.url.searchParams.get("key") || "";
const orderId = rawId.startsWith("YG-") ? rawId.split("-")[1] : rawId;

let order = null;
let accessDenied = false;

if (orderId && orderId !== "UNKNOWN") {
    try {
        order = await getOrder(orderId, { bypassCache: true });
        // Validasi order_key keamanan (Zero-Trust IDOR protection)
        if (!order || !order.id || !orderKey || order.order_key !== orderKey) {
            accessDenied = true;
            order = null;
        }
    } catch (e) {
        console.warn("Could not fetch order for success page:", e.message);
        accessDenied = true;
    }
} else {
    accessDenied = true;
}

const formattedTotal = order ? `Rp ${Number(order.total).toLocaleString("id-ID")}` : null;
const lineItems = order?.line_items || [];
const pageTitle = accessDenied ? "Akses Dibatasi - Yasui Game" : "Order Berhasil - Yasui Game";
---

<Layout title={pageTitle} showFooter={false}>
    <main class="min-h-[85vh] flex items-center justify-center p-4 py-12">
        <div class="max-w-md w-full">
            <div class="bg-[#11131A] border border-[#222634] rounded-lg p-6 sm:p-8">
                {accessDenied ? (
                    <div class="text-center py-4">
                        <div class="w-14 h-14 bg-red-950/40 border border-red-500/40 rounded-lg flex items-center justify-center mx-auto mb-4 text-red-400">
                            <div class="i-lucide-shield-alert text-2xl"></div>
                        </div>
                        <h1 class="text-lg font-bold text-white uppercase tracking-wider mb-2 font-mono">
                            Akses Pesanan Dibatasi
                        </h1>
                        <p class="text-xs text-[#94A3B8] mb-6 font-mono leading-relaxed">
                            Parameter otorisasi pesanan (key) tidak valid atau sesi Anda telah kedaluwarsa.
                            Untuk alasan keamanan, detail faktur dan kredensial akun dilindungi.
                        </p>
                        <div class="space-y-3">
                            <a
                                href="/orders"
                                class="yg-btn-primary block w-full text-center"
                            >
                                Buka Dashboard Pesanan Saya
                            </a>
                            <a
                                href="/"
                                class="yg-btn-secondary block w-full text-center"
                            >
                                Kembali ke Beranda
                            </a>
                        </div>
                    </div>
                ) : (
                    <>
                        <div class="text-center mb-6">
                            <div class="w-16 h-16 bg-[#00E5FF]/10 border border-[#00E5FF]/40 rounded-lg flex items-center justify-center mx-auto mb-4">
                                <div class="i-lucide-check text-3xl text-[#00E5FF]"></div>
                            </div>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 text-[10px] font-mono font-bold tracking-wider uppercase mb-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                <span data-i18n="order_success.verified">TRANSAKSI DIVERIFIKASI</span>
                            </span>
                            <h1 class="text-xl sm:text-2xl font-bold text-white uppercase tracking-tight mb-1" data-i18n="order_success.title">
                                Pembayaran Diterima
                            </h1>
                            <p class="text-xs text-[#94A3B8] font-mono">
                                <span data-i18n="order_success.order_id">ORDER ID:</span> <span class="text-[#00E5FF] font-bold">#{order.id}</span>
                            </p>
                        </div>

                        <div class="space-y-4 mb-6">
                            {order && (
                                <div class="bg-[#0D0F15] border border-[#222634] p-4 rounded-lg text-xs font-mono">
                                    <div class="flex justify-between pb-2.5 border-b border-[#222634] text-[#94A3B8]">
                                        <span data-i18n="order_success.status">Status Pesanan</span>
                                        <span class="text-emerald-400 font-bold uppercase"><span data-i18n="order_success.paid">LUNAS</span> / {order.status}</span>
                                    </div>
                                    <div class="py-2.5 space-y-2 border-b border-[#222634]">
                                        {lineItems.map(item => (
                                            <div class="flex justify-between text-[#F8FAFC]">
                                                <span class="truncate max-w-[210px]">{item.name} x{item.quantity}</span>
                                                <span class="text-[#94A3B8] tabular-nums yg-price" data-price-idr={Number(item.total)}>Rp {Number(item.total).toLocaleString("id-ID")}</span>
                                            </div>
                                        ))}
                                    </div>
                                    <div class="flex justify-between pt-2.5 text-white font-bold">
                                        <span data-i18n="order_success.total_paid">Total Dibayar</span>
                                        <span class="text-[#00E5FF] tabular-nums yg-price" data-price-idr={Number(order.total)}>{formattedTotal}</span>
                                    </div>
                                </div>
                            )}

                            <div class="bg-[#0D0F15] border-l-2 border-[#00E5FF] border-y border-r border-[#222634] p-3.5 rounded-r-lg">
                                <h2 class="text-white font-bold text-xs mb-1 flex items-center gap-2">
                                    <div class="i-lucide-mail text-[#00E5FF] text-sm"></div>
                                    <span data-i18n="order_success.check_email_title">Cek Email & WhatsApp</span>
                                </h2>
                                <p class="text-[11px] text-[#94A3B8] leading-relaxed" data-i18n="order_success.check_email_desc">
                                    Detail akun game telah dikirim ke email <b class="text-white">{order?.billing?.email || "Anda"}</b>. Jika tidak ada di inbox utama, silakan periksa folder <b>SPAM</b>.
                                </p>
                            </div>

                            <div class="bg-[#0D0F15] border-l-2 border-emerald-500 border-y border-r border-[#222634] p-3.5 rounded-r-lg">
                                <h2 class="text-white font-bold text-xs mb-1 flex items-center gap-2">
                                    <div class="i-lucide-user-check text-emerald-400 text-sm"></div>
                                    <span data-i18n="order_success.auto_dispatch_title">Pengiriman Otomatis & Support</span>
                                </h2>
                                <p class="text-[11px] text-[#94A3B8] leading-relaxed" data-i18n="order_success.auto_dispatch_desc">
                                    Admin Yasui Game memproses serah terima secara real-time. Jika pesanan Anda membutuhkan konfigurasi ID (seperti Summoners War), gunakan menu di dashboard pesanan.
                                </p>
                            </div>

                            <div id="quick-pwd-card" class="bg-[#0D0F15] border border-[#222634] p-4 rounded-lg">
                                <div class="flex items-center gap-2 mb-1.5">
                                    <div class="i-lucide-shield-check text-[#00E5FF] text-sm"></div>
                                    <h2 class="text-xs font-bold text-white uppercase tracking-wider font-mono" data-i18n="order_success.secure_account_title">
                                        Amankan Akun Anda
                                    </h2>
                                </div>
                                <p class="text-[11px] text-[#94A3B8] mb-3 leading-relaxed" data-i18n="order_success.secure_account_desc">
                                    Akun Anda telah terdaftar otomatis. Pasang kata sandi sekarang untuk mengunci profil & mengakses kredensial kapan saja.
                                </p>
                                
                                <div id="pwd-card-form" class="space-y-2.5">
                                    <input
                                        type="password"
                                        id="success-new-pwd"
                                        minlength="6"
                                        placeholder="Buat kata sandi baru (min. 6 karakter)"
                                        class="yg-input"
                                    />
                                    <button
                                        id="btn-save-success-pwd"
                                        class="yg-btn-primary w-full text-xs py-2.5"
                                        data-i18n="order_success.btn_save_pwd"
                                    >
                                        Kunci & Simpan Kata Sandi
                                    </button>
                                </div>
                                <div id="pwd-card-msg" class="hidden text-[11px] font-mono mt-2 p-2.5 rounded-lg"></div>
                            </div>
                        </div>

                        <div class="space-y-2.5">
                            <a
                                href="/orders"
                                class="yg-btn-primary block w-full text-center flex items-center justify-center gap-2"
                            >
                                <div class="i-lucide-receipt text-sm"></div>
                                <span data-i18n="order_success.btn_dashboard">Buka Dashboard Pesanan Saya</span>
                            </a>
                            <a
                                href="/"
                                class="yg-btn-secondary block w-full text-center"
                            >
                                <span data-i18n="order_success.btn_home">Kembali ke Beranda</span>
                            </a>
                        </div>

                        <script is:inline define:vars={{ orderId: order?.id, orderKey: order?.order_key, orderEmail: order?.billing?.email }}>
                            const btn = document.getElementById("btn-save-success-pwd");
                            btn?.addEventListener("click", async () => {
                                const pwd = document.getElementById("success-new-pwd")?.value;
                                const email = orderEmail || localStorage.getItem("yasui_buyer_email") || "";
                                const msg = document.getElementById("pwd-card-msg");

                                if (!email) {
                                    alert("Email pemesanan tidak ditemukan.");
                                    return;
                                }
                                if (!pwd || pwd.length < 6) {
                                    alert("Kata sandi minimal 6 karakter.");
                                    return;
                                }

                                btn.disabled = true;
                                btn.innerText = "MENYIMPAN...";

                                try {
                                    const res = await fetch("/api/auth/set-password", {
                                        method: "POST",
                                        headers: { "Content-Type": "application/json" },
                                        body: JSON.stringify({ 
                                            email: email, 
                                            password: pwd,
                                            orderId: orderId,
                                            orderKey: orderKey
                                        })
                                    });
                                    const data = await res.json();
                                    if (!res.ok || !data.success) {
                                        throw new Error(data.error || "Gagal menyimpan kata sandi");
                                    }

                                    if (data.session?.token) {
                                        localStorage.setItem("yasui_session", JSON.stringify({
                                            ...(data.user || {}),
                                            email: email,
                                            token: data.session.token,
                                            expiresAt: data.session.expiresAt || (Date.now() + 30 * 24 * 60 * 60 * 1000)
                                        }));
                                    }

                                    msg.className = "text-[11px] font-mono mt-2 p-2.5 rounded-lg bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 block";
                                    msg.innerText = "✓ Kata sandi berhasil dibuat! Akun Anda kini aktif & aman.";
                                    document.getElementById("pwd-card-form")?.classList.add("hidden");
                                } catch (err) {
                                    msg.className = "text-[11px] font-mono mt-2 p-2.5 rounded-lg bg-red-950/40 border border-red-500/40 text-red-400 block";
                                    msg.innerText = err.message || "Gagal menyimpan kata sandi";
                                    btn.disabled = false;
                                    btn.innerText = "KUNCI & SIMPAN KATA SANDI";
                                }
                            });
                        </script>
                    </>
                )}

                <div class="mt-6 pt-4 border-t border-[#222634] text-center">
                    <p class="text-[10px] text-[#64748B] font-mono flex items-center justify-center gap-1.5 uppercase">
                        <span class="i-lucide-lock text-xs text-[#00E5FF]"></span>
                        <span>Transaksi Terenkripsi & Terverifikasi</span>
                    </p>
                </div>
            </div>
        </div>
    </main>
</Layout>
